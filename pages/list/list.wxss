/* pages/list/list.wxss */

.container {
  background-color: #ffffff;
  min-height: 100vh;
}

/* 状态栏占位 */
.status-bar {
  background-color: #ffffff;
  width: 100%;
}

.toolbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.toolbar-actions {
  display: flex;
  gap: 15rpx;
}

.toolbar-actions .btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.toolbar-actions .icon {
  font-size: 24rpx;
}

/* 页面内容容器 - 与main页面保持一致的padding */
.page-content {
  padding: 20rpx;
}

.circles-container {
  flex: 1;
  height: calc(100vh - 120rpx);
  padding: 0 0 120rpx 0; /* 增加底部留白，确保最后一个卡片完整显示 */
}

.circles-list {
  /* 🎯 修复：阻止子元素 margin-top 穿透（CSS margin collapse），避免产生可滚动空间 */
  overflow: hidden;
}

/* .circle-item 样式已不再需要，因为现在使用discover-circle-card组件 */

.circle-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.circle-info {
  flex: 1;
}

.circle-name-container {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}

.circle-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-right: 15rpx;
}

.circle-tags {
  display: flex;
  gap: 8rpx;
}

.circle-meta {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.meta-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.meta-item .icon {
  font-size: 28rpx;
  margin-right: 6rpx;
}

.circle-actions {
  display: flex;
  align-items: center;
}

.action-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 50%;
}

.action-btn .icon {
  font-size: 28rpx;
  color: #666;
}

.creator-info {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 15rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.creator-name {
  font-size: 26rpx;
  color: #666;
  margin-left: 15rpx;
}

.latest-post {
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  margin-bottom: 15rpx;
}

.latest-post-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.latest-post-title {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.latest-post-time {
  font-size: 22rpx;
  color: #999;
}

.latest-post-content {
  margin-top: 10rpx;
}

.latest-post-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.no-post {
  padding: 20rpx;
  text-align: center;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  margin-bottom: 15rpx;
}

.no-post-text {
  font-size: 26rpx;
  color: #999;
}

.circle-id {
  display: flex;
  align-items: center;
  padding-top: 15rpx;
  border-top: 1rpx solid #f0f0f0;
}

.id-label {
  font-size: 24rpx;
  color: #999;
}

.id-value {
  font-size: 24rpx;
  color: #666;
  font-family: monospace;
  background-color: #f5f5f5;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
  flex: 1;
  word-break: break-all;
}

/* 空状态样式 */
.empty-state {
  text-align: center;
  padding: 350rpx 40rpx 120rpx 40rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #666;
  margin: 20rpx 0;
  line-height: 1.5;
}

.empty-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 40rpx;
}

.empty-actions .btn {
  width: 300rpx;
  margin: 0 auto;
}

/* 模态框样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background-color: #fff;
  border-radius: 20rpx;
  width: 600rpx;
  max-width: 90%;
  max-height: 80%;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  padding: 30rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  font-size: 28rpx;
  background-color: #fff;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #07c160;
}

.form-switch {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-desc {
  margin-top: 15rpx;
}

.form-desc text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  background-color: #fafafa;
}

.modal-footer .btn {
  min-width: 120rpx;
}

/* 历史记录模式特殊样式已移至discover-circle-card组件中 */

/* 历史记录模式时间标签 */
.meta-item.last-activity {
  background-color: #f6ffed;
  color: #52c41a;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  border: 1rpx solid #d9f7be;
}

.meta-item.last-activity .icon {
  color: #52c41a;
}

/* 历史记录模式进入按钮 */
.action-btn.enter-btn {
  background-color: #52c41a;
}

.action-btn.enter-btn .icon {
  color: #ffffff;
  font-weight: bold;
  font-size: 32rpx;
}

/* 没有更多了提示 */
.no-more-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 150rpx 0;
  gap: 20rpx;
}

.no-more-line {
  flex: 1;
  height: 1rpx;
  background-color: #e8e8e8;
  max-width: 100rpx;
}

.no-more-text {
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
}

/* 响应式适配 */
@media (max-width: 400px) {
  .circle-name-container {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .circle-name {
    margin-bottom: 10rpx;
  }
  
  .circle-meta {
    flex-direction: column;
    gap: 10rpx;
  }
  
  .modal-content {
    width: 95%;
  }
}