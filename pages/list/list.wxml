<!--pages/list/list.wxml-->
<view class="container">
  <!-- 自定义导航栏 -->
  <custom-navigation title="{{pageTitle}}" bindback="navigateToMain" custom-back="{{true}}" bindnavigationReady="onNavigationReady"></custom-navigation>
  
  <!-- 内容区域 -->
  <view class="page-content" style="padding-top: {{navigationData.totalNavigationHeight || 88}}px;">

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading && circles.length === 0}}">
    <text>加载中...</text>
  </view>

  <!-- 朋友圈列表 -->
  <scroll-view class="circles-container" scroll-y="true" enable-back-to-top="true" wx:else>
    <view class="circles-list">
      <discover-circle-card
        wx:for="{{circles}}" 
        wx:key="_id"
        mode="history"
        title="{{item.name}}"
        circle-data="{{item}}"
        circle-id="{{item._id}}"
        creator-avatar="{{item.creator.avatar || '/images/default_avatar.png'}}"
        content="{{item.latestPost ? (item.latestPost.content || '图片动态') : '还没有动态'}}"
        has-content="{{!!item.latestPost}}"
        post-image="{{item.postImageUrl || ''}}"
        last-update-time="{{item.lastUpdateFormatted}}"
        members="{{item.members || []}}"
        member-count="{{item.memberCount || 0}}"
        has-delete-permission="{{item.hasDeletePermission}}"
        bind:cardTap="viewCirclePosts"
        bind:delete="onCircleDelete"
        bindlongpress="onCircleLongPress"
        data-circle-id="{{item._id}}"
        data-circle-name="{{item.name}}"
        data-is-creator="{{item.creator._id === currentUser._id}}">
      </discover-circle-card>
    </view>

    <!-- 没有更多了提示 -->
    <view class="no-more-tip" wx:if="{{circles.length > 0}}">
      <view class="no-more-line"></view>
      <text class="no-more-text">没有更多了</text>
      <view class="no-more-line"></view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{circles.length === 0 && !loading}}">
      <view class="empty-text">还没有朋友圈</view>
      <view class="empty-desc">创建或加入一个朋友圈，开始分享生活吧</view>
    </view>
  </scroll-view>
  
  </view> <!-- 内容区域结束 -->
</view>