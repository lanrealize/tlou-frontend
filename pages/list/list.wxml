<!--pages/list/list.wxml-->
<view class="container">
  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{safeAreaInfo.statusBarHeight}}px;"></view>
  
  <!-- 顶部工具栏 -->
  <view class="toolbar">
    <view class="toolbar-left">
      <view class="back-btn" bindtap="navigateToMain">
        <text class="back-icon">←</text>
        <text>返回主页</text>
      </view>
    </view>
    <view class="toolbar-title">
      <text>{{pageTitle}}</text>
    </view>
    <view class="toolbar-actions" wx:if="{{!isHistoryMode}}">
      <button class="btn btn-primary btn-small" bindtap="showCreateDialog">
        <text class="icon">+</text>
        <text>创建</text>
      </button>
      <button class="btn btn-secondary btn-small" bindtap="showJoinDialog">
        <text class="icon">👥</text>
        <text>加入</text>
      </button>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading && circles.length === 0}}">
    <text>加载中...</text>
  </view>

  <!-- 朋友圈列表 -->
  <scroll-view class="circles-container" scroll-y="true" enable-back-to-top="true" wx:else>
    <view class="circles-list">
      <view class="circle-item card {{isHistoryMode ? 'history-mode' : ''}}" 
            wx:for="{{circles}}" 
            wx:key="_id"
            bindtap="viewCirclePosts"
            bindlongpress="onCircleLongPress"
            data-circle-id="{{item._id}}"
            data-circle-name="{{item.name}}"
            data-is-creator="{{item.creator._id === app.globalData.openid}}">
        
        <!-- 朋友圈头部信息 -->
        <view class="circle-header">
          <view class="circle-info">
            <view class="circle-name-container">
              <text class="circle-name">{{item.name}}</text>
              <view class="circle-tags">
                <text class="tag tag-success" wx:if="{{item.creator._id === app.globalData.openid}}">创建者</text>
                <text class="tag tag-primary" wx:if="{{item.isPublic}}">公开</text>
                <text class="tag" wx:else>私密</text>
              </view>
            </view>
            <view class="circle-meta">
              <text class="meta-item">
                <text class="icon">👥</text>
                {{item.memberCount}} 人
              </text>
              <text class="meta-item">
                <text class="icon">📅</text>
                {{isHistoryMode ? item.lastUpdateFormatted : item.formattedTime}}
              </text>
              <text class="meta-item last-activity" wx:if="{{isHistoryMode}}">
                <text class="icon">🕐</text>
                最后活动
              </text>
            </view>
          </view>
          
          <!-- 朋友圈操作 -->
          <view class="circle-actions">
            <!-- 历史记录模式显示进入图标 -->
            <view class="action-btn enter-btn" wx:if="{{isHistoryMode}}">
              <text class="icon">→</text>
            </view>
            <!-- 普通模式显示复制按钮 -->
            <view class="action-btn" wx:else bindtap="copyCircleId" data-circle-id="{{item._id}}" catchtap="true">
              <text class="icon">📋</text>
            </view>
          </view>
        </view>

        <!-- 创建者信息 -->
        <view class="creator-info">
          <image class="avatar avatar-small" src="{{item.creator.avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
          <text class="creator-name">创建者: {{item.creator.username}}</text>
        </view>

        <!-- 最新动态 -->
        <view class="latest-post" wx:if="{{item.latestPost}}">
          <view class="latest-post-header">
            <text class="latest-post-title">最新动态</text>
            <text class="latest-post-time">{{item.latestPost.formattedTime}}</text>
          </view>
          <view class="latest-post-content">
            <text class="latest-post-text">{{item.latestPost.content || '图片动态'}}</text>
          </view>
        </view>

        <!-- 无动态状态 -->
        <view class="no-post" wx:else>
          <text class="no-post-text">还没有动态</text>
        </view>

        <!-- 朋友圈ID -->
        <view class="circle-id">
          <text class="id-label">ID: </text>
          <text class="id-value">{{item._id}}</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{circles.length === 0 && !loading}}">
      <view class="empty-icon">{{isHistoryMode ? '📋' : '🌟'}}</view>
      <view class="empty-text">{{isHistoryMode ? '暂无历史记录' : '还没有朋友圈'}}</view>
      <view class="empty-desc">{{isHistoryMode ? '当你参与朋友圈后，记录会显示在这里' : '创建一个朋友圈，开始分享生活吧'}}</view>
      <view class="empty-actions" wx:if="{{!isHistoryMode}}">
        <button class="btn btn-primary" bindtap="showCreateDialog">创建朋友圈</button>
        <button class="btn btn-secondary" bindtap="showJoinDialog">加入朋友圈</button>
      </view>
    </view>
  </scroll-view>

  <!-- 创建朋友圈对话框 -->
  <view class="modal-overlay" wx:if="{{showCreateDialog && !isHistoryMode}}" bindtap="hideCreateDialog">
    <view class="modal-content" catchtap="true">
      <view class="modal-header">
        <text class="modal-title">创建朋友圈</text>
        <text class="modal-close" bindtap="hideCreateDialog">✕</text>
      </view>
      
      <view class="modal-body">
        <view class="form-group">
          <text class="form-label">朋友圈名称</text>
          <input class="form-input" 
                 placeholder="请输入朋友圈名称" 
                 value="{{newCircleName}}" 
                 bindinput="onCircleNameInput"
                 maxlength="20" />
        </view>
        
        <view class="form-group">
          <view class="form-switch">
            <text class="form-label">公开朋友圈</text>
            <switch checked="{{newCircleIsPublic}}" 
                    bindchange="onPublicSwitchChange" 
                    color="#07c160" />
          </view>
          <view class="form-desc">
            <text>公开的朋友圈任何人都可以查看，私密朋友圈只有成员可以查看</text>
          </view>
        </view>
      </view>
      
      <view class="modal-footer">
        <button class="btn btn-secondary" bindtap="hideCreateDialog">取消</button>
        <button class="btn btn-primary {{newCircleName ? '' : 'disabled'}}" 
                bindtap="createCircle" 
                disabled="{{!newCircleName}}">
          创建
        </button>
      </view>
    </view>
  </view>

  <!-- 加入朋友圈对话框 -->
  <view class="modal-overlay" wx:if="{{showJoinDialog && !isHistoryMode}}" bindtap="hideJoinDialog">
    <view class="modal-content" catchtap="true">
      <view class="modal-header">
        <text class="modal-title">加入朋友圈</text>
        <text class="modal-close" bindtap="hideJoinDialog">✕</text>
      </view>
      
      <view class="modal-body">
        <view class="form-group">
          <text class="form-label">朋友圈ID</text>
          <input class="form-input" 
                 placeholder="请输入朋友圈ID" 
                 value="{{joinCircleId}}" 
                 bindinput="onJoinIdInput" />
        </view>
        
        <view class="form-desc">
          <text>请向朋友圈创建者或成员获取朋友圈ID</text>
        </view>
      </view>
      
      <view class="modal-footer">
        <button class="btn btn-secondary" bindtap="hideJoinDialog">取消</button>
        <button class="btn btn-primary {{joinCircleId ? '' : 'disabled'}}" 
                bindtap="joinCircle" 
                disabled="{{!joinCircleId}}">
          加入
        </button>
      </view>
    </view>
  </view>
</view>