/* pages/management/management.wxss */

.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

/* 头部样式 */
.header {
  text-align: center;
  padding: 40rpx 20rpx;
  margin-bottom: 20rpx;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 通用section样式 */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

/* 当前身份信息 */
.current-identity-section {
  margin-bottom: 30rpx;
}

.identity-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  border-left: 6rpx solid #1A73E8;
}

.identity-card.virtual {
  border-left-color: #52c41a;
  background: linear-gradient(135deg, rgba(82, 196, 26, 0.05), rgba(82, 196, 26, 0.02));
}

.identity-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 3rpx solid #f0f0f0;
}

.identity-info {
  flex: 1;
}

.identity-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.identity-type {
  display: block;
  font-size: 24rpx;
  color: #666;
}

.switch-btn {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #1A73E8, #4285f4);
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 24rpx;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.switch-avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.switch-text {
  font-weight: 500;
}

/* 创建表单样式 */
.create-section {
  margin-bottom: 30rpx;
}

.create-form {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 15rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  background-color: #fafafa;
  transition: border-color 0.2s ease;
}

.form-input:focus {
  border-color: #1A73E8;
  background-color: #ffffff;
}

/* 头像上传 */
.avatar-upload {
  display: flex;
  align-items: center;
  gap: 30rpx;
  margin-top: 15rpx;
}

.avatar-preview {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid #e0e0e0;
  overflow: hidden;
  background-color: #f5f5f5;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.upload-btn {
  flex: 1;
  height: 80rpx;
  background-color: #fafafa;
  border: 2rpx dashed #d9d9d9;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.2s ease;
}

.upload-btn:hover {
  border-color: #1A73E8;
  background-color: #f0f7ff;
  color: #1A73E8;
}

.upload-btn.uploading {
  background-color: #e6f7ff;
  border-color: #1A73E8;
  color: #1A73E8;
}

.upload-icon {
  font-size: 32rpx;
}

.upload-text {
  font-weight: 500;
}

.form-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 15rpx;
  line-height: 1.4;
}

/* 按钮样式 */
.create-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1A73E8, #4285f4);
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  margin-top: 20rpx;
}

.create-btn.disabled {
  background: #d9d9d9;
  color: #999999;
  box-shadow: none;
}

/* 虚拟用户列表 */
.virtual-users-section {
  margin-bottom: 30rpx;
}

.users-list {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
}

.user-item {
  display: flex;
  align-items: center;
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.user-item:last-child {
  border-bottom: none;
}

.user-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid #f0f0f0;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 6rpx;
}

.user-meta {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.user-actions {
  display: flex;
  gap: 15rpx;
}

.action-btn {
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  border: none;
  font-weight: 500;
}

.switch-btn-small {
  background: linear-gradient(135deg, #1A73E8, #4285f4);
  color: #ffffff;
}

.delete-btn-small {
  background-color: #ff4d4f;
  color: #ffffff;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
}

.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
}

/* 说明信息 */
.info-section {
  margin-bottom: 30rpx;
}

.info-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  border-left: 6rpx solid #52c41a;
}

.info-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.info-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

/* 主题按钮样式 */
.theme-btn {
  background: linear-gradient(135deg, #1A73E8, #4285f4);
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  font-weight: 500;
}

.theme-btn:active {
  transform: scale(0.98);
}

.theme-btn.disabled {
  background: #d9d9d9 !important;
  color: #999999 !important;
  box-shadow: none !important;
  transform: none !important;
}

/* 响应式适配 */
@media (max-width: 400px) {
  .avatar-option {
    width: 70rpx;
    height: 70rpx;
  }
  
  .user-avatar {
    width: 50rpx;
    height: 50rpx;
  }
  
  .identity-avatar {
    width: 70rpx;
    height: 70rpx;
  }
  
  .action-btn {
    padding: 8rpx 16rpx;
    font-size: 20rpx;
  }
}