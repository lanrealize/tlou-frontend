/* pages/main/main.wxss */

/* 公共字体样式 */
.card-main-title {
  font-size: 28rpx;
  color: #000000;
  font-weight: 400;
  line-height: 1.5;
}

.card-sub-title {
  font-size: 24rpx;
  color: #808080;
  font-weight: 400;
  line-height: 1.6;
}

/* 基础样式 */
page {
  background-color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
}

view, text, image {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* 页面容器 */
.page-container {
  position: relative;
  width: 100%;
  min-height: 100vh;
  background-color: #ffffff;
  overflow-x: hidden;
}

/* 状态栏占位 */
.status-bar {
  background-color: #ffffff;
  width: 100%;
}

/* 头部区域 - 采用flex布局实现整体居中对齐 */
.header {
  display: flex;
  align-items: center;
  padding: 40rpx 40rpx 20rpx 40rpx;
  margin-top: 60rpx;
}

.title-group {
  flex: 1;
  margin-left: 30rpx;
}

.welcome-text {
  font-size: 32rpx;
  color: #A6A6A6;
  line-height: 1.2;
  font-weight: 400;
  margin-bottom: 12rpx;
}

.title-text {
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #383838;
  letter-spacing: 1rpx;
}

.avatar-main {
  width: 102rpx;
  height: 102rpx;
  border-radius: 50%;
  background-position: center;
  background-size: cover;
  background-repeat: no-repeat;
  flex-shrink: 0;
}

.avatar-main.error-avatar {
  opacity: 0.7;
  filter: grayscale(0.3);
}

.avatar-main.loading-avatar {
  opacity: 0.6;
}

/* 管理员设置按钮 */
.admin-btn {
  color: #1A73E8;
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 400;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

/* 身份标识徽章 */
.identity-badge {
  margin-top: 16rpx;
  display: inline-block;
}

.identity-text {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #1A73E8, #4285f4);
  color: #ffffff;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
}

/* 登录状态检查卡片 */
.login-checking-card {
  position: relative;
  margin: 30rpx 40rpx;
  height: 228rpx;
  border-radius: 10rpx;
  background: #ffffff;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 朋友圈加载状态卡片 */
.friend-circle-loading {
  position: relative;
  margin: 30rpx 40rpx;
  height: 228rpx;
  border-radius: 10rpx;
  background: #ffffff;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 朋友圈卡片 */
.friend-circle-card {
  position: relative;
  margin: 30rpx 40rpx;
  height: 228rpx;
  border-radius: 10rpx;
  background: #ffffff;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
}

.card-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  background: #ffffff;
}

.card-title {
  position: absolute;
  left: 40rpx;
  top: 30rpx;
  z-index: 1;
}

.user-count {
  position: absolute;
  left: 40rpx;
  top: 148rpx;
  font-size: 24rpx;
  color: #808080;
  z-index: 3;
  display: flex;
  align-items: center;
  width: auto;
}

.avatar-group {
  position: relative;
  margin-left: 20rpx;
  width: 200rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
}

.avatar-small-1 {
  position: absolute;
  left: 0;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  z-index: 1;
}

.avatar-small-2 {
  position: absolute;
  left: 30rpx;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  z-index: 2;
}

.avatar-small-3 {
  position: absolute;
  left: 60rpx;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  z-index: 3;
}

.avatar-small-4 {
  position: absolute;
  left: 90rpx;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  z-index: 4;
}

.avatar-small-5 {
  position: absolute;
  left: 120rpx;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  z-index: 5;
}

.avatar-more {
  position: absolute;
  left: 150rpx;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  overflow: hidden;
  z-index: 6;
}

.avatar-more-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-more-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
  z-index: 1;
}

.avatar-more-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 18rpx;
  font-weight: 600;
  color: #ffffff;
  z-index: 2;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.5);
}

.status-tag {
  position: absolute;
  right: 20rpx;
  top: 28rpx;
  display: flex;
  align-items: center;
  z-index: 4;
}

.status-tag text {
  font-size: 28rpx;
  color: #1A73E8;
  margin-right: 8rpx;
}

.status-icon {
  width: 24rpx;
  height: 24rpx;
}

.update-time {
  position: absolute;
  left: 40rpx;
  top: 92rpx;
  font-size: 24rpx;
  color: #808080;
  z-index: 4;
  margin-top: 3rpx;
}

/* 空状态朋友圈卡片 */
.empty-state-card,
.browse-tip-card {
  margin: 30rpx 40rpx;
  border-radius: 10rpx;
  background: #ffffff;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  padding: 44rpx 40rpx 36rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-title {
  margin-bottom: 24rpx;
}

.empty-desc {
  width: 100%;
  max-width: 540rpx;
}

.divider {
  width: 100%;
  height: 2rpx;
  background-color: #E0E0E0;
  margin-bottom: 32rpx;
}

.create-btn {
  font-size: 28rpx;
  color: #1A73E8;
  font-weight: 700;
}

/* 操作行布局 */
.action-row {
  display: flex;
  margin: 30rpx 40rpx;
  gap: 30rpx;
}

/* 创建区域 */
.create-section {
  position: relative;
  flex: 1;
  height: 128rpx;
  border-radius: 10rpx;
  background: #ffffff;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
}

.create-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  background: #ffffff;
}

.create-content {
  position: relative;
  padding: 24rpx 32rpx;
  height: 100%;
  display: flex;
  align-items: center;
  z-index: 1;
}

.scan-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scan-icon image {
  width: 100%;
  height: 100%;
}

.create-text-container {
  flex: 1;
}

.create-title {
  margin-bottom: 8rpx;
}

.create-desc {
  /* 字体样式由公共样式提供 */
}

/* 右侧功能区 */
.action-panel {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  border-radius: 10rpx;
  background: #ffffff;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
}

.action-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  background: #ffffff;
}

.action-icon-container {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.action-icon {
  width: 52rpx;
  height: 52rpx;
}

/* 发现有趣朋友圈 */
.post-card {
  position: relative;
  margin: 30rpx 40rpx;
  height: 300rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
}

.post-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  background: #ffffff;
}

.discover-title {
  position: absolute;
  left: 40rpx;
  top: 34rpx;
  z-index: 5;
}

.menu-icon {
  position: absolute;
  right: 40rpx;
  top: 30rpx;
  width: 50rpx;
  height: 50rpx;
  z-index: 6;
}

.menu-icon image {
  width: 100%;
  height: 100%;
}

.discover-avatar {
  position: absolute;
  left: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 55rpx;
  height: 55rpx;
  border-radius: 30rpx;
  z-index: 3;
}

.content-container {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  left: 90rpx;
  width: 250rpx;
  z-index: 2;
  padding-left: 32rpx;
}

.quote-mark {
  font-size: 32rpx;
  color: #1A73E8;
  font-weight: 700;
  position: absolute;
  left: 40rpx;
  top: 0;
  line-height: 1.4;
}

.post-content {
  flex: 1;
  color: #808080;
  font-size: 24rpx;
  font-weight: 400;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  text-overflow: ellipsis;
  line-height: 1.4;
  text-indent: 2em;
}

.view-btn {
  position: absolute;
  left: 40rpx;
  bottom: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: row;
  z-index: 3;
}

.view-more {
  font-size: 28rpx;
  color: #1A73E8;
  font-weight: 400;
  margin-right: 8rpx;
}

.view-icon {
  width: 24rpx;
  height: 24rpx;
}

.rotated-img {
  position: absolute;
  right: -100rpx;
  top: 140rpx;
  width: 360rpx;
  height: 270rpx;
  border-radius: 10rpx;
  transform: rotate(-16.8deg);
  z-index: 6;
  transform-origin: center;
  overflow: hidden;
}

/* 发现有趣朋友圈 - 加载状态 */
.discover-loading {
  position: relative;
  margin: 30rpx 40rpx;
  height: 200rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  background: #ffffff;
}

.loading-title {
  position: absolute;
  top: 30rpx;
  left: 40rpx;
  z-index: 2;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 2;
  margin-top: 20rpx;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #1A73E8;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 24rpx;
  color: #808080;
  text-align: center;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 🆕 朋友圈预加载覆盖层样式 */
.circle-preloading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.preloading-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
}

.preloading-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.preloading-spinner {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 40rpx;
}

.spinner-circle {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #f0f0f0;
  border-top: 6rpx solid #1A73E8;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.preloading-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
  text-align: center;
}

.preloading-subtitle {
  font-size: 26rpx;
  color: #808080;
  text-align: center;
}

/* 推荐内容的淡入动画 */
.discover-fade-in {
  animation: fadeIn 0.6s ease-in-out;
}

@keyframes fadeIn {
  0% {
    opacity: 0;
    transform: translateY(20rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 发现区域空状态样式 - 采用统一的卡片样式 */
.discover-empty {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 30rpx 40rpx;
  padding: 60rpx 40rpx;
  border-radius: 10rpx;
  background: #ffffff;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  text-align: center;
  overflow: hidden;
}

.discover-empty .card-sub-title {
  margin-top: 20rpx;
}

.refresh-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  background-color: #f5f5f5;
  opacity: 0.8;
}

.refresh-hint image {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.refresh-hint text {
  font-size: 24rpx;
  color: #666666;
}

/* 发现空状态的标题和描述现在使用公共样式类 */

/* 响应式适配 */
@media (max-width: 400px) {
  .header {
    padding: 30rpx 30rpx 15rpx 30rpx;
    margin-top: 40rpx;
  }
  
  .avatar-main {
    width: 90rpx;
    height: 90rpx;
  }
  
  .title-text {
    font-size: 36rpx;
  }
  
  .welcome-text {
    font-size: 28rpx;
  }
  
  .admin-btn {
    font-size: 28rpx;
  }
  
  .identity-text {
    font-size: 20rpx;
    padding: 4rpx 12rpx;
  }
  
  .login-checking-card,
  .friend-circle-loading,
  .friend-circle-card,
  .empty-state-card,
  .browse-tip-card {
    margin: 45rpx 30rpx;
    padding: 36rpx 30rpx 30rpx 30rpx;
  }
  
  .post-card {
    margin: 45rpx 30rpx;
  }
  
  .action-row {
    margin: 45rpx 30rpx;
  }
  
  .discover-empty {
    margin: 45rpx 30rpx;
    padding: 45rpx 30rpx;
  }
}