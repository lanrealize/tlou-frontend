/* pages/main/main.wxss */

/* 公共字体样式 */
.card-main-title {
  font-size: 28rpx;
  color: #000000;
  font-weight: 400;
  line-height: 1.5;
  /* 🔧 第1行【变回黑色】的时间（从白→黑） */
  transition: color 4s ease-out, text-shadow 1s ease-out;
}

.card-sub-title {
  font-size: 24rpx;
  color: #808080;
  font-weight: 400;
  line-height: 1.6;
}

/* 基础样式 */
page {
  background-color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
}

view, text, image {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* 页面容器 */
.page-container {
  position: relative;
  width: 100%;
  min-height: 100vh;
  background-color: #ffffff;
  overflow-x: hidden;
}

/* 状态栏占位 */
.status-bar {
  background-color: #ffffff;
  width: 100%;
}

/* 头部区域 - 采用flex布局实现整体居中对齐 */
.header {
  display: flex;
  align-items: center;
  padding: 40rpx 40rpx 20rpx 40rpx;
  margin-top: 60rpx;
}

.title-group {
  flex: 1;
  margin-left: 30rpx;
}

/* 未登录状态下的标题组 - 不显示头像时左移 */
.title-group.no-avatar {
  margin-left: 0;
}

.welcome-text {
  font-size: 32rpx;
  color: #A6A6A6;
  line-height: 1.2;
  font-weight: 400;
  margin-bottom: 12rpx;
}

.title-text {
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #383838;
  letter-spacing: 1rpx;
}

.avatar-main {
  width: 102rpx;
  height: 102rpx;
  border-radius: 50%;
  background-position: center;
  background-size: cover;
  background-repeat: no-repeat;
  flex-shrink: 0;
}

.avatar-main.error-avatar {
  opacity: 0.7;
  filter: grayscale(0.3);
}

.avatar-main.loading-avatar {
  opacity: 0.6;
}

/* 管理员设置按钮 */
.admin-btn {
  color: #1A73E8;
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 400;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

/* 身份标识徽章 */
.identity-badge {
  margin-top: 16rpx;
  display: inline-block;
}

.identity-text {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #1A73E8, #4285f4);
  color: #ffffff;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
}

/* 朋友圈加载状态卡片 */
.friend-circle-loading {
  position: relative;
  margin: 30rpx 40rpx;
  height: 250rpx;
  border-radius: 10rpx;
  background: #ffffff;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  
  /* 🎬 Loading 卡片动画系统 */
  opacity: 1;
  transform: translateY(0);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
              opacity 0.25s ease;
  
  /* 🎬 入场动画：从透明+下沉状态淡入 */
  animation: cardFadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

/* 🎬 卡片淡入动画 */
@keyframes cardFadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 🎬 Loading卡片消失动画 */
.friend-circle-loading.updating {
  opacity: 0;
  transform: translateY(20rpx);
  transition: transform 0.25s cubic-bezier(0.4, 0, 1, 1), 
              opacity 0.2s ease;
}

/* 朋友圈卡片 - Flex 布局 */
.friend-circle-card {
  position: relative;
  margin: 30rpx 40rpx;
  height: 250rpx;
  padding: 34rpx 40rpx 34rpx 40rpx;
  border-radius: 10rpx;
  background: #ffffff;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  
  /* 🎬 切换动画 */
  opacity: 1;
  transform: translateY(0);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
              opacity 0.25s ease;
  
  /* 🎬 入场动画：从透明+下沉状态淡入 */
  animation: cardFadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  
  /* 🔧 性能优化：防止闪烁 */
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* 🎬 朋友圈卡片图片背景（复用视频样式逻辑） */
/* 图片背景层（z-index: 0，最底层） */
.circle-card-image-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  border-radius: 10rpx;
  background: #000000;       /* 图片加载前的占位背景 */
  opacity: 0;                /* 初始透明 */
  transition: opacity 2s ease, border-radius 2s ease;  /* 2秒淡入淡出 + 圆角过渡 */
}

.circle-card-image-bg.fade-in {
  opacity: 1;                /* 淡入：完全显示 */
  border-radius: 22rpx;      /* 淡入时圆角变大 */
}

.circle-card-image-bg.fade-out {
  opacity: 0;                /* 淡出：完全透明 */
  border-radius: 10rpx;      /* 淡出时圆角恢复 */
}

/* 快速淡出（页面隐藏时使用） */
.circle-card-image-bg.fade-out-fast {
  opacity: 0;
  border-radius: 10rpx;
  transition: opacity 0.5s ease, border-radius 0.5s ease;  /* 500ms快速淡出 */
}

/* 毛玻璃遮罩层（z-index: 1，中间层） */
.circle-card-glass-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  border-radius: 10rpx;
  
  /* 渐变半透明黑色遮罩（上下深，中间浅） */
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0.3) 0%,
    rgba(0, 0, 0, 0.1) 50%,
    rgba(0, 0, 0, 0.3) 100%
  );
  /* 🔧 图片背景模糊度降低为视频的一半：20px → 10px */
  backdrop-filter: blur(3px);
  -webkit-backdrop-filter: blur(3px);
  
  opacity: 0;                /* 初始透明 */
  transition: opacity 2s ease, border-radius 2s ease;  /* 2秒淡入淡出 + 圆角过渡 */
}

.circle-card-glass-overlay.fade-in {
  opacity: 1;
  border-radius: 22rpx;      /* 淡入时圆角变大 */
}

.circle-card-glass-overlay.fade-out {
  opacity: 0;
  border-radius: 10rpx;      /* 淡出时圆角恢复 */
}

/* 快速淡出（页面隐藏时使用） */
.circle-card-glass-overlay.fade-out-fast {
  opacity: 0;
  border-radius: 10rpx;
  transition: opacity 0.5s ease, border-radius 0.5s ease;  /* 500ms快速淡出 */
}

/* 朋友圈卡片内容层（z-index: 2，最上层） */
.friend-circle-card .card-content {
  /* ❌ 不使用 position: relative，避免影响 .status-tag 的绝对定位参照物 */
  position: relative;  /* 但需要 relative 来让 z-index 生效 */
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
  /* 只保留文字颜色过渡，不影响布局 */
}

/* 🔧 确保 .status-tag 相对于卡片本身定位，不受 .card-content 影响 */
.friend-circle-card .status-tag {
  z-index: 3;  /* 在图片背景(0)、毛玻璃(1)、内容层(2)之上 */
}

/* 🔧 图片背景时，查看详情按钮：白色、粗体、无阴影 */
.friend-circle-card .status-tag.text-light text {
  font-weight: bold;
  color: #ffffff;
  text-shadow: none;  /* 去掉阴影 */
  transition: font-weight 2s ease, color 2s ease, text-shadow 2s ease;
}

/* 🎬 朋友圈卡片激活状态（有图片背景时） */
.friend-circle-card.image-active {
  transition: border-radius 2s ease, box-shadow 2s ease;
}

/* 🎬 行级错落动画 - 正常状态 */
.update-time,
.user-count {
  opacity: 1;
  transform: translate3d(0, 0, 0);
  /* 🔧 第2/3行【变回灰色】的时间（从白→灰） */
  transition: opacity 0.25s ease, transform 0.25s ease, 
              color 3s ease-out, text-shadow 2.5s ease-out;
  /* 🔧 性能优化 */
  will-change: transform, opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* 🎬 行级错落动画 - 更新中（淡出+轻微上移） */
.line-updating {
  opacity: 0;
  transform: translate3d(0, -8rpx, 0);  /* 轻微上移 */
}

/* 🎬 第2行延迟动画（150ms延迟） */
.line-updating-delay {
  transition-delay: 0.15s;  /* 150ms延迟，营造错落感 */
}

.card-title {
  flex-shrink: 0;
}

.user-count {
  position: relative;  /* 为绝对定位的 indicator 提供参照 */
  flex-shrink: 0;
  font-size: 24rpx;
  color: #808080;
  display: flex;
  align-items: center;
  margin-bottom: 5rpx;
}

.avatar-group {
  position: relative;
  margin-left: 30rpx;
  width: 200rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
}

.avatar-small-1 {
  position: absolute;
  left: 0;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  /* 🔧 去掉白边 */
  z-index: 1;
}

.avatar-small-2 {
  position: absolute;
  left: 30rpx;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  /* 🔧 去掉白边 */
  z-index: 2;
}

.avatar-small-3 {
  position: absolute;
  left: 60rpx;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  /* 🔧 去掉白边 */
  z-index: 3;
}

.avatar-small-4 {
  position: absolute;
  left: 90rpx;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  /* 🔧 去掉白边 */
  z-index: 4;
}

.avatar-small-5 {
  position: absolute;
  left: 120rpx;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  /* 🔧 去掉白边 */
  z-index: 5;
}

.avatar-more {
  position: absolute;
  left: 150rpx;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  /* 🔧 去掉白边 */
  overflow: hidden;
  z-index: 6;
}

.avatar-more-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-more-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
  z-index: 1;
}

.avatar-more-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 18rpx;
  font-weight: 600;
  color: #ffffff;
  z-index: 2;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.5);
}

.status-tag {
  position: absolute;
  right: 40rpx;
  top: 34rpx;
  display: flex;
  align-items: center;
}

.status-tag text {
  font-size: 28rpx;
  color: #1A73E8;
  margin-right: 8rpx;
}

.status-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 1;
  /* 🔧 和图片/文字变化速度保持一致（2秒） */
  transition: opacity 2s ease;
}

/* 🔧 图片背景时隐藏图标（视觉隐藏，保留占位） */
.status-icon.icon-hidden {
  opacity: 0;
}

.update-time {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #808080;
  margin-top: 5rpx;
}

/* 空状态朋友圈卡片 */
.empty-state-card {
  position: relative;
  margin: 30rpx 40rpx;
  height: 250rpx;
  border-radius: 10rpx;
  background: transparent;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
  
  /* 🎬 卡片切换动画 */
  opacity: 1;
  transform: translateY(0);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
              opacity 0.25s ease,
              box-shadow 2s ease, 
              border-radius 2s ease;
  
  /* 🎬 入场动画：从透明+下沉状态淡入 */
  animation: cardFadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

/* 视频激活状态：增强阴影效果 + 更大的圆角 */
.empty-state-card.video-active {
  box-shadow: 0px 8rpx 24rpx rgba(0, 0, 0, 0.15);
  border-radius: 22rpx;  /* 视频显示时圆角更大 */
}

/* 🎬 空状态卡片更新中状态（淡出下沉） */
.empty-state-card.updating {
  opacity: 0;
  transform: translateY(20rpx);
  transition: transform 0.25s cubic-bezier(0.4, 0, 1, 1), 
              opacity 0.2s ease,
              box-shadow 2s ease,
              border-radius 2s ease;
}

/* 🎬 视频背景层（z-index: 0，最底层） */
.empty-card-video-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  border-radius: 10rpx;
  background: #000000;       /* 视频加载前的占位背景 */
  opacity: 0;                /* 初始透明 */
  transition: opacity 2s ease, border-radius 2s ease;  /* 2秒淡入淡出 + 圆角过渡 */
}

.empty-card-video-bg.fade-in {
  opacity: 1;                /* 淡入：完全显示 */
  border-radius: 22rpx;      /* 淡入时圆角变大 */
}

.empty-card-video-bg.fade-out {
  opacity: 0;                /* 淡出：完全透明 */
  border-radius: 10rpx;      /* 淡出时圆角恢复 */
}

/* 快速淡出（页面隐藏时使用） */
.empty-card-video-bg.fade-out-fast {
  opacity: 0;
  border-radius: 10rpx;
  transition: opacity 0.5s ease, border-radius 0.5s ease;  /* 500ms快速淡出 */
}

/* 🎬 毛玻璃遮罩层（z-index: 1，中间层） */
.empty-card-glass-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  border-radius: 10rpx;
  
  /* 渐变半透明黑色遮罩（上下深，中间浅） */
  background: linear-gradient(
    180deg, 
    rgba(0,0,0,0.5) 0%,      /* 顶部 50% 不透明 */
    rgba(0,0,0,0.35) 50%,    /* 中部 35% 不透明 */
    rgba(0,0,0,0.5) 100%     /* 底部 50% 不透明 */
  );
  
  /* 毛玻璃效果：模糊 + 饱和度提升 */
  backdrop-filter: blur(6px) saturate(120%);
  -webkit-backdrop-filter: blur(6px) saturate(120%);
  
  opacity: 0;                /* 初始透明 */
  transition: opacity 2s ease, border-radius 2s ease;  /* 2秒淡入淡出 + 圆角过渡 */
}

.empty-card-glass-overlay.fade-in {
  opacity: 1;
  border-radius: 22rpx;      /* 淡入时圆角变大 */
}

.empty-card-glass-overlay.fade-out {
  opacity: 0;
  border-radius: 10rpx;      /* 淡出时圆角恢复 */
}

/* 快速淡出（页面隐藏时使用） */
.empty-card-glass-overlay.fade-out-fast {
  opacity: 0;
  border-radius: 10rpx;
  transition: opacity 0.5s ease, border-radius 0.5s ease;  /* 500ms快速淡出 */
}

/* 🔄 刷新indicator通用样式 */
.refreshing-indicator {
  position: absolute;
  z-index: 10;  /* 在所有内容之上 */
  opacity: 0;
  animation: fadeInOnly 1s ease forwards;  /* 纯淡入，无滑动 */
}

/* 右上角位置 - 和第一行文字垂直居中对齐（空状态卡片） */
.refreshing-indicator-top {
  top: 36rpx;  /* 和 .empty-content 的 padding-top 对齐 */
  right: 40rpx;
}

/* 右下角位置 - 和第三行用户头像垂直居中对齐（最近朋友圈卡片） */
.refreshing-indicator-bottom {
  bottom: 34rpx;  /* 和 .friend-circle-card 的 padding-bottom 对齐 */
  right: 40rpx;
}

/* 内联样式 - 绝对定位，垂直居中对齐 */
.refreshing-indicator-inline {
  position: absolute;
  right: 0;  /* 靠右侧 */
  top: 50%;  /* 垂直居中 */
  transform: translate3d(0, -50%, 0);  /* 精确垂直居中 + GPU加速 */
  z-index: 10;  /* 在所有内容之上 */
  opacity: 0;
  animation: fadeInSlow 1s ease forwards;  /* 1秒慢慢淡入 */
  display: flex;
  align-items: center;
  /* 🔧 性能优化：防止闪烁 */
  will-change: opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  margin-right: 10rpx;
}

.refresh-icon {
  width: 44rpx;  /* 再次增大：36rpx → 44rpx */
  height: 44rpx;
  display: block;
  /* 🔧 性能优化：防止闪烁 */
  will-change: transform;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  transform: translate3d(0, 0, 0);  /* 启用GPU加速 */
}

/* 旋转动画 */
.refresh-icon.rotating {
  animation: rotate 3s linear infinite;  /* 3秒一圈 */
}

/* 慢速淡入动画 - 1秒 */
@keyframes fadeInSlow {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 纯淡入动画（无滑动） */
@keyframes fadeInOnly {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* 🎬 内容层（z-index: 2，最上层） */
.empty-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  padding: 36rpx 40rpx 32rpx 40rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 标题行容器 - 包含标题和refreshing indicator */
.empty-title-row {
  position: relative;  /* 为绝对定位的 indicator 提供参照 */
  width: 100%;  /* 占据整个宽度 */
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.empty-title {
  flex-shrink: 0;
  transition: color 2s ease, text-shadow 2s ease;
}

.empty-desc {
  flex-shrink: 0;
  width: 100%;
  max-width: 540rpx;
  margin-top: 20rpx;
  transition: color 2s ease, text-shadow 2s ease;
}

/* 🎬 文字样式：深色（无视频/图片时） */
.text-dark {
  color: #000000;
  text-shadow: none;
  /* 🔧 不定义transition，让元素本身的类控制过渡时间 */
}

/* 🎬 文字样式：浅色（有视频/图片时） */
.text-light {
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.8);  /* 深色阴影提高可读性 */
}

/* 🔧 快速重置类：页面切换时立即禁用过渡，直接重置状态 */
.fast-reset {
  transition: none !important;  /* 立即重置，不用过渡 */
}

/* 🔧 为不同元素的 .text-light 定义【变白】时的过渡时间（从黑/灰→白） */
.card-main-title.text-light {
  transition: color 1.9s ease-out, text-shadow 1s ease-out;  /* 第1行变白时间 */
}

.update-time.text-light,
.user-count.text-light {
  transition: opacity 0.25s ease, transform 0.25s ease, 
              color 5s ease-out, text-shadow 2.5s ease-out;  /* 第2/3行变白时间 */
}

/* 🎬 分割线 */
.divider {
  flex-shrink: 0;
  width: 100%;
  height: 2rpx;
  margin: 24rpx 0;
  transition: background 2s ease;
}

/* 分割线：深色（无视频时） */
.divider-dark {
  background-color: #E0E0E0;
}

/* 分割线：浅色（有视频时） */
.divider-light {
  background: linear-gradient(
    90deg, 
    rgba(255,255,255,0) 0%, 
    rgba(255,255,255,0.3) 50%, 
    rgba(255,255,255,0) 100%
  );
}

/* 🎬 按钮 */
.create-btn {
  flex-shrink: 0;
  font-size: 28rpx;
  transition: color 2s ease, font-weight 2s ease, text-shadow 2s ease;
}

/* 按钮：深色（无视频时） */
.btn-dark {
  color: #1A73E8;
  font-weight: 400;
  text-shadow: none;
}

/* 按钮：浅色（有视频时） - 加粗 + 阴影 */
.btn-light {
  color: #1A73E8;
  font-weight: 600;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.6);
}

/* 操作行布局 */
.action-row {
  display: flex;
  margin: 30rpx 40rpx;
  gap: 30rpx;
}

/* 创建区域 */
.create-section {
  position: relative;
  flex: 1;
  height: 128rpx;
  border-radius: 10rpx;
  background: #ffffff;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
}

.create-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  background: #ffffff;
}

.create-content {
  position: relative;
  padding: 24rpx 32rpx;
  height: 100%;
  display: flex;
  align-items: center;
  z-index: 1;
}

.scan-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scan-icon image {
  width: 100%;
  height: 100%;
}

.create-text-container {
  flex: 1;
}

.create-title {
  margin-bottom: 8rpx;
}

.create-desc {
  /* 字体样式由公共样式提供 */
}

/* 右侧功能区 */
.action-panel {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  border-radius: 10rpx;
  background: #ffffff;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
}

.action-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  background: #ffffff;
}

.action-icon-container {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.action-icon {
  width: 52rpx;
  height: 52rpx;
}

/* 发现有趣朋友圈 */
.post-card {
  position: relative;
  margin: 30rpx 40rpx;
  height: 300rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
}

.post-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  background: #ffffff;
}

.discover-title {
  position: absolute;
  left: 40rpx;
  top: 34rpx;
  z-index: 5;
}

.menu-icon {
  position: absolute;
  right: 40rpx;
  top: 30rpx;
  width: 50rpx;
  height: 50rpx;
  z-index: 6;
}

.menu-icon image {
  width: 100%;
  height: 100%;
}

.discover-avatar {
  position: absolute;
  left: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 55rpx;
  height: 55rpx;
  border-radius: 30rpx;
  z-index: 3;
}

.content-container {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  left: 90rpx;
  width: 250rpx;
  z-index: 2;
  padding-left: 32rpx;
}

.quote-mark {
  font-size: 32rpx;
  color: #1A73E8;
  font-weight: 700;
  position: absolute;
  left: 40rpx;
  top: 0;
  line-height: 1.4;
}

.post-content {
  flex: 1;
  color: #808080;
  font-size: 24rpx;
  font-weight: 400;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  text-overflow: ellipsis;
  line-height: 1.4;
  text-indent: 2em;
}

.view-btn {
  position: absolute;
  left: 40rpx;
  bottom: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: row;
  z-index: 3;
}

.view-more {
  font-size: 28rpx;
  color: #1A73E8;
  font-weight: 400;
  margin-right: 8rpx;
}

.view-icon {
  width: 24rpx;
  height: 24rpx;
}

.rotated-img {
  position: absolute;
  right: -100rpx;
  top: 140rpx;
  width: 360rpx;
  height: 270rpx;
  border-radius: 10rpx;
  transform: rotate(-16.8deg);
  z-index: 6;
  transform-origin: center;
  overflow: hidden;
}

/* 发现有趣朋友圈 - 加载状态 */
.discover-loading {
  position: relative;
  margin: 30rpx 40rpx;
  height: 200rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  background: #ffffff;
}

.loading-title {
  position: absolute;
  top: 30rpx;
  left: 40rpx;
  z-index: 2;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 2;
  margin-top: 20rpx;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #1A73E8;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 24rpx;
  color: #808080;
  text-align: center;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 🎯 统一的全屏 Loading Overlay 样式 */
.unified-loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-overlay-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
}

.loading-overlay-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.loading-overlay-spinner {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 40rpx;
}

.spinner-circle {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #f0f0f0;
  border-top: 6rpx solid #1A73E8;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-overlay-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
  text-align: center;
}

.loading-overlay-subtitle {
  font-size: 26rpx;
  color: #808080;
  text-align: center;
}

/* 推荐内容的淡入动画 */
.discover-fade-in {
  animation: fadeIn 0.6s ease-in-out;
}

@keyframes fadeIn {
  0% {
    opacity: 0;
    transform: translateY(20rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 发现区域空状态样式 - 采用统一的卡片样式 */
.discover-empty {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 30rpx 40rpx;
  padding: 60rpx 40rpx;
  border-radius: 10rpx;
  background: #ffffff;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  text-align: center;
  overflow: hidden;
}

.discover-empty .card-sub-title {
  margin-top: 20rpx;
}

.refresh-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  background-color: #f5f5f5;
  opacity: 0.8;
}

.refresh-hint image {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.refresh-hint text {
  font-size: 24rpx;
  color: #666666;
}

/* 发现空状态的标题和描述现在使用公共样式类 */

/* 响应式适配 */
@media (max-width: 400px) {
  .header {
    padding: 30rpx 30rpx 15rpx 30rpx;
    margin-top: 40rpx;
  }
  
  .avatar-main {
    width: 90rpx;
    height: 90rpx;
  }
  
  .title-text {
    font-size: 36rpx;
  }
  
  .welcome-text {
    font-size: 28rpx;
  }
  
  .admin-btn {
    font-size: 28rpx;
  }
  
  .identity-text {
    font-size: 20rpx;
    padding: 4rpx 12rpx;
  }
  
  .friend-circle-loading,
  .friend-circle-card {
    margin: 45rpx 30rpx;
    height: 250rpx;
    padding: 34rpx 30rpx 34rpx 45rpx;
  }
  
  .status-tag {
    right: 30rpx;
    top: 34rpx;
  }
  
  .empty-state-card {
    margin: 45rpx 30rpx;
    height: 250rpx;
  }
  
  .empty-content {
    padding: 36rpx 30rpx 32rpx 30rpx;
  }
  
  .post-card {
    margin: 45rpx 30rpx;
  }
  
  .action-row {
    margin: 45rpx 30rpx;
  }
  
  .discover-empty {
    margin: 45rpx 30rpx;
    padding: 45rpx 30rpx;
  }
}