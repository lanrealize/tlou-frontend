/* pages/main/main.wxss */

/* 加载状态样式 */
.loading-circle-content {
  text-align: center;
  padding: 60rpx 40rpx;
  color: #666666;
}

.loading-title {
  font-size: 32rpx;
  margin-bottom: 20rpx;
  color: #666666;
}

.loading-description {
  font-size: 28rpx;
  line-height: 1.5;
  color: #999999;
}

/* 错误状态样式 */
.error-circle-content {
  text-align: center;
  padding: 60rpx 40rpx;
  color: #ff4444;
}

.error-title {
  font-size: 32rpx;
  margin-bottom: 20rpx;
  color: #ff4444;
}

.error-description {
  font-size: 28rpx;
  line-height: 1.5;
  color: #999999;
  margin-bottom: 30rpx;
}

.login-btn,
.retry-btn {
  margin-top: 30rpx;
}

.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 0;
}

/* 状态栏占位 */
.status-bar {
  background-color: #ffffff;
  width: 100%;
}

/* 顶部用户信息区域 */
.header-section {
  background-color: #ffffff;
  padding: 20rpx 30rpx 30rpx;
  margin-bottom: 20rpx;
  border-radius: 0 0 20rpx 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.user-header {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 3rpx solid #f0f0f0;
}

.header-content {
  flex: 1;
}

.welcome-text {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.app-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  letter-spacing: 1rpx;
}

.header-action {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f8f8f8;
  border-radius: 50%;
}

.setting-icon {
  font-size: 32rpx;
  color: #666;
}

/* 空状态朋友圈卡片 */
.empty-circle-card {
  background-color: #ffffff;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
}

.empty-circle-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 400;
  color: #333;
  margin-bottom: 15rpx;
}

.empty-description {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
  margin-bottom: 30rpx;
  text-align: center;
}

.create-circle-btn {
  background-color: #1890ff;
  color: #ffffff;
  border: none;
  border-radius: 20rpx;
  padding: 15rpx 40rpx;
  font-size: 26rpx;
  font-weight: 400;
  min-width: 160rpx;
}

.create-circle-btn:active {
  background-color: #096dd9;
}

/* 创建新朋友圈区域 */
.create-section {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
}

.create-item {
  display: flex;
  align-items: center;
  flex: 1;
}

.create-icon {
  width: 60rpx;
  height: 60rpx;
  background-color: #1890ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.plus-icon {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 300;
}

.create-content {
  flex: 1;
}

.create-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 6rpx;
}

.create-subtitle {
  display: block;
  font-size: 22rpx;
  color: #999;
  line-height: 1.3;
}

.refresh-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f8f8f8;
  border-radius: 50%;
  margin-left: 20rpx;
}

.refresh-icon {
  font-size: 28rpx;
  color: #666;
}

/* 发现有趣朋友圈 */
.discover-section {
  margin: 0 20rpx 30rpx;
}

.discover-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.discover-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.discover-content {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
}

.discover-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.discover-item:last-child {
  margin-bottom: 0;
}

.discover-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.discover-info {
  flex: 1;
  margin-right: 20rpx;
}

.discover-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: block;
  margin-bottom: 15rpx;
}

.discover-action {
  margin-top: 10rpx;
}

.action-link {
  font-size: 26rpx;
  color: #1890ff;
  font-weight: 500;
}

.discover-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

/* 模态框样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background-color: #fff;
  border-radius: 20rpx;
  width: 600rpx;
  max-width: 90%;
  max-height: 80%;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  padding: 30rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  font-size: 28rpx;
  background-color: #fff;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #1890ff;
}

.form-switch {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-desc {
  margin-top: 15rpx;
}

.form-desc text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  background-color: #fafafa;
}

.modal-footer .btn {
  min-width: 120rpx;
  padding: 15rpx 30rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
}

.btn-primary {
  background-color: #1890ff;
  color: #fff;
}

.btn-primary.disabled {
  background-color: #ccc;
  color: #999;
}

.btn-secondary {
  background-color: #fff;
  color: #333;
  border: 1rpx solid #ddd;
}

/* 用户状态相关样式 */

/* 状态指示器 */
.status-indicator {
  margin-top: 20rpx;
  padding: 15rpx 20rpx;
  border-radius: 12rpx;
  background-color: #f8f9fa;
}

.status-text {
  font-size: 24rpx;
  line-height: 1.4;
  display: block;
}

.status-text.loading {
  color: #1890ff;
  animation: pulse 1.5s ease-in-out infinite;
}

.status-text.unregistered {
  color: #52c41a;
}

.status-text.error {
  color: #ff4d4f;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

/* 登录状态样式 */
.login-avatar-container {
  position: relative;
  display: inline-block;
  margin-right: 20rpx;
}

.login-avatar {
  opacity: 0.6;
  transition: opacity 0.3s ease;
}

.login-avatar-container:active .login-avatar {
  opacity: 0.4;
}

.login-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  transition: background-color 0.3s ease;
}

.login-avatar-container:active .login-overlay {
  background-color: rgba(0, 0, 0, 0.5);
}

.login-text {
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 500;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.5);
  letter-spacing: 1rpx;
}

/* 错误状态样式 */
.error-avatar-container {
  position: relative;
  display: inline-block;
  margin-right: 20rpx;
}

.error-avatar {
  opacity: 0.7;
  filter: grayscale(0.3);
  transition: all 0.3s ease;
}

.error-avatar-container:active .error-avatar {
  opacity: 0.5;
  filter: grayscale(0.5);
}

.error-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 77, 79, 0.2);
  border-radius: 50%;
  transition: background-color 0.3s ease;
}

.error-avatar-container:active .error-overlay {
  background-color: rgba(255, 77, 79, 0.4);
}

.error-text {
  color: #ff4d4f !important;
  font-size: 28rpx;
}

/* 加载状态样式 */
.loading-avatar-container {
  position: relative;
  display: inline-block;
  margin-right: 20rpx;
}

.loading-avatar {
  opacity: 0.5;
  transition: opacity 0.3s ease;
}

.loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(24, 144, 255, 0.1);
  border-radius: 50%;
}

.loading-text {
  color: #1890ff;
  font-size: 32rpx;
  animation: rotate 2s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 浏览提示卡片 */
.browse-tip-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.browse-tip-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.tip-icon {
  font-size: 60rpx;
  margin-bottom: 15rpx;
}

.tip-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 15rpx;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.3);
}

.tip-description {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}

/* 禁用按钮样式 */
.create-circle-btn[disabled] {
  background-color: #d9d9d9 !important;
  color: #999999 !important;
  cursor: not-allowed;
  opacity: 0.6;
}

.create-circle-btn[disabled]:active {
  background-color: #d9d9d9 !important;
}

/* 响应式适配 */
@media (max-width: 400px) {
  .user-avatar {
    width: 80rpx;
    height: 80rpx;
  }
  
  .app-title {
    font-size: 32rpx;
  }
  
  .create-icon {
    width: 60rpx;
    height: 60rpx;
  }
  
  .plus-icon {
    font-size: 32rpx;
  }
  
  .login-text {
    font-size: 18rpx;
  }
}