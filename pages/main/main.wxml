<!--pages/main/main.wxml-->
<view class="page-container">
  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{safeAreaInfo.statusBarHeight}}px;"></view>
  
  <!-- 头部区域 -->
  <view class="header">
    <!-- 用户头像 -->
    <block wx:if="{{loginStatus === 'loggedIn'}}">
      <image class="avatar-main" src="{{avatarUrl}}" mode="aspectFill"></image>
    </block>
    <block wx:elif="{{loginStatus === 'unregistered'}}">
      <view class="avatar-main" bindtap="handleUserAuth" style="background-image: url(/images/default_avatar.png);"></view>
    </block>
    <block wx:elif="{{loginStatus === 'error'}}">
      <view class="avatar-main error-avatar" bindtap="handleUserAuth" style="background-image: url(/images/default_avatar.png);"></view>
    </block>
    <block wx:else>
      <view class="avatar-main loading-avatar" style="background-image: url(/images/default_avatar.png);"></view>
    </block>
    
    <!-- 标题组 -->
    <view class="title-group">
      <view class="welcome-text">
        <block wx:if="{{loginStatus === 'loggedIn'}}">你好，{{displayName}}</block>
        <block wx:elif="{{loginStatus === 'unregistered'}}">欢迎来到</block>
        <block wx:elif="{{loginStatus === 'error'}}">登录异常</block>
        <block wx:else>检查中...</block>
      </view>
      <view class="title-text">两个人的朋友圈</view>
    </view>
    
    <!-- 管理员设置按钮 -->
    <view class="admin-btn" wx:if="{{isAdmin && isLoggedIn}}" bindtap="goToManagement">管理员设置</view>
  </view>

  <!-- 朋友圈卡片 -->
  <view class="friend-circle-card" wx:if="{{!isLoading && isLoggedIn && circles.length > 0}}" bindtap="goToRecentCircle">
    <view class="card-bg"></view>
    <view class="card-title">最近的朋友圈</view>
    <view class="user-count">
      <text>有 {{recentCircle.memberCount}} 名用户在内</text>
      <!-- 用户头像组 -->
      <view class="avatar-group">
        <image class="avatar-small-1" wx:if="{{recentCircle.members[0]}}" src="{{recentCircle.members[0].avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
        <image class="avatar-small-2" wx:if="{{recentCircle.members[1]}}" src="{{recentCircle.members[1].avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
      </view>
    </view>
    <view class="status-tag">
      <text>查看详情</text>
      <image class="status-icon" src="/assets/icons/right.svg" mode="aspectFit"></image>
    </view>
    <view class="update-time">最新内容更新于： {{recentCircle.formattedTime}}</view>
  </view>

  <!-- 空状态朋友圈卡片 -->
  <view class="empty-state-card" wx:elif="{{!isLoading && isLoggedIn && circles.length === 0}}">
    <view class="empty-bg"></view>
    <view class="empty-title">没有正在进行的朋友圈</view>
    <view class="empty-desc">点击"创建朋友圈"按钮，邀请朋友或扫一扫开始吧</view>
    <view class="divider"></view>
    <view class="create-btn" bindtap="createCircleDirectly">创建朋友圈</view>
  </view>

  <!-- 未登录提示卡片 -->
  <view class="browse-tip-card" wx:elif="{{!isLoading && !isLoggedIn}}">
    <view class="empty-bg"></view>
    <view class="empty-title">浏览模式</view>
    <view class="empty-desc">你可以浏览内容，点击感兴趣的功能时会引导登录</view>
    <view class="divider"></view>
    <view class="create-btn" bindtap="handleUserAuth">点击登录</view>
  </view>

  <!-- 创建区域和历史记录功能 -->
  <view class="action-row">
    <!-- 创建新朋友圈 -->
    <view class="create-section" bindtap="createCircleDirectly">
      <view class="create-bg"></view>
      <view class="create-content">
        <view class="scan-icon">
          <image src="/assets/icons/add.svg" mode="aspectFit"></image>
        </view>
        <view class="create-text-container">
          <view class="create-title">创建新的朋友圈</view>
          <view class="create-desc">邀请朋友"扫一扫"一起开始吧</view>
        </view>
      </view>
    </view>

    <!-- 历史记录功能 -->
    <view class="action-panel" bindtap="goToHistory">
      <view class="action-bg"></view>
      <view class="action-icon-container">
        <image class="action-icon" src="/assets/icons/history.svg" mode="aspectFit"></image>
      </view>
    </view>
  </view>

  <!-- 发现有趣朋友圈 -->
  <view class="post-card" wx:if="{{recommendedCircles.length > 0}}" bindtap="viewRecommendedCircle" data-circle-id="{{recommendedCircles[0]._id}}">
    <view class="post-bg"></view>
    <view class="discover-title">发现有趣朋友圈</view>
    <view class="menu-icon" catchtap="refreshRecommendations">
      <image src="/assets/icons/refresh.svg" mode="aspectFit"></image>
    </view>
    
    <image class="discover-avatar" src="{{recommendedCircles[0].creator.avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
    
    <!-- 动态内容区域 -->
    <view class="content-container">
      <view class="quote-mark">“</view>
      <view class="post-content" wx:if="{{recommendedCircles[0].hasLatestPost}}">{{recommendedCircles[0].latestPost.content}}</view>
      <view class="post-content" wx:else>Ta什么都没说</view>
    </view>
    
    <view class="view-btn">
      <view class="view-more">点击查看</view>
      <image class="view-icon" src="/assets/icons/right.svg" mode="aspectFit"></image>
    </view>
    
    <!-- 倾斜的图片 -->
    <view class="rotated-img">
      <image wx:if="{{recommendedCircles[0].latestPost && recommendedCircles[0].latestPost.images && recommendedCircles[0].latestPost.images.length > 0}}" 
             src="{{recommendedCircles[0].latestPost.images[0]}}" 
             mode="aspectFill" 
             style="width: 100%; height: 100%; border-radius: 10rpx;"></image>
      <image wx:else 
             src="{{recommendedCircles[0].creator.avatar || '/images/default_avatar.png'}}" 
             mode="aspectFill" 
             style="width: 100%; height: 100%; border-radius: 10rpx;"></image>
    </view>
  </view>

  <!-- 暂无推荐时的占位 -->
  <view class="discover-empty" wx:elif="{{!isLoadingRecommendations && recommendedCircles.length === 0}}">
    <text class="empty-icon">🌱</text>
    <text class="empty-title">暂无可推荐的朋友圈</text>
    <text class="empty-desc">请稍后再试或者创建一个新的公开朋友圈吧</text>
  </view>
</view>