<!--pages/main/main.wxml-->
<view class="page-container">
  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{safeAreaInfo.statusBarHeight}}px;"></view>
  
  <!-- 头部区域 -->
  <view class="header">
    <!-- 用户头像 - 只在已登录状态显示 -->
    <image wx:if="{{loginStatus === 'loggedIn'}}" class="avatar-main" src="{{avatarUrl}}" mode="aspectFill"></image>
    
    <!-- 标题组 -->
    <view class="title-group {{loginStatus !== 'loggedIn' ? 'no-avatar' : ''}}">
      <view class="welcome-text">
        <block wx:if="{{loginStatus === 'loggedIn'}}">你好，{{displayName}}</block>
        <block wx:elif="{{loginStatus === 'unregistered'}}">欢迎来到</block>
        <block wx:elif="{{loginStatus === 'error'}}">登录异常</block>
        <block wx:else>检查中...</block>
      </view>
      <view class="title-text">两个人的朋友圈</view>
    </view>
    
    <!-- 管理员设置按钮 -->
    <view class="admin-btn" wx:if="{{isAdmin && isLoggedIn}}" bindtap="goToManagement">管理员设置</view>
  </view>

  <!-- 朋友圈数据加载中状态 -->
  <view class="friend-circle-loading" wx:if="{{loginStatus === 'loggedIn' && isLoadingCircles}}">
    <view class="loading-bg"></view>
    <view class="loading-content">
      <view class="loading-spinner"></view>
      <view class="loading-text">正在加载朋友圈...</view>
    </view>
  </view>

  <!-- 朋友圈卡片 - 使用 circleStore 的数据 -->
  <view id="recent-circle-card" class="friend-circle-card {{circleCardImageVisible ? 'image-active' : ''}}" wx:elif="{{loginStatus === 'loggedIn' && !isLoadingCircles && hasRecentCircle}}" bindtap="goToRecentCircle">
    <!-- 🎬 图片背景层（z-index: 0，最底层） -->
    <image 
      wx:if="{{showCircleCardImage}}"
      class="circle-card-image-bg {{circleCardImageVisible ? 'fade-in' : ''}} {{circleCardImageFastFade ? 'fade-out-fast' : ''}}"
      src="{{circleCardImageUrl}}"
      mode="aspectFill"
    />
    
    <!-- 🎬 毛玻璃遮罩层（z-index: 1，中间层） -->
    <view 
      wx:if="{{showCircleCardImage}}"
      class="circle-card-glass-overlay {{circleCardImageVisible ? 'fade-in' : ''}} {{circleCardImageFastFade ? 'fade-out-fast' : ''}}"
    />
    
    <!-- 🔧 查看详情按钮（z-index: 3，独立定位，不受 .card-content 影响） -->
    <view class="status-tag {{circleCardImageVisible ? 'text-light' : ''}}">
      <text>查看详情</text>
      <!-- 🔧 图片背景时视觉隐藏右侧图标，但保留占位避免文字跳动 -->
      <image class="status-icon {{circleCardImageVisible ? 'icon-hidden' : ''}}" src="/assets/icons/right.svg" mode="aspectFit"></image>
    </view>
    
    <!-- 🎬 内容层（z-index: 2，最上层） -->
    <view class="card-content">
      <view class="card-title card-main-title {{circleCardImageVisible ? 'text-light' : ''}} {{isFastTextReset ? 'fast-reset' : ''}}">最近的朋友圈</view>
      <!-- 🎬 第2行 - 错落动画（先刷新） -->
      <view class="update-time {{isUpdatingCircleLine1 ? 'line-updating' : ''}} {{circleCardImageVisible ? 'text-light' : ''}} {{isFastTextReset ? 'fast-reset' : ''}}">最新内容更新于： {{recentCircle.formattedTime}}</view>
      <!-- 🎬 第3行 - 错落动画（后刷新，延迟150ms） -->
      <view class="user-count {{isUpdatingCircleLine2 ? 'line-updating line-updating-delay' : ''}} {{circleCardImageVisible ? 'text-light' : ''}} {{isFastTextReset ? 'fast-reset' : ''}}">
        <text>有 {{recentCircle.memberCount}} 名用户在内</text>
        <view class="avatar-group">
        <image class="avatar-small-1" wx:if="{{recentCircle.members && recentCircle.members.length > 0}}" src="{{recentCircle.members[0].avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
        <image class="avatar-small-2" wx:if="{{recentCircle.members && recentCircle.members.length > 1}}" src="{{recentCircle.members[1].avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
        <image class="avatar-small-3" wx:if="{{recentCircle.members && recentCircle.members.length > 2}}" src="{{recentCircle.members[2].avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
        <image class="avatar-small-4" wx:if="{{recentCircle.members && recentCircle.members.length > 3}}" src="{{recentCircle.members[3].avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
        <image class="avatar-small-5" wx:if="{{recentCircle.members && recentCircle.members.length > 4}}" src="{{recentCircle.members[4].avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
        <view class="avatar-more" wx:if="{{recentCircle.members && recentCircle.members.length > 5}}">
          <image class="avatar-more-bg" src="{{recentCircle.members[5].avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
          <view class="avatar-more-mask"></view>
          <text class="avatar-more-text">+{{recentCircle.members.length - 5}}</text>
        </view>
      </view>
        <!-- 🔄 刷新indicator - 和头像垂直居中对齐 -->
        <view class="refreshing-indicator-inline" wx:if="{{isRefreshing}}">
          <image class="refresh-icon rotating" src="/assets/icons/refresh.svg" mode="aspectFit"></image>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态朋友圈卡片 - 已登录无圈 或 未登录 -->
  <view class="empty-state-card {{emptyCardVideoVisible ? 'video-active' : 'video-inactive'}} {{isEmptyCardUpdating ? 'updating' : ''}}" wx:elif="{{!isLoadingCircles && (loginStatus !== 'loggedIn' || !hasRecentCircle)}}">
    <!-- 视频层：绝对定位，铺满整个卡片 -->
    <video 
      wx:if="{{showEmptyCardVideo}}"
      id="emptyCardVideo"
      class="empty-card-video-bg {{emptyCardVideoVisible ? 'fade-in' : (emptyCardVideoFastFade ? 'fade-out-fast' : 'fade-out')}}"
      src="https://images.wltech-service.site/PhotoMemories-0.3.mp4"
      muted
      show-center-play-btn="{{false}}"
      show-play-btn="{{false}}"
      controls="{{false}}"
      object-fit="cover"
      enable-progress-gesture="{{false}}"
      poster=""
      preload="auto"
      bindloadstart="onEmptyCardVideoLoadStart"
      bindloadedmetadata="onEmptyCardVideoLoadedMetadata"
      bindcanplay="onEmptyCardVideoCanPlay"
      bindplay="onEmptyCardVideoPlay"
      bindpause="onEmptyCardVideoPause"
      bindended="onEmptyCardVideoEnded"
      binderror="onEmptyCardVideoError"
      bindwaiting="onEmptyCardVideoWaiting"
    ></video>
    
    <!-- 毛玻璃层：绝对定位，在视频上方 -->
    <view wx:if="{{showEmptyCardVideo}}" class="empty-card-glass-overlay {{emptyCardVideoVisible ? 'fade-in' : (emptyCardVideoFastFade ? 'fade-out-fast' : 'fade-out')}}"></view>
    
    <!-- 内容层：相对定位，在最上层 -->
    <view class="empty-content">
      <!-- 标题行 - 包含标题和refreshing indicator -->
      <view class="empty-title-row">
        <view class="empty-title card-main-title {{emptyCardVideoVisible ? 'text-light' : 'text-dark'}}">没有正在进行的朋友圈</view>
        <!-- 🔄 刷新indicator - 和标题垂直居中对齐 -->
        <view class="refreshing-indicator-inline" wx:if="{{isRefreshing}}">
          <image class="refresh-icon rotating" src="/assets/icons/refresh.svg" mode="aspectFit"></image>
        </view>
      </view>
      <view class="empty-desc card-sub-title {{emptyCardVideoVisible ? 'text-light' : 'text-dark'}}">点击"创建朋友圈"按钮，开始一段有陪伴的旅程</view>
      <view class="divider {{emptyCardVideoVisible ? 'divider-light' : 'divider-dark'}}"></view>
      <view class="create-btn {{emptyCardVideoVisible ? 'btn-light' : 'btn-dark'}}" bindtap="createCircleDirectly">创建朋友圈</view>
    </view>
  </view>

  <!-- 创建区域和历史记录功能 -->
  <view class="action-row">
    <!-- 创建新朋友圈 -->
    <view id="createCircleBtn" class="create-section" bindtap="createCircleDirectly">
      <view class="create-bg"></view>
      <view class="create-content">
        <view class="scan-icon">
          <image src="/assets/icons/add.svg" mode="aspectFit"></image>
        </view>
        <view class="create-text-container">
          <view class="create-title card-main-title">创建新的朋友圈</view>
          <view class="create-desc card-sub-title">邀请朋友"扫一扫"一起开始吧</view>
        </view>
      </view>
    </view>

    <!-- 历史记录功能 -->
    <view id="historyBtn" class="action-panel" bindtap="goToHistory">
      <view class="action-bg"></view>
      <view class="action-icon-container">
        <image class="action-icon" src="/assets/icons/history.svg" mode="aspectFit"></image>
      </view>
    </view>
  </view>

  <!-- 发现有趣朋友圈 - 加载状态 -->
  <view class="discover-loading" wx:if="{{isLoadingRecommendations}}">
    <view class="loading-bg"></view>
    <view class="loading-title card-main-title">发现有趣朋友圈</view>
    <view class="loading-content">
      <view class="loading-spinner"></view>
      <text class="loading-text">正在为你寻找有趣的朋友圈...</text>
    </view>
  </view>

  <!-- 发现有趣朋友圈 - 有推荐内容 -->
  <discover-circle-card 
    wx:elif="{{recommendedCircles.length > 0}}"
    mode="discover"
    title="发现有趣朋友圈"
    circle-data="{{recommendedCircles[0]}}"
    circle-id="{{recommendedCircles[0]._id}}"
    creator-avatar="{{recommendedCircles[0].creator.avatar || '/images/default_avatar.png'}}"
    content="{{recommendedCircles[0].latestPost.content}}"
    has-content="{{recommendedCircles[0].hasLatestPost}}"
    post-image="{{recommendedCircles[0].postImageUrl || ''}}"
    bind:cardTap="viewRecommendedCircle"
    bind:refresh="refreshRecommendations">
  </discover-circle-card>

  <!-- 暂无推荐时的占位 - 允许未登录用户刷新 -->
  <!-- 移除 recommendationsLoaded 条件，确保空状态始终显示 -->
  <view class="discover-empty" wx:elif="{{!isLoadingRecommendations && recommendedCircles.length === 0}}" bindtap="refreshRecommendations">
    <text class="card-main-title">暂无可推荐的朋友圈</text>
    <text class="card-sub-title">请稍后再试或者{{isLoggedIn ? '创建一个新的公开朋友圈吧' : '登录后可创建朋友圈'}}</text>
    <view class="refresh-hint">
      <image src="/assets/icons/refresh.svg" mode="aspectFit"></image>
      <text>点击刷新</text>
    </view>
  </view>

  <!-- 用户信息弹出层 -->
  <user-info-popup
    id="userInfoPopup"
    visible="{{userInfoPopupVisible}}"
    rejectReason="{{userInfoPopupReason}}"
    pendingIntent="{{userInfoPopupIntent}}"
    circleId="{{userInfoPopupCircleId}}"
    bind:success="onUserInfoSuccess"
    bind:cancel="onUserInfoCancel"
    bind:close="onUserInfoClose"
  ></user-info-popup>

  <!-- 🎯 统一的全屏 Loading Overlay -->
  <view class="unified-loading-overlay" wx:if="{{showLoadingOverlay}}">
    <view class="loading-overlay-bg"></view>
    <view class="loading-overlay-content">
      <view class="loading-overlay-spinner">
        <view class="spinner-circle"></view>
      </view>
      <view class="loading-overlay-title">{{loadingOverlayTitle}}</view>
      <view class="loading-overlay-subtitle">{{loadingOverlaySubtitle}}</view>
    </view>
  </view>

</view>