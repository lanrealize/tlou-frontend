<!--pages/setting/setting.wxml-->
<view class="container">
  <!-- 自定义导航栏 -->
  <custom-navigation title="朋友圈设置" customBack="{{true}}" bind:back="handleBackButton"></custom-navigation>
  
  <!-- 内容区域 -->
  <view class="page-content">
  
  <!-- 页面加载状态 -->
  <view class="loading-container" wx:if="{{status === 'loading'}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 页面内容 -->
  <view class="content-container" wx:if="{{status === 'success'}}">
    <!-- 朋友圈成员管理 -->
    <view class="section-card card card-spacing">
      <view class="section-header">
        <view class="section-title-group">
          <text class="section-title">朋友圈成员管理</text>
          <text class="section-subtitle">管理朋友圈的所有成员信息</text>
        </view>
        <text class="add-btn-text" bindtap="addMember" wx:if="{{isCircleOwner}}">添加</text>
      </view>
    
    <view id="member-list" class="member-list">
      <view class="member-item member-item-{{item._id || item.id}}" wx:for="{{circleMembers}}" wx:key="_id" data-member-id="{{item._id || item.id}}">
        <image class="member-avatar" 
               src="{{item.avatar || item.avatarUrl || '/images/default_avatar.png'}}" 
               mode="aspectFill" />
        <text class="member-name">{{item.username || item.nickName || item.displayName || '未知用户'}}</text>
        <image class="member-delete-btn" 
               wx:if="{{isCircleOwner}}"
               bindtap="removeMember" 
               data-member-id="{{item._id || item.id}}"
               src="/assets/icons/delete.svg"
               mode="aspectFit"></image>
      </view>
      
      <view class="empty-member" wx:if="{{circleMembers.length === 0}}">
        <text class="empty-text">暂无成员</text>
      </view>
    </view>
  </view>

  <!-- 申请管理（只有主人可见） -->
  <view class="section-card card card-spacing" wx:if="{{isCircleOwner && (appliers.length > 0 || isLoadingAppliers)}}">
    <view class="section-header">
      <text class="section-title">申请管理</text>
      <text class="section-subtitle badge">{{appliers.length}}个待处理申请</text>
    </view>
    
    <!-- 加载状态 -->
    <view class="loading-appliers" wx:if="{{isLoadingAppliers}}">
      <text class="loading-text">加载申请列表中...</text>
    </view>
    
    <!-- 申请者列表 -->
    <view id="applier-list" class="applier-list" wx:else>
      <view class="applier-item applier-item-{{item._id}}" wx:for="{{appliers}}" wx:key="_id" data-user-id="{{item._id}}">
        <image class="applier-avatar" 
               src="{{item.avatar || '/images/default_avatar.png'}}" 
               mode="aspectFill" />
        <view class="applier-info">
          <text class="applier-name">{{item.username || '未知用户'}}</text>
          <text class="applier-time">申请时间：刚刚</text>
        </view>
        <view class="applier-actions">
          <button id="approve-btn-{{item._id}}" class="action-btn approve-btn {{isProcessingApplication ? 'disabled' : ''}}" 
                  bindtap="approveApplication" 
                  data-user-id="{{item._id}}"
                  data-username="{{item.username}}"
                  disabled="{{isProcessingApplication}}">
            同意
          </button>
          <button id="reject-btn-{{item._id}}" class="action-btn reject-btn {{isProcessingApplication ? 'disabled' : ''}}" 
                  bindtap="rejectApplication" 
                  data-user-id="{{item._id}}"
                  data-username="{{item.username}}"
                  disabled="{{isProcessingApplication}}">
            拒绝
          </button>
        </view>
      </view>
      
      <view class="empty-appliers" wx:if="{{appliers.length === 0 && !isLoadingAppliers}}">
        <text class="empty-text">暂无申请</text>
      </view>
    </view>
  </view>

  <!-- 公开设置（只有创建者可见） -->
  <view class="section-card card card-spacing" wx:if="{{isCircleOwner}}">
    <view class="setting-item">
      <view class="setting-content">
        <text class="setting-title">设为公开朋友圈</text>
        <text class="setting-desc">开启后朋友圈会被其他用户看到</text>
      </view>
      <switch class="setting-switch" 
             checked="{{settingData.isPublic}}" 
             bindchange="togglePublicStatus"
             color="#1A73E8" />
    </view>
  </view>

  <!-- 成员邀请设置（只有创建者可见） -->
  <view class="section-card card card-spacing" wx:if="{{isCircleOwner}}">
    <view class="setting-item">
      <view class="setting-content">
        <text class="setting-title">允许成员邀请</text>
        <text class="setting-desc">开启后成员也可以分享邀请新成员加入</text>
      </view>
      <switch class="setting-switch" 
             checked="{{settingData.allowInvite}}" 
             bindchange="toggleAllowInvite"
             color="#1A73E8" />
    </view>
  </view>
  
  <!-- 非创建者操作区域 -->
  <view class="section-card card card-spacing" wx:if="{{!isCircleOwner}}">
    <!-- 退出朋友圈按钮 -->
    <view class="leave-circle-section">
      <view class="leave-circle-item">
        <view class="leave-info">
          <text class="leave-title">退出朋友圈</text>
          <text class="leave-desc">退出后将无法再次查看此朋友圈内容</text>
        </view>
        <button class="leave-btn" bindtap="leaveCircle" hover-class="button-hover">
          退出
        </button>
      </view>
    </view>
  </view>
  
  <!-- 添加成员对话框 -->
  <view class="modal-overlay" wx:if="{{showAddMemberDialog}}" bindtap="hideAddMemberDialog">
    <view class="modal-content" catchtap="true">
      <view class="modal-header">
        <text class="modal-title">添加成员</text>
        <text class="modal-close" bindtap="hideAddMemberDialog">✕</text>
      </view>
      
      <view class="modal-body">
        <view class="form-group">
          <text class="form-label">用户ID或用户名</text>
          <input class="form-input" 
                 placeholder="请输入用户ID或用户名" 
                 value="{{newMemberInput}}" 
                 bindinput="onMemberInput" />
        </view>
      </view>
      
      <view class="modal-footer">
        <button class="btn btn-secondary" bindtap="hideAddMemberDialog">取消</button>
        <button class="btn theme-btn {{newMemberInput ? '' : 'disabled'}}" 
                bindtap="confirmAddMember" 
                disabled="{{!newMemberInput}}">
          添加
        </button>
      </view>
    </view>
  </view>

  <!-- 关闭内容容器 -->
  </view>

  <!-- 错误状态 -->
  <view class="error-container" wx:if="{{status === 'error'}}">
    <text class="error-text">加载失败，请稍后重试</text>
    <button class="retry-btn theme-btn" bindtap="loadCircleSettings">重试</button>
  </view>
  
  </view> <!-- 内容区域结束 -->
</view>