/* pages/setting/setting.wxss */
@import '../../styles/common.wxss';

.container {
  background-color: #ffffff;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.page-content {
  padding-top: 88px; /* 固定导航栏高度 */
}

/* 卡片容器 */
.section-card {
  padding: 40rpx;
}

/* 设置项 */
.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.setting-content {
  flex: 1;
  margin-right: 30rpx;
}

.setting-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.setting-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  display: block;
}

.setting-switch {
  transform: scale(0.9);
  filter: drop-shadow(0px 2px 4px rgba(0, 0, 0, 0.08));
}

/* 成员管理 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.section-title-group {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.section-title {
  font-size: 28rpx;
  font-weight: 400;
  color: #000000;
  line-height: 1.5;
  margin-bottom: 4rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #808080;
  font-weight: 400;
  line-height: 1.6;
  margin-right: 20rpx;
}

.add-btn {
  border: none;
  border-radius: 20rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
}

/* 新的文字按钮样式 */
.add-btn-text {
  font-size: 28rpx;
  color: #1A73E8;
  cursor: pointer;
  padding: 8rpx 12rpx;
  padding-top: 0;
  border-radius: 8rpx;
  transition: background-color 0.2s ease;
  line-height: 1.5; /* 与section-title保持一致 */
  background-color: transparent;
  border: none;
}

.add-btn-text::after {
  border: none;
}

.add-btn-text:hover {
  background-color: rgba(26, 115, 232, 0.05);
}

.member-list {
  margin-top: 20rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background-color 0.2s ease;
}

.member-item:last-child {
  border-bottom: none;
}

.member-item:hover {
  background-color: rgba(26, 115, 232, 0.02);
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 2rpx solid #f0f0f0;
  box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.08);
}

.member-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.member-delete-btn {
  width: 36rpx;
  height: 36rpx;
  border-radius: 4rpx;
  padding: 4rpx;
  opacity: 0.7;
  transition: all 0.2s ease;
  margin-right: 20rpx;
}

.member-delete-btn:active {
  background-color: #ffebee;
  transform: scale(0.9);
}

.empty-member {
  padding: 80rpx 0;
  text-align: center;
  opacity: 0.8;
}

.empty-text {
  font-size: 24rpx;
  color: #999;
  position: relative;
}

.empty-text::before {
  content: "👥";
  display: block;
  font-size: 48rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}



/* 模态框样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background-color: #fff;
  border-radius: 20rpx;
  width: 600rpx;
  max-width: 90%;
  max-height: 80%;
  overflow: hidden;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  letter-spacing: 0.5rpx;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  padding: 40rpx;
  max-height: 500rpx;
  overflow-y: auto;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  font-size: 28rpx;
  background-color: #fff;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #1A73E8;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 30rpx 40rpx;
  border-top: 1rpx solid #f0f0f0;
  background-color: #fafafa;
}

.modal-footer .btn {
  min-width: 120rpx;
  padding: 20rpx 40rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.btn-secondary {
  background-color: #f5f5f5;
  color: #666;
}

.btn-secondary:active {
  background-color: #e8e8e8;
}

.disabled {
  opacity: 0.5;
}

/* === 申请列表管理样式 === */

/* 申请管理区域的副标题样式 */
.section-header .section-subtitle.badge {
  font-size: 24rpx;
  color: #FA5151;
  font-weight: 600;
  margin-left: auto;
  padding: 0;
  border-radius: 0;
}

/* 申请者列表 */
.applier-list {
  margin-top: 30rpx;
}

.applier-item {
  display: flex;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.applier-item:last-child {
  border-bottom: none;
}

.applier-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 2rpx solid #f0f0f0;
  box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.08);
}

.applier-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.applier-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.applier-time {
  font-size: 24rpx;
  color: #666;
}

.applier-actions {
  display: flex;
  gap: 0rpx;
  margin-left: auto;
}

.action-btn {
  min-width: 100rpx;
  height: auto;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 400;
  border: none;
  background-color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.action-btn::after {
  border: none;
}

.approve-btn {
  color: #1A73E8;
}

.approve-btn:active {
  background-color: rgba(26, 115, 232, 0.1);
}

.reject-btn {
  color: #f44336;
}

.reject-btn:active {
  background-color: rgba(244, 67, 54, 0.1);
}

.action-btn.disabled {
  opacity: 0.7;
  transform: none;
}

/* 加载和空状态 */
.loading-appliers {
  text-align: center;
  padding: 40rpx 0;
}

.loading-text {
  font-size: 24rpx;
  color: #666;
}

.empty-appliers {
  text-align: center;
  padding: 80rpx 0;
  opacity: 0.8;
}

.empty-appliers .empty-text {
  font-size: 24rpx;
  color: #999;
  position: relative;
}

.empty-appliers .empty-text::before {
  content: "📝";
  display: block;
  font-size: 48rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

/* 响应式适配 */
@media (max-width: 400px) {
  .section-card {
    margin: 40rpx 30rpx;
    padding: 30rpx;
  }
  
  .modal-content {
    width: 95%;
  }
  
  .member-item {
    padding: 15rpx 0;
  }
  
  .member-avatar {
    width: 60rpx;
    height: 60rpx;
    margin-right: 20rpx;
  }
}

/* 权限提示信息 */
.no-permission-tip {
  padding:0rpx;
  text-align: center;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.tip-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 🚀 页面加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  min-height: 400rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #1A73E8;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #666;
}

/* 错误状态 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  min-height: 400rpx;
}

.error-text {
  font-size: 28rpx;
  color: #ff4757;
  margin-bottom: 40rpx;
  text-align: center;
}

.retry-btn {
  background-color: #1A73E8;
  color: #ffffff;
  padding: 24rpx 60rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
}

/* 内容容器 */
.content-container {
  opacity: 1;
  transition: opacity 0.3s ease;
}

/* 退出朋友圈样式 */
.leave-circle-section {
  padding-left: 10rpx;
}

.leave-circle-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.leave-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.leave-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.leave-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.leave-btn {
  min-width: 100rpx;
  height: 60rpx;
  padding: 0 24rpx;
  background-color: transparent;
  border: none;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #ff4757;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.leave-btn::after {
  border: none;
}

.leave-btn.button-hover {
  background-color: rgba(255, 71, 87, 0.1);
  transform: scale(0.98);
}

/* 朋友圈名称编辑 - 行内布局 */
.circle-name-edit-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
}

.circle-name-input-inline {
  flex: 1;
  padding: 0 24rpx;
  padding-right: 100rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  border: 2rpx solid #e9ecef;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  transition: all 0.2s ease;
  height: 88rpx;
  line-height: 88rpx;
}

.circle-name-input-inline:focus {
  background-color: #ffffff;
  border-color: #1A73E8;
}

.circle-name-counter {
  position: absolute;
  right: 140rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #999;
  pointer-events: none;
  white-space: nowrap;
}

.change-name-btn {
  font-size: 28rpx;
  color: #1A73E8;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  background-color: transparent !important;
  border: none;
  flex-shrink: 0;
}

.change-name-btn::after {
  border: none;
}

.change-name-btn:not(.disabled):active {
  background-color: rgba(26, 115, 232, 0.1) !important;
}

.change-name-btn.disabled {
  color: #666;
  background-color: transparent !important;
}