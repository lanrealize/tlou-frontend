/* pages/setting/setting.wxss */

.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 状态栏占位 */
.status-bar {
  background-color: #f5f5f5;
  width: 100%;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
}

.user-avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
}

.user-avatar {
  margin-bottom: 15rpx;
}

.avatar-tip {
  font-size: 22rpx;
  color: #999;
  text-align: center;
}

.user-info-section {
  flex: 1;
}

.user-name-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.edit-btn {
  background-color: #07c160;
  color: #fff;
  border: none;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
}

.user-id {
  font-size: 24rpx;
  color: #666;
  font-family: monospace;
  background-color: #f5f5f5;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
}

/* 功能区域 */
.section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  padding: 0 20rpx 20rpx;
}

.list-container {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin: 0 20rpx;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background-color: transparent;
  border: none;
  width: 100%;
  text-align: left;
  border-radius: 0;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item:active {
  background-color: #f5f5f5;
}

.list-item-content {
  flex: 1;
}

.list-item-title {
  font-size: 30rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.list-item-desc {
  font-size: 26rpx;
  color: #666;
  display: block;
}

.list-item-arrow {
  color: #ccc;
  font-size: 32rpx;
}

/* 系统信息 */
.system-info-card {
  margin: 0 20rpx;
  padding: 30rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 28rpx;
  color: #333;
}

.info-value {
  font-size: 26rpx;
  color: #666;
  font-family: monospace;
  background-color: #f5f5f5;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
}

/* 退出登录 */
.logout-section {
  margin: 60rpx 20rpx 40rpx;
}

.logout-btn {
  width: 100%;
  background-color: #ff4757;
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 25rpx;
  font-size: 30rpx;
}

.logout-btn:active {
  background-color: #ff3742;
}

/* 模态框样式复用 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background-color: #fff;
  border-radius: 20rpx;
  width: 600rpx;
  max-width: 90%;
  max-height: 80%;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  padding: 30rpx;
  max-height: 500rpx;
  overflow-y: auto;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  font-size: 28rpx;
  background-color: #fff;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #07c160;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  background-color: #fafafa;
}

.modal-footer .btn {
  min-width: 120rpx;
}

/* 关于页面样式 */
.about-content {
  text-align: center;
}

.about-logo {
  margin-bottom: 30rpx;
}

.logo-text {
  font-size: 120rpx;
}

.about-info {
  margin-bottom: 40rpx;
}

.app-name {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.app-version {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 20rpx;
}

.app-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  display: block;
}

.about-features {
  text-align: left;
  margin-bottom: 40rpx;
}

.features-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 15rpx;
}

.features-item {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  display: block;
}

.about-footer {
  padding-top: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.copyright {
  font-size: 24rpx;
  color: #999;
}

/* 响应式适配 */
@media (max-width: 400px) {
  .user-card {
    flex-direction: column;
    text-align: center;
  }
  
  .user-avatar-section {
    margin-right: 0;
    margin-bottom: 30rpx;
  }
  
  .user-name-container {
    justify-content: center;
    gap: 20rpx;
  }
  
  .modal-content {
    width: 95%;
  }
}