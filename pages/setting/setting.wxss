/* pages/setting/setting.wxss */
@import '../../styles/common.wxss';

.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 状态栏占位 */
.status-bar {
  background-color: #f5f5f5;
  width: 100%;
}

/* 页面头部 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  background-color: #f5f5f5;
}

.back-btn {
  display: flex;
  align-items: center;
  color: #1A73E8;
  font-size: 32rpx;
}

.back-icon {
  margin-right: 10rpx;
  font-size: 36rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.header-action {
  width: 80rpx; /* 占位保持居中 */
}

/* 卡片容器 */
.section-card {
  margin: 30rpx 40rpx;
  padding: 40rpx;
}

/* 设置项 */
.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.setting-content {
  flex: 1;
  margin-right: 30rpx;
}

.setting-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.setting-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
  display: block;
}

.setting-switch {
  transform: scale(1.2);
}

/* 成员管理 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.add-btn {
  border: none;
  border-radius: 20rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
}

.member-list {
  margin-top: 20rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.member-name {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.member-action {
  padding: 12rpx;
}

.remove-icon {
  font-size: 36rpx;
  color: #ff4757;
}

.empty-member {
  padding: 60rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}



/* 模态框样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background-color: #fff;
  border-radius: 20rpx;
  width: 600rpx;
  max-width: 90%;
  max-height: 80%;
  overflow: hidden;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  padding: 30rpx;
  max-height: 500rpx;
  overflow-y: auto;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  font-size: 28rpx;
  background-color: #fff;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #1A73E8;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  background-color: #fafafa;
}

.modal-footer .btn {
  min-width: 120rpx;
  padding: 16rpx 30rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}

.btn-secondary {
  background-color: #f5f5f5;
  color: #666;
}

.btn-secondary:active {
  background-color: #e8e8e8;
}

.disabled {
  opacity: 0.5;
}

/* === 申请列表管理样式 === */

.section-subtitle {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
  margin-left: 20rpx;
}

/* 申请者列表 */
.applier-list {
  margin-top: 30rpx;
}

.applier-item {
  display: flex;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.applier-item:last-child {
  border-bottom: none;
}

.applier-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 2rpx solid #f0f0f0;
}

.applier-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.applier-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.applier-time {
  font-size: 24rpx;
  color: #999;
}

.applier-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  min-width: 100rpx;
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.action-btn::after {
  border: none;
}

.approve-btn {
  background-color: #4caf50;
  color: #fff;
}

.approve-btn:active {
  background-color: #45a049;
  transform: scale(0.98);
}

.reject-btn {
  background-color: #f44336;
  color: #fff;
}

.reject-btn:active {
  background-color: #da190b;
  transform: scale(0.98);
}

.action-btn.disabled {
  opacity: 0.7;
  transform: none;
}

/* 加载和空状态 */
.loading-appliers {
  text-align: center;
  padding: 40rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

.empty-appliers {
  text-align: center;
  padding: 60rpx 0;
}

.empty-appliers .empty-text {
  font-size: 26rpx;
  color: #ccc;
}

/* 响应式适配 */
@media (max-width: 400px) {
  .section-card {
    margin: 20rpx 30rpx;
    padding: 30rpx;
  }
  
  .modal-content {
    width: 95%;
  }
  
  .member-item {
    padding: 15rpx 0;
  }
  
  .member-avatar {
    width: 60rpx;
    height: 60rpx;
    margin-right: 20rpx;
  }
}