/* pages/details/details.wxss */

/* ===== 帖子列表区域 ===== */
.posts-container {
  margin-top: 20rpx;
  padding-bottom: 200rpx; /* 为底部按钮留出空间 */
}

.posts-list {
  /* 由post-item组件自己处理样式 */
}

.empty-content {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999999;
}

.empty-title {
  font-size: 32rpx;
  margin-bottom: 20rpx;
  color: #666666;
}

.empty-subtitle {
  font-size: 28rpx;
  line-height: 1.5;
}

.load-more,
.no-more {
  text-align: center;
  padding: 40rpx;
}

.load-more-text,
.no-more-text {
  font-size: 26rpx;
  color: #999999;
}

/* ===== 发布按钮 ===== */
.publish-button-container {
  position: fixed;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  z-index: 100;
}

.main-publish-btn {
  width: 100%;
  font-size: 32rpx;
  padding: 30rpx;
}

/* ===== 评论输入框模态框 ===== */
.comment-input-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.comment-input-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.comment-input-container {
  width: 100%;
  background-color: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
  z-index: 1001;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.comment-input-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.comment-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.cancel-btn {
  font-size: 28rpx;
  color: #999999;
  padding: 10rpx;
}

.comment-input-content {
  padding: 30rpx 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.comment-textarea {
  width: 100%;
  min-height: 120rpx;
  max-height: 300rpx;
  padding: 20rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  background-color: #ffffff;
  box-sizing: border-box;
  outline: none;
  resize: none;
}

.comment-input-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}

.char-count {
  font-size: 24rpx;
  color: #999999;
}

.send-btn {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
}

.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 状态栏占位 */
.status-bar {
  background-color: #ffffff;
  width: 100%;
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  font-size: 28rpx;
  color: #666;
}

/* 朋友圈页面主容器 */
.moment-page {
  background-color: #ffffff;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶部导航栏 */
.nav-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #ffffff;
  z-index: 100;
}

.nav-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.back-btn {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.back-icon {
  font-size: 40rpx;
  color: #333;
  font-weight: bold;
}

.nav-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.nav-right {
  display: flex;
  align-items: center;
}

.more-btn, .timer-btn {
  margin-left: 30rpx;
  padding: 10rpx;
}

.more-icon, .timer-icon {
  font-size: 32rpx;
  color: #333;
}

/* 用户信息区域 */
.user-section {
  padding: 30rpx;
  background-color: #ffffff;
  margin: 20rpx 30rpx;
  border-radius: 20rpx;
}

.user-count-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.user-count {
  font-size: 28rpx;
  color: #666;
}

.setting-btn {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.user-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.user-avatar-container {
  margin-right: 20rpx;
  margin-bottom: 10rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: #f0f0f0;
}

.user-avatar-container:last-of-type {
  margin-right: 30rpx;
}

.user-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
}

.add-user-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ccc;
  flex-shrink: 0;
  margin-left: auto;
  padding: 0;
  line-height: normal;
  font-size: inherit;
}

.add-user-btn::after {
  border: none;
}

.add-user-btn-hover {
  background-color: #e8f4fd;
  border-color: #1A73E8;
}

.add-user-btn.disabled {
  opacity: 0.5;
  background-color: #f0f0f0;
  border-color: #ddd;
}

.add-user-btn.disabled .add-icon {
  color: #ccc;
}

.add-icon {
  font-size: 36rpx;
  color: #999;
  font-weight: bold;
}

/* 空状态内容区域 */
.empty-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.empty-subtitle {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  line-height: 1.5;
}

/* 主分享按钮容器 */
.share-button-container {
  padding: 40rpx 60rpx;
  display: flex;
  justify-content: center;
}

.main-share-btn {
  border: none;
  width: 100%;
  max-width: 400rpx;
}

.main-share-btn::after {
  border: none;
}

/* 底部添加分享区域 */
.bottom-share-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background-color: #ffffff;
  margin: 20rpx 30rpx 30rpx;
  border-radius: 20rpx;
}

.share-preview {
  display: flex;
  align-items: center;
  flex: 1;
}

.share-image {
  width: 60rpx;
  height: 60rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.share-text {
  display: flex;
  flex-direction: column;
}

.share-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.share-action {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.camera-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 10rpx;
}

.camera-icon {
  font-size: 32rpx;
}

/* === 邀请功能样式 === */

/* 邀请横幅 */
.invite-banner {
  margin: 40rpx 40rpx 20rpx;
  padding: 40rpx;
  background: linear-gradient(135deg, #1A73E8 0%, #4285F4 100%);
  border-radius: 24rpx;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  color: #fff;
}

.invite-info {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.invite-icon {
  font-size: 60rpx;
  margin-right: 30rpx;
}

.invite-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.invite-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.invite-desc {
  font-size: 26rpx;
  opacity: 0.9;
  line-height: 1.4;
}

.join-btn {
  width: 100%;
  padding: 30rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  background-color: #fff;
  color: #1A73E8;
  border: none;
  box-shadow: 0px 4px 12px rgba(255, 255, 255, 0.3);
}

.join-btn:active {
  background-color: #f0f6ff;
  transform: scale(0.98);
}

.join-btn.disabled {
  opacity: 0.7;
  transform: none;
}

/* 响应式适配 */
@media (max-width: 400px) {
  .invite-banner {
    margin: 30rpx 30rpx 15rpx;
    padding: 30rpx;
  }
  
  .invite-icon {
    font-size: 50rpx;
    margin-right: 20rpx;
  }
  
  .invite-title {
    font-size: 32rpx;
  }
  
  .invite-desc {
    font-size: 24rpx;
  }
}

/* === 申请加入朋友圈样式 === */

.apply-section {
  margin: 30rpx 40rpx 20rpx;
}

/* 申请卡片 */
.apply-card, .applied-card, .private-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
}

.apply-header, .applied-header, .private-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.apply-icon, .applied-icon, .private-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.apply-info, .applied-info, .private-info {
  flex: 1;
}

.apply-title, .applied-title, .private-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.apply-desc, .applied-desc, .private-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

/* 申请按钮 */
.apply-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #1A73E8, #4285f4);
  color: #fff;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
}

.apply-btn::after {
  border: none;
}

.apply-btn:active {
  background: linear-gradient(135deg, #1557b0, #3367d6);
  transform: scale(0.98);
}

.apply-btn.disabled {
  opacity: 0.7;
  transform: none;
}

/* 不同状态的卡片颜色区分 */
.apply-card {
  border-left: 6rpx solid #1A73E8;
}

.applied-card {
  border-left: 6rpx solid #ff9800;
  background-color: #fff8e1;
}

.applied-icon {
  color: #ff9800;
}

.private-card {
  border-left: 6rpx solid #9e9e9e;
  background-color: #f5f5f5;
}

.private-icon {
  color: #9e9e9e;
}

/* 浏览提示 */
.browse-tip {
  text-align: center;
  padding: 20rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #999;
  font-style: italic;
}

/* 响应式适配 */
@media (max-width: 400px) {
  .apply-section {
    margin: 25rpx 30rpx 15rpx;
  }
  
  .apply-card, .applied-card, .private-card {
    padding: 30rpx;
  }
  
  .apply-icon, .applied-icon, .private-icon {
    font-size: 36rpx;
    margin-right: 20rpx;
  }
  
  .apply-title, .applied-title, .private-title {
    font-size: 28rpx;
  }
  
  .apply-desc, .applied-desc, .private-desc {
    font-size: 24rpx;
  }
  
  .apply-btn {
    height: 70rpx;
    font-size: 28rpx;
  }
}