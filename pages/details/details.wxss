/* ===== 全屏 Loading Overlay ===== */
.unified-loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-overlay-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
}

.loading-overlay-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.loading-overlay-spinner {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 40rpx;
}

.spinner-circle {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #f0f0f0;
  border-top: 6rpx solid #1A73E8;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-overlay-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
  text-align: center;
}

.loading-overlay-subtitle {
  font-size: 26rpx;
  color: #808080;
  text-align: center;
}

/* ===== 时间轴结束标记 ===== */
.timeline-end-marker {
  /* 复用 post-item 的 Grid 布局 */
  --post-gap: 80rpx;
  --header-height: 50rpx;
  --end-marker-top-gap: 50rpx; /* 结束标记与上一个帖子的间距 */

  display: grid;
  grid-template-columns: 50rpx 1fr;
  grid-template-rows: auto;
  column-gap: 24rpx;
  margin-top: calc(var(--end-marker-top-gap) - var(--post-gap)); /* 50rpx - 80rpx = -30rpx */
  margin-bottom: 0; /* 去掉底部间距，避免 scroll-view 底部空白 */
  padding-bottom: 40rpx; /* 用 padding 提供视觉呼吸空间，不影响布局计算 */
  position: relative;
  align-items: center;
}

/* 时间线背景 */
.timeline-end-marker .timeline-line {
  grid-column: 1;
  grid-row: 1;
  position: relative;
  width: 100%;
  height: 100%;
}

/* 时间线（伪元素） - 向上延伸到与最后帖子的时间线相接 */
.timeline-end-marker .timeline-line::before {
  content: '';
  position: absolute;
  width: 2rpx;
  /* 向上延伸到最后帖子时间线的终点 */
  /* 最后帖子向下延伸 40rpx，间距 50rpx，所以需要向上延伸 10rpx */
  top: calc(var(--post-gap) / 2 - var(--end-marker-top-gap)); /* 40rpx - 50rpx = -10rpx */
  bottom: calc(var(--header-height) / 2);
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(to bottom,
    rgba(26, 115, 232, 0.2) 0%,
    rgba(26, 115, 232, 0.12) 50%,
    rgba(26, 115, 232, 0.08) 90%,
    transparent 100%);
  z-index: 1;
}

/* 结束节点圆点 */
.timeline-end-marker .node-dot {
  grid-column: 1;
  grid-row: 1;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #1A73E8;
  box-shadow: 0 0 0 4rpx rgba(26, 115, 232, 0.1);
  justify-self: center;
  z-index: 2;
  margin-bottom: 2rpx; /* 与 post-item 的圆点保持一致 */
}

/* 结束文字内容 */
.timeline-end-marker .end-content {
  grid-column: 2;
  grid-row: 1;
  display: flex;
  align-items: center;
  height: var(--header-height);
  padding-left: 4rpx; /* 向右移动一点 */
}

.timeline-end-marker .end-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1;
  position: relative;
  top: -3rpx; /* 微调向上，视觉居中 */
}

