/* pages/details/details.wxss */

/* 基础样式 */
page {
  background-color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
}

view, text, image {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* 页面容器 */
.page-container {
  position: relative;
  width: 100%;
  height: 100vh;
  background-color: #ffffff;
  overflow: hidden; /* 防止页面滚动 */
}

/* 状态栏占位 - 已集成到自定义导航栏中 */

/* 🔧 移除了加载状态样式，现在在main page处理预加载 */
/* .loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: calc(100vh - var(--navigation-height, 88px));
  font-size: 28rpx;
  color: #666666;
} */

/* 朋友圈页面主容器 */
.moment-page {
  background-color: #ffffff;
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding-top: 20px; /* 默认导航栏高度，会被动态设置覆盖 */
  overflow: hidden; /* 防止内容溢出 */
}

/* scroll-view样式 */
.moment-scroll-view {
  width: 100%;
  flex: 1;
}

/* 自定义导航栏样式已移至custom-navigation组件 */

/* 朋友圈信息卡片 */
.friend-circle-info-card {
  position: relative;
  background: #ffffff;
  margin: 45rpx 30rpx 25rpx 30rpx;
  padding: 30rpx;
}

.card-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 80rpx;
  padding-left: 30rpx;
  padding-right: 15rpx;
  box-sizing: border-box;
  margin-top: 10rpx;
}

/* 左侧内容区域：文字 + 头像按钮 */
.left-content {
  display: flex;
  align-items: center;
  gap: 25rpx;
  flex: 1;
  min-width: 0;
}

.circle-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  width: fit-content;
  max-width: 400rpx; /* 设置最大宽度避免过长 */
  flex-shrink: 0;
  min-width: 0;
}

.member-count {
  font-size: 28rpx;
  font-weight: 400;
  color: #000000;
  line-height: 1.2;
  white-space: nowrap;
  width: fit-content;
}

.circle-status {
  font-size: 20rpx;
  line-height: 1.3;
  white-space: normal; /* 允许换行 */
  width: fit-content;
  word-break: break-all; /* 长单词可以断行 */
  color: #808080;
}

.avatars-section {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 20rpx;
  margin: 0 16rpx;
}

.avatar-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.member-avatar {
  width: 55rpx;
  height: 55rpx;
  border-radius: 50%;
  border: none;
  flex-shrink: 0;
}

.member-count-badge {
  width: 55rpx;
  height: 55rpx;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);
}

.member-count-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  z-index: 1;
}

.member-count-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 2;
}

.count-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1;
  text-align: center;
  position: relative;
  z-index: 3;
}

.add-member-btn {
  width: 55rpx;
  height: 55rpx;
  border-radius: 50%;
  background-color: #F0F5FF;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  line-height: normal;
  font-size: inherit;
  flex-shrink: 0;
}

.add-member-btn::after {
  border: none;
}

.add-member-hover {
  background-color: #e8f4fd;
  transform: scale(1.05);
}

.add-icon {
  width: 40rpx;
  height: 40rpx;
  filter: brightness(0) saturate(100%) invert(42%) sepia(55%) saturate(3611%) hue-rotate(205deg) brightness(96%) contrast(94%);
  opacity: 1;
}

.setting-btn {
  font-size: 24rpx;
  font-weight: 500;
  padding: 10rpx 30rpx;
  color: #ffffff;
  background-color: #1A73E8;
  border-radius: 50rpx;
  flex-shrink: 0;
  height: 55rpx;
}

/* ===== 时间轴帖子列表区域 ===== */
.timeline-container {
  margin-top: 60rpx;
  padding-bottom: 200rpx; /* 为底部按钮留出更多空间 */
}

/* 空状态重新设计 */
.empty-content {
  text-align: center;
  padding: 100rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 25rpx;
}

.empty-icon {
  font-size: 70rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.empty-subtitle {
  font-size: 26rpx;
  line-height: 1.6;
  color: #666666;
  max-width: 400rpx;
}



/* 时间轴项目 - 4区域Grid布局 */
.timeline-item {
  display: grid;
  grid-template-columns: 10% 90%; /* 左列10%放时间轴，右列90%放内容 */
  grid-template-rows: auto 1fr;   /* 上行自适应时间文字高度，下行占剩余空间 */
  gap: 30rpx 20rpx;               /* 行间距30rpx，列间距20rpx */
  margin-bottom: 50rpx;
  align-items: start;             /* 改为start，让每个元素自己控制对齐 */
}

/* 确保帖子卡片和时间线容器高度同步 */
.post-card {
  align-self: start; /* 从顶部开始对齐 */
}

.timeline-space-container {
  align-self: stretch; /* 拉伸以匹配同行元素的高度 */
  min-height: auto; /* 移除固定最小高度，让它自适应 */
}

/* 时间点容器 - 确保宽度一致且内部居中 */
.time-dot-container {
  width: 100%;
  height: 40rpx; /* 与时间标签对齐的高度 */
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 时间线空间容器 - 与post-card高度同步 */
.timeline-space-container {
  width: 100%;
  display: flex;
  align-items: flex-start; /* 线条从顶部开始 */
  justify-content: center;
  padding-top: 15rpx; /* 从时间点下方开始画线 */
  position: relative;
  overflow: visible; /* 允许线条延伸到容器外 */
}

/* 时间线线条 - 延伸到time-dot中心实现真正连接 */
.timeline-line {
  width: 3rpx;
  background: #1A73E8;
  border-radius: 2rpx;
  position: absolute;
  top: -35rpx; /* 向上延伸到time-dot中心位置: -(gap行间距30rpx + time-dot容器高度一半20rpx - padding15rpx) */
  bottom: -60rpx; /* 延伸到容器外，连接下一个项目 */
  left: 50%;
  transform: translateX(-50%); /* 确保居中 */
}

/* 第一个项目的时间线连接到自己的时间点 */
.timeline-item:first-child .timeline-space-container .timeline-line {
  top: -35rpx; /* 第一个项目向上延伸到自己的时间点中心：time-dot容器高度40rpx的一半 */
}

/* 最后一个项目的时间线不需要延伸 */
.timeline-no-more .timeline-space-container .timeline-line {
  bottom: 0; /* 结束项目线条不延伸到容器外 */
}

/* 时间圆点 - 实心设计，更好看的样式 */
.time-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1A73E8 0%, #4285F4 50%, #1A73E8 100%); /* 渐变蓝色背景 */
  border: none; /* 移除边框，使用实心设计 */
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0.0, 0.2, 1);
  z-index: 2; /* 确保时间点在时间线之上 */
  box-shadow: 
    0 1rpx 6rpx rgba(26, 115, 232, 0.3), /* 蓝色阴影 */
    0 0 0 4rpx rgba(255, 255, 255, 1), /* 白色光晕 */
    0 0 15rpx rgba(26, 115, 232, 0.15); /* 外部柔和光晕 */
}

/* 悬停效果 - 实心设计的现代化交互 */
.time-dot:hover {
  transform: scale(1.2);
  background: linear-gradient(135deg, #4285F4 0%, #1A73E8 50%, #4285F4 100%); /* 反向渐变 */
  box-shadow: 
    0 2rpx 8rpx rgba(26, 115, 232, 0.4), /* 加强阴影 */
    0 0 0 6rpx rgba(255, 255, 255, 1), /* 扩大白色光晕 */
    0 0 20rpx rgba(26, 115, 232, 0.25); /* 扩大外部光晕 */
}

/* 添加一个内部高光效果 */
.time-dot::before {
  content: '';
  position: absolute;
  top: 1.5rpx;
  left: 1.5rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transition: all 0.3s ease;
}

/* 时间线段已移除，使用整体连续时间线 */

/* Grid布局下不需要单独的卡片容器 */

/* 帖子卡片 */
.post-card {
  background: linear-gradient(145deg, #ffffff 0%, #fafbfc 100%);
  border-radius: 18rpx;
  padding: 20rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.06), 
    0 2rpx 8rpx rgba(0, 0, 0, 0.04),
    0 1rpx 0rpx rgba(255, 255, 255, 0.8) inset; /* 内部高光 */
  position: relative;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  width: 92%;
}

/* 时间标签头部 - Grid右上区域，与时间点对齐 */
.post-time-header {
  background: #ffffff;
  padding: 12rpx 0rpx;
  border-radius: 20rpx;
  border-bottom: 1rpx solid rgba(26, 115, 232, 0.08);
  display: flex;
  align-items: center; /* 内容垂直居中 */
  justify-self: start; /* 在Grid容器中左对齐 */
  align-self: center;  /* 在Grid容器中垂直居中，与时间点对齐 */
  height: 40rpx;       /* 固定高度，确保与时间点对齐基准一致 */
}

/* 时间标签装饰线 - 已移除 */
.post-time-header::before {
  display: none;
}

/* details页面中的时间轴时间标签样式 */
.post-time {
  font-size: 28rpx; /* 增大字体 */
  color: #1A73E8;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 12rpx;
  position: relative;
  z-index: 1;
}

.post-time::before {
  display: none; /* 隐藏时钟图标 */
}

/* 帖子内容在新结构中直接包含在post-card中 */

/* 时间轴加载更多样式 - 4区域Grid布局 */
.timeline-load-more {
  margin-top: 20rpx;
}

.load-more-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #cccccc 0%, #e0e0e0 50%, #cccccc 100%); /* 灰色渐变 */
  border: none; /* 实心设计 */
  position: relative;
  transition: all 0.3s ease;
  box-shadow: 
    0 2rpx 8rpx rgba(204, 204, 204, 0.3), /* 灰色阴影 */
    0 0 0 6rpx rgba(255, 255, 255, 1), /* 白色光晕 */
    0 0 20rpx rgba(204, 204, 204, 0.15); /* 外部柔和光晕 */
  z-index: 2;
}

/* 加载更多点的内部高光 */
.load-more-dot::before {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
}

.loading-dot {
  animation: loadingPulse 1.5s infinite;
}

@keyframes loadingPulse {
  0%, 100% {
    opacity: 0.3;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.2);
  }
}

.load-more-text {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
}

/* 时间轴结束样式 - 4区域Grid布局 */
.timeline-no-more {
  margin-top: 40rpx;
}

.no-more-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 50%, #FFD700 100%); /* 金色渐变 */
  border: none; /* 实心设计 */
  position: relative;
  transition: all 0.3s ease;
  box-shadow: 
    0 2rpx 8rpx rgba(255, 215, 0, 0.4), /* 金色阴影 */
    0 0 0 6rpx rgba(255, 255, 255, 1), /* 白色光晕 */
    0 0 20rpx rgba(255, 215, 0, 0.2); /* 外部金色光晕 */
  z-index: 2;
}

/* 结束点的内部高光 */
.no-more-dot::before {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5); /* 更亮的高光 */
}

.no-more-text {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  font-style: italic;
  position: relative;
}

/* ===== 发布按钮 ===== */
.publish-button-container {
  position: fixed;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  z-index: 100;
}

.main-publish-btn {
  width: 100%;
  font-size: 28rpx;
  font-weight: 600;
  padding: 25rpx;
  border-radius: 30rpx;
  background-color: #1A73E8;
  color: #ffffff;
  border: none;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
}

.main-publish-btn::after {
  border: none;
}

/* ===== 评论输入框模态框 ===== */
.comment-input-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.comment-input-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

/* 评论输入框容器 */
.tlou-comment-input-no-anim {
  width: 100%;
  background-color: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
  z-index: 1001;
  
  /* 简洁的淡入动画 */
  animation: simpleFadeIn 0.2s ease-out;
  
  box-shadow: 0px -4px 12px rgba(0, 0, 0, 0.1);
}

/* 简洁的淡入动画 */
@keyframes simpleFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.comment-input-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx 15rpx;
}

.comment-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.cancel-btn {
  font-size: 28rpx;
  color: #999999;
  padding: 10rpx;
}

.comment-input-content {
  padding: 0rpx 30rpx 40rpx 30rpx;
  /* 增加底部内边距，确保不被键盘遮挡 */
}

.comment-textarea {
  flex: 1;
  height: 80rpx;
  min-height: 80rpx;
  max-height: 80rpx;
  padding: 22rpx 15rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 36rpx;
  background-color: #ffffff;
  box-sizing: border-box;
  margin-right: 15rpx;
  vertical-align: middle;
  word-wrap: break-word;
}

.input-row {
  display: flex;
  align-items: center;
}



.send-btn {
  padding: 0 40rpx;
  height: 80rpx;
  font-size: 26rpx;
  background-color: #1A73E8;
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  flex-shrink: 0;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn::after {
  border: none;
}



/* === 邀请功能样式 === */

/* 邀请横幅 */
.invite-banner {
  margin: 30rpx 30rpx 15rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #1A73E8 0%, #4285F4 100%);
  border-radius: 24rpx;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  color: #fff;
}

.invite-info {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.invite-icon {
  font-size: 50rpx;
  margin-right: 20rpx;
}

.invite-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.invite-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.invite-desc {
  font-size: 24rpx;
  opacity: 0.9;
  line-height: 1.4;
}

.join-btn {
  width: 100%;
  padding: 30rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  background-color: #fff;
  color: #1A73E8;
  border: none;
  box-shadow: 0px 4px 12px rgba(255, 255, 255, 0.3);
}

.join-btn:active {
  background-color: #f0f6ff;
  transform: scale(0.98);
}

.join-btn.disabled {
  opacity: 0.7;
  transform: none;
}


/* === 申请加入朋友圈样式 === */

.apply-section {
  margin: 25rpx 30rpx 15rpx;
}

/* 申请卡片 - 采用与main页面一致的卡片设计 */
.apply-card, .applied-card, .private-card {
  position: relative;
  background-color: #ffffff;
  border-radius: 10rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
}

.apply-header, .applied-header, .private-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  z-index: 1;
  position: relative;
}

.apply-icon, .applied-icon, .private-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.apply-info, .applied-info, .private-info {
  flex: 1;
}

.apply-title, .applied-title, .private-title {
  display: block;
  font-size: 26rpx;
  font-weight: 400;
  color: #000000;
  margin-bottom: 8rpx;
}

.apply-desc, .applied-desc, .private-desc {
  display: block;
  font-size: 22rpx;
  color: #808080;
  line-height: 1.4;
}

/* 申请按钮 - 采用main页面的按钮设计 */
.apply-btn {
  width: 100%;
  height: 70rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 500;
  background-color: #1A73E8;
  color: #ffffff;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  z-index: 1;
  position: relative;
}

.apply-btn::after {
  border: none;
}

.apply-btn.disabled {
  opacity: 0.7;
}

/* 不同状态的卡片样式调整 */
.apply-card .apply-icon {
  color: #1A73E8;
}

.applied-card {
  background-color: #ffffff;
}

.applied-icon {
  color: #ff9800;
}

.private-card {
  background-color: #ffffff;
}

.private-icon {
  color: #9e9e9e;
}

/* 浏览提示 */
.browse-tip {
  text-align: center;
  padding: 20rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #999999;
  font-style: italic;
}


/* ===== 添加新分享部分样式 ===== */

.new-share-section {
  position: fixed;
  bottom: 60rpx;
  left: 30rpx;
  right: 30rpx;
  z-index: 100;
}

.share-container {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  height: 120rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(8rpx);
  background: rgba(166, 166, 166, 0.2);
  padding: 16rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.share-container:active {
  transform: scale(0.98);
  background: rgba(166, 166, 166, 0.3);
}

.cards-image {
  width: 150rpx;
  height: 110rpx;
  margin-right: 30rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.share-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-right: 24rpx;
}

.share-first-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.share-title {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(0, 0, 0, 1);
  font-family: 'PingFang SC', sans-serif;
}

.new-share-image {
  width: 100rpx;
  height: 30rpx;
  margin-top: 5rpx;
}

.share-second-line {
  display: flex;
  align-items: center;
}

  .share-desc {
    font-size: 22rpx;
    font-weight: 400;
    font-family: 'PingFang SC', sans-serif;
    line-height: 1.4;
  }
  
  /* 分隔线 */
  .share-divider {
    width: 2rpx;
    height: 60rpx;
    background-color: rgba(0, 0, 0, 0.6);
    margin: 0 12rpx;
    flex-shrink: 0;
  }
  
  .camera-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
  margin-left: 35rpx;
  margin-right: 30rpx;
  width: 50rpx;
  height: 50rpx;
}

.camera-btn:active {
  transform: scale(0.9);
}

.camera-icon {
  width: 164rpx;
  height: 45rpx;
  filter: brightness(0) saturate(100%) invert(0%) sepia(0%) saturate(0%) hue-rotate(0deg) brightness(0%) contrast(100%);
}
