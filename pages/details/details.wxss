/* 朋友圈页面主容器 */
.moment-page {
  background-color: #f8f8f8; /* 更改背景色为浅灰，突出卡片效果 */
  width: 100vw; /* 确保占满屏幕宽度 */
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding-top: 20px; /* 默认导航栏高度，会被动态设置覆盖 */
  padding-left: 0; /* 确保没有左padding */
  padding-right: 0; /* 确保没有右padding */
  margin: 0; /* 确保没有margin */
  overflow: hidden; /* 防止内容溢出 */
}

/* 内容区域样式 */
.content-area {
  width: 100vw;
  flex: 1;
  box-sizing: border-box;
}

/* 自定义导航栏样式已移至custom-navigation组件 */

/* 朋友圈信息卡片 - 新的卡片化设计 */
.circle-info-card {
  background: #ffffff;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 25rpx 15rpx 25rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.card-body {
  padding: 20rpx 25rpx 25rpx 25rpx;
}

/* 成员统计信息区域 */
.member-stats {
  margin-bottom: 0;
}

.member-count-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #333333;
  line-height: 1.3;
  margin-bottom: 6rpx;
}

/* 新增：成员信息行布局 */
.member-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.member-text-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.member-status-text {
  font-size: 22rpx;
  color: #808080;
  line-height: 1.4;
}

/* 头像画廊样式 - 调整为右对齐 */
.avatar-gallery {
  display: flex;
  align-items: center;
  gap: 12rpx;
  justify-content: flex-end;
  flex-shrink: 0;
}

.member-avatar-card {
  width: 60rpx;
  height: 60rpx;
  border-radius: 10rpx; /* 使用圆角矩形而不是圆形 */
  border: 2rpx solid #ffffff;
  box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
}

.member-more-badge {
  width: 60rpx;
  height: 60rpx;
  border-radius: 10rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 2rpx solid #ffffff;
  box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.1);
}

.member-more-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  z-index: 1;
}

.member-more-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 2;
}

.more-count-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1;
  text-align: center;
  position: relative;
  z-index: 3;
}

.add-member-card-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 10rpx;
  background-color: #f8f9ff;
  border: 2rpx dashed #1A73E8;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: normal;
  font-size: inherit;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.add-member-card-btn::after {
  border: none;
}

.add-member-hover {
  background-color: #e8f4fd;
  transform: scale(1.05);
}

.add-member-icon {
  width: 28rpx;
  height: 28rpx;
  filter: brightness(0) saturate(100%) invert(42%) sepia(55%) saturate(3611%) hue-rotate(205deg) brightness(96%) contrast(94%);
  opacity: 1;
}

.setting-btn {
  font-size: 24rpx;
  font-weight: 500;
  padding: 8rpx 20rpx;
  color: #1A73E8;
  background-color: #f8f9ff;
  border: 1rpx solid #e0e7ff;
  border-radius: 16rpx;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.setting-btn:active {
  background-color: #e8f4fd;
  transform: scale(0.95);
  border-color: #1A73E8;
}

/* 删除原有的分隔线，已被卡片设计替代 */

/* ===== 滑动卡片区域 ===== */
.posts-section {
  margin-bottom: 20rpx;
}

/* 滑动卡片组件样式 */
card-swipe {
  height: 800rpx;
  margin-bottom: 30rpx;
}

/* 空状态卡片 */
.empty-state-card {
  background: #ffffff;
  border-radius: 10rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.empty-icon {
  font-size: 48rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
  color: #333333;
}

.empty-subtitle {
  font-size: 24rpx;
  line-height: 1.5;
  color: #808080;
}

/* ===== 滑动卡片容器样式已移至post-card组件 ===== */

/* 原有的卡片导航指示器已被水平时间地图替代 */

/* 查看全部按钮 */
.view-all-posts {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 0 20rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 2rpx dashed #e0e0e0;
  border-radius: 15rpx;
  transition: all 0.2s ease;
}

.view-all-posts:active {
  background: rgba(26, 115, 232, 0.05);
  border-color: #1A73E8;
  transform: scale(0.98);
}

.view-all-text {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}

.view-all-icon {
  width: 20rpx;
  height: 20rpx;
  opacity: 0.6;
}


/* ===== 发布新动态卡片 - 优化样式适配整体风格 ===== */
.publish-card {
  background: #ffffff;
  border: 2rpx solid #f0f0f0;
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 20rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 0.3s ease;
  overflow: hidden;
  position: relative;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.publish-card:active {
  transform: translateY(-2rpx) scale(0.98);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12);
  border-color: #1A73E8;
}

.publish-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
  z-index: 2;
}

.publish-icon-wrapper {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #1A73E8 0%, #4285F4 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(26, 115, 232, 0.3);
}

.publish-icon {
  width: 32rpx;
  height: 32rpx;
  filter: brightness(0) saturate(100%) invert(100%);
}

.publish-text-content {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.publish-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.3;
}

.publish-desc {
  font-size: 24rpx;
  color: #808080;
  line-height: 1.4;
}

.publish-right {
  width: 100rpx;
  height: 80rpx;
  z-index: 1;
  opacity: 0.6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.publish-decoration {
  width: 80rpx;
  height: 60rpx;
  filter: opacity(0.8);
}

/* ===== 评论输入框模态框 ===== */
.comment-input-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.comment-input-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

/* 评论输入框容器 - 简化类名 */
.comment-input-container {
  width: 100%;
  background-color: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
  z-index: 1001;
  animation: simpleFadeIn 0.2s ease-out;
  box-shadow: 0px -4px 12px rgba(0, 0, 0, 0.1);
}

/* 简洁的淡入动画 */
@keyframes simpleFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.comment-input-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx 15rpx;
}

.comment-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.cancel-btn {
  font-size: 28rpx;
  color: #999999;
  padding: 10rpx;
}

.comment-input-content {
  padding: 0rpx 30rpx 40rpx 30rpx;
  /* 增加底部内边距，确保不被键盘遮挡 */
}

.comment-textarea {
  flex: 1;
  height: 80rpx;
  min-height: 80rpx;
  max-height: 80rpx;
  padding: 22rpx 15rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 36rpx;
  background-color: #ffffff;
  box-sizing: border-box;
  margin-right: 15rpx;
  vertical-align: middle;
  word-wrap: break-word;
}

.input-row {
  display: flex;
  align-items: center;
}



.send-btn {
  padding: 0 40rpx;
  height: 80rpx;
  font-size: 26rpx;
  background-color: #1A73E8;
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  flex-shrink: 0;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn::after {
  border: none;
}



/* === 邀请功能样式 === */

/* 邀请横幅 */
.invite-banner {
  margin-bottom: 20rpx; /* 与其他卡片保持一致的间距 */
  padding: 30rpx;
  background: linear-gradient(135deg, #1A73E8 0%, #4285F4 100%);
  border-radius: 10rpx; /* 与其他卡片保持一致的圆角 */
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  color: #fff;
}

.invite-info {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.invite-icon {
  font-size: 50rpx;
  margin-right: 20rpx;
}

.invite-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.invite-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.invite-desc {
  font-size: 24rpx;
  opacity: 0.9;
  line-height: 1.4;
}

.join-btn {
  width: 100%;
  padding: 30rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  background-color: #fff;
  color: #1A73E8;
  border: none;
  box-shadow: 0px 4px 12px rgba(255, 255, 255, 0.3);
}

.join-btn:active {
  background-color: #f0f6ff;
  transform: scale(0.98);
}

.join-btn.disabled {
  opacity: 0.7;
  transform: none;
}


/* === 申请加入朋友圈样式 === */

.apply-section {
  margin: 0 30rpx 20rpx 30rpx; /* 添加左右边距，与其他卡片保持一致 */
}

/* 申请卡片 - 采用与main页面一致的卡片设计 */
.apply-card, .applied-card, .private-card {
  position: relative;
  background-color: #ffffff;
  border-radius: 10rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
}

.apply-header, .applied-header, .private-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  z-index: 1;
  position: relative;
}

.apply-icon, .applied-icon, .private-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.apply-info, .applied-info, .private-info {
  flex: 1;
}

.apply-title, .applied-title, .private-title {
  display: block;
  font-size: 26rpx;
  font-weight: 400;
  color: #000000;
  margin-bottom: 8rpx;
}

.apply-desc, .applied-desc, .private-desc {
  display: block;
  font-size: 22rpx;
  color: #808080;
  line-height: 1.4;
}

/* 申请按钮 - 采用main页面的按钮设计 */
.apply-btn {
  width: 100%;
  height: 70rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 500;
  background-color: #1A73E8;
  color: #ffffff;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  z-index: 1;
  position: relative;
}

.apply-btn::after {
  border: none;
}

.apply-btn.disabled {
  opacity: 0.7;
}

/* 不同状态的卡片样式调整 */
.apply-card .apply-icon {
  color: #1A73E8;
}

.applied-card {
  background-color: #ffffff;
}

.applied-icon {
  color: #ff9800;
}

.private-card {
  background-color: #ffffff;
}

.private-icon {
  color: #9e9e9e;
}

/* 浏览提示 */
.browse-tip {
  text-align: center;
  padding: 20rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #999999;
  font-style: italic;
}


/* 底部安全区域 */
.bottom-safe-area {
  width: 100%;
  flex-shrink: 0;
}

