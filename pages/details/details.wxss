/* pages/details/details.wxss */

/* 基础样式 */
page {
  background-color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
}

view, text, image {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* ===== 🎬 分享入场动画样式（页面级） ===== */

/* 页面黑色背景（动画播放时） */
.page-container.page-black-bg {
  background-color: #000000;
}

/* 🎬 内容淡入遮罩层 */
.content-fade-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #ffffff;  /* ✅ 白色遮罩（页面背景是白色的） */
  opacity: 1;  /* 初始完全不透明，遮住下面的内容 */
  z-index: 9998;  /* ✅ 比导航栏(1000)高，但比动画容器(9999)低 */
  pointer-events: none;  /* 不阻挡交互 */
  transition: opacity 800ms linear;  /* 800ms线性淡出（速度2.5倍） */
}

.content-fade-mask.fade-out {
  opacity: 0;  /* 淡出到透明，露出下面的白色内容 */
}

/* 🚫 交互阻止层：在动画期间阻止所有用户交互 */
.animation-interaction-blocker {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10000;  /* ✅ 最高层级，覆盖所有元素 */
  background-color: transparent;  /* 完全透明 */
  opacity: 1;  /* 保持可见（虽然透明） */
  pointer-events: auto;  /* ✅ 关键：阻止所有触摸和点击事件 */
}

/* 动画容器 - 全屏 */
.share-animation-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 9999;
  overflow: hidden;
  background-color: #000000; /* 确保容器本身是黑色 */
}

/* 动画容器初始状态 - 容器本身立即可见（黑色背景） */
.share-animation-container-appear {
  /* 不设置 opacity: 0，确保黑色背景立即可见 */
}

/* 动画容器激活状态 */
.share-animation-container.active {
  /* 动画应用到图片，而不是容器 */
}

/* 全屏图片 - 初始状态：模糊、变暗、放大 */
.share-animation-image {
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0;
  filter: blur(90px) brightness(0.4);
  transform: scale(1.3);
}

/* 图片激活状态 */
.share-animation-container.active .share-animation-image {
  animation: shareImageFadeIn 2.5s ease-out forwards;
}

/* 渐变遮罩层 */
.share-gradient-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 400%;
  height: 100%;
  /* 🎭 幕布效果：前25%完全不透明（实体幕布），然后渐变到透明 */
  background: linear-gradient(225deg, #000 25%, transparent 100%);
  transform: translateX(-65%);
  opacity: 1;
  z-index: 10;
  pointer-events: none;
}

/* 渐变遮罩激活状态 
   ✨ 优化缓动：cubic-bezier 让幕布拉开更有"力量感"和"重量感"
   注意：1.2s 是 CSS 内部延迟，实际触发时间 = 500ms(JS) + 1200ms(CSS) = 1700ms */
.share-gradient-overlay.active {
  animation: gradientSlide 2.5s cubic-bezier(0.4, 0, 0.2, 1) forwards 1.2s;
}

/* 动画关键帧 */

/* 图片从模糊到清晰的动画 */
@keyframes shareImageFadeIn {
  from {
    opacity: 0;
    filter: blur(90px) brightness(0.4);
    transform: scale(1.3);
  }
  to {
    opacity: 1;
    filter: blur(0px) brightness(1);
    transform: scale(1);
  }
}

/* 渐变遮罩滑动动画 */
@keyframes gradientSlide {
  from {
    transform: translateX(-65%);
    opacity: 1;
  }
  to {
    transform: translateX(0);
    opacity: 0;
  }
}

/* ===== 阶段3：过渡动画样式 ===== */

/* 容器过渡状态：背景从黑色渐变到白色 + 尺寸位置过渡 */
.share-animation-container.transitioning {
  background-color: #ffffff;
  /* ❌ 移除背景色过渡，避免在容器边缘（圆角、sub-pixel等）露出黑色背景 */
  transition: /* background-color 2000ms ease-out, */
              width 2000ms cubic-bezier(0.4, 0, 0.2, 1),
              height 2000ms cubic-bezier(0.4, 0, 0.2, 1),
              left 2000ms cubic-bezier(0.4, 0, 0.2, 1),
              top 2000ms cubic-bezier(0.4, 0, 0.2, 1),
              border-radius 2000ms cubic-bezier(0.4, 0, 0.2, 1);  /* 🔧 圆角也要平滑过渡 */
}

/* 目标状态：激活目标尺寸和位置（通过data属性） */
.share-animation-container.transitioning[data-transition-active="true"] {
  /* 尺寸和位置通过内联样式动态设置 */
  border-radius: 10rpx;  /* 🔧 与post-item图片圆角统一（.post-image-single: 10rpx） */
}

/* 图片过渡状态：保持100%填充容器 */
.share-animation-container.transitioning .share-animation-image {
  /* 停止开场动画 */
  animation: none !important;
  
  /* ✅ 关键：保持开场动画结束后的状态（包括transform） */
  opacity: 1;
  filter: blur(0px) brightness(1) !important;
  transform: scale(1) !important;  /* ← 必须保留！防止图片突然变大 */
  
  /* 图片填充容器，aspectFill会自动处理 */
  width: 100%;
  height: 100%;
}

/* 隐藏渐变遮罩（在过渡阶段不需要） */
.share-animation-container.transitioning .share-gradient-overlay {
  opacity: 0;
  pointer-events: none;
}

/* ===== 隐藏第一个post-item的图片（过渡期间） ===== */
/* 注意：由于微信小程序不支持>>>深度选择器，我们采用另一种方案：
   在过渡动画期间，全屏图片会精确覆盖在第一个post图片的位置上，
   用户看到的实际上是动画图片，所以不需要隐藏真实图片。
   在过渡完成后（T=6250ms），我们移除动画容器并显示真实图片，实现无缝切换。 */

/* ===== 分享动画样式结束 ===== */

