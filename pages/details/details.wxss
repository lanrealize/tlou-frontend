/* pages/details/details.wxss */

/* 基础样式 */
page {
  background-color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
}

view, text, image {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* 页面容器 */
.page-container {
  position: relative;
  width: 100%;
  height: 100vh;
  background-color: #ffffff;
  overflow: hidden; /* 防止页面滚动 */
}

/* 状态栏占位 - 已集成到自定义导航栏中 */

/* 🔧 移除了加载状态样式，现在在main page处理预加载 */
/* .loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: calc(100vh - var(--navigation-height, 88px));
  font-size: 28rpx;
  color: #666666;
} */

/* 朋友圈页面主容器 */
.moment-page {
  background-color: #ffffff;
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding-top: 20px; /* 默认导航栏高度，会被动态设置覆盖 */
  overflow: hidden; /* 防止内容溢出 */
}

/* scroll-view样式 */
.moment-scroll-view {
  width: 100%;
}

/* 自定义导航栏样式已移至custom-navigation组件 */

/* 朋友圈信息卡片 */
.friend-circle-info-card {
  position: relative;
  background: #ffffff;
}

/* 固定顶部的卡片容器 */
.card-content-fixed {
  position: relative;
  width: 100%;
  background: #ffffff;
  z-index: 10;
}

.card-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 80rpx;
  padding-left: 30rpx;
  padding-right: 15rpx;
  box-sizing: border-box;
  margin-top: 10rpx;
  padding-bottom: 25rpx;
}

/* 分割线 - 优雅的渐变设计 */
.divider {
  width: 100vw;
  height: 1px;
  position: absolute;
  left: 0;
  margin-bottom: 0;
  margin-top: 10rpx;
  margin-left: 0;
  margin-right: 0;
  z-index: 15;
  
  /* 渐变背景：从中心向两端淡出 */
  background: linear-gradient(
    to right,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 0.08) 15%,
    rgba(0, 0, 0, 0.15) 50%,
    rgba(0, 0, 0, 0.08) 85%,
    rgba(0, 0, 0, 0) 100%
  );
  
  /* 添加微妙的阴影效果 */
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  
  /* 可选：添加光晕效果 */
  filter: blur(0.5px);
}

/* 左侧内容区域：文字 + 头像按钮 */
.left-content {
  display: flex;
  align-items: center;
  gap: 25rpx;
  flex: 1;
  min-width: 0;
}

.circle-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  width: fit-content;
  flex-shrink: 0;
  min-width: 0;
}

.member-count {
  font-size: 28rpx;
  font-weight: 400;
  color: #000000;
  line-height: 1.2;
  white-space: nowrap;
  width: fit-content;
}

.circle-status {
  font-size: 20rpx;
  line-height: 1.3;
  white-space: normal; /* 允许换行 */
  width: fit-content;
  word-break: break-all; /* 长单词可以断行 */
  color: #808080;
}

.avatars-section {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.avatar-group {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.member-avatar {
  width: 55rpx;
  height: 55rpx;
  border-radius: 50%;
  border: none;
  flex-shrink: 0;
}

.member-count-badge {
  width: 55rpx;
  height: 55rpx;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);
}

.member-count-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  z-index: 1;
}

.member-count-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 2;
}

.count-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1;
  text-align: center;
  position: relative;
  z-index: 3;
}

.add-member-btn {
  width: 55rpx;
  height: 55rpx;
  border-radius: 50%;
  background-color: #F0F5FF;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  line-height: normal;
  font-size: inherit;
  flex-shrink: 0;
}

.add-member-btn::after {
  border: none;
}

.add-member-hover {
  background-color: #e8f4fd;
  transform: scale(1.05);
}

.add-icon {
  width: 56rpx;
  height: 56rpx;
  filter: brightness(0) saturate(100%) invert(42%) sepia(55%) saturate(3611%) hue-rotate(205deg) brightness(96%) contrast(94%);
  opacity: 1;
}

.setting-btn {
  color: #1A73E8;
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 400;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
}

/* ===== 帖子列表区域 ===== */
.posts-container {
  padding-top: 60rpx;
  padding-bottom: 200rpx; /* 为底部按钮留出空间 */
}

.empty-content {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999999;
}

.empty-title {
  font-size: 32rpx;
  margin-bottom: 20rpx;
  color: #666666;
}

.empty-subtitle {
  font-size: 28rpx;
  line-height: 1.5;
}

.load-more,
.no-more {
  text-align: center;
  padding: 40rpx;
}

.load-more-text,
.no-more-text {
  font-size: 26rpx;
  color: #999999;
}

/* ===== 发布按钮 ===== */
.publish-button-container {
  position: fixed;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  z-index: 100;
}

.main-publish-btn {
  width: 100%;
  font-size: 32rpx;
  font-weight: 600;
  padding: 30rpx;
  border-radius: 30rpx;
  background-color: #1A73E8;
  color: #ffffff;
  border: none;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
}

.main-publish-btn::after {
  border: none;
}

/* ===== 评论输入框模态框 ===== */
.comment-input-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.comment-input-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

/* 评论输入框容器 */
.tlou-comment-input-no-anim {
  width: 100%;
  background-color: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
  z-index: 1001;
  
  /* 简洁的淡入动画 */
  animation: simpleFadeIn 0.2s ease-out;
  
  box-shadow: 0px -4px 12px rgba(0, 0, 0, 0.1);
}

/* 简洁的淡入动画 */
@keyframes simpleFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.comment-input-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx 15rpx;
}

.comment-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.cancel-btn {
  font-size: 28rpx;
  color: #999999;
  padding: 10rpx;
}

.comment-input-content {
  padding: 0rpx 30rpx 40rpx 30rpx;
  /* 增加底部内边距，确保不被键盘遮挡 */
}

.comment-textarea {
  flex: 1;
  height: 80rpx;
  min-height: 80rpx;
  max-height: 80rpx;
  padding: 22rpx 15rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 36rpx;
  background-color: #ffffff;
  box-sizing: border-box;
  margin-right: 15rpx;
  vertical-align: middle;
  word-wrap: break-word;
}

.input-row {
  display: flex;
  align-items: center;
}



.send-btn {
  padding: 0 40rpx;
  height: 80rpx;
  font-size: 26rpx;
  background-color: #1A73E8;
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  flex-shrink: 0;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn::after {
  border: none;
}



/* === 邀请功能样式 === */

/* 邀请横幅 */
.invite-banner {
  margin: 40rpx 40rpx 20rpx;
  padding: 40rpx;
  background: linear-gradient(135deg, #1A73E8 0%, #4285F4 100%);
  border-radius: 24rpx;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  color: #fff;
}

.invite-info {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.invite-icon {
  font-size: 60rpx;
  margin-right: 30rpx;
}

.invite-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.invite-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.invite-desc {
  font-size: 26rpx;
  opacity: 0.9;
  line-height: 1.4;
}

.join-btn {
  width: 100%;
  padding: 30rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  background-color: #fff;
  color: #1A73E8;
  border: none;
  box-shadow: 0px 4px 12px rgba(255, 255, 255, 0.3);
}

.join-btn:active {
  background-color: #f0f6ff;
  transform: scale(0.98);
}

.join-btn.disabled {
  opacity: 0.7;
  transform: none;
}

/* 响应式适配 */
@media (max-width: 400px) {
  .invite-banner {
    margin: 30rpx 30rpx 15rpx;
    padding: 30rpx;
  }
  
  .invite-icon {
    font-size: 50rpx;
    margin-right: 20rpx;
  }
  
  .invite-title {
    font-size: 32rpx;
  }
  
  .invite-desc {
    font-size: 24rpx;
  }
}

/* === 申请加入朋友圈样式 === */

.apply-section {
  margin: 30rpx 40rpx 20rpx;
}

/* 申请卡片 - 采用与main页面一致的卡片设计 */
.apply-card, .applied-card, .private-card {
  position: relative;
  background-color: #ffffff;
  border-radius: 10rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
}

.apply-header, .applied-header, .private-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  z-index: 1;
  position: relative;
}

.apply-icon, .applied-icon, .private-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.apply-info, .applied-info, .private-info {
  flex: 1;
}

.apply-title, .applied-title, .private-title {
  display: block;
  font-size: 28rpx;
  font-weight: 400;
  color: #000000;
  margin-bottom: 8rpx;
}

.apply-desc, .applied-desc, .private-desc {
  display: block;
  font-size: 24rpx;
  color: #808080;
  line-height: 1.4;
}

/* 申请按钮 - 采用main页面的按钮设计 */
.apply-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: 500;
  background-color: #1A73E8;
  color: #ffffff;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  z-index: 1;
  position: relative;
}

.apply-btn::after {
  border: none;
}

.apply-btn.disabled {
  opacity: 0.7;
}

/* 不同状态的卡片样式调整 */
.apply-card .apply-icon {
  color: #1A73E8;
}

.applied-card {
  background-color: #ffffff;
}

.applied-icon {
  color: #ff9800;
}

.private-card {
  background-color: #ffffff;
}

.private-icon {
  color: #9e9e9e;
}

/* 浏览提示 */
.browse-tip {
  text-align: center;
  padding: 20rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #999999;
  font-style: italic;
}

/* 响应式适配 */
@media (max-width: 400px) {
  .nav-back-btn {
    left: 40rpx;
    width: 28px;
    height: 28px;
  }
  
  .back-icon {
    width: 24px;
    height: 24px;
  }
  
  .nav-title .title-text {
    font-size: 16px;
  }
  
  .friend-circle-info-card {
    margin: 45rpx 30rpx 25rpx 30rpx;
    padding: 30rpx;
  }
  
  .circle-info {
    gap: 6rpx;
    width: fit-content;
    max-width: 400rpx; /* 设置最大宽度避免过长 */
  }
  
  .avatars-section {
    gap: 20rpx;
    margin: 0 16rpx;
  }
  
  .avatar-group {
    gap: 16rpx;
  }
  
  .add-icon {
    width: 40rpx;
    height: 40rpx;
  }
  
  .setting-btn {
    font-size: 28rpx;
  }
  
  .apply-section {
    margin: 25rpx 30rpx 15rpx;
  }
  
  .apply-card, .applied-card, .private-card {
    padding: 30rpx;
  }
  
  .apply-icon, .applied-icon, .private-icon {
    font-size: 36rpx;
    margin-right: 20rpx;
  }
  
  .apply-title, .applied-title, .private-title {
    font-size: 26rpx;
  }
  
  .apply-desc, .applied-desc, .private-desc {
    font-size: 22rpx;
  }
  
  .apply-btn {
    height: 70rpx;
    font-size: 26rpx;
  }
  
  .main-publish-btn {
    font-size: 28rpx;
    padding: 25rpx;
  }
  
  .posts-container {
    padding-bottom: 180rpx;
  }
}

/* ===== 添加新分享部分样式 ===== */

.new-share-section {
  position: fixed;
  bottom: 60rpx;
  left: 40rpx;
  right: 40rpx;
  z-index: 100;
}

.share-container {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  height: 140rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(8rpx);
  background: rgba(166, 166, 166, 0.2);
  padding: 20rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.share-container:active {
  transform: scale(0.98);
  background: rgba(166, 166, 166, 0.3);
}

.cards-image {
  width: 150rpx;
  height: 110rpx;
  margin-right: 30rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.share-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-right: 30rpx;
}

.share-first-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.share-title {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(0, 0, 0, 1);
  font-family: 'PingFang SC', sans-serif;
}

.new-share-image {
  width: 100rpx;
  height: 30rpx;
  margin-top: 5rpx;
}

.share-second-line {
  display: flex;
  align-items: center;
}

  .share-desc {
    font-size: 24rpx;
    font-weight: 400;
    font-family: 'PingFang SC', sans-serif;
    line-height: 1.4;
  }
  
  /* 分隔线 */
  .share-divider {
    width: 2rpx;
    height: 70rpx;
    background-color: rgba(0, 0, 0, 0.6);
    margin: 0 30rpx;
    flex-shrink: 0;
  }
  
  .camera-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
  margin-left: 35rpx;
  margin-right: 30rpx;
}

.camera-btn:active {
  transform: scale(0.9);
}

.camera-icon {
  width: 164rpx;
  height: 45rpx;
  filter: brightness(0) saturate(100%) invert(0%) sepia(0%) saturate(0%) hue-rotate(0deg) brightness(0%) contrast(100%);
}

/* 响应式适配 */
@media (max-width: 400px) {
  .new-share-section {
    bottom: 60rpx;
    left: 30rpx;
    right: 30rpx;
  }
  
  .share-container {
    height: 120rpx;
    padding: 16rpx;
  }
  
  .share-content {
    margin-right: 24rpx;
    gap: 8rpx;
  }
  
  .share-title {
    font-size: 28rpx;
  }
  
  .share-desc {
    font-size: 22rpx;
  }
  
  .share-divider {
    height: 60rpx;
    margin: 0 12rpx;
  }
  
  .camera-btn {
    width: 50rpx;
    height: 50rpx;
  }
  
}