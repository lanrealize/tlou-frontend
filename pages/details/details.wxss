/* 朋友圈页面主容器 */
.moment-page {
  background-color: #ffffff;
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding-top: 20px; /* 默认导航栏高度，会被动态设置覆盖 */
  overflow: hidden; /* 防止页面滚动 */
  box-sizing: border-box; /* 让 padding 包含在 100vh 内 */
}

/* scroll-view样式 */
.moment-scroll-view {
  flex: 1;
  width: 100%;
  height: 0; /* 关键：配合 flex: 1 使用，让 flex 计算实际高度 */
  padding-top: 10rpx; /* 向上延伸一点，让卡片阴影覆盖 */
  margin-top: -10rpx; /* 负margin让内容向上移 */
  -ms-overflow-style: none !important;  /* IE and Edge */
  scrollbar-width: none !important;  /* Firefox */
  overflow: -moz-scrollbars-none !important;
}

/* 彻底隐藏滚动条 - 所有可能的选择器 */
.moment-scroll-view::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
  background: transparent !important;
  opacity: 0 !important;
}

.moment-scroll-view ::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
}

