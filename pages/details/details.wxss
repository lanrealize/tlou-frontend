/* 朋友圈页面主容器 */
.moment-page {
  background-color: #f8f8f8; /* 更改背景色为浅灰，突出卡片效果 */
  width: 100vw; /* 确保占满屏幕宽度 */
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding-top: 20px; /* 默认导航栏高度，会被动态设置覆盖 */
  padding-left: 0; /* 确保没有左padding */
  padding-right: 0; /* 确保没有右padding */
  margin: 0; /* 确保没有margin */
  overflow: hidden; /* 防止内容溢出 */
}

/* scroll-view样式 - 卡片化布局 */
.moment-scroll-view {
  width: 100vw;
  padding: 20rpx 30rpx 0 30rpx; /* 添加左右内边距为卡片留出空间 */
  flex: 1;
  box-sizing: border-box;
}

/* 自定义导航栏样式已移至custom-navigation组件 */

/* 朋友圈信息区域 - 简洁原始设计 */
.circle-info {
  padding: 20rpx 30rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.circle-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.circle-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.members-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.member-count {
  font-size: 26rpx;
  color: #666666;
}

.members-avatars {
  display: flex;
  align-items: center;
  gap: -10rpx;
}

.member-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  margin-left: -10rpx;
}

.member-avatar:first-child {
  margin-left: 0;
}

.more-members {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #999999;
}

.setting-btn {
  padding: 8rpx 16rpx;
  background: #f8f9fa;
  border: 1rpx solid #e9ecef;
  border-radius: 15rpx;
  font-size: 24rpx;
  color: #666666;
  transition: all 0.2s ease;
}

.setting-btn:active {
  background: #e9ecef;
  transform: scale(0.95);
}


/* 删除原有的分隔线，已被卡片设计替代 */

/* ===== 帖子和发布区域 - 统一管理 ===== */
.posts-section {
  margin-bottom: 20rpx;
  /* 包含卡片滑动和发布按钮的统一区域 */
}

/* 滑动卡片容器 */
.swipe-cards-section {
  height: 600rpx;
  margin-bottom: 30rpx;
}

/* 空状态卡片 */
.empty-state-card {
  background: #ffffff;
  border-radius: 10rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.empty-icon {
  font-size: 48rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
  color: #333333;
}

.empty-subtitle {
  font-size: 24rpx;
  line-height: 1.5;
  color: #808080;
}

/* ===== 滑动卡片和发布按钮统一容器 ===== */
.swipe-cards-container {
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
}

/* 为card-swipe组件设置固定高度区域 */
.swipe-cards-container card-swipe {
  height: 880rpx; /* 增加高度，为顶部留出更多空间 */
  flex-shrink: 0;
}

/* 卡片导航指示器 */
.cards-navigation {
  display: flex;
  justify-content: center;
  margin: 30rpx 0 20rpx 0;
}

.nav-dots {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 15rpx 25rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 30rpx;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
}

.nav-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #d0d0d0;
  transition: all 0.3s ease;
}

.nav-dot.active {
  background: #1A73E8;
  transform: scale(1.2);
}

.nav-more {
  font-size: 20rpx;
  color: #808080;
  margin-left: 8rpx;
}

/* 查看全部按钮 */
.view-all-posts {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 0 20rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 2rpx dashed #e0e0e0;
  border-radius: 15rpx;
  transition: all 0.2s ease;
}

.view-all-posts:active {
  background: rgba(26, 115, 232, 0.05);
  border-color: #1A73E8;
  transform: scale(0.98);
}

.view-all-text {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}

.view-all-icon {
  width: 20rpx;
  height: 20rpx;
  opacity: 0.6;
}


/* ===== 发布新动态卡片 - 统一在swipe-cards-container内 ===== */
.publish-card {
  background: linear-gradient(135deg, #1A73E8 0%, #4285F4 100%);
  border-radius: 10rpx;
  padding: 25rpx 30rpx;
  margin: 30rpx 20rpx 0 20rpx; /* 与容器内其他元素保持一致的边距 */
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 0.2s ease;
  overflow: hidden;
  /* 确保完全在文档流中，不遮挡任何内容 */
  position: static;
  width: auto; /* 让宽度自适应容器 */
  box-sizing: border-box;
  flex-shrink: 0; /* 防止在flex容器中被压缩 */
}

.publish-card:active {
  transform: scale(0.98);
  box-shadow: 0px 2px 8px rgba(26, 115, 232, 0.3);
}

.publish-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  /* 移除 z-index，确保在正常文档流中 */
}

.publish-icon-wrapper {
  width: 50rpx;
  height: 50rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.publish-icon {
  width: 28rpx;
  height: 28rpx;
  filter: brightness(0) saturate(100%) invert(100%);
}

.publish-text-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.publish-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.3;
}

.publish-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.4;
}

.publish-right {
  width: 80rpx;
  height: 60rpx;
  opacity: 0.3;
  /* 移除 z-index，确保在正常文档流中 */
}

.publish-decoration {
  width: 100%;
  height: 100%;
}

/* ===== 评论输入框模态框 ===== */
.comment-input-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.comment-input-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

/* 评论输入框容器 */
.tlou-comment-input-no-anim {
  width: 100%;
  background-color: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
  z-index: 1001;
  
  /* 简洁的淡入动画 */
  animation: simpleFadeIn 0.2s ease-out;
  
  box-shadow: 0px -4px 12px rgba(0, 0, 0, 0.1);
}

/* 简洁的淡入动画 */
@keyframes simpleFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.comment-input-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx 15rpx;
}

.comment-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.cancel-btn {
  font-size: 28rpx;
  color: #999999;
  padding: 10rpx;
}

.comment-input-content {
  padding: 0rpx 30rpx 40rpx 30rpx;
  /* 增加底部内边距，确保不被键盘遮挡 */
}

.comment-textarea {
  flex: 1;
  height: 80rpx;
  min-height: 80rpx;
  max-height: 80rpx;
  padding: 22rpx 15rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 36rpx;
  background-color: #ffffff;
  box-sizing: border-box;
  margin-right: 15rpx;
  vertical-align: middle;
  word-wrap: break-word;
}

.input-row {
  display: flex;
  align-items: center;
}



.send-btn {
  padding: 0 40rpx;
  height: 80rpx;
  font-size: 26rpx;
  background-color: #1A73E8;
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  flex-shrink: 0;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn::after {
  border: none;
}



/* === 邀请功能样式 === */

/* 邀请横幅 */
.invite-banner {
  margin-bottom: 20rpx; /* 与其他卡片保持一致的间距 */
  padding: 30rpx;
  background: linear-gradient(135deg, #1A73E8 0%, #4285F4 100%);
  border-radius: 10rpx; /* 与其他卡片保持一致的圆角 */
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  color: #fff;
}

.invite-info {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.invite-icon {
  font-size: 50rpx;
  margin-right: 20rpx;
}

.invite-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.invite-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.invite-desc {
  font-size: 24rpx;
  opacity: 0.9;
  line-height: 1.4;
}

.join-btn {
  width: 100%;
  padding: 30rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  background-color: #fff;
  color: #1A73E8;
  border: none;
  box-shadow: 0px 4px 12px rgba(255, 255, 255, 0.3);
}

.join-btn:active {
  background-color: #f0f6ff;
  transform: scale(0.98);
}

.join-btn.disabled {
  opacity: 0.7;
  transform: none;
}


/* === 申请加入朋友圈样式 === */

.apply-section {
  margin-bottom: 20rpx; /* 与其他卡片保持一致的间距 */
}

/* 申请卡片 - 采用与main页面一致的卡片设计 */
.apply-card, .applied-card, .private-card {
  position: relative;
  background-color: #ffffff;
  border-radius: 10rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
}

.apply-header, .applied-header, .private-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  z-index: 1;
  position: relative;
}

.apply-icon, .applied-icon, .private-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.apply-info, .applied-info, .private-info {
  flex: 1;
}

.apply-title, .applied-title, .private-title {
  display: block;
  font-size: 26rpx;
  font-weight: 400;
  color: #000000;
  margin-bottom: 8rpx;
}

.apply-desc, .applied-desc, .private-desc {
  display: block;
  font-size: 22rpx;
  color: #808080;
  line-height: 1.4;
}

/* 申请按钮 - 采用main页面的按钮设计 */
.apply-btn {
  width: 100%;
  height: 70rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 500;
  background-color: #1A73E8;
  color: #ffffff;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  z-index: 1;
  position: relative;
}

.apply-btn::after {
  border: none;
}

.apply-btn.disabled {
  opacity: 0.7;
}

/* 不同状态的卡片样式调整 */
.apply-card .apply-icon {
  color: #1A73E8;
}

.applied-card {
  background-color: #ffffff;
}

.applied-icon {
  color: #ff9800;
}

.private-card {
  background-color: #ffffff;
}

.private-icon {
  color: #9e9e9e;
}

/* 浏览提示 */
.browse-tip {
  text-align: center;
  padding: 20rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #999999;
  font-style: italic;
}


/* 删除原有的发布按钮样式，已被卡片设计替代 */

