/* pages/details/details.wxss */

/* 基础样式 */
page {
  background-color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
}

view, text, image {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* 页面容器 */
.page-container {
  position: relative;
  width: 100%;
  min-height: 100vh;
  background-color: #ffffff;
  overflow-x: hidden;
}

/* 状态栏占位 */
.status-bar {
  background-color: #ffffff;
  width: 100%;
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  font-size: 28rpx;
  color: #666666;
}

/* 朋友圈页面主容器 */
.moment-page {
  background-color: #ffffff;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 头部区域 - 采用与main页面相同的设计 */
.header {
  display: flex;
  align-items: center;
  padding: 40rpx 40rpx 20rpx 40rpx;
  margin-top: 60rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.back-icon {
  font-size: 50rpx;
  color: #383838;
  font-weight: bold;
  line-height: 1;
}

.title-group {
  flex: 1;
  margin-left: 10rpx;
}

.page-subtitle {
  font-size: 32rpx;
  color: #A6A6A6;
  line-height: 1.2;
  font-weight: 400;
  margin-bottom: 12rpx;
}

.title-text {
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #383838;
  letter-spacing: 1rpx;
}

.action-buttons {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
}

.action-icon {
  font-size: 32rpx;
  color: #383838;
  font-weight: 500;
}

/* 朋友圈信息卡片 */
.friend-circle-info-card {
  position: relative;
  margin: 30rpx 40rpx;
  padding: 40rpx;
  border-radius: 10rpx;
  background: #ffffff;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
}

.card-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  background: #ffffff;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30rpx;
  z-index: 1;
  position: relative;
}

.circle-info {
  flex: 1;
}

.member-count {
  font-size: 28rpx;
  font-weight: 400;
  color: #000000;
  margin-bottom: 8rpx;
}

.circle-status {
  font-size: 24rpx;
  color: #808080;
}

.setting-btn {
  font-size: 28rpx;
  font-weight: 400;
  padding: 8rpx 16rpx;
  color: #1A73E8;
}

.member-avatars {
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 1;
  position: relative;
}

.avatar-group {
  display: flex;
  align-items: center;
  gap: -20rpx;
}

.member-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  margin-left: -20rpx;
}

.member-avatar:first-child {
  margin-left: 0;
}

.add-member-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ccc;
  margin-left: 20rpx;
  padding: 0;
  line-height: normal;
  font-size: inherit;
}

.add-member-btn::after {
  border: none;
}

.add-member-hover {
  background-color: #e8f4fd;
  border-color: #1A73E8;
}

.add-member-btn.disabled {
  opacity: 0.5;
  background-color: #f0f0f0;
  border-color: #ddd;
}

.add-icon {
  font-size: 32rpx;
  color: #999999;
  font-weight: bold;
}

/* ===== 帖子列表区域 ===== */
.posts-container {
  margin-top: 20rpx;
  padding-bottom: 200rpx; /* 为底部按钮留出空间 */
}

.posts-list {
  /* 由post-item组件自己处理样式 */
}

.empty-content {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999999;
}

.empty-title {
  font-size: 32rpx;
  margin-bottom: 20rpx;
  color: #666666;
}

.empty-subtitle {
  font-size: 28rpx;
  line-height: 1.5;
}

.load-more,
.no-more {
  text-align: center;
  padding: 40rpx;
}

.load-more-text,
.no-more-text {
  font-size: 26rpx;
  color: #999999;
}

/* ===== 发布按钮 ===== */
.publish-button-container {
  position: fixed;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  z-index: 100;
}

.main-publish-btn {
  width: 100%;
  font-size: 32rpx;
  font-weight: 600;
  padding: 30rpx;
  border-radius: 30rpx;
  background-color: #1A73E8;
  color: #ffffff;
  border: none;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
}

.main-publish-btn::after {
  border: none;
}

/* ===== 评论输入框模态框 ===== */
.comment-input-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.comment-input-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.comment-input-container {
  width: 100%;
  background-color: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
  z-index: 1001;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.comment-input-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.comment-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.cancel-btn {
  font-size: 28rpx;
  color: #999999;
  padding: 10rpx;
}

.comment-input-content {
  padding: 30rpx 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.comment-textarea {
  width: 100%;
  min-height: 120rpx;
  max-height: 300rpx;
  padding: 20rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  background-color: #ffffff;
  box-sizing: border-box;
  outline: none;
  resize: none;
}

.comment-input-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}

.char-count {
  font-size: 24rpx;
  color: #999999;
}

.send-btn {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
}



/* === 邀请功能样式 === */

/* 邀请横幅 */
.invite-banner {
  margin: 40rpx 40rpx 20rpx;
  padding: 40rpx;
  background: linear-gradient(135deg, #1A73E8 0%, #4285F4 100%);
  border-radius: 24rpx;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  color: #fff;
}

.invite-info {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.invite-icon {
  font-size: 60rpx;
  margin-right: 30rpx;
}

.invite-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.invite-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.invite-desc {
  font-size: 26rpx;
  opacity: 0.9;
  line-height: 1.4;
}

.join-btn {
  width: 100%;
  padding: 30rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  background-color: #fff;
  color: #1A73E8;
  border: none;
  box-shadow: 0px 4px 12px rgba(255, 255, 255, 0.3);
}

.join-btn:active {
  background-color: #f0f6ff;
  transform: scale(0.98);
}

.join-btn.disabled {
  opacity: 0.7;
  transform: none;
}

/* 响应式适配 */
@media (max-width: 400px) {
  .invite-banner {
    margin: 30rpx 30rpx 15rpx;
    padding: 30rpx;
  }
  
  .invite-icon {
    font-size: 50rpx;
    margin-right: 20rpx;
  }
  
  .invite-title {
    font-size: 32rpx;
  }
  
  .invite-desc {
    font-size: 24rpx;
  }
}

/* === 申请加入朋友圈样式 === */

.apply-section {
  margin: 30rpx 40rpx 20rpx;
}

/* 申请卡片 - 采用与main页面一致的卡片设计 */
.apply-card, .applied-card, .private-card {
  position: relative;
  background-color: #ffffff;
  border-radius: 10rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
}

.apply-header, .applied-header, .private-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  z-index: 1;
  position: relative;
}

.apply-icon, .applied-icon, .private-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.apply-info, .applied-info, .private-info {
  flex: 1;
}

.apply-title, .applied-title, .private-title {
  display: block;
  font-size: 28rpx;
  font-weight: 400;
  color: #000000;
  margin-bottom: 8rpx;
}

.apply-desc, .applied-desc, .private-desc {
  display: block;
  font-size: 24rpx;
  color: #808080;
  line-height: 1.4;
}

/* 申请按钮 - 采用main页面的按钮设计 */
.apply-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: 500;
  background-color: #1A73E8;
  color: #ffffff;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  z-index: 1;
  position: relative;
}

.apply-btn::after {
  border: none;
}

.apply-btn.disabled {
  opacity: 0.7;
}

/* 不同状态的卡片样式调整 */
.apply-card .apply-icon {
  color: #1A73E8;
}

.applied-card {
  background-color: #ffffff;
}

.applied-icon {
  color: #ff9800;
}

.private-card {
  background-color: #ffffff;
}

.private-icon {
  color: #9e9e9e;
}

/* 浏览提示 */
.browse-tip {
  text-align: center;
  padding: 20rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #999999;
  font-style: italic;
}

/* 响应式适配 */
@media (max-width: 400px) {
  .header {
    padding: 30rpx 30rpx 15rpx 30rpx;
    margin-top: 40rpx;
  }
  
  .back-icon {
    font-size: 45rpx;
  }
  
  .title-text {
    font-size: 36rpx;
  }
  
  .page-subtitle {
    font-size: 28rpx;
  }
  
  .action-icon {
    font-size: 28rpx;
  }
  
  .friend-circle-info-card {
    margin: 45rpx 30rpx;
    padding: 30rpx;
  }
  
  .member-count {
    font-size: 26rpx;
  }
  
  .circle-status {
    font-size: 22rpx;
  }
  
  .setting-btn {
    font-size: 26rpx;
  }
  
  .member-avatar {
    width: 50rpx;
    height: 50rpx;
    border: 3rpx solid #ffffff;
  }
  
  .add-member-btn {
    width: 50rpx;
    height: 50rpx;
  }
  
  .add-icon {
    font-size: 28rpx;
  }
  
  .apply-section {
    margin: 25rpx 30rpx 15rpx;
  }
  
  .apply-card, .applied-card, .private-card {
    padding: 30rpx;
  }
  
  .apply-icon, .applied-icon, .private-icon {
    font-size: 36rpx;
    margin-right: 20rpx;
  }
  
  .apply-title, .applied-title, .private-title {
    font-size: 26rpx;
  }
  
  .apply-desc, .applied-desc, .private-desc {
    font-size: 22rpx;
  }
  
  .apply-btn {
    height: 70rpx;
    font-size: 26rpx;
  }
  
  .main-publish-btn {
    font-size: 28rpx;
    padding: 25rpx;
  }
  
  .posts-container {
    padding-bottom: 180rpx;
  }
}