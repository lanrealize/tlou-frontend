
/* 基础样式 */
page {
  background-color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
  margin: 0; /* 确保page没有默认margin */
  padding: 0; /* 确保page没有默认padding */
  width: 100vw; /* 确保page占满屏幕宽度 */
  box-sizing: border-box;
}

view, text, image {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* 页面容器 */
.page-container {
  position: relative;
  width: 100vw; /* 确保占满屏幕宽度 */
  height: 100vh;
  background-color: #ffffff;
  overflow: hidden; /* 防止页面滚动 */
  padding: 0; /* 确保没有padding限制 */
  margin: 0; /* 确保没有margin */
}

/* 状态栏占位 - 已集成到自定义导航栏中 */

/* 🔧 移除了加载状态样式，现在在main page处理预加载 */
