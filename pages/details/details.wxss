/* pages/details/details.wxss */

/* 基础样式 */
page {
  background-color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
}

view, text, image {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* 页面容器 */
.page-container {
  position: relative;
  width: 100%;
  height: 100vh;
  background-color: #ffffff;
  overflow: hidden; /* 防止页面滚动 */
}

/* 状态栏占位 - 已集成到自定义导航栏中 */

/* 🔧 移除了加载状态样式，现在在main page处理预加载 */
/* .loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: calc(100vh - var(--navigation-height, 88px));
  font-size: 28rpx;
  color: #666666;
} */

/* 朋友圈页面主容器 */
.moment-page {
  background-color: #ffffff;
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding-top: 20px; /* 默认导航栏高度，会被动态设置覆盖 */
  overflow: visible; /* 允许阴影显示 */
}

/* scroll-view样式 */
.moment-scroll-view {
  width: 100%;
  -ms-overflow-style: none !important;  /* IE and Edge */
  scrollbar-width: none !important;  /* Firefox */
  overflow: -moz-scrollbars-none !important;
}

/* 彻底隐藏滚动条 - 所有可能的选择器 */
.moment-scroll-view::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
  background: transparent !important;
  opacity: 0 !important;
}

.moment-scroll-view ::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
}

/* 针对 scroll-view 内部的滚动元素 */
scroll-view::-webkit-scrollbar,
::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
  opacity: 0 !important;
}

/* 自定义导航栏样式已移至custom-navigation组件 */

/* 朋友圈信息卡片 */
.friend-circle-info-card {
  position: relative;
  background: #ffffff;
}

/* 固定顶部的卡片容器 */
.card-content-fixed {
  position: relative;
  width: 100vw;
  margin-left: calc(-50vw + 50%);
  background: linear-gradient(to bottom, 
    #ffffff 0%, 
    #ffffff 80%, 
    rgba(255, 255, 255, 0.85) 95%,
    rgba(255, 255, 255, 0.3) 100%
  );
  z-index: 10;
  border-radius: 0 0 32rpx 32rpx; /* 下面两个圆角，上面直角 */
  box-shadow: 0px 2px 6px -2px rgba(0, 0, 0, 0.06); /* 更轻的阴影，淡化分隔感 */
  overflow: hidden;
  transition: all 0.2s ease;
}

.card-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 80rpx;
  padding-left: 50rpx;
  padding-right: 35rpx;
  box-sizing: border-box;
  padding-bottom: 25rpx;
}

/* 左侧内容区域：文字 + 头像按钮 */
.left-content {
  display: flex;
  align-items: center;
  gap: 25rpx;
  flex: 1;
  min-width: 0;
}

.circle-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  width: fit-content;
  flex-shrink: 0;
  min-width: 0;
}

.member-count {
  font-size: 28rpx;
  font-weight: 400;
  color: #000000;
  line-height: 1.2;
  white-space: nowrap;
  width: fit-content;
}

.circle-status {
  font-size: 20rpx;
  line-height: 1.3;
  white-space: normal; /* 允许换行 */
  width: fit-content;
  word-break: break-all; /* 长单词可以断行 */
  color: #808080;
}

.avatars-section {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.avatar-group {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.member-avatar {
  width: 55rpx;
  height: 55rpx;
  border-radius: 50%;
  border: none;
  flex-shrink: 0;
}

.member-count-badge {
  width: 55rpx;
  height: 55rpx;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);
}

.member-count-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  z-index: 1;
}

.member-count-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 2;
}

.count-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1;
  text-align: center;
  position: relative;
  z-index: 3;
}

.add-member-btn {
  width: 55rpx;
  height: 55rpx;
  border-radius: 50%;
  background-color: #F0F5FF;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  line-height: normal;
  font-size: inherit;
  flex-shrink: 0;
}

.add-member-btn::after {
  border: none;
}

.add-member-hover {
  background-color: #e8f4fd;
  transform: scale(1.05);
}

.add-icon {
  width: 56rpx;
  height: 56rpx;
  filter: brightness(0) saturate(100%) invert(42%) sepia(55%) saturate(3611%) hue-rotate(205deg) brightness(96%) contrast(94%);
  opacity: 1;
}

.setting-btn-wrapper {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
}

.setting-btn {
  color: #1A73E8;
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 400;
}

.setting-count {
  color: #FA5151;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
  margin-left: 2rpx;
}

/* ===== 帖子列表区域 ===== */
.posts-container {
  padding-top: 50rpx; /* 缩小间距，让内容更紧凑自然 */
  padding-bottom: 180rpx; /* 为底部统一组件留出空间 */
  position: relative;
}

/* 添加顶部渐变过渡，与卡片底部渐变呼应 */
.posts-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(to bottom, 
    rgba(255, 255, 255, 1) 0%, 
    transparent 100%
  );
  pointer-events: none; /* 不影响内容点击 */
  z-index: 1;
}

.empty-content {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999999;
}

.empty-title {
  font-size: 32rpx;
  margin-bottom: 20rpx;
  color: #666666;
}

.empty-subtitle {
  font-size: 28rpx;
  line-height: 1.5;
}

.load-more {
  text-align: center;
  padding: 0rpx 40rpx 40rpx 40rpx;
}

.load-more-text {
  font-size: 26rpx;
  color: #999999;
}

/* 没有更多提示 - 与list页面保持一致 */
.no-more-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 50rpx 0;
  gap: 20rpx;
}

.no-more-line {
  flex: 1;
  height: 1rpx;
  background-color: #f0f0f0;
  max-width: 100rpx;
}

.no-more-text {
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
}

/* ===== 发布按钮 - 已移至circle-status-action组件 ===== */

/* ===== 评论输入框模态框 ===== */
.comment-input-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.comment-input-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

/* 评论输入框容器 */
.tlou-comment-input-no-anim {
  width: 100%;
  background-color: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
  z-index: 1001;
  
  /* 简洁的淡入动画 */
  animation: simpleFadeIn 0.2s ease-out;
  
  box-shadow: 0px -4px 12px rgba(0, 0, 0, 0.1);
}

/* 简洁的淡入动画 */
@keyframes simpleFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.comment-input-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx 15rpx;
}

.comment-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.cancel-btn {
  font-size: 28rpx;
  color: #1A73E8;  /* 和发送按钮一样的蓝色，始终enable */
  padding: 10rpx;
}

.comment-input-content {
  padding: 0rpx 30rpx 40rpx 30rpx;
  /* 增加底部内边距，确保不被键盘遮挡 */
}

.comment-textarea {
  flex: 1;
  height: 120rpx;  /* 固定两行高度 */
  min-height: 120rpx;
  max-height: 120rpx;
  padding: 22rpx 15rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 36rpx;
  background-color: #ffffff;
  box-sizing: border-box;
  margin-right: 15rpx;
  vertical-align: top;  /* 改为顶部对齐 */
  word-wrap: break-word;
}

.input-row {
  display: flex;
  align-items: center;  /* 垂直居中对齐 */
}

.send-btn {
  /* 使用 admin-btn 样式 */
  color: #1A73E8;
  font-size: 28rpx;  /* 和取消按钮字号一致 */
  line-height: 1.2;
  font-weight: 400;
  padding: 10rpx;  /* 和取消按钮padding一致 */
  flex-shrink: 0;
  /* 去掉椭圆形背景 */
  background-color: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
  /* 靠右对齐，垂直居中 */
}

.send-btn::after {
  border: none;
}



/* === 邀请功能样式 - 已移至circle-status-action组件 === */

/* === 申请加入朋友圈样式 - 已移至circle-status-action组件 === */

/* 响应式适配 */
@media (max-width: 400px) {
  .nav-back-btn {
    left: 40rpx;
    width: 28px;
    height: 28px;
  }
  
  .back-icon {
    width: 24px;
    height: 24px;
  }
  
  .nav-title .title-text {
    font-size: 16px;
  }
  
  .friend-circle-info-card {
    margin: 45rpx 30rpx 25rpx 30rpx;
    padding: 30rpx;
  }
  
  .circle-info {
    gap: 6rpx;
    width: fit-content;
    max-width: 400rpx; /* 设置最大宽度避免过长 */
  }
  
  .avatars-section {
    gap: 20rpx;
    margin: 0 16rpx;
  }
  
  .avatar-group {
    gap: 16rpx;
  }
  
  .add-icon {
    width: 40rpx;
    height: 40rpx;
  }
  
  .setting-btn {
    font-size: 28rpx;
  }
  
  .posts-container {
    padding-bottom: 170rpx;
  }
}

/* ===== 添加新分享部分样式 - 已移至circle-status-action组件 ===== */

/* 朋友圈不存在提示overlay */
.circle-not-found-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 10000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* 彩色光球背景层 */
.overlay-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  background: #000000;
  overflow: hidden;
}

/* 彩色光球 - 粉色 */
.overlay-bg::before {
  content: '';
  position: absolute;
  width: 600rpx;
  height: 600rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 105, 180, 0.6) 0%, rgba(255, 182, 193, 0.3) 50%, transparent 100%);
  top: -100rpx;
  left: -150rpx;
  animation: float1 8s linear infinite alternate;
}

/* 彩色光球 - 蓝色 */
.overlay-bg::after {
  content: '';
  position: absolute;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(64, 156, 255, 0.5) 0%, rgba(135, 206, 250, 0.25) 50%, transparent 100%);
  top: 40%;
  right: -100rpx;
  animation: float2 10s linear infinite alternate;
}

/* 额外的彩色光球 */
.color-orb {
  position: absolute;
  border-radius: 50%;
}

/* 紫色光球 */
.orb-purple {
  width: 450rpx;
  height: 450rpx;
  background: radial-gradient(circle, rgba(147, 51, 234, 0.5) 0%, rgba(192, 132, 252, 0.25) 50%, transparent 100%);
  bottom: -50rpx;
  left: 10%;
  animation: float3 12s linear infinite alternate;
}

/* 橙色光球 */
.orb-orange {
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(251, 146, 60, 0.5) 0%, rgba(253, 186, 116, 0.3) 50%, transparent 100%);
  top: 20%;
  right: 5%;
  animation: float4 9s linear infinite alternate;
}

/* 毛玻璃遮罩层 */
.overlay-bg-glass {
  position: absolute;
  width: 100%;
  height: 100%;
  backdrop-filter: blur(80rpx) saturate(150%);
  -webkit-backdrop-filter: blur(80rpx) saturate(150%);
  background: rgba(0, 0, 0, 0.4);
}

.overlay-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.overlay-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 20rpx;
  text-align: center;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}

.overlay-subtitle {
  font-size: 28rpx;
  color: #e0e0e0;
  text-align: center;
  margin-bottom: 60rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}

.overlay-hint {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
}

/* 漂浮动画 - 光球1（粉色）- 纯横向右移 */
@keyframes float1 {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(400rpx);
  }
}

/* 漂浮动画 - 光球2（蓝色）- 纯横向左移 */
@keyframes float2 {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-400rpx);
  }
}

/* 漂浮动画 - 光球3（紫色）- 纯纵向上移 */
@keyframes float3 {
  0% {
    transform: translateY(0);
  }
  100% {
    transform: translateY(-400rpx);
  }
}

/* 漂浮动画 - 光球4（橙色）- 纯纵向下移 */
@keyframes float4 {
  0% {
    transform: translateY(0);
  }
  100% {
    transform: translateY(400rpx);
  }
}