<!--pages/details/details.wxml-->
<view class="page-container">
  <!-- 自定义导航栏 -->
  <custom-navigation title="两个人的朋友圈" bindnavigationReady="onNavigationReady"></custom-navigation>

  <!-- 🔧 移除了整体的"加载中..."显示，改为在main page预加载 -->

  <!-- 朋友圈详情页面 -->
  <view class="moment-page" style="padding-top: {{navigationData.totalNavigationHeight}}px;">
    
    <!-- 可滚动内容区域 -->
    <scroll-view 
      class="moment-scroll-view"
      scroll-y="{{true}}"
      style="height: calc(100vh - {{navigationData.totalNavigationHeight}}px - {{safeAreaBottom}}px);"
      bindscrolltolower="onReachBottom"
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
      enable-back-to-top="{{true}}"
      scroll-with-animation="{{true}}"
    >
      <!-- 朋友圈信息卡片 -->
      <view class="card-content">
        <!-- 左侧内容区域：文字 + 头像按钮 -->
        <view class="left-content">
          <!-- 左侧用户信息 -->
          <view class="circle-info">
            <view class="member-count">{{circle.memberCount || 1}} 名用户在内</view>
            <view class="circle-status">点击设置按钮可移除用户</view>
          </view>
          
          <!-- 中间头像和添加按钮 -->
          <view class="avatars-section">
            <!-- 用户头像组（包含头像和添加按钮） -->
            <view class="avatar-group">
              <!-- 显示实际成员头像（最多显示2个） -->
              <image class="member-avatar" wx:for="{{circle.members || []}}" wx:for-item="member" wx:key="_id" wx:if="{{index < 2}}" src="{{member.avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
              
              <!-- 如果没有任何成员，显示一个默认头像作为占位 -->
              <image class="member-avatar" wx:if="{{!circle.members || circle.members.length === 0}}" src="/images/default_avatar.png" mode="aspectFill"></image>
              
              <!-- 如果成员超过2个，显示剩余成员数量 -->
              <view class="member-count-badge" wx:if="{{circle.members && circle.members.length > 2}}">
                <image class="member-count-bg" src="{{circle.members[2].avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
                <view class="member-count-overlay"></view>
                <text class="count-text">{{circle.members.length - 2}}+</text>
              </view>
              
              <!-- 添加按钮 -->
              <button class="add-member-btn" open-type="share" wx:if="{{isCircleOwner}}" hover-class="add-member-hover">
                <image class="add-icon" src="/assets/icons/add.svg" mode="aspectFit"></image>
              </button>
            </view>
          </view>
        </view>
        
        <!-- 右侧设置按钮 -->
        <view class="setting-btn theme-color" bindtap="openSettings">设置</view>
      </view>

      <!-- 申请加入朋友圈区域 -->
      <view class="apply-section" wx:if="{{!isMember}}">
        <!-- 显示申请按钮（公开朋友圈且未申请） -->
        <view class="apply-card card-shadow" wx:if="{{showApplyButton}}">
          <view class="apply-header">
            <text class="apply-icon">🔓</text>
            <view class="apply-info">
              <text class="apply-title">公开朋友圈</text>
              <text class="apply-desc">你可以申请加入这个朋友圈</text>
            </view>
          </view>
          <button class="apply-btn theme-btn {{isApplying ? 'disabled' : ''}}" 
                  bindtap="applyToJoin" 
                  disabled="{{isApplying}}">
            {{isApplying ? '申请中...' : '申请加入'}}
          </button>
        </view>

        <!-- 已申请状态 -->
        <view class="applied-card card-shadow" wx:elif="{{hasApplied}}">
          <view class="applied-header">
            <text class="applied-icon">⏳</text>
            <view class="applied-info">
              <text class="applied-title">申请已提交</text>
              <text class="applied-desc">等待朋友圈主人审核中</text>
            </view>
          </view>
        </view>

        <!-- 私密朋友圈（无法申请） -->
        <view class="private-card card-shadow" wx:elif="{{circle.isPublic === false}}">
          <view class="private-header">
            <text class="private-icon">🔒</text>
            <view class="private-info">
              <text class="private-title">私密朋友圈</text>
              <text class="private-desc">仅限受邀用户查看</text>
            </view>
          </view>
        </view>

        <!-- 浏览模式提示 -->
        <view class="browse-tip" wx:if="{{!currentUser._id}}">
          <text class="tip-text">登录后可申请加入公开朋友圈</text>
        </view>
      </view>

      <!-- 时间轴帖子列表区域 -->
      <view class="timeline-container">
        <!-- 空状态 -->
        <view class="empty-content" wx:if="{{posts.length === 0 && !loading}}">
          <view class="empty-icon">📝</view>
          <view class="empty-title">这里还没有任何动态</view>
          <view class="empty-subtitle">快来发布第一条动态，开始记录美好时光吧！</view>
        </view>

        <!-- 时间轴帖子列表 - Grid布局 -->
        <view class="timeline-posts" wx:else>
          <!-- 帖子列表 -->
          <view 
            class="timeline-item" 
            wx:for="{{posts}}" 
            wx:key="_id"
            wx:for-index="index"
          >
            <!-- 左：时间点容器和时间线 -->
            <view class="time-dot-container">
              <view class="time-dot"></view>
              <!-- 时间线空间容器 -->
              <view class="timeline-space-container">
                <view class="timeline-line"></view>
              </view>
            </view>
            
            <!-- 右：帖子内容卡片 -->
            <view class="post-card">
              <!-- 左右布局：左侧头像，右侧两行内容 -->
              <view class="post-main-layout">
                <!-- 左侧：用户头像（跨两行） -->
                <image 
                  class="user-avatar-large" 
                  src="{{item.author.avatar || '/images/default_avatar.png'}}" 
                  mode="aspectFill"
                  bindtap="onTapAvatar"
                  data-user="{{item.author}}"
                  data-post="{{item}}"
                ></image>
                
                <!-- 右侧两行内容 -->
                <view class="right-content">
                  <!-- 第一行：昵称 + · + 时间标签 + 三点按钮 -->
                  <view class="post-time-header">
                    <!-- 用户昵称 -->
                    <text class="username-inline" 
                          bindtap="onTapAvatar"
                          data-user="{{item.author}}"
                          data-post="{{item}}">{{item.author.username || item.author.name || '未知用户'}}</text>
                    
                    <!-- 分隔符 -->
                    <text class="separator">·</text>
                    
                    <!-- 时间标签 -->
                    <text class="post-time">{{item.formattedTime || '刚刚'}}</text>
                    
                    <!-- 三点操作按钮 -->
                    <view class="actions-menu-btn" 
                          bindtap="toggleActionsMenu"
                          data-post-id="{{item._id}}">
                      <image class="menu-dots-icon" src="/assets/icons/more.svg" mode="aspectFit"></image>
                      
                      <!-- 下拉式操作菜单 -->
                      <view class="dropdown-menu {{activeMenuPostId === item._id ? 'show' : 'hide'}}">
                        <view class="dropdown-item" 
                              catchtap="onPostLike" 
                              data-post="{{item}}">
                          <image class="dropdown-icon" src="/assets/icons/like.svg" mode="aspectFit"></image>
                          <text class="dropdown-text">{{item.isLiked ? '取消点赞' : '点赞'}}</text>
                        </view>
                        <view class="dropdown-item" 
                              catchtap="onPostComment" 
                              data-post="{{item}}">
                          <image class="dropdown-icon comment-icon" src="/assets/icons/camera.svg" mode="aspectFit"></image>
                          <text class="dropdown-text">评论</text>
                        </view>
                        <view class="dropdown-item delete-item" 
                              wx:if="{{item.author._id === currentUser._id}}" 
                              catchtap="onPostDelete" 
                              data-post="{{item}}">
                          <image class="dropdown-icon" src="/assets/icons/delete.svg" mode="aspectFit"></image>
                          <text class="dropdown-text">删除</text>
                        </view>
                      </view>
                      
                      <!-- 遮罩层 - 点击其他地方隐藏下拉菜单 -->
                      <view class="dropdown-mask {{activeMenuPostId === item._id ? 'show' : 'hide'}}" catchtap="hideActionsMenu"></view>
                    </view>
                  </view>
                  
                  <!-- 第二行：分享的文字内容 -->
                  <view class="post-text-content" wx:if="{{item.content}}">
                    <text>{{item.content}}</text>
                  </view>
                </view>
              </view>
              
            <!-- post-item 只处理图片和评论 -->
            <post-item
              post="{{item}}"
              current-user="{{currentUser}}"
              bind:like="onPostLike"
              bind:comment="onPostComment"
              bind:replyComment="onPostReplyComment"
              bind:deletePost="onPostDelete"
              bind:deleteComment="onCommentDelete"
              bind:previewImage="onPreviewImage"
              bind:tapAvatar="onTapAvatar"
            ></post-item>
            </view>
          </view>

          <!-- 加载更多提示 - 4区域Grid布局 -->
          <view class="timeline-item timeline-load-more" wx:if="{{hasMore && posts.length > 0}}">
            <view class="time-dot-container">
              <view class="load-more-dot loading-dot"></view>
            </view>
            <text class="load-more-text">上拉加载更多</text>
            <view class="timeline-space-container">
              <view class="timeline-line"></view>
            </view>
            <view></view>
          </view>

          <!-- 没有更多数据提示 - 4区域Grid布局 -->
          <view class="timeline-item timeline-no-more" wx:if="{{!hasMore && posts.length > 0}}">
            <view class="time-dot-container">
              <view class="no-more-dot"></view>
            </view>
            <text class="no-more-text">— 所有回忆都在这里了 —</text>
            <view class="timeline-space-container">
              <!-- 结束状态不需要线条 -->
            </view>
            <view></view>
          </view>
        </view>
      </view>

      <!-- 添加新分享部分 - 替代原发布按钮 -->
      <view class="new-share-section" wx:if="{{!isInviteMode || !showJoinButton}}">
        <view class="share-container" bindtap="navigateToPublish">
          <!-- 左侧cards图片 -->
          <image class="cards-image" src="/assets/pics/cards.png" mode="aspectFit"></image>
          
          <!-- 中间分享内容 -->
          <view class="share-content">
            <!-- 第一行：添加 + newShare图片 -->
            <view class="share-first-line">
              <text class="share-title">添加</text>
              <image class="new-share-image" src="/assets/pics/newShare.png" mode="aspectFit"></image>
            </view>
            
            <!-- 第二行：提示文字 -->
            <view class="share-second-line">
              <text class="share-desc">点击右侧相机按钮添加新分享</text>
            </view>
          </view>
          
          <!-- 分隔线 -->
          <view class="share-divider"></view>
          
          <!-- 右侧相机图标（黑色） -->
          <view class="camera-btn">
            <image class="camera-icon" src="/assets/icons/camera.svg" mode="aspectFit"></image>
          </view>
        </view>
      </view>


      <!-- 邀请提示和接受按钮 -->
      <view class="invite-banner" wx:if="{{isInviteMode && showJoinButton}}">
        <view class="invite-info">
          <text class="invite-icon">🎉</text>
          <view class="invite-text">
            <text class="invite-title">你收到了邀请</text>
            <text class="invite-desc">点击下方按钮加入这个朋友圈</text>
          </view>
        </view>
        <button class="join-btn theme-btn {{isJoining ? 'disabled' : ''}}" 
                bindtap="acceptInvite" 
                disabled="{{isJoining}}">
          {{isJoining ? '加入中...' : '接受邀请'}}
        </button>
      </view>
    </scroll-view>

    <!-- 原发布按钮已被新分享组件替代 -->

    <!-- 评论输入框 -->
    <view class="comment-input-modal" wx:if="{{showCommentInput}}">
      <view class="comment-input-overlay" bindtap="cancelComment"></view>
      <view class="tlou-comment-input-no-anim">
        <view class="comment-input-header">
          <text class="comment-title">{{replyToUser ? '回复 ' + replyToUser.username : '发表评论'}}</text>
          <text class="cancel-btn" bindtap="cancelComment">取消</text>
        </view>
        <view class="comment-input-content">
          <view class="input-row">
            <textarea
              class="comment-textarea"
              placeholder="{{replyToUser ? '@' + replyToUser.username + ' ' : '说点什么...'}}"
              value="{{commentText}}"
              bindinput="onCommentInput"
              focus="{{focusInput}}"
              adjust-position="{{true}}"
              hold-keyboard="{{true}}"
              show-confirm-bar="{{false}}"
              maxlength="500"
              cursor-spacing="25"
              disable-default-padding="{{true}}"
              auto-height="{{false}}"
            ></textarea>
            <button class="send-btn theme-btn-small" bindtap="sendComment">发送</button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>