<!--pages/details/details.wxml-->
<view class="page-container">
  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{safeAreaInfo.statusBarHeight}}px;"></view>
  
  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 朋友圈详情页面 -->
  <view class="moment-page" wx:else>
    <!-- 头部区域 -->
    <view class="header">
      <view class="back-btn" bindtap="navigateBack">
        <text class="back-icon">‹</text>
      </view>
      
      <!-- 标题组 -->
      <view class="title-group">
        <view class="page-subtitle">朋友圈详情</view>
        <view class="title-text">两个人的朋友圈</view>
      </view>
      
      <!-- 操作按钮组 -->
      <view class="action-buttons">
        <view class="action-btn" bindtap="showMoreOptions">
          <text class="action-icon">...</text>
        </view>
        <view class="action-btn timer-btn">
          <text class="action-icon">⏰</text>
        </view>
      </view>
    </view>

    <!-- 朋友圈信息卡片 -->
    <view class="friend-circle-info-card">
      <view class="card-bg"></view>
      <view class="card-header">
        <view class="circle-info">
          <view class="member-count">有 {{circle.memberCount || 1}} 名用户在内</view>
          <view class="circle-status">朋友圈活跃中</view>
        </view>
        <view class="setting-btn theme-color" bindtap="openSettings">设置</view>
      </view>
      
      <!-- 用户头像组 -->
      <view class="member-avatars">
        <view class="avatar-group">
          <image class="member-avatar" wx:for="{{circle.members || []}}" wx:for-item="member" wx:key="_id" wx:if="{{index < 5}}" src="{{member.avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
          <!-- 如果没有成员信息，显示默认头像 -->
          <image class="member-avatar" wx:if="{{!circle.members || circle.members.length === 0}}" src="/images/default_avatar.png" mode="aspectFill"></image>
        </view>
        <button class="add-member-btn" open-type="share" wx:if="{{isCircleOwner}}" hover-class="add-member-hover">
          <text class="add-icon">+</text>
        </button>
        <view class="add-member-btn disabled" wx:else>
          <text class="add-icon">+</text>
        </view>
      </view>
    </view>

    <!-- 申请加入朋友圈区域 -->
    <view class="apply-section" wx:if="{{!isMember}}">
      <!-- 显示申请按钮（公开朋友圈且未申请） -->
      <view class="apply-card card-shadow" wx:if="{{showApplyButton}}">
        <view class="apply-header">
          <text class="apply-icon">🔓</text>
          <view class="apply-info">
            <text class="apply-title">公开朋友圈</text>
            <text class="apply-desc">你可以申请加入这个朋友圈</text>
          </view>
        </view>
        <button class="apply-btn theme-btn {{isApplying ? 'disabled' : ''}}" 
                bindtap="applyToJoin" 
                disabled="{{isApplying}}">
          {{isApplying ? '申请中...' : '申请加入'}}
        </button>
      </view>

      <!-- 已申请状态 -->
      <view class="applied-card card-shadow" wx:elif="{{hasApplied}}">
        <view class="applied-header">
          <text class="applied-icon">⏳</text>
          <view class="applied-info">
            <text class="applied-title">申请已提交</text>
            <text class="applied-desc">等待朋友圈主人审核中</text>
          </view>
        </view>
      </view>

      <!-- 私密朋友圈（无法申请） -->
      <view class="private-card card-shadow" wx:elif="{{circle.isPublic === false}}">
        <view class="private-header">
          <text class="private-icon">🔒</text>
          <view class="private-info">
            <text class="private-title">私密朋友圈</text>
            <text class="private-desc">仅限受邀用户查看</text>
          </view>
        </view>
      </view>

      <!-- 浏览模式提示 -->
      <view class="browse-tip" wx:if="{{!currentUser._id}}">
        <text class="tip-text">登录后可申请加入公开朋友圈</text>
      </view>
    </view>

    <!-- 帖子列表区域 -->
    <view class="posts-container">
      <!-- 空状态 -->
      <view class="empty-content" wx:if="{{posts.length === 0 && !loading}}">
        <view class="empty-title">朋友圈内容为空</view>
        <view class="empty-subtitle">还没有人发布动态，快来发布第一条吧！</view>
      </view>

      <!-- 帖子列表 -->
      <view class="posts-list" wx:else>
        <post-item
          wx:for="{{posts}}"
          wx:key="_id"
          post="{{item}}"
          current-user="{{currentUser}}"
          show-actions="{{true}}"
          bind:like="onPostLike"
          bind:comment="onPostComment"
          bind:replyComment="onPostReplyComment"
          bind:deletePost="onPostDelete"
          bind:deleteComment="onCommentDelete"
          bind:previewImage="onPreviewImage"
          bind:tapAvatar="onTapAvatar"
          bind:longPress="onPostLongPress"
        ></post-item>

        <!-- 加载更多提示 -->
        <view class="load-more" wx:if="{{hasMore && posts.length > 0}}">
          <text class="load-more-text">上拉加载更多</text>
        </view>

        <!-- 没有更多数据提示 -->
        <view class="no-more" wx:if="{{!hasMore && posts.length > 0}}">
          <text class="no-more-text">没有更多动态了</text>
        </view>
      </view>
    </view>

    <!-- 邀请提示和接受按钮 -->
    <view class="invite-banner" wx:if="{{isInviteMode && showJoinButton}}">
      <view class="invite-info">
        <text class="invite-icon">🎉</text>
        <view class="invite-text">
          <text class="invite-title">你收到了邀请</text>
          <text class="invite-desc">点击下方按钮加入这个朋友圈</text>
        </view>
      </view>
      <button class="join-btn theme-btn {{isJoining ? 'disabled' : ''}}" 
              bindtap="acceptInvite" 
              disabled="{{isJoining}}">
        {{isJoining ? '加入中...' : '接受邀请'}}
      </button>
    </view>

    <!-- 发布按钮 -->
    <view class="publish-button-container" wx:if="{{!isInviteMode || !showJoinButton}}">
      <button class="main-publish-btn theme-btn" bindtap="navigateToPublish">
        发布新动态
      </button>
    </view>

    <!-- 评论输入框 -->
    <view class="comment-input-modal" wx:if="{{showCommentInput}}">
      <view class="comment-input-overlay" bindtap="cancelComment"></view>
      <view class="comment-input-container card-shadow">
        <view class="comment-input-header">
          <text class="comment-title">{{replyToUser ? '回复 ' + replyToUser.username : '发表评论'}}</text>
          <text class="cancel-btn" bindtap="cancelComment">取消</text>
        </view>
        <view class="comment-input-content">
          <textarea
            class="comment-textarea"
            placeholder="{{replyToUser ? '@' + replyToUser.username + ' ' : '说点什么...'}}"
            value="{{commentText}}"
            bindinput="onCommentInput"
            auto-focus="{{focusInput}}"
            adjust-position="{{true}}"
            hold-keyboard="{{true}}"
            show-confirm-bar="{{false}}"
            auto-height
            maxlength="500"
            cursor-spacing="20"
          ></textarea>
          <view class="comment-input-footer">
            <text class="char-count">{{commentText.length}}/500</text>
            <button class="send-btn theme-btn-small" bindtap="sendComment">发送</button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>