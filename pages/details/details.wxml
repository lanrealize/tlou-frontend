<!--pages/details/details.wxml-->
<view class="container">
  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{safeAreaInfo.statusBarHeight}}px;"></view>
  
  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 朋友圈详情页面 -->
  <view class="moment-page" wx:else>
    <!-- 顶部导航栏 -->
    <view class="nav-header card-shadow">
      <view class="nav-left">
        <view class="back-btn" bindtap="navigateBack">
          <text class="back-icon">‹</text>
        </view>
        <text class="nav-title">两个人的朋友圈</text>
      </view>
      <view class="nav-right">
        <view class="more-btn" bindtap="showMoreOptions">
          <text class="more-icon">...</text>
        </view>
        <view class="timer-btn">
          <text class="timer-icon">⏰</text>
        </view>
      </view>
    </view>

    <!-- 用户信息区域 -->
    <view class="user-section card-shadow">
      <view class="user-count-row">
        <text class="user-count">{{circle.memberCount || 1}} 名用户在内</text>
        <view class="setting-btn theme-btn-small" bindtap="openSettings">
          <text>设置</text>
        </view>
      </view>
      <view class="user-row">
        <view class="user-avatar-container" wx:for="{{circle.members || []}}" wx:for-item="member" wx:key="_id" wx:if="{{index < 5}}">
          <image class="user-avatar" src="{{member.avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
        </view>
        <!-- 如果没有成员信息，显示默认头像 -->
        <view class="user-avatar-container" wx:if="{{!circle.members || circle.members.length === 0}}">
          <image class="user-avatar" src="/images/default_avatar.png" mode="aspectFill"></image>
        </view>
        <view class="add-user-btn" bindtap="addUser">
          <text class="add-icon">+</text>
        </view>
      </view>
    </view>

    <!-- 帖子列表区域 -->
    <view class="posts-container">
      <!-- 空状态 -->
      <view class="empty-content" wx:if="{{posts.length === 0 && !loading}}">
        <view class="empty-title">朋友圈内容为空</view>
        <view class="empty-subtitle">还没有人发布动态，快来发布第一条吧！</view>
      </view>

      <!-- 帖子列表 -->
      <view class="posts-list" wx:else>
        <post-item
          wx:for="{{posts}}"
          wx:key="_id"
          post="{{item}}"
          current-user="{{currentUser}}"
          show-actions="{{true}}"
          bind:like="onPostLike"
          bind:comment="onPostComment"
          bind:replyComment="onPostReplyComment"
          bind:deletePost="onPostDelete"
          bind:deleteComment="onCommentDelete"
          bind:previewImage="onPreviewImage"
          bind:tapAvatar="onTapAvatar"
          bind:longPress="onPostLongPress"
        ></post-item>

        <!-- 加载更多提示 -->
        <view class="load-more" wx:if="{{hasMore && posts.length > 0}}">
          <text class="load-more-text">上拉加载更多</text>
        </view>

        <!-- 没有更多数据提示 -->
        <view class="no-more" wx:if="{{!hasMore && posts.length > 0}}">
          <text class="no-more-text">没有更多动态了</text>
        </view>
      </view>
    </view>

    <!-- 发布按钮 -->
    <view class="publish-button-container">
      <button class="main-publish-btn theme-btn" bindtap="navigateToPublish">
        发布新动态
      </button>
    </view>

    <!-- 评论输入框 -->
    <view class="comment-input-modal" wx:if="{{showCommentInput}}">
      <view class="comment-input-overlay" bindtap="cancelComment"></view>
      <view class="comment-input-container card-shadow">
        <view class="comment-input-header">
          <text class="comment-title">{{replyToUser ? '回复 ' + replyToUser.username : '发表评论'}}</text>
          <text class="cancel-btn" bindtap="cancelComment">取消</text>
        </view>
        <view class="comment-input-content">
          <textarea
            class="comment-textarea"
            placeholder="{{replyToUser ? '@' + replyToUser.username + ' ' : '说点什么...'}}"
            value="{{commentText}}"
            bindinput="onCommentInput"
            auto-focus="{{focusInput}}"
            adjust-position="{{true}}"
            hold-keyboard="{{true}}"
            show-confirm-bar="{{false}}"
            auto-height
            maxlength="500"
            cursor-spacing="20"
          ></textarea>
          <view class="comment-input-footer">
            <text class="char-count">{{commentText.length}}/500</text>
            <button class="send-btn theme-btn-small" bindtap="sendComment">发送</button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>