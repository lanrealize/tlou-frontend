<!--pages/details/details.wxml-->
<view class="page-container">
  <!-- 自定义导航栏 -->
  <custom-navigation title="两个人的朋友圈" bindnavigationReady="onNavigationReady"></custom-navigation>

  <!-- 朋友圈详情页面 -->
  <view class="moment-page" style="padding-top: {{navigationData.totalNavigationHeight}}px;">
    
    <!-- 朋友圈信息卡片 -->
    <view class="circle-info-card card-shadow">
      <view class="card-header">
        <view class="card-title">朋友圈详情</view>
        <view class="setting-btn theme-color" bindtap="openSettings">设置</view>
      </view>
      
      <view class="card-body">
        <view class="member-stats">
          <view class="member-info-row">
            <view class="member-text-info">
              <view class="member-count-text">{{circle.memberCount || 1}} 名成员</view>
              <view class="member-status-text">点击设置按钮可管理用户</view>
            </view>
            
            <view class="avatar-gallery">
              <!-- 显示实际成员头像（最多显示3个） -->
              <image class="member-avatar-card" wx:for="{{circle.members || []}}" wx:for-item="member" wx:key="_id" wx:if="{{index < 3}}" src="{{member.avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
              
              <!-- 如果没有任何成员，显示一个默认头像作为占位 -->
              <image class="member-avatar-card" wx:if="{{!circle.members || circle.members.length === 0}}" src="/images/default_avatar.png" mode="aspectFill"></image>
              
              <!-- 如果成员超过3个，显示剩余成员数量 -->
              <view class="member-more-badge" wx:if="{{circle.members && circle.members.length > 3}}">
                <image class="member-more-bg" src="{{circle.members[3].avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
                <view class="member-more-overlay"></view>
                <text class="more-count-text">+{{circle.members.length - 3}}</text>
              </view>
              
              <!-- 添加成员按钮 -->
              <button class="add-member-card-btn" open-type="share" wx:if="{{isCircleOwner}}" hover-class="add-member-hover">
                <image class="add-member-icon" src="/assets/icons/add.svg" mode="aspectFit"></image>
              </button>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 内容区域 -->
    <view class="content-area">
      <!-- 申请加入朋友圈区域 -->
      <view class="apply-section" wx:if="{{!isMember}}">
        <!-- 显示申请按钮（公开朋友圈且未申请） -->
        <view class="apply-card card-shadow" wx:if="{{showApplyButton}}">
          <view class="apply-header">
            <text class="apply-icon">🔓</text>
            <view class="apply-info">
              <text class="apply-title">公开朋友圈</text>
              <text class="apply-desc">你可以申请加入这个朋友圈</text>
            </view>
          </view>
          <button class="apply-btn theme-btn {{isApplying ? 'disabled' : ''}}" 
                  bindtap="applyToJoin" 
                  disabled="{{isApplying}}">
            {{isApplying ? '申请中...' : '申请加入'}}
          </button>
        </view>

        <!-- 已申请状态 -->
        <view class="applied-card card-shadow" wx:elif="{{hasApplied}}">
          <view class="applied-header">
            <text class="applied-icon">⏳</text>
            <view class="applied-info">
              <text class="applied-title">申请已提交</text>
              <text class="applied-desc">等待朋友圈主人审核中</text>
            </view>
          </view>
        </view>

        <!-- 私密朋友圈（无法申请） -->
        <view class="private-card card-shadow" wx:elif="{{circle.isPublic === false}}">
          <view class="private-header">
            <text class="private-icon">🔒</text>
            <view class="private-info">
              <text class="private-title">私密朋友圈</text>
              <text class="private-desc">仅限受邀用户查看</text>
            </view>
          </view>
        </view>

        <!-- 浏览模式提示 -->
        <view class="browse-tip" wx:if="{{!currentUser._id}}">
          <text class="tip-text">登录后可申请加入公开朋友圈</text>
        </view>
      </view>

      <!-- 帖子列表区域 -->
      <view class="posts-section">
        <!-- 空状态卡片 -->
        <view class="empty-state-card card-shadow" wx:if="{{posts.length === 0 && !loading}}">
          <view class="empty-icon">📝</view>
          <view class="empty-title">暂无动态内容</view>
          <view class="empty-subtitle">还没有人发布动态，快来发布第一条吧！</view>
        </view>

        <!-- 滑动卡片组件 -->
        <card-swipe 
          wx:else
          id="cardSwipeComponent"
          cards="{{posts}}" 
          removed-cards="{{removedCards}}" 
          show-cards="{{3}}" 
          slide-thershold="{{60}}" 
          transition="{{true}}" 
          scale-ratio="{{0.05}}" 
          circling="{{true}}" 
          up-height="{{40}}" 
          rotate-deg="{{15}}" 
          slide-duration="{{200}}"
          bind:cardSwipe="onCardSwipe"
          bind:cardReverseSwipe="onCardReverseSwipe"
          bind:noPreviousCard="onNoPreviousCard"
          bind:like="onPostLike"
          bind:comment="onPostComment"
          bind:previewImage="onPreviewImage"
          bind:tapAvatar="onTapAvatar"
          bind:more="onPostMore"
        ></card-swipe>

        <!-- 临时返回按钮 -->
        <view class="temp-back-button" wx:if="{{canGoBack}}" bindtap="goToPreviousCard">
          <text class="back-icon">←</text>
          <text class="back-text">上一张</text>
        </view>

        <!-- 水平时间地图导航 - 替代原有的导航指示器 -->
        <timeline-map 
          wx:if="{{posts.length > 0}}"
          posts="{{posts}}"
          current-post-index="{{currentCardIndex}}"
          bind:timelinePostTap="onTimelinePostTap"
        ></timeline-map>

        <!-- 查看全部按钮 -->
        <view class="view-all-posts" wx:if="{{posts.length > 0}}" bindtap="viewAllPosts">
          <text class="view-all-text">查看全部 {{posts.length}} 条动态</text>
          <image class="view-all-icon" src="/assets/icons/right.svg" mode="aspectFit"></image>
        </view>
      </view>

      <!-- 发布新动态卡片 - 融入文档流 -->
      <view class="publish-card card-shadow" wx:if="{{showPublishButton}}" bindtap="navigateToPublish">
        <view class="publish-left">
          <view class="publish-icon-wrapper">
            <image class="publish-icon" src="/assets/icons/camera.svg" mode="aspectFit"></image>
          </view>
          <view class="publish-text-content">
            <view class="publish-title">发布新动态</view>
            <view class="publish-desc">分享你的精彩时刻</view>
          </view>
        </view>
        
        <view class="publish-right">
          <image class="publish-decoration" src="/assets/pics/cards.png" mode="aspectFit"></image>
        </view>
      </view>

      <!-- 邀请提示和接受按钮 -->
      <view class="invite-banner" wx:if="{{isInviteMode && showJoinButton}}">
        <view class="invite-info">
          <text class="invite-icon">🎉</text>
          <view class="invite-text">
            <text class="invite-title">你收到了邀请</text>
            <text class="invite-desc">点击下方按钮加入这个朋友圈</text>
          </view>
        </view>
        <button class="join-btn theme-btn {{isJoining ? 'disabled' : ''}}" 
                bindtap="acceptInvite" 
                disabled="{{isJoining}}">
          {{isJoining ? '加入中...' : '接受邀请'}}
        </button>
      </view>

      <!-- 底部安全区域占位 -->
      <view class="bottom-safe-area" style="height: {{safeAreaInfo.bottomSafeArea || 20}}rpx;"></view>
    </view>

    <!-- 评论输入框 -->
    <view class="comment-input-modal" wx:if="{{showCommentInput}}">
      <view class="comment-input-overlay" bindtap="cancelComment"></view>
      <view class="comment-input-container">
        <view class="comment-input-header">
          <text class="comment-title">{{replyToUser ? '回复 ' + replyToUser.username : '发表评论'}}</text>
          <text class="cancel-btn" bindtap="cancelComment">取消</text>
        </view>
        <view class="comment-input-content">
          <view class="input-row">
            <textarea
              class="comment-textarea"
              placeholder="{{replyToUser ? '@' + replyToUser.username + ' ' : '说点什么...'}}"
              value="{{commentText}}"
              bindinput="onCommentInput"
              focus="{{focusInput}}"
              adjust-position="{{true}}"
              hold-keyboard="{{true}}"
              show-confirm-bar="{{false}}"
              maxlength="500"
              cursor-spacing="25"
              disable-default-padding="{{true}}"
              auto-height="{{false}}"
            ></textarea>
            <button class="send-btn theme-btn-small" bindtap="sendComment">发送</button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>