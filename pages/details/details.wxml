<!--pages/details/details.wxml-->
<view class="page-container {{showShareAnimation && !shareAnimationCompleted ? 'page-black-bg' : ''}}">
  <!-- 🎬 分享入场动画容器（页面级） -->
  <view 
    class="share-animation-container {{shareAnimationClass}} {{showShareAnimation ? 'share-animation-container-appear' : ''}}"
    style="{{shareAnimationTransform}}"
    data-transition-active="{{transitionActive}}"
    wx:if="{{showShareAnimation}}"
  >
    <!-- 全屏图片（只在有URL时显示） -->
    <image 
      class="share-animation-image"
      src="{{shareAnimationImageUrl}}" 
      mode="aspectFill"
      bindload="onShareAnimationImageLoad"
      wx:if="{{shareAnimationImageUrl}}"
    ></image>
    
    <!-- 渐变遮罩层 -->
    <view class="share-gradient-overlay {{shareGradientClass}}"></view>
  </view>

  <!-- 🎬 白色遮罩层：用于控制内容淡入效果 -->
  <view 
    class="content-fade-mask {{shareAnimationCompleted ? 'fade-out' : ''}}"
    wx:if="{{showShareAnimation}}"
  ></view>

  <!-- 🚫 交互阻止层：在动画期间阻止所有用户交互 -->
  <view 
    class="animation-interaction-blocker"
    wx:if="{{showShareAnimation}}"
    catchtouchmove="preventTouchMove"
    catchtouchstart="preventTap"
    catchtouchend="preventTap"
    catchtap="preventTap"
    catchlongpress="preventTap"
  ></view>

  <!-- 自定义导航栏 -->
  <custom-navigation 
    title="{{circle.name || '两个人的朋友圈'}}" 
    customBack="{{true}}"
    backIconType="{{backIconType}}"
    bindnavigationReady="onNavigationReady" 
    bind:back="navigateBack"
  ></custom-navigation>

  <!-- 🔧 移除了整体的"加载中..."显示，改为在main page预加载 -->

  <!-- 朋友圈详情页面 -->
  <view 
    class="moment-page" 
    style="padding-top: {{navigationData.totalNavigationHeight}}px;"
  >
    
    <!-- 朋友圈信息卡片 - 固定在顶部 -->
    <view class="card-content-fixed">
      <view class="card-content">
        <!-- 左侧内容区域：文字 + 头像按钮 -->
        <view class="left-content">
          <!-- 左侧用户信息 -->
          <view class="circle-info">
            <!-- 四个条件都满足时显示简化文案 -->
            <block wx:if="{{circle.memberCount > 1 && pendingApplicationsCount > 0 && userStatus === 'member' && isCircleOwner}}">
              <view class="member-count">{{circle.memberCount || 1}} 名成员在内</view>
              <view class="circle-status">点击设置按钮移除用户</view>
            </block>
            
            <!-- 默认文案 -->
            <block wx:else>
              <view class="member-count">{{circle.memberCount || 1}} 名成员在内</view>
              <view class="circle-status">点击设置按钮可移除用户</view>
            </block>
          </view>
          
          <!-- 中间头像和添加按钮 -->
          <view class="avatars-section">
            <!-- 用户头像组（包含头像和添加按钮） -->
            <view class="avatar-group">
              <!-- 如果没有任何成员，显示一个默认头像作为占位 -->
              <image class="member-avatar" wx:if="{{!circle.members || circle.members.length === 0}}" src="/images/default_avatar.png" mode="aspectFill"></image>
              
              <!-- 成员≤2：显示实际数量的头像 -->
              <image class="member-avatar" wx:for="{{circle.members || []}}" wx:for-item="member" wx:key="_id" wx:if="{{circle.members.length <= 2 && index < 2}}" src="{{member.avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
              
              <!-- 成员>2：显示1个头像 + 1个+N徽章 -->
              <block wx:if="{{circle.members && circle.members.length > 2}}">
                <image class="member-avatar" src="{{circle.members[0].avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
                <view class="member-count-badge" bindtap="openSettings">
                  <image class="member-count-bg" src="{{circle.members[1].avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
                  <view class="member-count-overlay"></view>
                  <text class="count-text">{{circle.members.length - 1}}+</text>
                </view>
              </block>
              
              <!-- 添加按钮 -->
              <button class="add-member-btn" open-type="share" wx:if="{{isCircleOwner}}" hover-class="add-member-hover">
                <image class="add-icon" src="/assets/icons/add.svg" mode="aspectFit"></image>
              </button>
            </view>
          </view>
        </view>
        
        <!-- 右侧按钮组 -->
        <view id="action-btn-group" class="top-btn-group">
          <!-- 发布按钮 - 始终显示，非成员时 disabled -->
          <text id="publish-btn" class="top-btn {{(userStatus !== 'member' && isLoggedIn) ? 'disabled' : ''}}"
                bindtap="navigateToPublish">发布</text>
          
          <!-- 分隔符 - 始终显示 -->
          <text class="top-btn-divider">|</text>
          
          <!-- 设置按钮 - 所有人都能看到 -->
          <text id="setting-btn" class="top-btn" 
                bindtap="openSettings">设置</text>
          
          <!-- 待处理申请数角标 -->
          <text id="pending-count" class="setting-count"
                wx:if="{{isCircleOwner && pendingApplicationsCount > 0}}"
                bindtap="openSettings">({{pendingApplicationsCount}})</text>
        </view>
      </view>
    </view>

    <!-- 可滚动内容区域 -->
    <scroll-view 
      class="moment-scroll-view"
      scroll-y="{{true}}"
      scroll-top="{{scrollTopValue}}"
      scroll-with-animation="{{true}}"
      bindscrolltolower="onReachBottom"
      enhanced="{{false}}"
      show-scrollbar="{{false}}"
      enable-back-to-top="{{true}}"
    >

      <!-- 申请加入朋友圈区域 - 已移至底部统一组件 -->

      <!-- 帖子列表区域 - 时间轴布局 -->
      <view class="posts-container">
        <view class="posts-top-spacer"></view>
        <!-- 空状态 -->
        <view class="empty-content" wx:if="{{posts.length === 0 && !loading}}">
          <view class="empty-title">朋友圈内容为空</view>
          <view class="empty-subtitle">还没有人发布动态，快来发布第一条吧！</view>
        </view>

        <!-- 时间轴布局 -->
        <view class="timeline-posts" wx:else>
            <!-- 直接遍历所有帖子 -->
            <block wx:for="{{posts}}" wx:key="_id" wx:for-item="post">
              <post-item
                id="{{index === 0 ? 'first-post-item' : ''}}"
                post="{{post}}"
                current-user="{{currentUser}}"
                show-actions="{{true}}"
                is-first="{{index === 0}}"
                hide-image="{{index === 0 && hideFirstPostImage}}"
                timeline-mode="{{true}}"
                bind:like="onPostLike"
                bind:comment="onPostComment"
                bind:replyComment="onPostReplyComment"
                bind:deletePost="onPostDelete"
                bind:deleteComment="onCommentDelete"
                bind:previewImage="onPreviewImage"
                bind:tapAvatar="onTapAvatar"
              ></post-item>
            </block>

            <!-- 时间轴结束标记 -->
            <view class="timeline-end-marker" wx:if="{{!hasMore && posts.length > 0}}">
              <view class="timeline-line"></view>
              <view class="node-dot"></view>
              <view class="end-content">
                <text class="end-text">无更多内容</text>
              </view>
            </view>

            <!-- 加载更多提示 -->
            <view class="load-more" wx:if="{{hasMore && posts.length > 0}}">
              <text class="load-more-text">上拉加载更多</text>
            </view>

            <!-- 没有更多数据提示 -->
            <view class="no-more-tip" wx:if="{{false}}">
              <view class="no-more-line"></view>
              <text class="no-more-text">没有更多动态了</text>
              <view class="no-more-line"></view>
            </view>
          </view>
        </view>

      <!-- 底部占位：仅在有底部卡片时显示，高度与卡片相等 -->
      <view class="scroll-bottom-spacer" wx:if="{{userStatus !== 'member'}}"></view>

      <!-- 发布按钮和邀请提示 - 已移至底部统一组件 -->
    </scroll-view>

    <!-- 统一的底部状态操作组件 -->
    <circle-status-action
      status="{{userStatus}}"
      circle="{{circle}}"
      isApplying="{{isApplying}}"
      isJoining="{{isJoining}}"
      isOwner="{{isCircleOwner}}"
      hidden="{{userInfoPopupVisible}}"
      bind:publish="navigateToPublish"
      bind:apply="applyToJoin"
      bind:acceptInvite="acceptInvite"
    ></circle-status-action>

    <!-- 评论输入框 -->
    <view class="comment-input-modal" wx:if="{{showCommentInput}}">
      <view class="comment-input-overlay" bindtap="cancelComment"></view>
      <view class="tlou-comment-input-no-anim">
        <view class="comment-input-header">
          <text class="comment-title">{{replyToUser ? '回复 ' + replyToUser.username : '发表评论'}}</text>
          <text class="cancel-btn" bindtap="cancelComment">取消</text>
        </view>
        <view class="comment-input-content">
          <view class="input-row">
            <textarea
              id="commentTextarea"
              class="comment-textarea"
              placeholder="{{replyToUser ? '@' + replyToUser.username + ' ' : '说点什么...'}}"
              value="{{commentText}}"
              bindinput="onCommentInput"
              focus="{{focusInput}}"
              adjust-position="{{true}}"
              hold-keyboard="{{true}}"
              show-confirm-bar="{{false}}"
              maxlength="500"
              cursor-spacing="45"
              disable-default-padding="{{true}}"
              auto-height="{{false}}"
            ></textarea>
            <button id="sendCommentBtn" class="send-btn theme-btn-small" bindtap="sendComment">发送</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 用户信息弹出层 -->
  <user-info-popup
    id="userInfoPopup"
    visible="{{userInfoPopupVisible}}"
    rejectReason="{{userInfoPopupReason}}"
    pendingIntent="{{userInfoPopupIntent}}"
    circleId="{{userInfoPopupCircleId}}"
    bind:success="onUserInfoSuccess"
    bind:cancel="onUserInfoCancel"
    bind:close="onUserInfoClose"
  ></user-info-popup>

  <!-- 朋友圈不存在提示 -->
  <view class="circle-not-found-overlay" wx:if="{{circleNotFound}}" bindtap="goToMainPage">
    <!-- 背景光球层 -->
    <view class="overlay-bg">
      <!-- 额外的光球 - 紫色 -->
      <view class="color-orb orb-purple"></view>
      <!-- 额外的光球 - 橙色 -->
      <view class="color-orb orb-orange"></view>
    </view>
    <!-- 毛玻璃遮罩层 -->
    <view class="overlay-bg-glass"></view>
    <!-- 内容层 -->
    <view class="overlay-content">
      <view class="overlay-title">内容不存在</view>
      <view class="overlay-subtitle">可能已被删除</view>
      <view class="overlay-hint">点击任意位置返回首页</view>
    </view>
  </view>

</view>