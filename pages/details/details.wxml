<!--pages/details/details.wxml-->
<view class="page-container">
  <!-- 自定义导航栏 -->
  <custom-navigation title="两个人的朋友圈" customBack="{{true}}" bindnavigationReady="onNavigationReady" bind:back="navigateBack"></custom-navigation>

  <!-- 🔧 移除了整体的"加载中..."显示，改为在main page预加载 -->

  <!-- 朋友圈详情页面 -->
  <view class="moment-page" style="padding-top: {{navigationData.totalNavigationHeight}}px;">
    
    <!-- 朋友圈信息卡片 - 固定在顶部 -->
    <view class="card-content-fixed">
      <view class="card-content">
        <!-- 左侧内容区域：文字 + 头像按钮 -->
        <view class="left-content">
          <!-- 左侧用户信息 -->
          <view class="circle-info">
            <view class="member-count">{{circle.memberCount || 1}} 名用户在内</view>
            <view class="circle-status">点击设置按钮可移除用户</view>
          </view>
          
          <!-- 中间头像和添加按钮 -->
          <view class="avatars-section">
            <!-- 用户头像组（包含头像和添加按钮） -->
            <view class="avatar-group">
              <!-- 显示实际成员头像（最多显示2个） -->
              <image class="member-avatar" wx:for="{{circle.members || []}}" wx:for-item="member" wx:key="_id" wx:if="{{index < 2}}" src="{{member.avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
              
              <!-- 如果没有任何成员，显示一个默认头像作为占位 -->
              <image class="member-avatar" wx:if="{{!circle.members || circle.members.length === 0}}" src="/images/default_avatar.png" mode="aspectFill"></image>
              
              <!-- 如果成员超过2个，显示剩余成员数量 -->
              <view class="member-count-badge" wx:if="{{circle.members && circle.members.length > 2}}">
                <image class="member-count-bg" src="{{circle.members[2].avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
                <view class="member-count-overlay"></view>
                <text class="count-text">{{circle.members.length - 2}}+</text>
              </view>
              
              <!-- 添加按钮 -->
              <button class="add-member-btn" open-type="share" wx:if="{{isCircleOwner}}" hover-class="add-member-hover">
                <image class="add-icon" src="/assets/icons/add.svg" mode="aspectFit"></image>
              </button>
            </view>
          </view>
        </view>
        
        <!-- 右侧设置按钮 -->
        <view id="setting-btn-wrapper" class="setting-btn-wrapper" bindtap="openSettings">
          <text id="setting-btn" class="setting-btn theme-color">设置</text>
          <text id="pending-count" class="setting-count" wx:if="{{isCircleOwner && pendingApplicationsCount > 0}}">({{pendingApplicationsCount}})</text>
        </view>
      </view>
    </view>

    <!-- 可滚动内容区域 -->
    <scroll-view 
      class="moment-scroll-view"
      scroll-y="{{true}}"
      style="height: calc(100vh - {{navigationData.totalNavigationHeight}}px - 117rpx - 10rpx);"
      bindscrolltolower="onReachBottom"
      enhanced="{{false}}"
      show-scrollbar="{{false}}"
      enable-back-to-top="{{true}}"
      scroll-with-animation="{{false}}"
    >

      <!-- 申请加入朋友圈区域 - 已移至底部统一组件 -->

      <!-- 帖子列表区域 -->
      <view class="posts-container">
        <!-- 空状态 -->
        <view class="empty-content" wx:if="{{posts.length === 0 && !loading}}">
          <view class="empty-title">朋友圈内容为空</view>
          <view class="empty-subtitle">还没有人发布动态，快来发布第一条吧！</view>
        </view>

        <!-- 帖子列表 -->
        <view class="posts-list" wx:else>
          <post-item
            wx:for="{{posts}}"
            wx:key="_id"
            post="{{item}}"
            current-user="{{currentUser}}"
            show-actions="{{true}}"
            is-last="{{index === posts.length - 1}}"
            bind:like="onPostLike"
            bind:comment="onPostComment"
            bind:replyComment="onPostReplyComment"
            bind:deletePost="onPostDelete"
            bind:deleteComment="onCommentDelete"
            bind:previewImage="onPreviewImage"
            bind:tapAvatar="onTapAvatar"

          ></post-item>

          <!-- 加载更多提示 -->
          <view class="load-more" wx:if="{{hasMore && posts.length > 0}}">
            <text class="load-more-text">上拉加载更多</text>
          </view>

          <!-- 没有更多数据提示 -->
          <view class="no-more-tip" wx:if="{{!hasMore && posts.length > 0}}">
            <view class="no-more-line"></view>
            <text class="no-more-text">没有更多动态了</text>
            <view class="no-more-line"></view>
          </view>
        </view>
      </view>

      <!-- 发布按钮和邀请提示 - 已移至底部统一组件 -->
    </scroll-view>

    <!-- 统一的底部状态操作组件 -->
    <circle-status-action
      status="{{userStatus}}"
      circle="{{circle}}"
      isApplying="{{isApplying}}"
      isJoining="{{isJoining}}"
      isOwner="{{isCircleOwner}}"
      hidden="{{userInfoPopupVisible}}"
      bind:publish="navigateToPublish"
      bind:apply="applyToJoin"
      bind:acceptInvite="acceptInvite"
    ></circle-status-action>

    <!-- 评论输入框 -->
    <view class="comment-input-modal" wx:if="{{showCommentInput}}">
      <view class="comment-input-overlay" bindtap="cancelComment"></view>
      <view class="tlou-comment-input-no-anim">
        <view class="comment-input-header">
          <text class="comment-title">{{replyToUser ? '回复 ' + replyToUser.username : '发表评论'}}</text>
          <text class="cancel-btn" bindtap="cancelComment">取消</text>
        </view>
        <view class="comment-input-content">
          <view class="input-row">
            <textarea
              id="commentTextarea"
              class="comment-textarea"
              placeholder="{{replyToUser ? '@' + replyToUser.username + ' ' : '说点什么...'}}"
              value="{{commentText}}"
              bindinput="onCommentInput"
              focus="{{focusInput}}"
              adjust-position="{{true}}"
              hold-keyboard="{{true}}"
              show-confirm-bar="{{false}}"
              maxlength="500"
              cursor-spacing="45"
              disable-default-padding="{{true}}"
              auto-height="{{false}}"
            ></textarea>
            <button id="sendCommentBtn" class="send-btn theme-btn-small" bindtap="sendComment">发送</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 用户信息弹出层 -->
  <user-info-popup
    id="userInfoPopup"
    visible="{{userInfoPopupVisible}}"
    rejectReason="{{userInfoPopupReason}}"
    pendingIntent="{{userInfoPopupIntent}}"
    circleId="{{userInfoPopupCircleId}}"
    bind:success="onUserInfoSuccess"
    bind:cancel="onUserInfoCancel"
    bind:close="onUserInfoClose"
  ></user-info-popup>

</view>