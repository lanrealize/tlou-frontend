<!--pages/details/details.wxml-->
<view class="page-container {{showShareAnimation && !shareAnimationCompleted ? 'page-black-bg' : ''}}">
  <!-- 🎯 Details 内容容器：用 wx:if 控制显示 -->
  <view class="details-container {{onboardingExiting ? 'details-entering' : ''}}" wx:if="{{showOnboarding === false || onboardingExiting}}">
    <!-- 顶部导航栏 -->
    <top-nav-bar bind:homeclick="onHomeClick" bind:addclick="onAddClick" />
    
    <!-- 🎬 分享入场动画容器（页面级） -->
    <view 
      class="share-animation-container {{shareAnimationClass}} {{showShareAnimation ? 'share-animation-container-appear' : ''}}"
      style="{{shareAnimationTransform}}"
      data-transition-active="{{transitionActive}}"
      wx:if="{{showShareAnimation}}"
    >
      <!-- 全屏图片（只在有URL时显示） -->
      <image 
        class="share-animation-image"
        src="{{shareAnimationImageUrl}}" 
        mode="aspectFill"
        bindload="onShareAnimationImageLoad"
        wx:if="{{shareAnimationImageUrl}}"
      ></image>
      
      <!-- 渐变遮罩层 -->
      <view class="share-gradient-overlay {{shareGradientClass}}"></view>
    </view>

    <!-- 🎬 白色遮罩层：用于控制内容淡入效果 -->
    <view 
      class="content-fade-mask {{shareAnimationCompleted ? 'fade-out' : ''}}"
      wx:if="{{showShareAnimation}}"
    ></view>

    <!-- 🚫 交互阻止层：在动画期间阻止所有用户交互 -->
    <view 
      class="animation-interaction-blocker"
      wx:if="{{showShareAnimation}}"
      catchtouchmove="preventTouchMove"
      catchtouchstart="preventTap"
      catchtouchend="preventTap"
      catchtap="preventTap"
      catchlongpress="preventTap"
    ></view>

    <!-- 朋友圈详情页面 -->
    <view class="moment-page">
    
    <!-- 可滚动内容区域 -->
    <scroll-view
      class="moment-scroll-view"
      scroll-y="{{true}}"
      scroll-top="{{scrollTopValue}}"
      scroll-with-animation="{{true}}"
      bindscrolltolower="onReachBottom"
      bindscroll="onScroll"
      enhanced="{{false}}"
      show-scrollbar="{{false}}"
      enable-back-to-top="{{true}}"
    >

      <!-- 申请加入朋友圈区域 - 已移至底部统一组件 -->

      <!-- 帖子列表区域 - 时间轴布局 -->
      <view class="posts-container" style="padding-top: {{topSpacing}}px;">
        <!-- 空状态 -->
        <view class="empty-content" wx:if="{{posts.length === 0 && !loading}}">
          <view class="empty-title">朋友圈内容为空</view>
          <view class="empty-subtitle">还没有人发布动态，快来发布第一条吧！</view>
        </view>

        <!-- 时间轴布局 -->
        <view class="timeline-posts" wx:else>
            <!-- 直接遍历所有帖子 -->
            <block wx:for="{{posts}}" wx:key="_stableKey" wx:for-item="post">
              <post-item
                id="{{index === 0 ? 'first-post-item' : 'post-item-' + post._id}}"
                post="{{post}}"
                current-user="{{currentUser}}"
                show-actions="{{true}}"
                is-first="{{index === 0}}"
                hide-image="{{index === 0 && hideFirstPostImage}}"
                timeline-mode="{{true}}"
                local-image-path="{{post._tempImagePaths[0] || ''}}"
                bind:like="onPostLike"
                bind:comment="onPostComment"
                bind:replyComment="onPostReplyComment"
                bind:deletePost="onPostDelete"
                bind:deleteComment="onCommentDelete"
                bind:previewImage="onPreviewImage"
                bind:tapAvatar="onTapAvatar"
                bind:scrollToComment="onScrollToComment"
                bind:retryUpload="onPostRetryUpload"
                bind:removeFailedPost="onPostRemoveFailedPost"
              ></post-item>
            </block>

        </view>
      </view>

      <!-- 底部占位 -->
      <view class="scroll-bottom-spacer"></view>

    </scroll-view>

    <!-- 全屏 Loading Overlay -->
    <view class="unified-loading-overlay" wx:if="{{loading && posts.length === 0}}">
      <view class="loading-overlay-bg"></view>
      <view class="loading-overlay-content">
        <view class="loading-overlay-spinner">
          <view class="spinner-circle"></view>
        </view>
        <view class="loading-overlay-title">加载中</view>
        <view class="loading-overlay-subtitle">正在加载...</view>
      </view>
    </view>

    <!-- 评论输入框 -->
    <view class="comment-input-modal" wx:if="{{showCommentInput}}">
      <view class="comment-input-overlay" bindtap="cancelComment"></view>
      <view class="tlou-comment-input-no-anim">
        <view class="comment-input-header">
          <text class="comment-title">{{replyToUser ? '回复 ' + replyToUser.username : '发表评论'}}</text>
          <text class="cancel-btn" bindtap="cancelComment">取消</text>
        </view>
        <view class="comment-input-content">
          <view class="input-row">
            <textarea
              id="commentTextarea"
              class="comment-textarea"
              placeholder="{{replyToUser ? '@' + replyToUser.username + ' ' : '说点什么...'}}"
              value="{{commentText}}"
              bindinput="onCommentInput"
              focus="{{focusInput}}"
              adjust-position="{{true}}"
              hold-keyboard="{{true}}"
              show-confirm-bar="{{false}}"
              maxlength="500"
              cursor-spacing="45"
              disable-default-padding="{{true}}"
              auto-height="{{false}}"
            ></textarea>
            <button id="sendCommentBtn" class="send-btn theme-btn-small" bindtap="sendComment" wx:if="{{!isSendingComment}}">发送</button>
            <view class="send-btn-placeholder" wx:else>
              <view class="comment-sending-spinner"></view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 用户信息弹出层 -->
  <user-info-popup
    id="userInfoPopup"
    visible="{{userInfoPopupVisible}}"
    rejectReason="{{userInfoPopupReason}}"
    pendingIntent="{{userInfoPopupIntent}}"
    circleId="{{userInfoPopupCircleId}}"
    bind:success="onUserInfoSuccess"
    bind:cancel="onUserInfoCancel"
    bind:close="onUserInfoClose"
  ></user-info-popup>

  <!-- 朋友圈不存在提示 -->
  <view class="circle-not-found-overlay" wx:if="{{circleNotFound}}" bindtap="goToMainPage">
    <!-- 背景光球层 -->
    <view class="overlay-bg">
      <!-- 额外的光球 - 紫色 -->
      <view class="color-orb orb-purple"></view>
      <!-- 额外的光球 - 橙色 -->
      <view class="color-orb orb-orange"></view>
    </view>
    <!-- 毛玻璃遮罩层 -->
    <view class="overlay-bg-glass"></view>
    <!-- 内容层 -->
    <view class="overlay-content">
      <view class="overlay-title">内容不存在</view>
      <view class="overlay-subtitle">可能已被删除</view>
      <view class="overlay-hint">点击任意位置关闭</view>
    </view>
  </view>

  <!-- Home Panel -->
  <home-panel visible="{{showHomePanel}}" bind:close="onHomePanelClose" />

  <!-- Quota Panel -->
  <quota-panel visible="{{quotaPanelVisible}}" bind:close="onQuotaPanelClose" />
  </view>
  <!-- 🎯 Details 内容容器结束 -->

  <!-- 🎬 Onboarding 引导层（全屏覆盖，仅在 onboarding 模式下显示，且 publish-panel 未显示时） -->
  <onboarding-guide
    wx:if="{{showOnboarding === true && !showPublish}}"
    id="onboarding-guide"
    class="onboarding-layer {{onboardingExiting ? 'onboarding-exiting' : ''}}"
    final-frame-mode="{{onboardingFinalFrame}}"
    bind:takePhoto="onOnboardingTakePhoto"
  ></onboarding-guide>

</view>

<publish-panel
  id="publishPanel"
  circleId="{{circleId}}"
  show="{{showPublish}}"
  bind:close="onPublishClose"
  bind:needUserInfo="onPublishNeedUserInfo"
></publish-panel>