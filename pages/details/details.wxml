<!--pages/details/details.wxml-->
<view class="page-container">
  <!-- 自定义导航栏 -->
  <custom-navigation title="两个人的朋友圈" bindnavigationReady="onNavigationReady"></custom-navigation>

  <!-- 🔧 移除了整体的"加载中..."显示，改为在main page预加载 -->

  <!-- 朋友圈详情页面 -->
  <view class="moment-page" style="padding-top: {{navigationData.totalNavigationHeight}}px;">
    
    <!-- 朋友圈信息卡片 - 采用卡片化设计 -->
    <view class="circle-info-card card-shadow">
      <!-- 卡片头部：标题和设置按钮 -->
      <view class="card-header">
        <view class="card-title">朋友圈详情</view>
        <view class="setting-btn theme-color" bindtap="openSettings">设置</view>
      </view>
      
      <!-- 卡片内容：成员信息和头像组 -->
      <view class="card-body">
        <!-- 成员统计信息 -->
        <view class="member-stats">
          <view class="member-count-text">{{circle.memberCount || 1}} 名成员</view>
          <view class="member-status-text">点击设置按钮可管理用户</view>
        </view>
        
        <!-- 成员头像展示区域 -->
        <view class="members-display">
          <!-- 用户头像组 -->
          <view class="avatar-gallery">
            <!-- 显示实际成员头像（最多显示3个） -->
            <image class="member-avatar-card" wx:for="{{circle.members || []}}" wx:for-item="member" wx:key="_id" wx:if="{{index < 3}}" src="{{member.avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
            
            <!-- 如果没有任何成员，显示一个默认头像作为占位 -->
            <image class="member-avatar-card" wx:if="{{!circle.members || circle.members.length === 0}}" src="/images/default_avatar.png" mode="aspectFill"></image>
            
            <!-- 如果成员超过3个，显示剩余成员数量 -->
            <view class="member-more-badge" wx:if="{{circle.members && circle.members.length > 3}}">
              <image class="member-more-bg" src="{{circle.members[3].avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
              <view class="member-more-overlay"></view>
              <text class="more-count-text">+{{circle.members.length - 3}}</text>
            </view>
            
            <!-- 添加成员按钮 -->
            <button class="add-member-card-btn" open-type="share" wx:if="{{isCircleOwner}}" hover-class="add-member-hover">
              <image class="add-member-icon" src="/assets/icons/add.svg" mode="aspectFit"></image>
            </button>
          </view>
        </view>
      </view>
    </view>

    <!-- 可滚动内容区域 -->
    <scroll-view 
      class="moment-scroll-view"
      scroll-y="{{true}}"
      style="height: calc(100vh - {{navigationData.totalNavigationHeight}}px - {{safeAreaBottom}}px - 120rpx);"
      bindscrolltolower="onReachBottom"
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
      enable-back-to-top="{{true}}"
      scroll-with-animation="{{true}}"
    >

      <!-- 申请加入朋友圈区域 -->
      <view class="apply-section" wx:if="{{!isMember}}">
        <!-- 显示申请按钮（公开朋友圈且未申请） -->
        <view class="apply-card card-shadow" wx:if="{{showApplyButton}}">
          <view class="apply-header">
            <text class="apply-icon">🔓</text>
            <view class="apply-info">
              <text class="apply-title">公开朋友圈</text>
              <text class="apply-desc">你可以申请加入这个朋友圈</text>
            </view>
          </view>
          <button class="apply-btn theme-btn {{isApplying ? 'disabled' : ''}}" 
                  bindtap="applyToJoin" 
                  disabled="{{isApplying}}">
            {{isApplying ? '申请中...' : '申请加入'}}
          </button>
        </view>

        <!-- 已申请状态 -->
        <view class="applied-card card-shadow" wx:elif="{{hasApplied}}">
          <view class="applied-header">
            <text class="applied-icon">⏳</text>
            <view class="applied-info">
              <text class="applied-title">申请已提交</text>
              <text class="applied-desc">等待朋友圈主人审核中</text>
            </view>
          </view>
        </view>

        <!-- 私密朋友圈（无法申请） -->
        <view class="private-card card-shadow" wx:elif="{{circle.isPublic === false}}">
          <view class="private-header">
            <text class="private-icon">🔒</text>
            <view class="private-info">
              <text class="private-title">私密朋友圈</text>
              <text class="private-desc">仅限受邀用户查看</text>
            </view>
          </view>
        </view>

        <!-- 浏览模式提示 -->
        <view class="browse-tip" wx:if="{{!currentUser._id}}">
          <text class="tip-text">登录后可申请加入公开朋友圈</text>
        </view>
      </view>

      <!-- 帖子列表区域 - 卡片化设计 -->
      <view class="posts-section">
        <!-- 空状态卡片 -->
        <view class="empty-state-card card-shadow" wx:if="{{posts.length === 0 && !loading}}">
          <view class="empty-icon">📝</view>
          <view class="empty-title">暂无动态内容</view>
          <view class="empty-subtitle">还没有人发布动态，快来发布第一条吧！</view>
        </view>

        <!-- 滑动卡片容器 - 使用新的高性能组件 -->
        <view class="swipe-cards-section" wx:else>
          <swipe-cards
            posts="{{posts}}"
            removed-posts="{{removedPosts}}"
            transition="{{true}}"
            circling="{{false}}"
            rotate-deg="{{8}}"
            show-cards="{{3}}"
            slide-duration="{{200}}"
            slide-threshold="{{80}}"
            up-height="{{20}}"
            scale-ratio="{{0.03}}"
            current-user="{{currentUser}}"
            bind:postSwipe="onPostSwipe"
            bind:postLike="onPostLike"
            bind:postComment="onPostComment"
            bind:postDetail="onPostDetail"
          ></swipe-cards>
          
          <!-- 卡片导航指示器 -->
          <view class="cards-navigation" wx:if="{{posts.length > 1}}">
            <view class="nav-dots">
              <view 
                class="nav-dot {{index === currentCardIndex ? 'active' : ''}}" 
                wx:for="{{posts}}" 
                wx:key="_id"
                wx:if="{{index < 5}}"
                bindtap="onNavDotTap"
                data-index="{{index}}"
              ></view>
              <view class="nav-more" wx:if="{{posts.length > 5}}">+{{posts.length - 5}}</view>
            </view>
          </view>

          <!-- 查看全部按钮 -->
          <view class="view-all-posts" bindtap="onViewAllPosts">
            <text class="view-all-text">查看全部 {{posts.length}} 条动态</text>
            <image class="view-all-icon" src="/assets/icons/right.svg" mode="aspectFit"></image>
          </view>
        </view>
      </view>

      <!-- 发布新动态卡片 - 替代原发布按钮 -->
      <view class="publish-section" wx:if="{{!isInviteMode || !showJoinButton}}">
        <view class="publish-card card-shadow" bindtap="navigateToPublish">
          <!-- 卡片左侧：图标和文字 -->
          <view class="publish-left">
            <view class="publish-icon-wrapper">
              <image class="publish-icon" src="/assets/icons/camera.svg" mode="aspectFit"></image>
            </view>
            <view class="publish-text-content">
              <view class="publish-title">发布新动态</view>
              <view class="publish-desc">分享你的精彩时刻</view>
            </view>
          </view>
          
          <!-- 卡片右侧：装饰图片 -->
          <view class="publish-right">
            <image class="publish-decoration" src="/assets/pics/cards.png" mode="aspectFit"></image>
          </view>
        </view>
      </view>


      <!-- 邀请提示和接受按钮 -->
      <view class="invite-banner" wx:if="{{isInviteMode && showJoinButton}}">
        <view class="invite-info">
          <text class="invite-icon">🎉</text>
          <view class="invite-text">
            <text class="invite-title">你收到了邀请</text>
            <text class="invite-desc">点击下方按钮加入这个朋友圈</text>
          </view>
        </view>
        <button class="join-btn theme-btn {{isJoining ? 'disabled' : ''}}" 
                bindtap="acceptInvite" 
                disabled="{{isJoining}}">
          {{isJoining ? '加入中...' : '接受邀请'}}
        </button>
      </view>
    </scroll-view>

    <!-- 原发布按钮已被新分享组件替代 -->

    <!-- 卡片详情弹窗 -->
    <view class="card-detail-modal" wx:if="{{showCardDetail}}">
      <view class="card-detail-overlay" bindtap="closeCardDetail"></view>
      <view class="card-detail-container">
        <!-- 详情头部 -->
        <view class="detail-header">
          <view class="detail-title">帖子详情</view>
          <view class="close-detail-btn" bindtap="closeCardDetail">
            <image class="close-icon" src="/assets/icons/back.svg" mode="aspectFit"></image>
          </view>
        </view>

        <!-- 详情内容 -->
        <scroll-view class="detail-content" scroll-y="true">
          <!-- 帖子基本信息 -->
          <view class="detail-post-info" wx:if="{{currentDetailPost}}">
            <view class="detail-user-header">
              <image 
                class="detail-user-avatar" 
                src="{{currentDetailPost.author.avatar || '/images/default_avatar.png'}}" 
                mode="aspectFill"
              ></image>
              <view class="detail-user-info">
                <view class="detail-username">{{currentDetailPost.author.username || currentDetailPost.author.name || '未知用户'}}</view>
                <view class="detail-time">{{currentDetailPost.formattedTime || '刚刚'}}</view>
              </view>
            </view>

            <!-- 帖子内容 -->
            <view class="detail-post-content" wx:if="{{currentDetailPost.content}}">
              <text class="detail-text">{{currentDetailPost.content}}</text>
            </view>

            <!-- 帖子图片 -->
            <view class="detail-images" wx:if="{{currentDetailPost.images && currentDetailPost.images.length > 0}}">
              <image 
                class="detail-image" 
                wx:for="{{currentDetailPost.images}}" 
                wx:key="*this"
                src="{{item.url || item}}" 
                mode="aspectFill"
                bindtap="onPreviewImage"
                data-current="{{item.url || item}}"
                data-src="{{item.url || item}}"
              ></image>
            </view>
          </view>

          <!-- 点赞区域 -->
          <view class="detail-likes-section" wx:if="{{currentDetailPost && currentDetailPost.likes && currentDetailPost.likes.length > 0}}">
            <view class="detail-section-title">
              <image class="section-icon" src="/assets/icons/like.svg" mode="aspectFit"></image>
              <text class="section-title-text">{{currentDetailPost.likes.length}}人觉得很赞</text>
            </view>
            <view class="likes-list">
              <view 
                class="like-item" 
                wx:for="{{currentDetailPost.likedUsers || []}}" 
                wx:key="_id"
                bindtap="onTapLikedUser"
                data-user="{{item}}"
              >
                <image class="like-user-avatar" src="{{item.avatar || '/images/default_avatar.png'}}" mode="aspectFill"></image>
                <text class="like-username">{{item.username || item.name || '匿名用户'}}</text>
              </view>
            </view>
          </view>

          <!-- 评论区域 -->
          <view class="detail-comments-section" wx:if="{{currentDetailPost}}">
            <view class="detail-section-title">
              <image class="section-icon comment-section-icon" src="/assets/icons/camera.svg" mode="aspectFit"></image>
              <text class="section-title-text">评论 ({{(currentDetailPost.comments && currentDetailPost.comments.length) || 0}})</text>
            </view>
            
            <!-- 评论列表 -->
            <view class="comments-list" wx:if="{{currentDetailPost.comments && currentDetailPost.comments.length > 0}}">
              <view 
                class="detail-comment-item" 
                wx:for="{{currentDetailPost.comments}}" 
                wx:key="_id"
              >
                <image 
                  class="detail-comment-avatar" 
                  src="{{item.author.avatar || '/images/default_avatar.png'}}" 
                  mode="aspectFill"
                  bindtap="onTapCommentUser"
                  data-user="{{item.author}}"
                ></image>
                <view class="detail-comment-content">
                  <view class="detail-comment-header">
                    <text class="detail-comment-author">{{item.author.username || item.author.name || '匿名用户'}}</text>
                    <text class="detail-comment-time">{{item.formattedTime || '刚刚'}}</text>
                  </view>
                  <view class="detail-comment-text">
                    <text wx:if="{{item.replyTo}}" class="reply-target">@{{item.replyTo.username || item.replyTo.name || '未知用户'}} </text>
                    <text>{{item.content || '内容为空'}}</text>
                  </view>
                  <view class="detail-comment-actions">
                    <text 
                      class="detail-reply-btn"
                      bindtap="onReplyDetailComment"
                      data-user="{{item.author}}"
                      data-comment-id="{{item._id}}"
                    >回复</text>
                    <image 
                      class="detail-delete-comment-btn" 
                      wx:if="{{item.author && currentUser._id && currentUser._id === item.author._id}}"
                      bindtap="onDeleteDetailComment"
                      data-comment-id="{{item._id}}"
                      src="/assets/icons/delete.svg"
                      mode="aspectFit"
                    ></image>
                  </view>
                </view>
              </view>
            </view>

            <!-- 空评论状态 -->
            <view class="empty-comments" wx:else>
              <text class="empty-comments-text">还没有评论，快来抢沙发吧！</text>
            </view>
          </view>
        </scroll-view>

        <!-- 详情底部操作栏 -->
        <view class="detail-bottom-actions">
          <view class="detail-action-group">
            <view 
              class="detail-action-btn like-action {{currentDetailPost && currentDetailPost.isLiked ? 'liked' : ''}}" 
              bindtap="onDetailLike"
            >
              <image class="detail-action-icon" src="/assets/icons/like.svg" mode="aspectFit"></image>
              <text class="detail-action-text">{{currentDetailPost && currentDetailPost.isLiked ? '已赞' : '点赞'}}</text>
            </view>
            
            <view class="detail-action-btn comment-action" bindtap="onDetailComment">
              <image class="detail-action-icon comment-action-icon" src="/assets/icons/camera.svg" mode="aspectFit"></image>
              <text class="detail-action-text">评论</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 评论输入框 -->
    <view class="comment-input-modal" wx:if="{{showCommentInput}}">
      <view class="comment-input-overlay" bindtap="cancelComment"></view>
      <view class="tlou-comment-input-no-anim">
        <view class="comment-input-header">
          <text class="comment-title">{{replyToUser ? '回复 ' + replyToUser.username : '发表评论'}}</text>
          <text class="cancel-btn" bindtap="cancelComment">取消</text>
        </view>
        <view class="comment-input-content">
          <view class="input-row">
            <textarea
              class="comment-textarea"
              placeholder="{{replyToUser ? '@' + replyToUser.username + ' ' : '说点什么...'}}"
              value="{{commentText}}"
              bindinput="onCommentInput"
              focus="{{focusInput}}"
              adjust-position="{{true}}"
              hold-keyboard="{{true}}"
              show-confirm-bar="{{false}}"
              maxlength="500"
              cursor-spacing="25"
              disable-default-padding="{{true}}"
              auto-height="{{false}}"
            ></textarea>
            <button class="send-btn theme-btn-small" bindtap="sendComment">发送</button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>