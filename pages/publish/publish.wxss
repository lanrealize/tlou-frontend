/* pages/publish/publish.wxss */

.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx; /* 为底部按钮留出空间 */
}

/* 状态栏占位 */
.status-bar {
  background-color: #ffffff;
  width: 100%;
}

/* 自定义导航栏 */
.nav-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #ffffff;
  z-index: 100;
}

.nav-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.back-btn {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
  padding: 10rpx;
}

.back-icon {
  font-size: 40rpx;
  color: #333333;
  font-weight: bold;
}

.nav-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 600;
}

.nav-right {
  display: flex;
  align-items: center;
}

.clear-btn {
  padding: 12rpx 20rpx;
  background-color: #f0f0f0;
  border-radius: 20rpx;
}

.clear-text {
  font-size: 26rpx;
  color: #666666;
}

/* 朋友圈信息 */
.circle-info {
  margin: 20rpx;
  padding: 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
}

.circle-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.circle-label {
  font-size: 26rpx;
  color: #999999;
  margin-right: 12rpx;
}

.circle-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
}

.circle-meta {
  display: flex;
  align-items: center;
}

.meta-text {
  font-size: 24rpx;
  color: #999999;
}

.meta-divider {
  font-size: 24rpx;
  color: #cccccc;
  margin: 0 12rpx;
}

/* 发布内容区域 */
.publish-content {
  margin: 20rpx;
  padding: 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
}

/* 用户信息 */
.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-name {
  font-size: 32rpx;
  color: #333333;
  font-weight: 600;
}

/* 文本输入区域 */
.content-input-section {
  margin-bottom: 30rpx;
  position: relative;
}

.content-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 1.6;
  background-color: #fafafa;
}

.textarea-placeholder {
  color: #999999;
}

.char-count {
  position: absolute;
  bottom: 15rpx;
  right: 15rpx;
  font-size: 22rpx;
  color: #999999;
  background-color: rgba(255, 255, 255, 0.8);
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
}

/* 图片区域 */
.images-section {
  min-height: 60rpx;
}

/* 图片网格 */
.images-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.image-item {
  position: relative;
  width: calc((100% - 24rpx) / 3);
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.selected-image {
  width: 100%;
  height: 100%;
}

.delete-image-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: bold;
}

.add-image-btn {
  width: calc((100% - 24rpx) / 3);
  height: 200rpx;
  border: 2rpx dashed #cccccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #fafafa;
}

.add-icon {
  font-size: 48rpx;
  color: #999999;
  font-weight: 300;
}

/* 初始添加图片区域 */
.initial-add-images {
  padding: 60rpx 40rpx;
  border: 2rpx dashed #e8e8e8;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #fafafa;
}

.add-images-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.camera-icon {
  font-size: 48rpx;
  margin-bottom: 20rpx;
}

.add-images-text {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.add-images-desc {
  font-size: 24rpx;
  color: #999999;
}

/* 发布按钮区域 */
.publish-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx 40rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top: 1rpx solid #e8e8e8;
  z-index: 100;
}

.publish-btn {
  width: 100%;
  font-size: 32rpx;
  font-weight: 600;
  padding: 28rpx;
  border-radius: 30rpx;
  border: none;
}

.publish-btn::after {
  border: none;
}

.disabled-btn {
  background-color: #f0f0f0;
  color: #cccccc;
}

/* 响应式调整 */
@media (max-width: 400px) {
  .image-item,
  .add-image-btn {
    width: calc((100% - 12rpx) / 2);
  }
}