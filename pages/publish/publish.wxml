<!--pages/publish/publish.wxml-->
<view class="container">
  <!-- 自定义导航栏 - 双行充实设计 -->
  <view class="custom-navigation" style="height: {{navigationData.totalNavigationHeight || 88}}px;">
    <!-- 第一行：基础导航 -->
    <view class="navigation-content" style="height: {{navigationData.navigationBarHeight || 44}}px; margin-top: {{navigationData.statusBarHeight || 44}}px;">
      <!-- 左侧返回按钮 -->
      <view class="nav-back-btn" bindtap="goBack">
        <image class="back-icon" src="/assets/icons/back.svg" mode="aspectFit"></image>
      </view>
      
      <!-- 中间标题 -->
      <view class="nav-center">
        <text class="title-text">发布动态</text>
      </view>
    </view>
    
    <!-- 第二行：状态和操作栏 -->
    <view class="action-bar">
      <view class="action-left">
        <!-- 静态提示文字 -->
        <view class="static-hint">
          <text class="hint-text">请在本页面编辑分享</text>
        </view>
      </view>
      
      <view class="action-center">
        <!-- 违规提示 -->
        <view wx:if="{{showViolationAlert}}" class="violation-warning">
          <text class="warning-icon">⚠️</text>
          <text class="warning-text">{{violationDetails.violatedImages.length}}张违规</text>
        </view>
      </view>
      
      <view class="action-right">
        <!-- 发布按钮 -->
        <button 
          id="publishBtn"
          class="nav-publish-btn {{(content.length > 0 || tempImages.length > 0) && !showViolationAlert ? 'active' : 'disabled'}}"
          bindtap="publishPost"
          disabled="{{isPublishing || (content.length === 0 && tempImages.length === 0) || showViolationAlert}}"
          hover-class="nav-publish-hover"
        >
          {{isPublishing ? '发布中...' : (showViolationAlert ? '违规处理' : '发布')}}
        </button>
      </view>
    </view>
  </view>
  
  <!-- 内容区域 -->
  <view class="page-content" style="padding-top: {{(navigationData.totalNavigationHeight || 88) + 48}}px;">


  <!-- 文本输入区域 -->
  <view class="content-section">
    <view class="content-input-container">
      <textarea
        id="contentTextarea"
        class="content-textarea"
        placeholder="写点什么..."
        value="{{content}}"
        bindinput="onContentInput"
        auto-height
        maxlength="2000"
        placeholder-class="textarea-placeholder"
        show-confirm-bar="{{false}}"
        adjust-position="{{false}}"
      ></textarea>
      <view class="char-count" wx:if="{{content.length > 0}}">{{content.length}}/2000</view>
    </view>
  </view>

  <!-- 图片上传区域 -->
  <view class="images-section">
    <!-- 图片内容区域 -->
    
    <!-- 违规提示区域 -->
    <view class="violation-alert" wx:if="{{showViolationAlert}}">
      <view class="alert-header">
        <text class="alert-icon">⚠️</text>
        <text class="alert-title">图片内容违规</text>
      </view>
      <view class="alert-content">
        <text class="alert-desc">检测到{{violationDetails.violatedImages.length}}张图片违规，请移除红框标记的图片后重新发布</text>
        <text class="alert-timeout">剩余时间：{{remainingTimeText || (violationDetails.timeoutMinutes + '分钟')}}</text>
      </view>
      <view class="alert-actions">
        <view class="btn btn-secondary" bindtap="republishWithoutViolatedImages">
          <text>自动移除违规图片并发布</text>
        </view>
      </view>
    </view>

    <!-- 已选择的图片（支持违规状态） -->
    <view class="images-grid images-grid-{{tempImages.length}}" wx:if="{{tempImages.length > 0}}">
      <!-- 正常显示模式 -->
      <block wx:if="{{!showViolationAlert}}">
        <view 
          class="image-item"
          wx:for="{{tempImages}}" 
          wx:key="*this"
        >
          <image 
            class="selected-image" 
            src="{{item}}" 
            mode="aspectFill"
            bindtap="previewImage"
            data-index="{{index}}"
          ></image>
          <view 
            class="delete-image-btn" 
            bindtap="deleteImage" 
            data-index="{{index}}"
          >
            <image class="delete-icon" src="/assets/icons/delete.svg" mode="aspectFit"></image>
          </view>
        </view>
      </block>

      <!-- 违规检查模式 -->
      <block wx:if="{{showViolationAlert && tempImagesWithStatus}}">
        <view 
          class="image-item {{item.isViolated ? 'violated' : ''}}"
          wx:for="{{tempImagesWithStatus}}" 
          wx:key="originalIndex"
        >
          <image 
            class="selected-image" 
            src="{{item.path}}" 
            mode="aspectFill"
            bindtap="previewImage"
            data-index="{{index}}"
          ></image>
          
          <!-- 违规标记 -->
          <view class="violation-badge" wx:if="{{item.isViolated}}">
            <text class="violation-text">违规</text>
          </view>
          
          <!-- 删除按钮 -->
          <view 
            class="delete-image-btn {{item.isViolated ? 'delete-violated' : ''}}" 
            bindtap="{{item.isViolated ? 'deleteViolatedImage' : 'deleteImage'}}" 
            data-index="{{index}}"
          >
            <image class="delete-icon" src="/assets/icons/delete.svg" mode="aspectFit"></image>
          </view>
          
          <!-- 违规原因提示 -->
          <view class="violation-reason" wx:if="{{item.isViolated && item.violationReason}}">
            <text class="reason-text">{{item.violationReason}}</text>
          </view>
        </view>
      </block>
    </view>

    <!-- 添加图片按钮 - 独立放置在图片下方 -->
    <view 
      class="add-image-btn" 
      bindtap="chooseImages"
      wx:if="{{tempImages.length > 0 && tempImages.length < maxImages && !showViolationAlert}}"
    >
      <image class="add-icon-svg" src="/assets/icons/add.svg" mode="aspectFit"></image>
      <text class="add-text">添加图片</text>
    </view>

    <!-- 初始添加图片按钮 -->
    <view 
      id="addImagesBtn"
      class="add-images-btn-initial" 
      bindtap="chooseImages"
      wx:if="{{tempImages.length === 0}}"
    >
      <image class="add-icon-svg" src="/assets/icons/add.svg" mode="aspectFit"></image>
      <text class="add-text">添加图片</text>
    </view>
  </view>

  <!-- 发布提示 -->
  <view class="publish-tips" wx:if="{{showViolationAlert}}">
    <view class="violation-footer-tip">
      <text class="tip-text">⚠️ 请先处理违规图片才能发布</text>
    </view>
  </view>
  
  </view> <!-- 内容区域结束 -->
</view>