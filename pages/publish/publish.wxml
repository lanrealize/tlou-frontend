<!--pages/publish/publish.wxml-->
<view class="container">
  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{safeAreaInfo.statusBarHeight}}px;"></view>
  
  <!-- 自定义导航栏 -->
  <view class="nav-header card-shadow">
    <view class="nav-left">
      <view class="back-btn" bindtap="navigateBack">
        <text class="back-icon">‹</text>
      </view>
      <text class="nav-title">发布动态</text>
    </view>
    <view class="nav-right">
      <view class="clear-btn" bindtap="clearContent" wx:if="{{content.length > 0 || tempImages.length > 0}}">
        <text class="clear-text">清空</text>
      </view>
    </view>
  </view>

  <!-- 朋友圈信息 -->
  <view class="circle-info card-shadow" wx:if="{{circle}}">
    <view class="circle-header">
      <text class="circle-label">发布到</text>
      <text class="circle-name">{{circle.name}}</text>
    </view>
    <view class="circle-meta">
      <text class="meta-text">{{circle.members ? circle.members.length + 1 : 1}}人可见</text>
      <text class="meta-divider">·</text>
      <text class="meta-text">{{circle.isPublic ? '公开' : '私密'}}朋友圈</text>
    </view>
  </view>

  <!-- 发布内容区域 -->
  <view class="publish-content">
    <!-- 用户信息 -->
    <view class="user-info">
      <image 
        class="user-avatar" 
        src="{{userInfo.avatar || '/images/default_avatar.png'}}" 
        mode="aspectFill"
      ></image>
      <view class="user-name">{{userInfo.username || '我'}}</view>
    </view>

    <!-- 文本输入区域 -->
    <view class="content-input-section">
      <textarea
        class="content-textarea"
        placeholder="分享新鲜事..."
        value="{{content}}"
        bindinput="onContentInput"
        auto-height
        maxlength="2000"
        placeholder-class="textarea-placeholder"
      ></textarea>
      <view class="char-count">{{content.length}}/2000</view>
    </view>

    <!-- 图片区域 -->
    <view class="images-section">
      <!-- 已选择的图片 -->
      <view class="images-grid" wx:if="{{tempImages.length > 0}}">
        <view 
          class="image-item"
          wx:for="{{tempImages}}" 
          wx:key="*this"
        >
          <image 
            class="selected-image" 
            src="{{item}}" 
            mode="aspectFill"
            bindtap="previewImage"
            data-index="{{index}}"
          ></image>
          <view 
            class="delete-image-btn" 
            bindtap="deleteImage" 
            data-index="{{index}}"
          >
            <text class="delete-icon">×</text>
          </view>
        </view>
        
        <!-- 添加图片按钮 -->
        <view 
          class="add-image-btn" 
          bindtap="chooseImages"
          wx:if="{{tempImages.length < maxImages}}"
        >
          <text class="add-icon">+</text>
        </view>
      </view>

      <!-- 初始添加图片按钮 -->
      <view 
        class="initial-add-images" 
        bindtap="chooseImages"
        wx:if="{{tempImages.length === 0}}"
      >
        <view class="add-images-content">
          <text class="camera-icon">📷</text>
          <text class="add-images-text">添加图片</text>
          <text class="add-images-desc">最多可选择{{maxImages}}张图片</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 发布按钮 -->
  <view class="publish-footer">
    <button 
      class="publish-btn {{content.length > 0 || tempImages.length > 0 ? 'theme-btn' : 'disabled-btn'}}"
      bindtap="publishPost"
      disabled="{{isPublishing || (content.length === 0 && tempImages.length === 0)}}"
    >
      {{isPublishing ? '发布中...' : '发布'}}
    </button>
  </view>
</view>