/* pages/userInfo/userInfo.wxss */

.container {
  padding: 0 30rpx 40rpx;
  min-height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
}

/* 状态栏占位 */
.status-bar {
  background: #f5f5f5;
  width: 100%;
}

/* 头部区域 */
.header {
  text-align: center;
  margin: 40rpx 0 60rpx;
  padding: 0 30rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #666;
}

/* 操作原因提示 */
.reject-reason {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 30rpx;
  border-radius: 16rpx;
  margin: 0 30rpx 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.reason-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
  font-weight: 500;
}

/* 表单区域 */
.form-section {
  background: white;
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

/* 头像选择区域 */
.avatar-section {
  text-align: center;
  margin-bottom: 50rpx;
}

.label {
  display: block;
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 30rpx;
}

.avatar-help {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
  line-height: 1.4;
  text-align: center;
}

.avatar-wrapper {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto;
  border-radius: 50%;
  overflow: hidden;
  border: none;
  padding: 0;
  background: none;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-tip {
  font-size: 24rpx;
}

/* 昵称填写区域 */
.nickname-section {
  margin-bottom: 20rpx;
}

.input-wrapper {
  position: relative;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 2rpx solid #e9ecef;
  transition: border-color 0.3s ease;
}

.input-wrapper:focus-within {
  border-color: #667eea;
  background: white;
}

.nickname-input {
  width: 100%;
  padding: 25rpx 20rpx;
  font-size: 32rpx;
  color: #333;
  background: transparent;
  border: none;
  outline: none;
}

.input-placeholder {
  color: #999;
}

.char-count {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #999;
}

/* 按钮区域 */
.button-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.primary-btn {
  background: #007aff;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 25rpx 0;
  font-size: 32rpx;
  font-weight: 600;
}

.primary-btn:disabled {
  opacity: 0.5;
}

.secondary-btn {
  background: white;
  color: #007aff;
  border: 2rpx solid #007aff;
  border-radius: 12rpx;
  padding: 25rpx 0;
  font-size: 30rpx;
}

.secondary-btn:disabled {
  opacity: 0.5;
}

/* 提示信息区域 */
.tip-section {
  margin-top: auto;
  padding-top: 40rpx;
}

.tip-text {
  display: block;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  margin-bottom: 10rpx;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .container {
    padding: 30rpx 20rpx;
  }
  
  .form-section {
    padding: 40rpx 30rpx;
  }
  
  .avatar-wrapper {
    width: 180rpx;
    height: 180rpx;
  }
}