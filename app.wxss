/**app.wxss**/
/* 全局样式 */

/* 通用样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  box-sizing: border-box;
}

/* 页面内容容器 */
.page-container {
  padding: 20rpx;
  min-height: 100vh;
}

/* 卡片样式 */
.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 用户头像 */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
}

.avatar-large {
  width: 120rpx;
  height: 120rpx;
}

.avatar-small {
  width: 60rpx;
  height: 60rpx;
}

/* 用户信息 */
.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-left: 20rpx;
}

.user-time {
  font-size: 24rpx;
  color: #999;
  margin-left: 20rpx;
}

/* 内容文本 */
.content-text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
  margin-bottom: 20rpx;
}

/* 图片网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.image-item:nth-child(3n) {
  margin-right: 0;
}

.image-item image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 操作按钮 */
.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-left {
  display: flex;
  align-items: center;
}

.like-btn, .comment-btn {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 30rpx;
}

.like-btn.liked {
  color: #ff4757;
}

.like-btn .icon, .comment-btn .icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

/* 评论列表 */
.comment-list {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.comment-item {
  display: flex;
  margin-bottom: 20rpx;
}

.comment-content {
  flex: 1;
  margin-left: 20rpx;
}

.comment-user {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.comment-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  margin-top: 8rpx;
}

.comment-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 底部输入框 */
.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.1);
  z-index: 1000;
}

.input-container {
  display: flex;
  align-items: center;
}

.comment-input {
  flex: 1;
  background-color: #f5f5f5;
  border-radius: 25rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.send-btn {
  background-color: #07c160;
  color: #fff;
  border-radius: 25rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  border: none;
}

.send-btn.disabled {
  background-color: #ccc;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}

.loading-more {
  padding: 20rpx 0;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 按钮样式 */
.btn {
  display: inline-block;
  padding: 20rpx 40rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
}

.btn-primary {
  background-color: #07c160;
}

.btn-secondary {
  background-color: #fff;
  color: #333;
  border: 1rpx solid #e0e0e0;
}

.btn-danger {
  background-color: #ff4757;
}

.btn-small {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
}

.btn:active {
  opacity: 0.8;
}

/* 列表项 */
.list-item {
  background-color: #fff;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-content {
  flex: 1;
  margin-left: 20rpx;
}

.list-item-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.list-item-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.list-item-arrow {
  color: #ccc;
  font-size: 32rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 30rpx 0;
}

/* 工具栏 */
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  background-color: #f0f0f0;
  color: #666;
  font-size: 24rpx;
  border-radius: 16rpx;
  margin-right: 10rpx;
}

.tag-primary {
  background-color: #e6f7ff;
  color: #1890ff;
}

.tag-success {
  background-color: #f6ffed;
  color: #52c41a;
}

/* 响应式 */
@media (max-width: 750rpx) {
  .image-item {
    width: 180rpx;
    height: 180rpx;
  }
}