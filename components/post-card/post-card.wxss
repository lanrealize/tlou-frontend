/* 拍立得风格卡片 */
.post-card.polaroid-card {
  width: 100%;
  height: 720rpx; /* 调整为拍立得比例 */
  position: relative;
  transform: translateZ(0);
  will-change: transform, opacity;
  backface-visibility: hidden;
  cursor: pointer;
  /* 移除原有阴影，使用新的拍立得阴影 */
}

/* 拍立得主框架 */
.polaroid-frame {
  width: 100%;
  height: 100%;
  background: #ffffff;
  border-radius: 8rpx; /* 拍立得特有的小圆角 */
  padding: 20rpx 20rpx 80rpx 20rpx; /* 底部留更多空间 */
  box-sizing: border-box;
  position: relative;
  /* 添加细微的纹理效果 */
  background-image: 
    radial-gradient(circle at 20% 50%, rgba(120, 119, 198, 0.02) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(255, 119, 198, 0.02) 0%, transparent 50%),
    radial-gradient(circle at 40% 80%, rgba(120, 200, 255, 0.02) 0%, transparent 50%);
  /* 拍立得特有的边框效果 */
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

/* 拍立得照片区域 */
.polaroid-photo-area {
  width: 100%;
  height: calc(100% - 120rpx); /* 为底部区域留空间 */
  position: relative;
  background: #f8f9fa;
  border-radius: 4rpx;
  overflow: hidden;
  /* 添加内阴影模拟照片凹陷效果 */
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 图片内容容器 */
.polaroid-image-content {
  width: 100%;
  height: 100%;
  position: relative;
}

/* 单张图片样式 */
.polaroid-single-image {
  width: 100%;
  height: 100%;
  position: relative;
}

.polaroid-main-image {
  width: 100%;
  height: 100%;
  border-radius: 4rpx;
  transition: all 0.3s ease;
}

/* 多张图片拼贴样式 */
.polaroid-multi-images {
  width: 100%;
  height: 100%;
  position: relative;
}

.polaroid-image-collage {
  width: 100%;
  height: 100%;
  display: flex;
  gap: 6rpx;
  padding: 10rpx;
  box-sizing: border-box;
}

.polaroid-collage-image {
  flex: 1;
  height: 100%;
  border-radius: 4rpx;
  transition: all 0.2s ease;
  /* 添加轻微旋转效果，模拟随意摆放 */
}

.polaroid-img-0 {
  transform: rotate(-1deg);
}

.polaroid-img-1 {
  transform: rotate(0.5deg);
}

.polaroid-img-2 {
  transform: rotate(-0.5deg);
}

.polaroid-more-overlay {
  position: absolute;
  bottom: 15rpx;
  right: 15rpx;
  width: 50rpx;
  height: 50rpx;
  background: rgba(0, 0, 0, 0.7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.polaroid-more-count {
  font-size: 20rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 纯文字内容背景 */
.polaroid-text-bg {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.polaroid-text-pattern {
  width: 80%;
  height: 80%;
  background-image: 
    repeating-linear-gradient(
      45deg,
      transparent,
      transparent 10rpx,
      rgba(0, 0, 0, 0.02) 10rpx,
      rgba(0, 0, 0, 0.02) 20rpx
    );
  border-radius: 4rpx;
}

/* 文字覆盖层 */
.polaroid-text-overlay {
  position: absolute;
  bottom: 20rpx;
  left: 20rpx;
  right: 20rpx;
  background: rgba(255, 255, 255, 0.95);
  padding: 15rpx 20rpx;
  border-radius: 8rpx;
  /* 模拟手写标签效果 */
  border-left: 4rpx solid #007AFF;
}

.polaroid-text {
  font-size: 26rpx;
  line-height: 1.5;
  color: #333333;
  word-wrap: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  /* 模拟手写字体 */
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* 拍立得底部区域 */
.polaroid-bottom-area {
  position: absolute;
  bottom: 20rpx;
  left: 20rpx;
  right: 20rpx;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

/* 用户信息区域 */
.polaroid-user-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.polaroid-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.1);
}

.polaroid-user-details {
  flex: 1;
}

.polaroid-username {
  font-size: 24rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.2;
  margin-bottom: 2rpx;
  /* 模拟手写标签字体 */
}

.polaroid-time {
  font-size: 20rpx;
  color: #666666;
  line-height: 1.2;
}

.polaroid-more-btn {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
  transition: all 0.2s ease;
}

.polaroid-more-icon {
  width: 16rpx;
  height: 16rpx;
  opacity: 0.6;
}

/* 交互按钮区域 */
.polaroid-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.polaroid-action-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 12rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 20rpx;
  transition: all 0.2s ease;
  /* 模拟拍立得标签效果 */
  border: 1rpx solid rgba(0, 0, 0, 0.1);
}

.polaroid-action-btn.liked {
  background: rgba(255, 59, 92, 0.1);
  border-color: rgba(255, 59, 92, 0.3);
}

.polaroid-action-icon {
  width: 20rpx;
  height: 20rpx;
}

.polaroid-action-text {
  font-size: 20rpx;
  color: #666666;
  font-weight: 500;
  min-width: 20rpx;
}

.liked .polaroid-action-text {
  color: #ff3b5c;
}

/* 滑动提示 */
.polaroid-swipe-hint {
  display: flex;
  align-items: center;
  justify-content: center;
}

.polaroid-swipe-dot {
  width: 6rpx;
  height: 6rpx;
  background: #cccccc;
  border-radius: 50%;
  animation: polaroidPulse 2s ease-in-out infinite;
}

@keyframes polaroidPulse {
  0%, 100% { 
    transform: scale(1); 
    opacity: 0.6; 
  }
  50% { 
    transform: scale(1.5); 
    opacity: 1; 
  }
}

/* 拍立得阴影效果 */
.polaroid-shadow {
  position: absolute;
  top: 8rpx;
  left: 4rpx;
  right: -4rpx;
  bottom: -8rpx;
  background: rgba(0, 0, 0, 0.15);
  border-radius: 8rpx;
  z-index: -1;
  /* 模拟真实照片的不规则阴影 */
  transform: rotate(0.5deg);
}

/* 悬停效果（如果支持） */
.polaroid-card:hover .polaroid-frame {
  transform: translateY(-2rpx) rotate(-0.5deg);
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.polaroid-card:hover .polaroid-shadow {
  transform: rotate(0.5deg) translateY(4rpx);
  opacity: 0.8;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .post-card.polaroid-card {
    height: 680rpx;
  }
  
  .polaroid-frame {
    padding: 18rpx 18rpx 70rpx 18rpx;
  }
  
  .polaroid-bottom-area {
    height: 90rpx;
  }
}