/* 主要帖子卡片 - 性能优化版本 */
.post-card {
  width: 100%;
  height: 640rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  /* 优化动画性能 */
  transition: transform 0.2s cubic-bezier(0.25, 0.8, 0.25, 1), 
              opacity 0.2s ease-out;
  /* 启用硬件加速 */
  transform: translateZ(0);
  will-change: transform, opacity;
  /* 优化渲染 */
  backface-visibility: hidden;
  cursor: pointer;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.15);
}

.post-card:hover {
  transform: translateY(-10rpx) scale(1.02) !important;
  box-shadow: 0 30rpx 60rpx rgba(0, 0, 0, 0.25);
}

/* 卡片背景渐变 */
.card-gradient-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* 卡片内容包装器 - 性能优化版本 */
.card-content-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  z-index: 2;
  background: rgba(255, 255, 255, 0.95);
  /* 优化模糊效果性能 */
  backdrop-filter: blur(8rpx);
  /* 启用硬件加速 */
  transform: translateZ(0);
  will-change: auto;
}

/* 用户信息头部 */
.card-user-header {
  display: flex;
  align-items: center;
  margin-bottom: 25rpx;
  z-index: 3;
}

.card-user-avatar {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.8);
  margin-right: 15rpx;
  transition: all 0.3s ease;
}

.card-user-avatar:active {
  transform: scale(1.1);
  border-color: #1A73E8;
}

.card-user-info {
  flex: 1;
}

.card-username {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.3;
  margin-bottom: 4rpx;
}

.card-time {
  font-size: 22rpx;
  color: #808080;
  line-height: 1.2;
}

.card-action-btn {
  width: 40rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.card-action-btn:active {
  background: rgba(26, 115, 232, 0.1);
  transform: scale(1.1);
}

.card-more-icon {
  width: 20rpx;
  height: 20rpx;
  opacity: 0.7;
}

/* 卡片主内容区域 */
.card-main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  overflow: hidden;
}

/* 文字内容 */
.card-text-content {
  max-height: 150rpx;
  overflow: hidden;
}

.card-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333333;
  word-wrap: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 媒体内容 */
.card-media-content {
  flex: 1;
  border-radius: 15rpx;
  overflow: hidden;
  position: relative;
}

/* 单张图片展示 */
.card-single-media {
  width: 100%;
  height: 100%;
  position: relative;
  border-radius: 15rpx;
  overflow: hidden;
}

.card-main-image {
  width: 100%;
  height: 100%;
  transition: all 0.3s ease;
}

.card-main-image:active {
  transform: scale(1.05);
}

.card-image-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.1) 100%);
  pointer-events: none;
}

/* 多张图片创意网格 */
.card-multi-media {
  width: 100%;
  height: 100%;
  position: relative;
}

.media-grid-creative {
  width: 100%;
  height: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 4rpx;
  border-radius: 15rpx;
  overflow: hidden;
}

.grid-image-creative {
  width: 100%;
  height: 100%;
  transition: all 0.2s ease;
}

.grid-image-creative:active {
  transform: scale(1.02);
  z-index: 10;
}

.grid-pos-0 {
  grid-column: 1 / 3;
  grid-row: 1 / 2;
}

.grid-pos-1 {
  grid-column: 1 / 2;
  grid-row: 2 / 3;
}

.grid-pos-2 {
  grid-column: 2 / 3;
  grid-row: 2 / 3;
}

.more-images-overlay {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 60rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.more-count {
  font-size: 20rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 卡片底部交互区域 */
.card-bottom-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 25rpx;
  z-index: 3;
}

/* 快速交互按钮 */
.quick-actions {
  display: flex;
  gap: 20rpx;
}

.quick-action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 25rpx;
  transition: all 0.2s ease;
  backdrop-filter: blur(5rpx);
}

.quick-action-btn:active {
  transform: scale(0.95);
  background: rgba(26, 115, 232, 0.1);
}

.quick-action-btn.liked {
  background: rgba(255, 59, 92, 0.1);
  border: 1rpx solid rgba(255, 59, 92, 0.3);
}

.quick-action-icon {
  width: 24rpx;
  height: 24rpx;
}

.quick-action-text {
  font-size: 22rpx;
  color: #666666;
  font-weight: 500;
}

.liked .quick-action-text {
  color: #ff3b5c;
}

/* 滑动提示 */
.swipe-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  opacity: 0.6;
}

.swipe-indicator {
  width: 30rpx;
  height: 4rpx;
  background: linear-gradient(to right, #1A73E8, transparent);
  border-radius: 2rpx;
  animation: swipeHint 2s ease-in-out infinite;
}

.swipe-text {
  font-size: 20rpx;
  color: #808080;
}

@keyframes swipeHint {
  0%, 100% { transform: translateX(0); opacity: 0.6; }
  50% { transform: translateX(10rpx); opacity: 1; }
}

/* 卡片装饰边框 */
.card-border-decoration {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  pointer-events: none;
  z-index: 4;
}

/* 卡片阴影层 */
.card-shadow-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
  pointer-events: none;
  z-index: 5;
}
