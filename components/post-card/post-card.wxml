<view class="post-card polaroid-card">
  <!-- 拍立得白色边框 -->
  <view class="polaroid-frame">
    <!-- 拍立得照片区域 -->
    <view class="polaroid-photo-area">
      <!-- 图片内容 -->
      <view class="polaroid-image-content" wx:if="{{post.images && post.images.length > 0}}">
        <!-- 单张图片 -->
        <view class="polaroid-single-image" wx:if="{{post.images.length === 1}}">
          <image 
            class="polaroid-main-image" 
            src="{{post.images[0].url || post.images[0]}}" 
            mode="aspectFill"
            bindtap="onPreviewImage"
            data-current="{{post.images[0].url || post.images[0]}}"
            hover-class="none"
          ></image>
        </view>

        <!-- 多张图片 - 拼贴风格 -->
        <view class="polaroid-multi-images" wx:else>
          <view class="polaroid-image-collage">
            <image 
              class="polaroid-collage-image polaroid-img-{{index}}" 
              wx:for="{{post.images}}" 
              wx:for-item="img" 
              wx:key="*this"
              wx:if="{{index < 3}}"
              src="{{img.url || img}}" 
              mode="aspectFill"
              bindtap="onPreviewImage"
              data-current="{{img.url || img}}"
              hover-class="none"
            ></image>
            <!-- 更多图片提示 -->
            <view class="polaroid-more-overlay" wx:if="{{post.images.length > 3}}">
              <text class="polaroid-more-count">+{{post.images.length - 3}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 纯文字内容时的背景 -->
      <view class="polaroid-text-bg" wx:if="{{!post.images || post.images.length === 0}}">
        <view class="polaroid-text-pattern"></view>
      </view>

      <!-- 文字内容覆盖层 -->
      <view class="polaroid-text-overlay" wx:if="{{post.content}}">
        <text class="polaroid-text">{{post.content}}</text>
      </view>
    </view>

    <!-- 拍立得底部白色区域 -->
    <view class="polaroid-bottom-area">
      <!-- 用户信息 -->
      <view class="polaroid-user-info">
        <image 
          class="polaroid-avatar" 
          src="{{post.author.avatar || '/images/default_avatar.png'}}" 
          mode="aspectFill"
          bindtap="onTapAvatar"
          hover-class="none"
        ></image>
        <view class="polaroid-user-details">
          <view class="polaroid-username">{{post.author.username || post.author.name || '未知用户'}}</view>
          <view class="polaroid-time">{{post.formattedTime || '刚刚'}}</view>
        </view>
        <!-- 更多操作按钮 -->
        <view class="polaroid-more-btn" bindtap="onMore" hover-class="none">
          <image class="polaroid-more-icon" src="/assets/icons/more.svg" mode="aspectFit"></image>
        </view>
      </view>

      <!-- 交互按钮区域 -->
      <view class="polaroid-actions">
        <view 
          class="polaroid-action-btn polaroid-like-btn {{post.isLiked ? 'liked' : ''}}"
          bindtap="onLike"
          hover-class="none"
        >
          <image class="polaroid-action-icon" src="/assets/icons/like.svg" mode="aspectFit"></image>
          <text class="polaroid-action-text">{{post.likes && post.likes.length > 0 ? post.likes.length : ''}}</text>
        </view>
        
        <view 
          class="polaroid-action-btn polaroid-comment-btn"
          bindtap="onComment"
          hover-class="none"
        >
          <image class="polaroid-action-icon" src="/assets/icons/camera.svg" mode="aspectFit"></image>
          <text class="polaroid-action-text">{{post.comments && post.comments.length > 0 ? post.comments.length : ''}}</text>
        </view>

        <!-- 滑动提示 -->
        <view class="polaroid-swipe-hint">
          <view class="polaroid-swipe-dot"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 拍立得阴影 -->
  <view class="polaroid-shadow"></view>
</view>
