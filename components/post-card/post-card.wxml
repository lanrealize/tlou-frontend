<view class="post-card">
  <!-- 卡片背景渐变 -->
  <view class="card-gradient-bg" style="background: {{card.gradientBg || 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)'}}"></view>
  
  <!-- 卡片内容 -->
  <view class="card-content-wrapper">
    <!-- 用户信息头部 -->
    <view class="card-user-header">
      <image 
        class="card-user-avatar" 
        src="{{card.author.avatar || '/images/default_avatar.png'}}" 
        mode="aspectFill"
        bindtap="onTapAvatar"
      ></image>
      <view class="card-user-info">
        <view class="card-username">{{card.author.username || card.author.name || '未知用户'}}</view>
        <view class="card-time">{{card.formattedTime || '刚刚'}}</view>
      </view>
      <!-- 卡片操作按钮 -->
      <view class="card-action-btn" wx:if="{{currentUser._id === card.author._id}}" bindtap="onDelete">
        <image class="card-more-icon" src="/assets/icons/delete.svg" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 卡片主内容区域 -->
    <view class="card-main-content">
      <!-- 文字内容 -->
      <view class="card-text-content" wx:if="{{card.content}}">
        <text class="card-text">{{card.content}}</text>
      </view>

      <!-- 图片内容 - 特殊布局 -->
      <view class="card-media-content" wx:if="{{card.images && card.images.length > 0}}">
        <!-- 单张图片 - 全屏展示 -->
        <view class="card-single-media" wx:if="{{card.images.length === 1}}">
          <image 
            class="card-main-image" 
            src="{{card.images[0].url || card.images[0]}}" 
            mode="aspectFill"
            bindtap="onPreviewImage"
            data-current="{{card.images[0].url || card.images[0]}}"
          ></image>
          <!-- 图片遮罩效果 -->
          <view class="card-image-overlay"></view>
        </view>

        <!-- 多张图片 - 创意拼接 -->
        <view class="card-multi-media" wx:else>
          <view class="media-grid-creative">
            <image 
              class="grid-image-creative grid-pos-{{index}}" 
              wx:for="{{card.images}}" 
              wx:for-item="img" 
              wx:key="index"
              wx:if="{{index < 4}}"
              src="{{img.url || img}}" 
              mode="aspectFill"
              bindtap="onPreviewImage"
              data-current="{{img.url || img}}"
            ></image>
            <!-- 更多图片提示 -->
            <view class="more-images-overlay" wx:if="{{card.images.length > 4}}">
              <text class="more-count">+{{card.images.length - 4}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 卡片底部交互区域 -->
    <view class="card-bottom-actions">
      <!-- 快速交互按钮 -->
      <view class="quick-actions">
        <view 
          class="quick-action-btn like-btn {{card.isLiked ? 'liked' : ''}}"
          bindtap="onLike"
        >
          <image class="quick-action-icon" src="/assets/icons/like.svg" mode="aspectFit"></image>
          <text class="quick-action-text">{{card.likes && card.likes.length > 0 ? card.likes.length : '赞'}}</text>
        </view>
        
        <view 
          class="quick-action-btn comment-btn"
          bindtap="onComment"
        >
          <image class="quick-action-icon" src="/assets/icons/camera.svg" mode="aspectFit"></image>
          <text class="quick-action-text">{{card.comments && card.comments.length > 0 ? card.comments.length : '评论'}}</text>
        </view>
      </view>

      <!-- 滑动提示 -->
      <view class="swipe-hint">
        <view class="swipe-indicator"></view>
        <text class="swipe-text">滑动查看下一张</text>
      </view>
    </view>
  </view>

  <!-- 卡片边框装饰 -->
  <view class="card-border-decoration"></view>
  
  <!-- 卡片阴影 -->
  <view class="card-shadow-layer"></view>
</view>
