<!--components/circle-status-action/circle-status-action.wxml-->
<view class="circle-status-action {{hidden ? 'hidden' : ''}}">
  
  <!-- ========== 已登录状态 ========== -->
  
  <!-- 状态1: 成员 - 发布新动态 -->
  <view class="status-card" wx:if="{{status === 'member'}}" bindtap="onPublish">
    <view class="card-layout">
      <view class="left-content">
        <text id="mainTitle" class="main-title">发布新动态</text>
        <text id="subTitle" class="sub-title">分享你的精彩瞬间</text>
      </view>
      <view id="actionBtn" class="action-btn static">发布</view>
    </view>
  </view>

  <!-- 状态2: 已申请 -->
  <view class="status-card" wx:elif="{{status === 'applied'}}">
    <view class="card-layout">
      <view class="left-content">
        <text id="mainTitle" class="main-title">申请已提交</text>
        <text id="subTitle" class="sub-title">等待朋友圈主人审核中</text>
      </view>
      <view id="actionBtn" class="action-btn static disabled">审核中</view>
    </view>
  </view>

  <!-- 状态3: 被邀请且已申请（优先显示邀请） -->
  <view class="status-card" wx:elif="{{status === 'invited_applied'}}">
    <view class="card-layout">
      <view class="left-content">
        <text id="mainTitle" class="main-title">你收到了邀请</text>
        <text id="subTitle" class="sub-title">点击右侧按钮可直接加入（无需等待审核）</text>
      </view>
      <button id="actionBtn" class="action-btn {{isJoining ? 'disabled' : ''}}" 
              bindtap="onAcceptInvite" 
              disabled="{{isJoining}}">
        {{isJoining ? '加入中...' : '接受邀请'}}
      </button>
    </view>
  </view>

  <!-- 状态4: 被邀请（已登录） -->
  <view class="status-card" wx:elif="{{status === 'invited'}}">
    <view class="card-layout">
      <view class="left-content">
        <text id="mainTitle" class="main-title">你收到了邀请</text>
        <text id="subTitle" class="sub-title">点击右侧按钮加入这个朋友圈</text>
      </view>
      <button id="actionBtn" class="action-btn {{isJoining ? 'disabled' : ''}}" 
              bindtap="onAcceptInvite" 
              disabled="{{isJoining}}">
        {{isJoining ? '加入中...' : '接受邀请'}}
      </button>
    </view>
  </view>

  <!-- 状态5: 可申请加入（已登录） -->
  <view class="status-card" wx:elif="{{status === 'can_apply'}}">
    <view class="card-layout">
      <view class="left-content">
        <text id="mainTitle" class="main-title">公开朋友圈</text>
        <text id="subTitle" class="sub-title">你可以申请加入这个朋友圈</text>
      </view>
      <button id="actionBtn" class="action-btn {{isApplying ? 'disabled' : ''}}" 
              bindtap="onApply" 
              disabled="{{isApplying}}">
        {{isApplying ? '申请中...' : '申请加入'}}
      </button>
    </view>
  </view>

  <!-- 状态6: 无权限（已登录） -->
  <view class="status-card" wx:elif="{{status === 'no_access'}}">
    <view class="card-layout">
      <view class="left-content">
        <text id="mainTitle" class="main-title">无法访问</text>
        <text id="subTitle" class="sub-title">无权查看此朋友圈</text>
      </view>
      <view id="actionBtn" class="action-btn static disabled">无权限</view>
    </view>
  </view>

  <!-- ========== 未登录状态 ========== -->
  
  <!-- 状态7: 被邀请（未登录） -->
  <view class="status-card" wx:elif="{{status === 'guest_invited'}}">
    <view class="card-layout">
      <view class="left-content">
        <text id="mainTitle" class="main-title">你收到了邀请</text>
        <text id="subTitle" class="sub-title">点击右侧按钮加入这个朋友圈</text>
      </view>
      <button id="actionBtn" class="action-btn {{isJoining ? 'disabled' : ''}}" 
              bindtap="onAcceptInvite" 
              disabled="{{isJoining}}">
        {{isJoining ? '加入中...' : '接受邀请'}}
      </button>
    </view>
  </view>

  <!-- 状态8: 可申请加入（未登录） -->
  <view class="status-card" wx:elif="{{status === 'guest_can_apply'}}">
    <view class="card-layout">
      <view class="left-content">
        <text id="mainTitle" class="main-title">公开朋友圈</text>
        <text id="subTitle" class="sub-title">你可以申请加入这个朋友圈</text>
      </view>
      <button id="actionBtn" class="action-btn {{isApplying ? 'disabled' : ''}}" 
              bindtap="onApply" 
              disabled="{{isApplying}}">
        {{isApplying ? '申请中...' : '申请加入'}}
      </button>
    </view>
  </view>

  <!-- 状态9: 无权限（未登录，不显示） -->
  <!-- guest_no_access 状态不显示任何内容 -->

</view>

