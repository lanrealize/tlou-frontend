<!-- components/onboarding-guide/onboarding-guide.wxml -->
<view class="onboarding-container">

  <!-- 顶部标题 -->
  <view class="onboarding-header {{headerVisible ? 'slide-in' : ''}}" style="padding-top: {{headerTop}}px;">
    <text class="onboarding-title">拍下此刻，\nAI 陪你记录生活</text>
    <text class="onboarding-subtitle">发一张照片，看看 AI 怎么说</text>
  </view>

  <!-- 示例帖子 -->
  <view class="demo-post {{postVisible ? 'slide-in' : ''}}" bindtap="onTapDemoPost">
    <post-item
      id="demo-post-item"
      post="{{demoPost}}"
      showActions="{{false}}"
      timelineMode="{{true}}"
      onboardingMode="{{true}}"
      hideComments="{{hideComments}}"
      bindvideoended="onVideoEnded"
    ></post-item>
  </view>

  <!-- 底部浮层 -->
  <view class="onboarding-footer {{footerVisible ? 'footer-visible' : ''}}">
    <view class="footer-fade"></view>

    <view class="footer-n" bindtap="onTakePhoto">
      <view class="fn3-g1"></view>
      <view class="fn3-g2"></view>
      <view class="fn3-g3"></view>
      <view class="fn-cta">
        <text class="fn-title">点击按钮，拍下此刻</text>
        <text class="fn-sub">在这里分享的每一张照片，都会得到用心的回应</text>
        <view class="fn-btn" bindtap="onTakePhoto">
          <text class="fn-btn-text">点击拍摄</text>
        </view>
        <view class="fn-line"></view>
      </view>
    </view>

  </view>

</view>
