<!-- components/onboarding-guide/onboarding-guide.wxml -->
<view class="onboarding-container">

  <!-- 顶部标题 -->
  <view class="onboarding-header" style="padding-top: {{headerTop}}px;">
    <text class="onboarding-title">拍下此刻，\nAI 陪你记录生活</text>
    <text class="onboarding-subtitle">发一张照片，看看 AI 怎么说</text>
  </view>

  <!-- 示例帖子 -->
  <view class="demo-post" bindtap="onTapDemoPost">
    <post-item
      id="demo-post-item"
      post="{{demoPost}}"
      showActions="{{false}}"
      timelineMode="{{true}}"
      onboardingMode="{{true}}"
    ></post-item>
  </view>

  <!-- 底部浮层 -->
  <view class="onboarding-footer footer-visible">
    <view class="footer-fade"></view>

    <view class="footer-n" bindtap="onTakePhoto">
      <view class="fn3-g1"></view>
      <view class="fn3-g2"></view>
      <view class="fn3-g3"></view>
      <view class="fn-cta">
        <text class="fn-sub">AI 马上回应你</text>
        <text class="fn-main">拍下来 →</text>
      </view>
    </view>

  </view>

</view>
