/* components/onboarding-guide/onboarding-guide.wxss */

.onboarding-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
}

/* 顶部标题区 */
.onboarding-header {
  padding: 0 56rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.onboarding-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #111;
  line-height: 1.3;
}

.onboarding-subtitle {
  font-size: 28rpx;
  color: #999;
  line-height: 1.6;
}

/* 示例帖子区域 */
.demo-post {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 56rpx;
  overflow: hidden;
}

/* 作者行 */
.demo-author-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.demo-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  flex-shrink: 0;
}

.demo-author-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  position: relative;
  top: -0.5rpx;
}

.demo-author-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111;
}

.demo-author-time {
  font-size: 22rpx;
  color: #bbb;
}

/* 示例图片 */
.demo-image-wrap {
  width: 100%;
  height: 460rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #f5f5f5;
  margin-bottom: 28rpx;
  position: relative;
}

.demo-video {
  width: 100%;
  height: 100%;
  display: block;
}

.demo-video-blur {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
  background-color: rgba(0, 0, 0, 0.3);
}

/* AI 评论区 */
.demo-comments {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.demo-comment {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.comment-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background-color: #e8f0fe;
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.comment-name {
  font-size: 24rpx;
  color: #1A73E8;
  font-weight: 500;
}

.comment-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 底部按钮区 */
.onboarding-footer {
  padding: 40rpx 56rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

.guide-text {
  font-size: 26rpx;
  color: #bbb;
  text-align: center;
}

.camera-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background-color: #1A73E8;
  border-radius: 100rpx;
  padding: 32rpx 0;
}

.camera-icon {
  width: 40rpx;
  height: 40rpx;
}

.camera-btn-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 600;
}
