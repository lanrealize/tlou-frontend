/* 滑动卡片组件样式 */
.swipe-cards-wrapper {
  width: 100%;
  height: 100%;
  padding: 0 30rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.swipe-cards-container {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  padding: 20rpx;
  box-sizing: border-box;
  transform-style: preserve-3d;
}

/* 卡片进入动画 */
.card-enter {
  animation: cardEnter 0.3s ease-out;
}

@keyframes cardEnter {
  from {
    opacity: 0;
    transform: translateY(20rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 帖子卡片 */
.post-card {
  width: 100%;
  height: 520rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.15);
  /* 启用硬件加速 */
  transform: translateZ(0);
  will-change: transform;
  backface-visibility: hidden;
}

/* 卡片背景渐变 */
.card-gradient {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* 卡片内容 */
.card-content {
  position: relative;
  width: 100%;
  height: 100%;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  z-index: 2;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(8rpx);
}

/* 卡片头部 */
.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 25rpx;
}

.user-avatar {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  margin-right: 15rpx;
}

.user-info {
  flex: 1;
}

.username {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.3;
  margin-bottom: 4rpx;
}

.time {
  font-size: 22rpx;
  color: #808080;
  line-height: 1.2;
}

/* 主要内容区域 */
.card-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  overflow: hidden;
}

/* 文字内容 */
.text-content {
  max-height: 120rpx;
  overflow: hidden;
}

.post-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333333;
  word-wrap: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 图片内容 */
.image-content {
  flex: 1;
  border-radius: 15rpx;
  overflow: hidden;
  position: relative;
}

/* 单张图片 */
.single-image {
  width: 100%;
  height: 100%;
  border-radius: 15rpx;
  overflow: hidden;
}

.main-image {
  width: 100%;
  height: 100%;
  transition: transform 0.3s ease;
}

.main-image:active {
  transform: scale(1.02);
}

/* 多张图片网格 */
.image-grid {
  width: 100%;
  height: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 4rpx;
  border-radius: 15rpx;
  overflow: hidden;
  position: relative;
}

.grid-image {
  width: 100%;
  height: 100%;
  transition: transform 0.2s ease;
}

.grid-image:active {
  transform: scale(1.02);
  z-index: 10;
}

.grid-0 {
  grid-column: 1 / 3;
  grid-row: 1 / 2;
}

.grid-1 {
  grid-column: 1 / 2;
  grid-row: 2 / 3;
}

.grid-2 {
  grid-column: 2 / 3;
  grid-row: 2 / 3;
}

.more-images {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 60rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.more-images text {
  font-size: 20rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 25rpx;
}

/* 操作按钮 */
.actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 25rpx;
  transition: all 0.2s ease;
  backdrop-filter: blur(5rpx);
}

.action-btn:active {
  transform: scale(0.95);
  background: rgba(26, 115, 232, 0.1);
}

.action-btn.liked {
  background: rgba(255, 59, 92, 0.1);
  border: 1rpx solid rgba(255, 59, 92, 0.3);
}

.action-icon {
  width: 24rpx;
  height: 24rpx;
}

.action-text {
  font-size: 22rpx;
  color: #666666;
  font-weight: 500;
}

.liked .action-text {
  color: #ff3b5c;
}

/* 滑动提示 */
.swipe-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  opacity: 0.6;
}

.hint-line {
  width: 30rpx;
  height: 4rpx;
  background: linear-gradient(to right, #1A73E8, transparent);
  border-radius: 2rpx;
  animation: swipeHint 2s ease-in-out infinite;
}

.hint-text {
  font-size: 20rpx;
  color: #808080;
}

@keyframes swipeHint {
  0%, 100% { 
    transform: translateX(0); 
    opacity: 0.6; 
  }
  50% { 
    transform: translateX(10rpx); 
    opacity: 1; 
  }
}
