<wxs module="swipe" src="./swipe-cards.wxs"></wxs>
<view class="swipe-cards-wrapper">
  <view class="swipe-cards-container">
    <block wx:for="{{posts}}" wx:for-item="post" wx:key="_id">
      <view 
        wx:if="{{post && (circling ? (swipe.circleRange(index, currentCursor, sc, posts.length, removedPosts, 'in') && index !== justShown) : (index >= currentCursor && index < swipe.getRangeRemoves(removedPosts, currentCursor, sc, posts.length)))}}" 
        class="swipe-card {{swipe.circleRange(index, currentCursor, sc, posts.length, removedPosts, 'in') && swipe.circleRange(index, currentCursor, sc, posts.length, removedPosts, 'loc') >= 1 && transition ? 'card-enter' : ''}}"
        style="width: 100%; height: 100%; will-change: transform; position: absolute; top: {{upHeight * swipe.circleRange(index, currentCursor, sc, posts.length, removedPosts, 'loc')}}rpx; transform: translate3d(0, 0, {{currentZIndex[swipe.circleRange(index, currentCursor, sc, posts.length, removedPosts, 'loc')]}}px) scale({{1-(scaleRatio*swipe.circleRange(index, currentCursor, sc, posts.length, removedPosts, 'loc'))}}); {{transition ? 'transition: all ease 0.2s;' : ''}}"
        data-current-cursor="{{currentCursor}}"
        data-card-index="{{index}}"
        data-card-zindex="{{currentZIndex[swipe.circleRange(index, currentCursor, sc, posts.length, removedPosts, 'loc')]}}"
        data-slide-threshold="{{slideThreshold}}"
        data-context-width="{{contextWidth}}"
        data-slide-duration="{{slideDuration}}"
        data-rotate-deg="{{rotateDeg}}"
        mut-bind:touchstart="{{swipe.touchstart}}"
        mut-bind:touchmove="{{swipe.touchmove}}"
        mut-bind:touchend="{{swipe.touchend}}"
      >
        <!-- 帖子卡片内容 -->
        <view class="post-card">
          <!-- 卡片背景渐变 -->
          <view class="card-gradient" style="background: {{post.gradientBg || 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)'}}"></view>
          
          <!-- 卡片内容 -->
          <view class="card-content">
            <!-- 用户信息头部 -->
            <view class="card-header">
              <image 
                class="user-avatar" 
                src="{{post.author.avatar || '/images/default_avatar.png'}}" 
                mode="aspectFill"
              ></image>
              <view class="user-info">
                <view class="username">{{post.author.username || post.author.name || '未知用户'}}</view>
                <view class="time">{{post.formattedTime || '刚刚'}}</view>
              </view>
            </view>

            <!-- 主要内容区域 -->
            <view class="card-main">
              <!-- 文字内容 -->
              <view class="text-content" wx:if="{{post.content}}">
                <text class="post-text">{{post.content}}</text>
              </view>

              <!-- 图片内容 -->
              <view class="image-content" wx:if="{{post.images && post.images.length > 0}}">
                <!-- 单张图片 -->
                <view class="single-image" wx:if="{{post.images.length === 1}}">
                  <image 
                    class="main-image" 
                    src="{{post.images[0].url || post.images[0]}}" 
                    mode="aspectFill"
                    bindtap="onPreviewImage"
                    data-current="{{post.images[0].url || post.images[0]}}"
                    data-urls="{{post.images}}"
                  ></image>
                </view>

                <!-- 多张图片网格 -->
                <view class="image-grid" wx:else>
                  <image 
                    class="grid-image grid-{{index < 4 ? index : 3}}" 
                    wx:for="{{post.images}}" 
                    wx:for-item="img" 
                    wx:key="*this"
                    wx:if="{{index < 4}}"
                    src="{{img.url || img}}" 
                    mode="aspectFill"
                    bindtap="onPreviewImage"
                    data-current="{{img.url || img}}"
                    data-urls="{{post.images}}"
                  ></image>
                  <!-- 更多图片提示 -->
                  <view class="more-images" wx:if="{{post.images.length > 4}}">
                    <text>+{{post.images.length - 4}}</text>
                  </view>
                </view>
              </view>
            </view>

            <!-- 底部操作栏 -->
            <view class="card-footer">
              <view class="actions">
                <view 
                  class="action-btn like-btn {{post.isLiked ? 'liked' : ''}}"
                  bindtap="onPostLike"
                  data-post-id="{{post._id}}"
                >
                  <image class="action-icon" src="/assets/icons/like.svg" mode="aspectFit"></image>
                  <text class="action-text">{{post.likes && post.likes.length > 0 ? post.likes.length : '赞'}}</text>
                </view>
                
                <view 
                  class="action-btn comment-btn"
                  bindtap="onPostComment"
                  data-post-id="{{post._id}}"
                >
                  <image class="action-icon" src="/assets/icons/camera.svg" mode="aspectFit"></image>
                  <text class="action-text">{{post.comments && post.comments.length > 0 ? post.comments.length : '评论'}}</text>
                </view>
                
                <view 
                  class="action-btn detail-btn"
                  bindtap="onPostDetail"
                  data-post="{{post}}"
                >
                  <image class="action-icon" src="/assets/icons/more.svg" mode="aspectFit"></image>
                  <text class="action-text">详情</text>
                </view>
              </view>
              
              <!-- 滑动提示 -->
              <view class="swipe-hint">
                <view class="hint-line"></view>
                <text class="hint-text">滑动切换</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
