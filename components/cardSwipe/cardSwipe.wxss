.wrapper{
    width: 100%;
    height:780rpx;
    padding: 0;
    padding-top: 50rpx;
    box-sizing: border-box;
    overflow: visible;
    display: flex;
    justify-content: center;
    align-items: flex-start;
}

.cards{
    position: relative;
    width: 92%;
    height: calc(100% - 50rpx);
    display: flex;
    justify-content: center;
    padding: 10rpx 0 40rpx 0;
    box-sizing: border-box;
    transform-style: preserve-3d;
}

.card-next{
    animation: fadeIn 0.3s linear;
}

.card-reverse{
    animation: slideInFromLeft 0.2s ease;
    z-index: 9999 !important;
    position: relative;
}

@keyframes fadeIn{
    from{
        opacity: 0;
    }
    to{
        opacity: 1;
    }
}

@keyframes slideInFromLeft{
    0%{
        transform: translate3d(-100%, 0, 9999px) rotate(-15deg);
        opacity: 0.8;
        z-index: 9999;
    }
    100%{
        transform: translate3d(0, 0, 9999px) rotate(0deg);
        opacity: 1;
        z-index: 9999;
    }
}
