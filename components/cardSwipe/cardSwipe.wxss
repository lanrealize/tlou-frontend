.wrapper{
    width: 100%;
    height: 820rpx;
    padding: 0;
    padding-top: 40rpx;
    box-sizing: border-box;
    overflow: visible;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    background: #f8f9fa; /* 使用纯色背景提升性能 */
    position: relative;
}

.cards{
    position: relative;
    width: 88%;
    height: calc(100% - 40rpx);
    display: flex;
    justify-content: center;
    padding: 15rpx 0 50rpx 0;
    box-sizing: border-box;
    transform-style: preserve-3d;
}

.card-next{
    animation: fadeIn 0.3s linear;
}

.card-reverse-from-left{
    animation: slideInFromLeft 0.2s ease;
    z-index: 9999 !important;
    position: relative;
}

.card-reverse-from-right{
    animation: slideInFromRight 0.2s ease;
    z-index: 9999 !important;
    position: relative;
}

@keyframes fadeIn{
    from{
        opacity: 0;
    }
    to{
        opacity: 1;
    }
}

@keyframes slideInFromLeft{
    0%{
        transform: translate3d(-120%, -10rpx, 9999px) rotate(-8deg);
        opacity: 0.7;
        z-index: 9999;
        filter: blur(2rpx);
    }
    50%{
        transform: translate3d(-20%, 5rpx, 9999px) rotate(-2deg);
        opacity: 0.9;
        filter: blur(1rpx);
    }
    100%{
        transform: translate3d(0, 0, 9999px) rotate(0deg);
        opacity: 1;
        z-index: 9999;
        filter: blur(0);
    }
}

@keyframes slideInFromRight{
    0%{
        transform: translate3d(120%, -10rpx, 9999px) rotate(8deg);
        opacity: 0.7;
        z-index: 9999;
        filter: blur(2rpx);
    }
    50%{
        transform: translate3d(20%, 5rpx, 9999px) rotate(2deg);
        opacity: 0.9;
        filter: blur(1rpx);
    }
    100%{
        transform: translate3d(0, 0, 9999px) rotate(0deg);
        opacity: 1;
        z-index: 9999;
        filter: blur(0);
    }
}

/* 移除性能杀手装饰效果 */

/* 恢复原来的简单卡片出现动画 */
.card-next{
    animation: fadeIn 0.3s linear;
}
