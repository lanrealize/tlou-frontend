.wrapper{
    width: 100%;
    height: 820rpx; /* 调整高度适配拍立得卡片 */
    padding: 0;
    padding-top: 40rpx;
    box-sizing: border-box;
    overflow: visible;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    /* 添加拍立得风格的背景 */
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    position: relative;
}

.cards{
    position: relative;
    width: 88%; /* 稍微减小宽度，给拍立得卡片更多呼吸空间 */
    height: calc(100% - 40rpx);
    display: flex;
    justify-content: center;
    padding: 15rpx 0 50rpx 0;
    box-sizing: border-box;
    transform-style: preserve-3d;
    /* 添加拍立得风格的装饰背景 */
    background-image: 
        radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 90% 80%, rgba(255, 255, 255, 0.2) 0%, transparent 50%);
}

.card-next{
    animation: fadeIn 0.3s linear;
}

.card-reverse-from-left{
    animation: slideInFromLeft 0.2s ease;
    z-index: 9999 !important;
    position: relative;
}

.card-reverse-from-right{
    animation: slideInFromRight 0.2s ease;
    z-index: 9999 !important;
    position: relative;
}

@keyframes fadeIn{
    from{
        opacity: 0;
    }
    to{
        opacity: 1;
    }
}

@keyframes slideInFromLeft{
    0%{
        transform: translate3d(-120%, -10rpx, 9999px) rotate(-8deg);
        opacity: 0.7;
        z-index: 9999;
        filter: blur(2rpx);
    }
    50%{
        transform: translate3d(-20%, 5rpx, 9999px) rotate(-2deg);
        opacity: 0.9;
        filter: blur(1rpx);
    }
    100%{
        transform: translate3d(0, 0, 9999px) rotate(0deg);
        opacity: 1;
        z-index: 9999;
        filter: blur(0);
    }
}

@keyframes slideInFromRight{
    0%{
        transform: translate3d(120%, -10rpx, 9999px) rotate(8deg);
        opacity: 0.7;
        z-index: 9999;
        filter: blur(2rpx);
    }
    50%{
        transform: translate3d(20%, 5rpx, 9999px) rotate(2deg);
        opacity: 0.9;
        filter: blur(1rpx);
    }
    100%{
        transform: translate3d(0, 0, 9999px) rotate(0deg);
        opacity: 1;
        z-index: 9999;
        filter: blur(0);
    }
}

/* 拍立得风格装饰效果 */
.wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
        /* 模拟桌面纹理 */
        repeating-linear-gradient(
            90deg,
            transparent,
            transparent 100rpx,
            rgba(255, 255, 255, 0.1) 100rpx,
            rgba(255, 255, 255, 0.1) 102rpx
        ),
        repeating-linear-gradient(
            0deg,
            transparent,
            transparent 100rpx,
            rgba(255, 255, 255, 0.05) 100rpx,
            rgba(255, 255, 255, 0.05) 102rpx
        );
    pointer-events: none;
    z-index: 0;
}

.cards::after {
    content: '';
    position: absolute;
    top: -20rpx;
    left: -20rpx;
    right: -20rpx;
    bottom: -20rpx;
    background: 
        radial-gradient(circle at 15% 15%, rgba(0, 0, 0, 0.02) 0%, transparent 30%),
        radial-gradient(circle at 85% 85%, rgba(0, 0, 0, 0.02) 0%, transparent 30%);
    pointer-events: none;
    z-index: -1;
}

/* 优化卡片层叠效果，模拟拍立得照片堆叠 */
.card-next{
    animation: fadeInPolaroid 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
}

@keyframes fadeInPolaroid{
    from{
        opacity: 0;
        transform: translateY(20rpx) rotate(2deg) scale(0.95);
        filter: blur(1rpx);
    }
    to{
        opacity: 1;
        transform: translateY(0) rotate(0deg) scale(1);
        filter: blur(0);
    }
}
