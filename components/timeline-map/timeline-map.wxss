/* 水平时间地图主容器 */
.horizontal-timeline-map {
  width: 100%;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  margin: 30rpx 20rpx 20rpx 20rpx;
  padding: 25rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

/* 第一行：时间地图 */
.timeline-row {
  margin-bottom: 20rpx;
}

.timeline-scroll-horizontal {
  width: 100%;
  white-space: nowrap;
}

/* 时间轴容器 - 网格系统容器 */
.timeline-container {
  position: relative;
  width: 100%;
  min-width: 200vw;
  height: 160rpx; /* 网格高度：120rpx + 上下边距 */
  padding: 20rpx 5vw 20rpx 5vw; /* 为网格留出边距 */
}

/* 时间轴主体 - 使用flexbox居中对齐 */
.timeline-axis {
  position: relative;
  width: 100%;
  height: 120rpx;
  display: flex;
  align-items: center; /* 垂直居中：轴线和圆点自然对齐 */
  justify-content: flex-start;
}

/* 轴线 - 自动垂直居中 */
.axis-line {
  position: absolute;
  top: 50%; /* 相对于timeline-axis垂直居中 */
  transform: translateY(-50%); /* 精确居中 */
  left: 5vw;
  width: 190vw;
  height: 4rpx;
  background: linear-gradient(to right, 
    rgba(26, 115, 232, 0.4) 0%, 
    rgba(26, 115, 232, 0.8) 10%, 
    rgba(26, 115, 232, 0.9) 50%, 
    rgba(26, 115, 232, 0.8) 90%, 
    rgba(26, 115, 232, 0.4) 100%
  );
  border-radius: 2rpx;
  z-index: 2;
  box-shadow: 0 1rpx 3rpx rgba(26, 115, 232, 0.2);
}

/* 时间节点容器 - 垂直居中对齐，激活时不移动 */
.timeline-node {
  position: absolute;
  top: 50%; /* 相对于timeline-axis垂直居中 */
  transform: translateX(-50%) translateY(-50%); /* 精确居中 */
  width: 100rpx;
  height: 60rpx;
  z-index: 5;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.timeline-node:active {
  /* 保持位置不变 */
}

.timeline-node.active {
  /* 激活时容器保持位置不变，只有子元素变化 */
}

/* 节点圆圈 - 在timeline-node内部居中 */
.node-circle {
  position: absolute;
  top: 50%; /* 相对于timeline-node居中 */
  left: 50%;
  transform: translate(-50%, -50%); /* 精确居中 */
  width: 24rpx;
  height: 24rpx;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

/* 激活状态：圆圈样式变化，位置保持不变 */
.timeline-node.active .node-circle {
  transform: translate(-50%, -50%) scale(1.15); /* 稍微放大 */
}

/* 连接线：稳定连接圆圈和标签 */
.connector-line {
  position: absolute;
  top: 50%; /* 从timeline-node中心开始 */
  left: 50%;
  transform: translateX(-50%);
  width: 2rpx;
  height: calc(100% - 30rpx + 8rpx); /* 从圆圈底部到标签顶部的距离 */
  margin-top: 12rpx; /* 圆圈半径，从圆圈底部开始 */
  background: linear-gradient(to bottom, 
    rgba(26, 115, 232, 0.6) 0%, 
    rgba(26, 115, 232, 0.2) 100%
  );
  z-index: 3; /* 在圆点下方，标签上方 */
  transition: all 0.3s ease;
}

/* 激活状态下的连接线：响应标签的上移 */
.timeline-node.active .connector-line {
  height: calc(100% - 30rpx + 6rpx); /* 标签上移时连接线稍短 */
  background: linear-gradient(to bottom, 
    rgba(26, 115, 232, 0.8) 0%, 
    rgba(26, 115, 232, 0.3) 100%
  );
}

.node-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12rpx;
  height: 12rpx;
  background: #ffffff;
  border: 3rpx solid #1A73E8;
  border-radius: 50%;
  transition: all 0.3s ease;
  z-index: 6; /* 圆点在轴线上方，实现穿透效果 */
}

.timeline-node.active .node-dot {
  width: 16rpx;
  height: 16rpx;
  background: #1A73E8;
  border: 4rpx solid #ffffff;
  box-shadow: 0 0 0 3rpx rgba(26, 115, 232, 0.3);
}

.node-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid transparent;
  border-radius: 50%;
  transition: all 0.3s ease;
  z-index: 1;
}

.node-ring.active-ring {
  width: 32rpx;
  height: 32rpx;
  border-color: rgba(26, 115, 232, 0.4);
  animation: ringPulse 2s ease-in-out infinite;
}

@keyframes ringPulse {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 0.6;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.2);
    opacity: 0.3;
  }
}

/* 指向时间轴的指针 */


/* 节点标签 */
/* 时间标签 - 相对于timeline-node定位 */
.node-label {
  position: absolute;
  top: 100%; /* 在timeline-node下方 */
  left: 50%;
  transform: translateX(-50%);
  margin-top: 8rpx; /* 与圆圈的间距 */
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(5rpx);
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(26, 115, 232, 0.2);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  min-width: 60rpx;
  transition: all 0.3s ease;
  z-index: 1; /* 标签在轴线下方 */
}

.timeline-node.active .node-label {
  background: rgba(26, 115, 232, 0.1);
  border-color: rgba(26, 115, 232, 0.4);
  transform: translateX(-50%) translateY(-2rpx); /* 保持水平居中 */
}

.node-time {
  font-size: 22rpx;
  font-weight: 600;
  color: #1A73E8;
  line-height: 1.2;
  text-align: center;
}

.node-type {
  display: flex;
  align-items: center;
  justify-content: center;
}

.type-icon {
  width: 16rpx;
  height: 16rpx;
  opacity: 0.7;
}

/* 时间间隔指示器 */
/* 时间间隔指示器 - 相对于timeline-node定位 */
.interval-indicator {
  position: absolute;
  top: 0; /* 在timeline-node上方 */
  left: 50%;
  transform: translateX(-50%) translateY(-100%);
  margin-top: -8rpx; /* 与圆圈的间距 */
  font-size: 18rpx;
  color: #808080;
  background: rgba(255, 255, 255, 0.9);
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
  white-space: nowrap;
  z-index: 7; /* 间隔指示器在最上层 */
}

/* 时间刻度 */
.time-scale {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 30rpx;
  z-index: 2;
}

.scale-mark {
  position: absolute;
  top: 0;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.scale-tick {
  width: 1rpx;
  height: 12rpx;
  background: rgba(26, 115, 232, 0.3);
}

.scale-label {
  font-size: 18rpx;
  color: #999999;
  margin-top: 4rpx;
  white-space: nowrap;
}


/* 第二行：进度条和信息 */
.progress-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 当前信息 */
.current-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 120rpx;
}

.current-time {
  font-size: 22rpx;
  font-weight: 600;
  color: #1A73E8;
  line-height: 1.2;
  margin-bottom: 2rpx;
}

.current-position {
  font-size: 18rpx;
  color: #808080;
  line-height: 1.2;
}

/* 进度条容器 */
.progress-container {
  flex: 1;
  margin: 0 10rpx;
}

.progress-track {
  position: relative;
  width: 100%;
  height: 6rpx;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 3rpx;
  overflow: visible;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(to right, #1A73E8, #4285F4);
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.progress-thumb {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  background: #1A73E8;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(26, 115, 232, 0.3);
  transition: left 0.3s ease;
}

/* 时间筛选器 */
.time-filters {
  display: flex;
  gap: 8rpx;
}

.filter-btn {
  padding: 12rpx 16rpx;
  font-size: 18rpx;
  text-align: center;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.05);
  color: #666666;
  transition: all 0.2s ease;
  min-width: 60rpx;
}

.filter-btn.active {
  background: #1A73E8;
  color: #ffffff;
  font-weight: 500;
}

.filter-btn:active {
  transform: scale(0.95);
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .horizontal-timeline-map {
    margin: 20rpx 15rpx;
    padding: 20rpx;
  }
  
  .timeline-track {
    gap: 25rpx;
    padding: 8rpx 15rpx;
  }
  
  .timeline-point {
    min-width: 70rpx;
    padding: 12rpx 8rpx;
  }
  
  .point-time {
    font-size: 18rpx;
  }
  
  .current-time {
    font-size: 20rpx;
  }
  
  .current-position {
    font-size: 16rpx;
  }
  
  .filter-btn {
    font-size: 16rpx;
    padding: 10rpx 12rpx;
    min-width: 50rpx;
  }
}
