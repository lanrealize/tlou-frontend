/* 水平时间地图主容器 */
.horizontal-timeline-map {
  width: 100%;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  margin: 30rpx 20rpx 20rpx 20rpx;
  padding: 25rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

/* 第一行：时间地图 */
.timeline-row {
  margin-bottom: 20rpx;
}

.timeline-scroll-horizontal {
  width: 100%;
  white-space: nowrap;
}

.timeline-track {
  display: inline-flex;
  align-items: center;
  gap: 30rpx;
  padding: 10rpx 20rpx;
  min-width: 100%;
}

/* 时间点 */
.timeline-point {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 80rpx;
  padding: 15rpx 10rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
  cursor: pointer;
}

.timeline-point:active {
  background: rgba(26, 115, 232, 0.05);
  transform: translateY(-2rpx);
}

.timeline-point.current {
  background: rgba(26, 115, 232, 0.1);
  border: 2rpx solid rgba(26, 115, 232, 0.3);
}

/* 时间点标记 */
.point-marker {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.marker-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #d0d0d0;
  border: 2rpx solid #ffffff;
  transition: all 0.3s ease;
  z-index: 2;
}

.marker-dot.active {
  width: 16rpx;
  height: 16rpx;
  background: #1A73E8;
  box-shadow: 0 0 0 4rpx rgba(26, 115, 232, 0.2);
}

.connecting-line {
  position: absolute;
  left: 100%;
  top: 50%;
  transform: translateY(-50%);
  width: 30rpx;
  height: 2rpx;
  background: linear-gradient(to right, #d0d0d0, rgba(208, 208, 208, 0.3));
  z-index: 1;
}

/* 时间点信息 */
.point-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.point-time {
  font-size: 20rpx;
  font-weight: 600;
  color: #1A73E8;
  line-height: 1.2;
  text-align: center;
}

.point-type {
  display: flex;
  align-items: center;
  justify-content: center;
}

.type-icon {
  width: 16rpx;
  height: 16rpx;
  opacity: 0.6;
}

/* 当前指示器脉冲 */
.current-pulse {
  position: absolute;
  top: -5rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  background: #1A73E8;
  border-radius: 50%;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: translateX(-50%) scale(1);
  }
  50% {
    opacity: 0.6;
    transform: translateX(-50%) scale(1.3);
  }
}

/* 第二行：进度条和信息 */
.progress-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 当前信息 */
.current-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 120rpx;
}

.current-time {
  font-size: 22rpx;
  font-weight: 600;
  color: #1A73E8;
  line-height: 1.2;
  margin-bottom: 2rpx;
}

.current-position {
  font-size: 18rpx;
  color: #808080;
  line-height: 1.2;
}

/* 进度条容器 */
.progress-container {
  flex: 1;
  margin: 0 10rpx;
}

.progress-track {
  position: relative;
  width: 100%;
  height: 6rpx;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 3rpx;
  overflow: visible;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(to right, #1A73E8, #4285F4);
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.progress-thumb {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  background: #1A73E8;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(26, 115, 232, 0.3);
  transition: left 0.3s ease;
}

/* 时间筛选器 */
.time-filters {
  display: flex;
  gap: 8rpx;
}

.filter-btn {
  padding: 12rpx 16rpx;
  font-size: 18rpx;
  text-align: center;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.05);
  color: #666666;
  transition: all 0.2s ease;
  min-width: 60rpx;
}

.filter-btn.active {
  background: #1A73E8;
  color: #ffffff;
  font-weight: 500;
}

.filter-btn:active {
  transform: scale(0.95);
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .horizontal-timeline-map {
    margin: 20rpx 15rpx;
    padding: 20rpx;
  }
  
  .timeline-track {
    gap: 25rpx;
    padding: 8rpx 15rpx;
  }
  
  .timeline-point {
    min-width: 70rpx;
    padding: 12rpx 8rpx;
  }
  
  .point-time {
    font-size: 18rpx;
  }
  
  .current-time {
    font-size: 20rpx;
  }
  
  .current-position {
    font-size: 16rpx;
  }
  
  .filter-btn {
    font-size: 16rpx;
    padding: 10rpx 12rpx;
    min-width: 50rpx;
  }
}
