<!-- 水平时间地图导航 -->
<view class="horizontal-timeline-map" wx:if="{{posts && posts.length > 0}}">
  
  <!-- 第一行：时间地图 -->
  <view class="timeline-row">
    <scroll-view class="timeline-scroll-horizontal" scroll-x="{{true}}" show-scrollbar="{{false}}">
      <view class="timeline-container">
        <!-- 时间轴主体 -->
        <view class="timeline-axis">
          <!-- 连续的时间轴线 -->
          <view class="axis-line"></view>
          
          <!-- 动态间距的时间点 -->
          <view 
            class="timeline-node {{currentPostIndex === node.originalIndex ? 'active' : ''}}"
            wx:for="{{timelineNodes}}" 
            wx:key="originalIndex"
            wx:for-index="index"
            wx:for-item="node"
            style="left: {{node.position}}vw"
            bindtap="onTimelinePostTap"
            data-index="{{index}}"
          >
            <!-- 时间点圆圈 -->
            <view class="node-circle">
              <view class="node-dot"></view>
              <view class="node-ring {{currentPostIndex === node.originalIndex ? 'active-ring' : ''}}"></view>
            </view>
            
            <!-- 连接线：从圆圈到标签的稳定连接 -->
            <view class="connector-line"></view>
            
            <!-- 时间标签 -->
            <view class="node-label">
              <view class="node-time">{{node.timeLabel}}</view>
              <view class="node-type">
                <image 
                  class="type-icon" 
                  src="{{node.hasImages ? '/assets/icons/image.svg' : '/assets/icons/text.svg'}}" 
                  mode="aspectFit"
                ></image>
              </view>
            </view>
            
          </view>
        </view>
        
        <!-- 时间刻度参考线 -->
        <view class="time-scale">
          <view class="scale-mark" wx:for="{{timeScale}}" wx:key="time" style="left: {{item.position}}%">
            <view class="scale-tick"></view>
            <view class="scale-label">{{item.label}}</view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 第二行：进度条和信息 -->
  <view class="progress-row">
    <!-- 当前时间信息 -->
    <view class="current-info">
      <text class="current-time">{{currentPostTime}}</text>
      <text class="current-position">{{currentPostIndex + 1}}/{{processedPosts.length}}</text>
    </view>

    <!-- 进度条 -->
    <view class="progress-container">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{progressWidth}}%"></view>
        <view class="progress-thumb" style="left: {{progressWidth}}%"></view>
      </view>
    </view>

    <!-- 时间范围筛选 -->
    <view class="time-filters">
      <view 
        class="filter-btn {{currentFilter === 'all' ? 'active' : ''}}"
        bindtap="onFilterChange"
        data-filter="all"
      >全部</view>
      <view 
        class="filter-btn {{currentFilter === 'today' ? 'active' : ''}}"
        bindtap="onFilterChange"
        data-filter="today"
      >今天</view>
    </view>
  </view>
</view>
