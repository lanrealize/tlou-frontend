<!--components/user-info-popup/user-info-popup.wxml-->
<!-- 遮罩层 -->
<view class="user-info-popup-mask" wx:if="{{visible}}" bindtap="onMaskTap" catchtouchmove="preventMove"></view>

<!-- 弹出层 -->
<view class="user-info-popup {{visible ? 'show' : ''}}">
  <view class="popup-content" catchtouchmove="preventMove">
    
    <form bindsubmit="onFormSubmit">
      <!-- 头部卡片 - 参考 circle-status-action -->
      <view class="header-card">
        <view class="card-layout">
          <view class="left-content">
            <text class="main-title">完善个人信息</text>
            <text class="sub-title">{{rejectReason || '请设置您的头像和昵称'}}</text>
          </view>
          <button 
            form-type="submit" 
            class="action-btn {{canSubmit && !isSubmitting ? '' : 'disabled'}}"
            disabled="{{!canSubmit || isSubmitting}}">
            {{isSubmitting ? '提交中' : '完成'}}
          </button>
        </view>
      </view>

      <!-- 表单内容区域 - 列表样式 -->
      <view class="form-content">
        <!-- 头像选择行 -->
        <button 
          class="setting-item {{isUploadingAvatar ? 'disabled' : ''}}" 
          open-type="chooseAvatar" 
          bind:chooseavatar="onChooseAvatar"
          disabled="{{isUploadingAvatar}}">
          <text class="item-label">头像</text>
          <view class="item-right">
            <!-- 头像容器 -->
            <view class="avatar-container">
              <image 
                class="avatar-preview {{isUploadingAvatar ? 'uploading' : ''}}" 
                src="{{avatarUrl}}" 
                mode="aspectFill"></image>
              <!-- 毛玻璃遮罩 -->
              <view class="avatar-blur-mask" wx:if="{{isUploadingAvatar}}"></view>
            </view>
            
            <!-- 上传状态提示 -->
            <view class="upload-status" wx:if="{{isUploadingAvatar}}">
              <view class="loading-spinner"></view>
              <text class="upload-text">上传中</text>
            </view>
            
            <image class="arrow-icon" src="/assets/icons/right.svg" mode="aspectFit" wx:if="{{!isUploadingAvatar}}"></image>
          </view>
        </button>

        <!-- 昵称输入行 -->
        <view class="setting-item">
          <text class="item-label">昵称</text>
          <view class="item-right">
            <input 
              type="nickname" 
              class="nickname-input" 
              name="nickname"
              placeholder="输入昵称" 
              value="{{nickname}}"
              bindinput="onNicknameInput"
              maxlength="20"
              placeholder-class="input-placeholder"/>
            <image class="arrow-icon" src="/assets/icons/right.svg" mode="aspectFit"></image>
          </view>
        </view>
      </view>
    </form>

  </view>
</view>


