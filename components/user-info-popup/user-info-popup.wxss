/* components/user-info-popup/user-info-popup.wxss */

/* 遮罩层 */
.user-info-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(6px);
  z-index: 998;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.user-info-popup-mask.mask-show {
  opacity: 1;
  pointer-events: auto;
}

.user-info-popup-mask.mask-hide {
  opacity: 0;
  pointer-events: none;
}

/* 弹出层容器 */
.user-info-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  transform: translateY(100%);
  opacity: 0;
}

/* 显示状态 - 和 circle-status-action 一样快 */
.user-info-popup.show {
  transform: translateY(0);
  opacity: 1;
  /* 0.3s 和 circle-status-action 保持一致，无延迟 */
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
              opacity 0.3s ease;
}

/* 隐藏状态 - 快速下沉消失 */
.user-info-popup:not(.show) {
  transform: translateY(100%);
  opacity: 0;
  transition: transform 0.25s cubic-bezier(0.4, 0, 1, 1), 
              opacity 0.2s ease;
}

/* 弹出内容 - 完全参考 circle-status-action 的卡片样式 */
.popup-content {
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0; /* 上面两个圆角，下面直角 */
  box-shadow: 0px -2px 8px rgba(0, 0, 0, 0.1); /* 向上的阴影 */
  overflow: hidden;
  max-height: 85vh;
  overflow-y: auto;
  padding: 0;  /* 移除padding，让子元素自己控制间距 */
}

/* 内容淡入动画 - 和弹出层同步，无延迟 */
.user-info-popup.show .popup-content {
  animation: fadeInUp 0.3s ease-out both;
}

/* 淡入动画 - 参考 circle-status-action */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ========== 头部卡片 - 完全参考 circle-status-action ========== */
.header-card {
  /* 无分割线 */
}

.card-layout {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx 10rpx 40rpx;
  gap: 30rpx;
}

.left-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  min-width: 0;
}

.main-title {
  font-size: 28rpx;
  color: #000000;
  font-weight: 400;
  line-height: 1.5;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sub-title {
  font-size: 24rpx;
  color: #808080;
  font-weight: 400;
  line-height: 1.6;
}

/* 右侧操作按钮 - 严格参考 circle-status-action */
.action-btn {
  color: #1A73E8;
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 400;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
  background: none !important;
  border: none;
  white-space: nowrap;
}

.action-btn::after {
  border: none !important;
  background: none !important;
}

.action-btn:active {
  opacity: 0.7;
  background: none !important;
}

/* 静态按钮（不可点击） */
.action-btn.static {
  pointer-events: none;
}

/* 禁用状态 - 完全参考 circle-status-action */
.action-btn.disabled {
  color: #BDBDBD !important;
  opacity: 0.6;
  background: none !important;
}

/* ========== 表单内容区域 - 列表样式 ========== */
.form-content {
  padding: 0 40rpx;
  margin-bottom: 50rpx;
}

/* 设置项 - 列表行样式 */
.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  background: transparent;
  border: none;
  width: 100%;
  text-align: left;
}

.setting-item::after {
  border: none;
}

.setting-item:active {
  background: rgba(0, 0, 0, 0.02);
}

/* 禁用状态下不变色 */
.setting-item.disabled {
  background: transparent !important;
}

.setting-item.disabled:active {
  background: transparent !important;
}

/* 左侧标签 */
.item-label {
  font-size: 28rpx;
  color: #666666;
  font-weight: 400;
  line-height: normal;
}

/* 右侧内容区域 */
.item-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  justify-content: space-between;
  margin-left: 80rpx;
  min-height: 50rpx; /* 固定最小高度，防止跳动 */
}

/* 头像容器 */
.avatar-container {
  position: relative;
  width: 50rpx;
  height: 50rpx;
  flex-shrink: 0;
}

/* 头像预览 */
.avatar-preview {
  width: 50rpx;
  height: 50rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  flex-shrink: 0;
  display: block;
}

/* 毛玻璃遮罩 */
.avatar-blur-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 8rpx;
  backdrop-filter: blur(4rpx);
  -webkit-backdrop-filter: blur(4rpx);
  background: rgba(255, 255, 255, 0.5);
  z-index: 1;
}

/* 上传状态容器 */
.upload-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  height: 50rpx; /* 固定高度，与头像容器一致 */
}

/* Loading 动画 */
.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #f0f0f0;
  border-top-color: #1A73E8;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  flex-shrink: 0; /* 防止被压缩 */
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 上传文字 */
.upload-text {
  font-size: 28rpx;
  color: #666666;
  font-weight: 400;
  line-height: 1.2; /* 固定行高 */
  white-space: nowrap; /* 防止换行 */
}

/* 右箭头图标 */
.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 1;
  flex-shrink: 0;
  margin-right: 20rpx;
}

/* 昵称输入框 */
.nickname-input {
  font-size: 28rpx;
  color: #000000;
  font-weight: 400;
  text-align: right;
  flex: 1;
  text-align: left;
}

.input-placeholder {
  color: #BDBDBD;
  text-align: left;
}

