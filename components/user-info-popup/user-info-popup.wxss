/* components/user-info-popup/user-info-popup.wxss */

/* 遮罩层 - 完全透明，不影响背景 */
.user-info-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: transparent;
  z-index: 998;
}

/* 弹出层容器 */
.user-info-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
}

.user-info-popup.show {
  transform: translateY(0);
}

/* 弹出内容 - 完全参考 circle-status-action 的卡片样式 */
.popup-content {
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0; /* 上面两个圆角，下面直角 */
  box-shadow: 0px -2px 8px rgba(0, 0, 0, 0.1); /* 向上的阴影 */
  overflow: hidden;
  max-height: 85vh;
  overflow-y: auto;
  padding: 40rpx 30rpx 40rpx;
  animation: fadeInUp 0.3s ease-out;
}

/* 淡入动画 - 参考 circle-status-action */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 头部区域 */
.popup-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  color: #666;
}

/* 操作原因提示 */
.reject-reason {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.reason-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
  font-weight: 500;
}

/* 表单区域 */
.form-section {
  background: #f8f9fa;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
}

/* 头像选择区域 */
.avatar-section {
  text-align: center;
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 25rpx;
}

.avatar-help {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 15rpx;
  text-align: center;
}

.avatar-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto;
  border-radius: 50%;
  overflow: hidden;
  border: none;
  padding: 0;
  background: none;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-tip {
  font-size: 22rpx;
}

/* 昵称填写区域 */
.nickname-section {
  margin-bottom: 10rpx;
}

.input-wrapper {
  position: relative;
  background: white;
  border-radius: 12rpx;
  border: 2rpx solid #e9ecef;
  transition: border-color 0.3s ease;
}

.input-wrapper:focus-within {
  border-color: #667eea;
}

.nickname-input {
  width: 100%;
  padding: 20rpx 18rpx;
  font-size: 28rpx;
  color: #333;
  background: transparent;
  border: none;
  outline: none;
}

.input-placeholder {
  color: #999;
}

.char-count {
  position: absolute;
  right: 18rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx;
  color: #999;
}

/* 按钮区域 */
.button-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.primary-btn {
  background: #007aff;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  font-weight: 600;
}

.primary-btn:disabled {
  opacity: 0.5;
}

.secondary-btn {
  background: white;
  color: #007aff;
  border: 2rpx solid #007aff;
  border-radius: 12rpx;
  padding: 22rpx 0;
  font-size: 28rpx;
}

.secondary-btn:disabled {
  opacity: 0.5;
}

/* 提示信息区域 */
.tip-section {
  padding-top: 20rpx;
}

.tip-text {
  display: block;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

