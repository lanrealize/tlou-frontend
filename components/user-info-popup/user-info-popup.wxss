/* components/user-info-popup/user-info-popup.wxss */

/* 遮罩层 - 完全透明，不影响背景 */
.user-info-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: transparent;
  z-index: 998;
}

/* 弹出层容器 */
.user-info-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  transform: translateY(100%);
  opacity: 0;
}

/* 显示状态 - 和 circle-status-action 一样快 */
.user-info-popup.show {
  transform: translateY(0);
  opacity: 1;
  /* 0.3s 和 circle-status-action 保持一致，无延迟 */
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
              opacity 0.3s ease;
}

/* 隐藏状态 - 快速下沉消失 */
.user-info-popup:not(.show) {
  transform: translateY(100%);
  opacity: 0;
  transition: transform 0.25s cubic-bezier(0.4, 0, 1, 1), 
              opacity 0.2s ease;
}

/* 弹出内容 - 完全参考 circle-status-action 的卡片样式 */
.popup-content {
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0; /* 上面两个圆角，下面直角 */
  box-shadow: 0px -2px 8px rgba(0, 0, 0, 0.1); /* 向上的阴影 */
  overflow: hidden;
  max-height: 85vh;
  overflow-y: auto;
  padding: 40rpx 30rpx 40rpx;
}

/* 内容淡入动画 - 和弹出层同步，无延迟 */
.user-info-popup.show .popup-content {
  animation: fadeInUp 0.3s ease-out both;
}

/* 淡入动画 - 参考 circle-status-action */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ========== 头部卡片 - 完全参考 circle-status-action ========== */
.header-card {
  border-bottom: 1rpx solid #f0f0f0;
}

.card-layout {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  gap: 30rpx;
}

.left-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  min-width: 0;
}

.main-title {
  font-size: 28rpx;
  color: #000000;
  font-weight: 400;
  line-height: 1.5;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sub-title {
  font-size: 24rpx;
  color: #808080;
  font-weight: 400;
  line-height: 1.6;
}

/* 右侧操作按钮 - 严格参考 circle-status-action */
.action-btn {
  color: #1A73E8;
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 400;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
  background: none !important;
  border: none;
  white-space: nowrap;
}

.action-btn::after {
  border: none !important;
  background: none !important;
}

.action-btn:active {
  opacity: 0.7;
  background: none !important;
}

/* 静态按钮（不可点击） */
.action-btn.static {
  pointer-events: none;
}

/* 禁用状态 - 完全参考 circle-status-action */
.action-btn.disabled {
  color: #BDBDBD !important;
  opacity: 0.6;
  background: none !important;
}

/* 覆盖微信button的默认样式 */
.action-btn[disabled] {
  background: none !important;
  color: #BDBDBD !important;
  opacity: 0.6;
}

/* ========== 表单内容区域 ========== */
.form-content {
  padding: 24rpx 40rpx 28rpx;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  gap: 40rpx;
}

.form-item:not(:last-child) {
  border-bottom: 1rpx solid #f5f5f5;
}

.item-label {
  font-size: 28rpx;
  color: #000000;
  font-weight: 400;
  flex-shrink: 0;
}

/* ========== 头像选择器 - 重新设计 ========== */
.avatar-picker {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  background: none;
  border: none;
  padding: 0;
  box-shadow: 0 0 0 2rpx rgba(26, 115, 232, 0.1);
  transition: all 0.2s ease;
}

.avatar-picker::after {
  border: none;
}

.avatar-picker:active {
  transform: scale(0.95);
  box-shadow: 0 0 0 2rpx rgba(26, 115, 232, 0.3);
}

.avatar-image {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-status {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 115, 232, 0.8);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.status-text {
  font-size: 22rpx;
  color: white;
  font-weight: 400;
}

/* ========== 昵称输入框 ========== */
.input-container {
  flex: 1;
  display: flex;
  align-items: center;
}

.nickname-input {
  flex: 1;
  font-size: 28rpx;
  color: #000000;
  text-align: right;
  font-weight: 400;
}

.input-placeholder {
  color: #BDBDBD;
}

