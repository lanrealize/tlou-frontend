<!--components/quota-panel/quota-panel.wxml-->
<!-- 遮罩层 -->
<view class="quota-panel-mask {{visible ? 'mask-show' : 'mask-hide'}}" bindtap="onMaskTap" catchtouchmove="preventMove"></view>

<!-- 弹出层 -->
<view class="quota-panel {{visible ? 'show' : ''}}">
  <view class="panel-content" catchtouchmove="preventMove">
    <!-- 内容区域 - 预留给后续说明和商品推销 -->
    <view class="content-area">
      <!-- 这里将来会放置配额说明和购买入口 -->
    </view>
  </view>
</view>
