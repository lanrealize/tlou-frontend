/* components/post-item/post-item.wxss */

.post-item {
  background-color: #ffffff;
  margin: 20rpx 20rpx 25rpx 25rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 20rpx;
}

.user-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  margin-right: 15rpx;
}

/* 右侧内容区域 */
.post-right-content {
  flex: 1;
  min-width: 0; /* 防止flex子元素溢出 */
  display: flex;
  flex-direction: column;
}

.username {
  font-size: 32rpx;
  color: #000000;
  margin-bottom: 8rpx;
}

.post-meta {
  display: flex;
  align-items: center;
}

.post-time {
  font-size: 28rpx;
  color: #808080;
}

.post-location {
  font-size: 26rpx;
  color: #808080;
}

/* 三点操作按钮容器 */
.actions-menu-container {
  position: relative;
}

/* 三点操作按钮 */
.actions-menu-btn {
  width: 90rpx;
  height: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F0F5FF;
  border-radius: 5rpx;
  transition: all 0.2s ease;
  position: relative;
  z-index: 5;
}

.actions-menu-btn:active {
  background-color: #f0f0f0;
  transform: scale(0.95);
}

.menu-dots-icon {
  width: 42rpx;
  height: 42rpx;
}

/* 下拉式操作菜单 */
.dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9;
  background-color: transparent;
  opacity: 0;
  visibility: hidden;
  transition: all 0.2s ease;
}

.dropdown-mask.show {
  opacity: 1;
  visibility: visible;
}

.dropdown-mask.hide {
  opacity: 0;
  visibility: hidden;
}

.dropdown-menu {
  position: absolute;
  right: 110%;
  top: 0;
  background-color: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0rpx 4rpx 12rpx rgba(0, 0, 0, 0.15);
  z-index: 10;
  overflow: hidden;
  opacity: 0;
  visibility: hidden;
  transform: scale(0.8) translateY(-10rpx);
  transform-origin: top right;
  transition: all 0.25s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.dropdown-menu.show {
  opacity: 1;
  visibility: visible;
  transform: scale(1) translateY(0);
}

.dropdown-menu.hide {
  opacity: 0;
  visibility: hidden;
  transform: scale(0.8) translateY(-10rpx);
}

/* 窄菜单样式 - 用于"点赞"状态，居中对齐 */
.dropdown-menu.narrow-menu .dropdown-item {
  justify-content: center;
  padding: 24rpx 34rpx;
  min-width: 160rpx;
}

/* 宽菜单样式 - 用于"取消点赞"状态，左对齐 */
.dropdown-menu.wide-menu .dropdown-item {
  justify-content: flex-start;
  padding: 24rpx 36rpx;
  min-width: 200rpx;
}

.dropdown-item {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  transition: background-color 0.2s ease;
}

.dropdown-item:active {
  background-color: #f5f5f5;
}

.dropdown-item.delete-item:active {
  background-color: #ffebee;
}

.dropdown-icon {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}

/* 点赞图标 - 向下微调以视觉居中 */
.dropdown-icon.like-icon-dropdown {
  position: relative;
  top: 2rpx;
}

/* 编辑/评论图标 - 稍微放大并横向拉伸以匹配视觉大小 */
.dropdown-icon.comment-icon {
  width: 40rpx;
  height: 38rpx;
  transform: scaleX(1.1);
  filter: brightness(0) saturate(100%) invert(21%) sepia(86%) saturate(1780%) hue-rotate(206deg) brightness(99%) contrast(92%);
}

.dropdown-text {
  font-size: 28rpx;
  color: #333333;
  white-space: nowrap;
  flex-shrink: 0;
}

.dropdown-item.delete-item .dropdown-text {
  color: #f44336;
}

/* 帖子内容区域 */
.post-content {
  text-align: left;
}

.post-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #000000;
  margin-bottom: 25rpx;
  word-wrap: break-word;
  margin-top: 8rpx;
}

/* 图片区域 */
.post-images {
  margin-bottom: 10rpx;
  max-width: 100%;
}

/* 当没有文字内容时（图片是post-content的第一个子元素），增加顶部间距 */
.post-content > .post-images:first-child {
  margin-top: 20rpx;
}

/* 当有文字内容时，图片紧跟在文字后面，不需要额外顶部间距 */
.post-text + .post-images {
  margin-top: 0;
}

/* 单张图片容器 */
.single-image {
  border-radius: 6rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 精确的尺寸由内联样式动态设置，提供占位背景 */
  background-color: #f8f8f8;
  position: relative;
}

.post-image-single {
  border-radius: 10rpx;
  display: block;
  /* 图片在容器内居中显示 */
  max-width: 100%;
  max-height: 100%;
}

/* 纵向图片样式 - heightFix模式，高度固定460rpx */
.post-image-single.portrait {
  height: 460rpx;
  max-width: 500rpx;
  width: auto;
}

/* 横向图片样式 - widthFix模式，宽度固定500rpx */
.post-image-single.landscape {
  width: 500rpx;
  max-height: 460rpx;
  height: auto;
}

/* 多张图片网格 - 参考 publish 页面的布局系统 */

/* 2张图片：使用Grid布局，两列等宽 */
.images-grid-2 {
  display: grid;
  width: 100%;
  max-width: 500rpx; /* 与单张横向照片最大宽度一致 */
  gap: 16rpx;
  box-sizing: border-box;
  grid-template-columns: 1fr 1fr;
  margin-bottom: 10rpx;
}

.images-grid-2 .grid-item {
  width: 100%;
  aspect-ratio: 1;
  height: 0;
  padding-bottom: 100%; /* 创建正方形 */
}

/* 3-9张图片：九宫格布局，使用Grid布局 */
.images-grid-3,
.images-grid-4,
.images-grid-5,
.images-grid-6,
.images-grid-7,
.images-grid-8,
.images-grid-9 {
  display: grid;
  grid-template-columns: repeat(3, 1fr); /* 3列等宽 */
  grid-gap: 16rpx; /* 使用grid-gap确保兼容性，横向和纵向间距统一 */
  row-gap: 16rpx; /* 显式设置行间距 */
  column-gap: 16rpx; /* 显式设置列间距 */
  width: 100%;
  max-width: 500rpx; /* 与单张横向照片最大宽度一致 */
  box-sizing: border-box;
  margin-bottom: 10rpx;
  padding: 0;
}

/* 九宫格中的每个图片项 - 使用padding-bottom技巧确保正方形 */
.images-grid-3 .grid-item,
.images-grid-4 .grid-item,
.images-grid-5 .grid-item,
.images-grid-6 .grid-item,
.images-grid-7 .grid-item,
.images-grid-8 .grid-item,
.images-grid-9 .grid-item {
  width: 100%;
  height: 0;
  padding-bottom: 100%; /* 创建正方形比例 */
  position: relative;
  margin: 0; /* 确保没有额外的margin */
}

/* 统一的图片容器样式 */
.grid-item {
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #f5f5f5;
  box-sizing: border-box;
}

/* 图片元素样式 - 基础样式 */
.post-image-grid {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* 2-9张图片使用padding-bottom技巧，图片需要绝对定位 */
.images-grid-2 .grid-item .post-image-grid,
.images-grid-3 .grid-item .post-image-grid,
.images-grid-4 .grid-item .post-image-grid,
.images-grid-5 .grid-item .post-image-grid,
.images-grid-6 .grid-item .post-image-grid,
.images-grid-7 .grid-item .post-image-grid,
.images-grid-8 .grid-item .post-image-grid,
.images-grid-9 .grid-item .post-image-grid {
  position: absolute;
  top: 0;
  left: 0;
}

.more-images-tip {
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 8rpx;
  position: absolute;
  top: 0;
  left: 0;
}

/* ===== 图片骨架屏样式 ===== */

/* 骨架屏基础样式 */
.image-skeleton {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  border-radius: inherit;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  z-index: 2;
}

.image-skeleton.show {
  opacity: 1;
  visibility: visible;
}

/* 骨架屏动画效果 */
.skeleton-shimmer {
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.6) 50%,
    transparent 100%
  );
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% {
    left: -100%;
  }
  100% {
    left: 100%;
  }
}

/* 单张图片骨架屏 */
.single-skeleton {
  border-radius: 6rpx;
}

/* 网格图片骨架屏 */
.grid-skeleton {
  border-radius: 6rpx;
}

/* 图片加载状态样式 */
.post-image-single.loading,
.post-image-grid.loading {
  opacity: 0;
  transition: opacity 0.3s ease;
}

.post-image-single.loaded,
.post-image-grid.loaded {
  opacity: 1;
  transition: opacity 0.3s ease;
}

/* 帖子时间地点和操作按钮区域 */
.post-bottom-meta {
  margin-top: 25rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 10rpx;
}

/* 帖子底部 */
.post-footer {
  padding-top: 20rpx;
}

/* 点赞区域 */
.likes-section {
  margin-bottom: 30rpx;
}

.likes-container {
  display: flex;
  align-items: center;
  padding: 0;
  background-color: transparent;
  border-radius: 0;
}

.like-icon {
  width: 32rpx;
  height: 28rpx;
  margin-right: 25rpx;
  margin-left: 5rpx;
}

.likes-text {
  font-size: 26rpx;
  color: #808080;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.liked-username {
  color: #000000;
  font-weight: 500;
}

/* 评论区域 */
.comments-section {
  margin-bottom: 10rpx;
}

.comments-container {
  background-color: transparent;
  padding: 0;
}

.comment-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.comment-item:last-child {
  margin-bottom: 0;
}

/* 当存在toggle按钮时，最后一个评论项也不需要底部边距 */
.comment-item:last-of-type {
  margin-bottom: 0;
}

/* 评论头像 */
.comment-avatar {
  width: 38rpx;
  height: 38rpx;
  border-radius: 19rpx;
  flex-shrink: 0;
  margin-right: 25rpx;
}

/* 评论内容包装器 */
.comment-content-wrapper {
  flex: 1;
  min-width: 0;
}

/* 评论头部：用户名和时间 */
.comment-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 38rpx;
}

.comment-author {
  color: #808080;
  font-weight: 500;
  font-size: 26rpx;
}

.comment-time {
  font-size: 26rpx;
  color: #808080;
}

/* 评论内容 */
.comment-content {
  line-height: 1.4;
  word-wrap: break-word;
  margin-bottom: 5rpx;
}

.comment-text-flow {
  font-size: 26rpx;
  color: #000000;
  line-height: 1.4;
  word-wrap: break-word;
  display: inline;
}

.comment-main-text {
  font-size: 26rpx;
  color: #000000;
  line-height: inherit;
  word-wrap: break-word;
  margin-right: 32rpx;
}

.comment-space {
  white-space: pre;
}

.comment-actions-container {
  display: inline-block;
  vertical-align: baseline;
  white-space: nowrap;
}

.comment-separator {
  color: #333333;
}

.reply-indicator {
  color: #808080;
  font-size: 26rpx;
}

.reply-target {
  color: #1A73E8;
  font-weight: 500;
  font-size: 26rpx;
}

/* 具体回复内容另起一行 */
.comment-main-content {
  width: 100%;
  margin-top: 8rpx;
}

/* 回复按钮 */
.reply-btn {
  font-size: 26rpx;
  color: #808080;
  padding: 2rpx 0rpx;
  border-radius: 4rpx;
  transition: all 0.2s ease;
  white-space: nowrap;
  line-height: 1.4;
  display: inline;
}

.reply-btn:active {
  background-color: rgba(87, 107, 149, 0.1);
  transform: scale(0.95);
}

.delete-comment-btn {
  width: 28rpx;
  height: 28rpx;
  border-radius: 4rpx;
  transition: all 0.2s ease;
  vertical-align: middle;
  margin-left: 30rpx;
  display: inline-block;
}

.delete-comment-btn:active {
  background-color: #ffebee;
  transform: scale(0.9);
}

.comments-toggle {
  display: flex;
  align-items: center;
  text-align: left;
  line-height: 1;
  gap: 16rpx;
  margin-top: 30rpx;
}

.toggle-dash {
  width: 40rpx;
  height: 2rpx;
  background-color: #E5E5E5;
  flex-shrink: 0;
}

.toggle-text {
  font-size: 26rpx;
  color: #000000;
  line-height: 1;
  padding-left: 7rpx;
}

.toggle-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

/* 响应式调整 - 小屏幕优化 */
@media (max-width: 400px) {
  /* 2张图片的小屏幕适配 */
  .images-grid-2 {
    gap: 14rpx;
  }
  
  .images-grid-2 .grid-item {
    width: 100%;
    height: 0;
    padding-bottom: 100%; /* 小屏幕正方形 */
  }
  
  /* 3-9张图片的小屏幕适配 */
  .images-grid-3,
  .images-grid-4,
  .images-grid-5,
  .images-grid-6,
  .images-grid-7,
  .images-grid-8,
  .images-grid-9 {
    grid-gap: 14rpx; /* 小屏幕统一间距 */
    row-gap: 14rpx; /* 显式设置行间距 */
    column-gap: 14rpx; /* 显式设置列间距 */
  }
  
  /* 小屏幕下图片项样式与主样式保持一致 */
  .images-grid-3 .grid-item,
  .images-grid-4 .grid-item,
  .images-grid-5 .grid-item,
  .images-grid-6 .grid-item,
  .images-grid-7 .grid-item,
  .images-grid-8 .grid-item,
  .images-grid-9 .grid-item {
    width: 100%;
    height: 0;
    padding-bottom: 100%; /* 确保正方形 */
    position: relative;
    margin: 0; /* 确保没有额外的margin */
  }
}
/* 🚀 上传状态样式 */
.upload-status-bar {
  margin-top: 20rpx;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%);
  width: 500rpx;
  box-sizing: border-box;
}

/* 当有文字内容时的 margin-bottom */
.upload-status-bar.has-text {
  margin-bottom: 23rpx;
}

/* 当没有文字内容时的 margin-bottom */
.upload-status-bar.no-text {
  margin-bottom: 32rpx;
}

/* 上传中指示器 */
.uploading-indicator {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 20rpx;
}

.uploading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #e8ecf1;
  border-top-color: #1890ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.status-text {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 500;
}

/* 上传失败指示器 */
.upload-failed-indicator {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 20rpx;
}

.error-icon {
  width: 32rpx;
  height: 32rpx;
  filter: brightness(0) saturate(100%) invert(32%) sepia(96%) saturate(3213%) hue-rotate(346deg) brightness(91%) contrast(94%);
}

.error-text {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: 500;
}

/* 上传中的图片样式 */
.post-image-single.uploading,
.post-image-grid.uploading {
  opacity: 0.6;
  filter: blur(1px);
}
