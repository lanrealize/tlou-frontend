/* components/post-item/post-item.wxss */

.post-item {
  background-color: #ffffff;
  margin: 20rpx 20rpx 25rpx 25rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 20rpx;
}

.user-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  margin-right: 15rpx;
}

/* 右侧内容区域 */
.post-right-content {
  flex: 1;
  min-width: 0; /* 防止flex子元素溢出 */
  display: flex;
  flex-direction: column;
}

.username {
  font-size: 32rpx;
  color: #000000;
  margin-bottom: 8rpx;
}

.post-meta {
  display: flex;
  align-items: center;
}

.post-time {
  font-size: 28rpx;
  color: #808080;
}

.post-location {
  font-size: 26rpx;
  color: #808080;
}

/* 三点操作按钮 */
.actions-menu-btn {
  width: 80rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F0F5FF;
  border-radius: 5rpx;
  transition: all 0.2s ease;
}

.actions-menu-btn:active {
  background-color: #f0f0f0;
  transform: scale(0.95);
}

.menu-dots-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 弹出式操作菜单 */
.actions-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.actions-popup.show {
  opacity: 1;
  visibility: visible;
}

.popup-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.popup-content {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin: 0 40rpx;
  min-width: 300rpx;
  box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.2);
  transform: scale(0.8);
  transition: transform 0.3s ease;
}

.actions-popup.show .popup-content {
  transform: scale(1);
}

.popup-action-btn {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  transition: background-color 0.2s ease;
}

.popup-action-btn:last-child {
  margin-bottom: 0;
}

.popup-action-btn:active {
  background-color: #f0f0f0;
}

.popup-action-btn.delete-action:active {
  background-color: #ffebee;
}

.popup-action-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 40rpx;
  text-align: center;
}

.popup-action-text {
  font-size: 32rpx;
  color: #333333;
  flex: 1;
}

.popup-action-btn.delete-action .popup-action-text {
  color: #f44336;
}

/* 帖子内容区域 */
.post-content {
  text-align: left;
}

.post-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #000000;
  margin-bottom: 25rpx;
  word-wrap: break-word;
}

/* 图片区域 */
.post-images {
  margin-bottom: 10rpx;
  max-width: 100%;
}

/* 单张图片 */
.single-image {
  border-radius: 6rpx;
  overflow: hidden;
  display: block;
}

.post-image-single {
  border-radius: 10rpx;
  display: block;
}

/* 纵向图片样式 - heightFix模式，高度固定460rpx */
.post-image-single.portrait {
  height: 460rpx;
  max-width: 500rpx;
}

/* 横向图片样式 - widthFix模式，宽度固定560rpx */
.post-image-single.landscape {
  width: 560rpx;
  max-height: 460rpx;
}

/* 多张图片网格 */
.images-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.grid-item {
  border-radius: 6rpx;
  overflow: hidden;
}

.grid-item.two-cols {
  width: calc((100% - 6rpx) / 2);
  height: 220rpx;
}

.grid-item.three-cols {
  width: calc((100% - 12rpx) / 3);
  height: 140rpx;
}

.post-image-grid {
  width: 100%;
  height: 100%;
  display: block;
}

.more-images-tip {
  width: calc((100% - 12rpx) / 3);
  height: 140rpx;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 6rpx;
}

/* 帖子时间地点和操作按钮区域 */
.post-bottom-meta {
  margin-top: 25rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 10rpx;
}

/* 帖子底部 */
.post-footer {
  padding-top: 20rpx;
}

/* 点赞区域 */
.likes-section {
  margin-bottom: 30rpx;
}

.likes-container {
  display: flex;
  align-items: center;
  padding: 0;
  background-color: transparent;
  border-radius: 0;
}

.like-icon {
  width: 32rpx;
  height: 28rpx;
  margin-right: 25rpx;
  margin-left: 5rpx;
}

.likes-text {
  font-size: 26rpx;
  color: #808080;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.liked-username {
  color: #000000;
  font-weight: 500;
}

/* 评论区域 */
.comments-section {
  margin-bottom: 10rpx;
}

.comments-container {
  background-color: transparent;
  padding: 0;
}

.comment-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.comment-item:last-child {
  margin-bottom: 0;
}

/* 当存在toggle按钮时，最后一个评论项也不需要底部边距 */
.comment-item:last-of-type {
  margin-bottom: 0;
}

/* 评论头像 */
.comment-avatar {
  width: 38rpx;
  height: 38rpx;
  border-radius: 19rpx;
  flex-shrink: 0;
  margin-right: 25rpx;
}

/* 评论内容包装器 */
.comment-content-wrapper {
  flex: 1;
  min-width: 0;
}

/* 评论头部：用户名和时间 */
.comment-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 38rpx;
}

.comment-author {
  color: #808080;
  font-weight: 500;
  font-size: 26rpx;
}

.comment-time {
  font-size: 26rpx;
  color: #808080;
}

/* 评论内容 */
.comment-content {
  line-height: 1.4;
  word-wrap: break-word;
  margin-bottom: 5rpx;
}

.comment-text-flow {
  font-size: 26rpx;
  color: #000000;
  line-height: 1.4;
  word-wrap: break-word;
  display: inline;
}

.comment-main-text {
  font-size: 26rpx;
  color: #000000;
  line-height: inherit;
  word-wrap: break-word;
  margin-right: 32rpx;
}

.comment-space {
  white-space: pre;
}

.comment-actions-container {
  display: inline-block;
  vertical-align: baseline;
  white-space: nowrap;
}

.comment-separator {
  color: #333333;
}

.comment-main-text {
  color: #000000;
}



.reply-indicator {
  color: #808080;
  font-size: 26rpx;
}

.reply-target {
  color: #1A73E8;
  font-weight: 500;
  font-size: 26rpx;
}

/* 具体回复内容另起一行 */
.comment-main-content {
  width: 100%;
  margin-top: 8rpx;
}

/* 回复按钮 */
.reply-btn {
  font-size: 26rpx;
  color: #808080;
  padding: 2rpx 0rpx;
  border-radius: 4rpx;
  transition: all 0.2s ease;
  white-space: nowrap;
  line-height: 1.4;
  display: inline;
}

.reply-btn:active {
  background-color: rgba(87, 107, 149, 0.1);
  transform: scale(0.95);
}

.delete-comment-btn {
  width: 28rpx;
  height: 28rpx;
  border-radius: 4rpx;
  transition: all 0.2s ease;
  vertical-align: middle;
  margin-left: 30rpx;
  display: inline-block;
}

.delete-comment-btn:active {
  background-color: #ffebee;
  transform: scale(0.9);
}

.comments-toggle {
  display: flex;
  align-items: center;
  text-align: left;
  line-height: 1;
  gap: 16rpx;
  margin-top: 30rpx;
}

.toggle-dash {
  width: 40rpx;
  height: 2rpx;
  background-color: #E5E5E5;
  flex-shrink: 0;
}

.toggle-text {
  font-size: 26rpx;
  color: #000000;
  line-height: 1;
  padding-left: 7rpx;
}

.toggle-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}



/* 动画效果 */
@keyframes heartbeat {
  0% { transform: scale(1); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}