<!--components/post-item/post-item.wxml-->
<view class="post-item card-shadow" bindlongpress="onLongPress">
  <!-- 帖子头部：头像和用户信息 -->
  <view class="post-header">
    <image 
      class="user-avatar" 
      src="{{post.author.avatar || '/images/default_avatar.png'}}" 
      mode="aspectFill"
      bindtap="onTapAvatar"
    ></image>
    
    <view class="user-info">
      <view class="username">{{post.author.username || post.author.name || '未知用户'}}</view>
      <view class="post-meta">
        <text class="post-time">{{post.formattedTime || '刚刚'}}</text>
        <text class="post-location" wx:if="{{post.location}}">· {{post.location}}</text>
      </view>
    </view>
    
    <!-- 删除按钮（仅作者可见） -->
    <view 
      class="delete-btn" 
      wx:if="{{showActions && currentUser._id === post.author._id}}"
      bindtap="onDeletePost"
    >
      <text class="delete-icon">×</text>
    </view>
  </view>

  <!-- 帖子内容区域 -->
  <view class="post-content">
    <!-- 文字内容 -->
    <view class="post-text" wx:if="{{post.content}}">
      <text>{{post.content}}</text>
    </view>

    <!-- 图片内容 -->
    <view class="post-images" wx:if="{{post.images && post.images.length > 0}}">
      <!-- 单张图片 -->
      <view class="single-image" wx:if="{{post.images.length === 1}}">
        <image 
          class="post-image-single" 
          src="{{post.images[0]}}" 
          mode="widthFix"
          bindtap="onPreviewImage"
          data-current="{{post.images[0]}}"
        ></image>
      </view>

      <!-- 多张图片网格 -->
      <view class="images-grid" wx:else>
        <view 
          class="grid-item {{post.images.length === 2 ? 'two-cols' : post.images.length === 4 ? 'two-cols' : 'three-cols'}}"
          wx:for="{{post.images}}" 
          wx:key="*this"
          wx:if="{{index < 9}}"
        >
          <image 
            class="post-image-grid" 
            src="{{item}}" 
            mode="aspectFill"
            bindtap="onPreviewImage"
            data-current="{{item}}"
          ></image>
        </view>
        
        <!-- 更多图片提示 -->
        <view class="more-images-tip" wx:if="{{post.images.length > 9}}">
          <text>+{{post.images.length - 9}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 帖子底部：点赞和评论 -->
  <view class="post-footer">
    <!-- 点赞列表 -->
    <view class="likes-section" wx:if="{{post.likes && post.likes.length > 0}}">
      <view class="likes-container">
        <text class="like-icon">❤️</text>
        <text class="likes-text">{{post.likes.length}}人觉得很赞</text>
      </view>
    </view>

    <!-- 评论列表 -->
    <view class="comments-section" wx:if="{{post.comments && post.comments.length > 0}}">
      <view class="comments-container">
        <!-- 显示部分评论 -->
        <view 
          class="comment-item" 
          wx:for="{{displayComments}}" 
          wx:for-item="comment" 
          wx:key="_id"
        >
          <!-- 评论内容区域 - 可点击回复 -->
          <view class="comment-content-wrapper" 
                catchtap="onReplyComment"
                data-user-id="{{comment.author ? comment.author._id : ''}}"
                data-username="{{comment.author ? (comment.author.username || comment.author.name) : '匿名用户'}}">
            
            <view class="comment-content-inner">
              <!-- 如果是回复用户的评论 -->
              <text wx:if="{{comment.replyTo}}" class="comment-content">
                <text class="comment-author theme-color">{{comment.author ? (comment.author.username || comment.author.name || '匿名用户') : '匿名用户'}}</text>
                <text class="reply-indicator"> 回复 </text>
                <text class="reply-target theme-color">{{comment.replyTo.username || comment.replyTo.name || '未知用户'}}</text>
                <text class="reply-separator">: </text>
                <text class="comment-text">{{comment.content || '内容为空'}}</text>
              </text>
              
              <!-- 如果是直接评论帖子 -->
              <text wx:else class="comment-content">
                <text class="comment-author theme-color">{{comment.author ? (comment.author.username || comment.author.name || '匿名用户') : '匿名用户'}}</text>
                <text class="comment-separator">: </text>
                <text class="comment-text">{{comment.content || '内容为空'}}</text>
              </text>
            </view>
            
            <!-- 点击提示图标 -->
            <view class="tap-hint">
              <text class="tap-hint-icon">💬</text>
            </view>
          </view>
          
          <view class="comment-meta">
            <text class="comment-time">{{comment.formattedTime || '刚刚'}}</text>
            
            <!-- 删除评论按钮 -->
            <text 
              class="delete-comment-btn" 
              wx:if="{{showActions && comment.author && currentUser._id && currentUser._id === comment.author._id}}"
              catchtap="onDeleteComment"
              data-comment-id="{{comment._id}}"
            >删除</text>
          </view>
        </view>

        <!-- 展开/收起评论 -->
        <view 
          class="comments-toggle" 
          wx:if="{{post.comments.length > maxCommentsShow}}"
          bindtap="toggleComments"
        >
          <text class="toggle-text theme-color">
            {{commentsExpanded ? '收起评论' : '查看全部' + post.comments.length + '条评论'}}
          </text>
        </view>
      </view>
    </view>



    <!-- 操作按钮区域 -->
    <view class="actions-section">
      <view class="action-btn" bindtap="onLike">
        <text class="action-icon {{post.isLiked ? 'liked' : ''}}">{{post.isLiked ? '❤️' : '🤍'}}</text>
        <text class="action-text {{post.isLiked ? 'liked' : ''}}">{{post.isLiked ? '已赞' : '点赞'}} ({{post.likes.length}})</text>
      </view>
      
      <view class="action-btn" bindtap="onComment">
        <text class="action-icon">💬</text>
        <text class="action-text">评论 ({{post.comments ? post.comments.length : 0}})</text>
      </view>
    </view>
  </view>
</view>