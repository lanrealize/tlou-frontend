<!--components/post-item/post-item.wxml-->
<view class="post-item {{isFirst ? 'first-item' : ''}} {{timelineMode ? 'timeline-mode' : ''}} {{onboardingMode ? 'onboarding-mode' : ''}}" id="post-{{post._id}}">
  
  <!-- 时间轴模式：时间线背景 -->
  <view class="timeline-line" wx:if="{{timelineMode}}"></view>
  
  <!-- 时间轴模式：节点圆点（Grid 直接子元素） -->
  <view class="node-dot" wx:if="{{timelineMode}}"></view>
  
  <!-- 时间轴模式：头部信息 -->
  <view class="timeline-header" wx:if="{{timelineMode}}">
    <view class="timeline-info">

      <!-- 模式1：AI 帖子 → 只有 AI 头像 + 时间 -->
      <block wx:if="{{post.author.isAI}}">
        <ai-avatar mode="static" size="28"></ai-avatar>
        <text class="timeline-separator">·</text>
        <text class="timeline-time">{{post.formattedTime || '刚刚'}}</text>
      </block>

      <!-- 模式2：资料完整的已登录用户 → 头像 + 用户名 + 时间 -->
      <block wx:elif="{{post.author.username && post.author.avatar}}">
        <image
          class="timeline-avatar"
          src="{{post.author.avatar}}"
          mode="aspectFill"
          bindtap="onTapAvatar"
        ></image>
        <text class="timeline-separator">·</text>
        <text class="timeline-username">{{post.author.username}}</text>
        <text class="timeline-separator">·</text>
        <text class="timeline-time">{{post.formattedTime || '刚刚'}}</text>
      </block>

      <!-- 模式3：资料未完善 → "你" + 时间，无头像 -->
      <block wx:else>
        <text class="timeline-username">你</text>
        <text class="timeline-separator">·</text>
        <text class="timeline-time">{{post.formattedTime || '刚刚'}}</text>
      </block>

    </view>
    
    <view class="actions-menu-container" wx:if="{{!onboardingMode}}">
      <view id="postActionsBtn" class="actions-menu-btn" bindtap="toggleActionsMenu">
        <image class="menu-dots-icon" src="/assets/icons/more.svg" mode="aspectFit"></image>
      </view>
      
      <view class="dropdown-menu {{showActions && showActionsMenu ? 'show' : 'hide'}} {{isLiked ? 'wide-menu' : 'narrow-menu'}}">
        <view id="likeBtn" class="dropdown-item" catchtap="onLikeFromPopup">
          <view class="dropdown-icon-wrap"><image class="dropdown-icon like-icon-dropdown" src="/assets/icons/like.svg" mode="aspectFit"></image></view>
          <text class="dropdown-text">{{isLiked ? '取消点赞' : '点赞'}}</text>
        </view>

        <view id="commentBtn" class="dropdown-item" catchtap="onCommentFromPopup">
          <view class="dropdown-icon-wrap"><image class="dropdown-icon comment-icon" src="/assets/icons/edit.svg" mode="aspectFit"></image></view>
          <text class="dropdown-text">评论</text>
        </view>

        <view
          id="deletePostBtn"
          class="dropdown-item delete-item"
          wx:if="{{currentUser && currentUser._id && post.author && post.author._id && currentUser._id === post.author._id}}"
          catchtap="onDeleteFromPopup"
        >
          <view class="dropdown-icon-wrap"><image class="dropdown-icon" src="/assets/icons/delete.svg" mode="aspectFit"></image></view>
          <text class="dropdown-text">删除</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 🗑️ 已移除：普通模式用户头像（AI-only 模式只使用时间轴布局） -->
  
  <view class="post-right-content">
    <!-- 🗑️ 已移除：普通模式用户信息头部（AI-only 模式只使用时间轴布局） -->

    <!-- 帖子内容区域 -->
    <view class="post-content">
    <!-- 🚀 上传状态提示 -->
    <view class="upload-status-bar {{post.content ? 'has-text' : 'no-text'}} {{post._isUploading || post._uploadFailed ? '' : 'upload-status-bar-hidden'}}">
      <!-- 上传中（只在未失败时显示） -->
      <view class="uploading-indicator" wx:if="{{post._isUploading && !post._uploadFailed}}">
        <view class="uploading-spinner"></view>
        <text class="status-text">正在发布...</text>
      </view>

      <!-- 上传失败 -->
      <view class="upload-failed-indicator" wx:if="{{post._uploadFailed}}">
        <image class="error-icon" src="/assets/icons/delete.svg" mode="aspectFit"></image>
        <text class="error-text">{{post._errorMessage || '发布失败'}}</text>
      </view>
    </view>

    <!-- 文字内容 -->
    <view class="post-text-container {{textAnimating ? 'animating' : ''}}" wx:if="{{post.content}}">
      <!-- 展开状态或不需要折叠：完整文字 + inline按钮 -->
      <block wx:if="{{textExpanded || !needTextToggle}}">
        <text class="post-text">{{post.content}}</text>
        <text 
          class="text-toggle-btn" 
          wx:if="{{needTextToggle && textExpanded}}"
          catchtap="toggleText"
        >收起</text>
      </block>
      
      <!-- 折叠状态：截断文字 + "..." + inline按钮 -->
      <block wx:if="{{!textExpanded && needTextToggle}}">
        <text class="post-text">{{collapsedText}}...</text>
        <text 
          class="text-toggle-btn" 
          catchtap="toggleText"
        >全文</text>
      </block>
    </view>

    <!-- 图片内容 -->
    <!-- ✅ 使用 class 控制 opacity，而不是 wx:if，确保图片能加载 -->
    <!-- onboarding 模式：视频替代图片 -->
    <view class="post-images onboarding-video-wrap" wx:if="{{onboardingMode && post.videoUrl}}">
      <video
        id="onboarding-video"
        src="{{post.videoUrl}}"
        muted
        show-play-btn="{{false}}"
        show-center-play-btn="{{false}}"
        controls="{{false}}"
        objectFit="cover"
        style="width: 100%; height: 400rpx; border-radius: 20rpx; display: block;"
        bindplay="onVideoCanPlay"
        bindended="onVideoEnded"
        binderror="onVideoError"
      ></video>
      <!-- 黑色遮罩 + loading -->
      <view class="video-overlay {{videoReady ? 'video-overlay-hidden' : ''}}">
        <view class="video-loading-spinner" wx:if="{{showVideoLoading}}"></view>
      </view>
    </view>
    <view class="post-images {{hideImage ? 'post-images-hidden' : ''}}" wx:elif="{{post.images && post.images.length > 0}}">
      <!-- 单张图片 -->
      <view class="single-image" wx:if="{{post.images.length === 1}}"
            style="width: {{singleImageInfo.displayWidth}}rpx; height: {{singleImageInfo.displayHeight}}rpx;">
        <!-- 骨架屏占位 -->
        <view class="image-skeleton single-skeleton {{imageLoadStates[post.images[0].url || post.images[0]] === 'show' ? '' : 'show'}}">
          <view class="skeleton-shimmer"></view>
        </view>

        <image
          id="post-image-{{post._id}}-0"
          class="post-image-single {{singleImageInfo.styleClass}} {{imageLoadStates[post.images[0].url || post.images[0]] === 'show' ? 'loaded' : 'loading'}} {{post._isUploading ? 'uploading' : ''}}"
          src="{{localImagePath || post.images[0].url || post.images[0]}}"
          mode="{{singleImageInfo.mode}}"
          bindload="onSingleImageLoad"
          binderror="onImageError"
          bindtap="onPreviewImage"
          data-current="{{localImagePath || post.images[0].url || post.images[0]}}"
          data-src="{{localImagePath || post.images[0].url || post.images[0]}}"
          wx:if="{{post.images[0]}}"
        ></image>
      </view>

      <!-- 多张图片网格（不受hideImage影响，多图模式不会被分享动画使用） -->
      <view class="images-grid images-grid-{{post.images.length > 9 ? 9 : post.images.length}}" wx:else>
        <view 
          class="grid-item"
          wx:for="{{post.images}}" 
          wx:key="url"
          wx:for-index="imgIndex"
          wx:if="{{imgIndex < 9}}"
        >
          <!-- 网格图片骨架屏 -->
          <view class="image-skeleton grid-skeleton {{imageLoadStates[item.url || item] === 'show' ? '' : 'show'}}">
            <view class="skeleton-shimmer"></view>
          </view>
          
          <image 
            id="post-image-{{post._id}}-{{imgIndex}}"
            class="post-image-grid {{imageLoadStates[item.url || item] === 'show' ? 'loaded' : 'loading'}} {{post._isUploading ? 'uploading' : ''}}" 
            src="{{item.url || item}}" 
            mode="aspectFill"
            bindload="onGridImageLoad"
            binderror="onImageError"
            bindtap="onPreviewImage"
            data-current="{{item.url || item}}"
            data-src="{{item.url || item}}"
            wx:if="{{item}}"
          ></image>
        </view>
        
        <!-- 更多图片提示 -->
        <view class="more-images-tip" wx:if="{{post.images.length > 9}}">
          <text>+{{post.images.length - 9}}</text>
        </view>
      </view>
    </view>
    
    <!-- 🗑️ 已移除：普通模式的帖子时间地点和操作按钮（AI-only 模式只使用时间轴布局） -->

      <!-- 帖子底部：点赞和评论 -->
      <view class="post-footer" wx:if="{{(post.likes && post.likes.length > 0) || (post.comments && post.comments.length > 0)}}">
        <!-- 点赞列表 -->
        <view class="likes-section" wx:if="{{post.likes && post.likes.length > 0}}">
          <view class="likes-container">
            <image class="like-icon" src="/assets/icons/like.svg" mode="aspectFit"></image>
            <view class="likes-text">
              <text wx:if="{{post.likedUsers && post.likedUsers.length > 0}}"><text wx:for="{{post.likedUsers}}" wx:for-item="user" wx:key="_id" wx:for-index="idx"><text class="liked-username">{{user.username}}</text><text wx:if="{{idx < post.likedUsers.length - 1}}" decode="{{true}}">&nbsp;&nbsp;</text></text><text decode="{{true}}">&nbsp;&nbsp;&nbsp;</text>觉得很赞</text>
              <text wx:else>{{post.likes.length}}人觉得很赞</text>
            </view>
          </view>
        </view>

        <!-- 评论列表 -->
        <view class="comments-section" wx:if="{{!hideComments && post.comments && post.comments.length > 0}}">
          <view class="comments-container">
            <!-- 显示所有评论（通过CSS控制折叠） -->
            <view
              class="comment-item {{comment._isNew ? 'comment-new-highlight' : ''}} {{!commentsExpanded && index >= maxCommentsShow ? 'comment-hidden' : ''}} {{!commentsExpanded && index === maxCommentsShow - 1 ? 'last-visible-comment' : ''}}"
              id="comment-{{comment._id}}"
              wx:for="{{post.comments}}"
              wx:for-item="comment"
              wx:key="_id"
              wx:if="{{!onboardingMode || visibleCommentIds[comment._id]}}"
            >
      <!-- 评论头像 -->
      <!-- 🗑️ 已移除：评论头像点击事件（AI-only 模式不需要查看用户资料） -->
      <ai-avatar wx:if="{{comment.author.isAI}}" mode="{{aiAvatarModes[comment._id] || 'dynamic'}}" size="28" bindtap="onTapAiAvatar" data-comment-id="{{comment._id}}"></ai-avatar>
      <image
        wx:else
        class="comment-avatar"
        src="{{comment.author.avatar || '/images/default_avatar.png'}}"
        mode="aspectFill"
      ></image>
              
              <!-- 评论内容区域 -->
              <view class="comment-content-wrapper">
                <!-- 用户名和时间 -->
                <view class="comment-header">
                  <text wx:if="{{comment.author._id !== 'ai'}}" class="comment-author">{{comment.author ? (comment.author.username || comment.author.name || '匿名用户') : '匿名用户'}}</text>
                  <!-- 如果是回复用户的评论，在用户名后显示回复目标 -->
                  <text wx:if="{{comment.replyTo}}" class="reply-indicator">·</text>
                  <text wx:if="{{comment.replyTo}}" class="reply-indicator">回复</text>
                  <text wx:if="{{comment.replyTo}}" class="reply-target">@{{comment.replyTo.username || comment.replyTo.name || '未知用户'}}</text>
                  <text wx:if="{{comment.author._id !== 'ai'}}">·</text>
                  <!-- AI 评论：状态文字 或 时间 -->
                  <block wx:if="{{comment.author.isAI}}">
                    <view class="ai-status-wrap">
                      <view
                        wx:if="{{aiHeaderStates[comment._id].showStatus}}"
                        class="ai-shimmer {{aiHeaderStates[comment._id].statusAnim}}"
                      >{{comment.aiStatus}}</view>
                      <view
                        wx:if="{{aiHeaderStates[comment._id].showTime}}"
                        class="comment-time {{aiHeaderStates[comment._id].timeAnim}}"
                      >{{comment.formattedTime || '刚刚'}}</view>
                    </view>
                  </block>
                  <!-- 普通评论：时间 -->
                  <text wx:else class="comment-time">{{comment.formattedTime || '刚刚'}}</text>
                </view>
                
                <!-- 评论内容 -->
                <view class="comment-content {{commentTextStates[comment._id] && commentTextStates[comment._id].animating ? 'comment-text-animating' : ''}}">
                  <!-- AI 评论：逐字 fadeIn -->
                  <view wx:if="{{comment.author.isAI && aiCommentChars[comment._id]}}" class="comment-text-flow" catchtap="onTapAiCommentText" data-comment-id="{{comment._id}}">
                    <text
                      wx:for="{{aiCommentChars[comment._id]}}"
                      wx:key="index"
                      class="comment-char-animated"
                      style="animation-delay:{{item.delay}};"
                    >{{item.char}}</text>
                  </view>
                  <!-- 普通评论（AI 无内容时不渲染） -->
                  <text wx:elif="{{comment.author._id !== 'ai' || comment.content}}" class="comment-text-flow">
                    <text
                      class="comment-main-text"
                      catchtap="onReplyComment"
                      data-user-id="{{comment.author ? comment.author._id : ''}}"
                      data-username="{{comment.author ? (comment.author.username || comment.author.name) : '匿名用户'}}"
                      data-comment-id="{{comment._id}}">{{commentTextStates[comment._id] && commentTextStates[comment._id].needToggle && !commentTextStates[comment._id].expanded ? commentTextStates[comment._id].collapsedText + '...' : (comment.content || '内容为空')}}</text><text class="comment-space" decode="{{true}}"></text>
                  </text>
                  <view class="comment-actions-container">
                    <text 
                      class="comment-toggle-btn"
                      wx:if="{{commentTextStates[comment._id] && commentTextStates[comment._id].needToggle}}"
                      catchtap="toggleCommentText"
                      data-comment-id="{{comment._id}}"
                    >{{commentTextStates[comment._id].expanded ? '收起' : '全文'}}</text>
                    <text
                      wx:if="{{!onboardingMode}}"
                      class="reply-btn"
                      catchtap="onReplyComment"
                      data-user-id="{{comment.author ? comment.author._id : ''}}"
                      data-username="{{comment.author ? (comment.author.username || comment.author.name) : '匿名用户'}}"
                      data-comment-id="{{comment._id}}">回复</text>
                    <image 
                      id="deleteCommentBtn"
                      class="delete-comment-btn" 
                      wx:if="{{showActions && comment.author && currentUser._id && currentUser._id === comment.author._id}}"
                      catchtap="onDeleteComment"
                      data-comment-id="{{comment._id}}"
                      src="/assets/icons/delete.svg"
                      mode="aspectFit"
                    ></image>
                  </view>
                </view>
              </view>
            </view>

            <!-- 展开/收起评论 -->
            <view 
              class="comments-toggle {{commentsExpanded ? 'toggle-expanded' : 'toggle-collapsed'}}" 
              wx:if="{{post.comments.length > maxCommentsShow}}"
              bindtap="toggleComments"
            >
              <view class="toggle-dash"></view>
              <text class="toggle-text">{{commentsExpanded ? '收起评论' : '查看全部' + post.comments.length + '条评论'}}</text>
              <image class="toggle-icon" src="{{commentsExpanded ? '/assets/icons/up.svg' : '/assets/icons/down.svg'}}" mode="aspectFit"></image>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 遮罩层 - 点击其他地方隐藏下拉菜单 -->
  <view class="dropdown-mask {{showActionsMenu ? 'show' : 'hide'}}" catchtap="hideActionsMenu"></view>
</view>