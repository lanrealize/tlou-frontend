/* discover-circle-card 组件样式 */

.card-wrapper {
  margin: 30rpx 40rpx;
}

/* history模式右上角区域 */
.top-right-area {
  position: absolute;
  right: 40rpx;
  top: 34rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 6;
}

/* 内联更新时间 */
.update-time-inline {
  font-size: 24rpx;
  color: #666666;
  white-space: nowrap;
}

/* 菜单区域 */
.menu-section {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 分隔线 */
.separator-line {
  width: 1rpx;
  height: 32rpx;
  background-color: #e0e0e0;
}

/* 三点菜单按钮 */
.more-menu {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: opacity 0.2s ease;
}

.more-menu:active {
  opacity: 0.6;
}

.more-menu .more-image {
  width: 36rpx;
  height: 36rpx;
}

.post-card {
  position: relative;
  height: 300rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.25);
  overflow: hidden;
}

/* history模式的特殊样式 */
.post-card.history-mode {
  height: 300rpx; /* 恢复到标准高度，因为成员信息移到了底部 */
}

/* 底部成员信息 - 替换点击查看位置 */
.members-info-bottom {
  position: absolute;
  left: 40rpx;
  bottom: 34rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 3;
}

.members-text {
  font-size: 24rpx;
  color: #666666;
  white-space: nowrap;
}

.members-list-horizontal {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.member-avatar-small {
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  border: 1rpx solid #ffffff;
}

.more-members-small {
  font-size: 18rpx;
  color: #999999;
  background: #f5f5f5;
  padding: 2rpx 6rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

/* 下拉菜单遮罩层 */
.dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9;
  background-color: transparent;
  opacity: 0;
  visibility: hidden;
  transition: all 0.2s ease;
}

.dropdown-mask.show {
  opacity: 1;
  visibility: visible;
}

.dropdown-mask.hide {
  opacity: 0;
  visibility: hidden;
}

/* 下拉菜单 */
.dropdown-menu {
  position: absolute;
  right: 40rpx;
  top: 80rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0rpx 4rpx 12rpx rgba(0, 0, 0, 0.15);
  z-index: 10;
  min-width: 200rpx;
  overflow: hidden;
  opacity: 0;
  visibility: hidden;
  transform: scale(0.8) translateY(-10rpx);
  transform-origin: top right;
  transition: all 0.25s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.dropdown-menu.show {
  opacity: 1;
  visibility: visible;
  transform: scale(1) translateY(0);
}

.dropdown-menu.hide {
  opacity: 0;
  visibility: hidden;
  transform: scale(0.8) translateY(-10rpx);
}

.dropdown-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  gap: 16rpx;
  background-color: #ffffff;
  transition: background-color 0.2s ease;
}

.dropdown-item:active {
  background-color: #f5f5f5;
}

.dropdown-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.dropdown-text {
  font-size: 28rpx;
  color: #333333;
  white-space: nowrap;
}

/* 响应式适配 - 与主页面保持一致 */
@media (max-width: 400px) {
  .card-wrapper {
    margin: 45rpx 30rpx;
  }
}

.post-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  background: #ffffff;
}

.discover-title {
  position: absolute;
  left: 40rpx;
  top: 34rpx;
  z-index: 5;
  font-size: 28rpx;
  color: #000000;
  font-weight: 400;
  line-height: 1.5;
}

.menu-icon {
  position: absolute;
  right: 40rpx;
  top: 30rpx;
  width: 50rpx;
  height: 50rpx;
  z-index: 6;
}

.menu-icon .menu-image {
  width: 100%;
  height: 100%;
}

/* 旧的成员信息和更新时间样式已移除，新样式在上方定义 */

.discover-avatar {
  position: absolute;
  left: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 55rpx;
  height: 55rpx;
  border-radius: 30rpx;
  z-index: 3;
}

/* history模式下头像位置调整 - 与内容区域保持一致 */
.history-mode .discover-avatar {
  top: 50%;
}

.content-container {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  left: 90rpx;
  width: 240rpx;
  z-index: 2;
  padding-left: 32rpx;
}

/* history模式下内容位置调整 - 由于list页面有额外的20rpx padding，需要减少对应宽度 */
.history-mode .content-container {
  top: 50%;
  width: 210rpx;
}

.quote-mark {
  font-size: 32rpx;
  color: #1A73E8;
  font-weight: 700;
  position: absolute;
  left: 40rpx;
  top: 0;
  line-height: 1.4;
}

.post-content {
  flex: 1;
  color: #808080;
  font-size: 24rpx;
  font-weight: 400;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  text-overflow: ellipsis;
  line-height: 1.4;
  text-indent: 2em;
}

.view-btn {
  position: absolute;
  left: 40rpx;
  bottom: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: row;
  z-index: 3;
}

.view-more {
  font-size: 28rpx;
  color: #1A73E8;
  font-weight: 400;
  margin-right: 8rpx;
}

.view-icon {
  width: 24rpx;
  height: 24rpx;
}

.rotated-img {
  position: absolute;
  right: -100rpx;
  top: 140rpx;
  width: 360rpx;
  height: 270rpx;
  border-radius: 10rpx;
  transform: rotate(-16.8deg);
  z-index: 6;
  transform-origin: center;
  overflow: hidden;
}

/* 动画效果 */
/* 初始加载：只淡入 */
.card-fade-only {
  opacity: 0;
  animation: cardFadeOnly 0.5s ease-out forwards;
}

/* 刷新：淡入+上滑 */
.card-fade-slide {
  opacity: 0;
  animation: cardFadeSlide 0.5s ease-out forwards;
}

@keyframes cardFadeOnly {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes cardFadeSlide {
  from {
    opacity: 0;
    transform: translate3d(0, 40px, 0);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}
