/* components/home-panel/home-panel.wxss */

/* 遮罩层 - 完全透明，不影响背景 */
.home-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: transparent;
  z-index: 998;
}

/* 弹出层容器 */
.home-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  transform: translateY(100%);
  opacity: 0;
}

/* 显示状态 - 和 user-info-popup 一样的动画 */
.home-panel.show {
  transform: translateY(0);
  opacity: 1;
  /* 0.3s 和 circle-status-action 保持一致，无延迟 */
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
              opacity 0.3s ease;
}

/* 隐藏状态 - 快速下沉消失 */
.home-panel:not(.show) {
  transform: translateY(100%);
  opacity: 0;
  transition: transform 0.25s cubic-bezier(0.4, 0, 1, 1), 
              opacity 0.2s ease;
}

/* 弹出内容 - 更大的卡片 */
.panel-content {
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0; /* 上面两个圆角，下面直角 */
  box-shadow: 0px -2px 8px rgba(0, 0, 0, 0.1); /* 向上的阴影 */
  overflow: hidden;
  max-height: 90vh; /* 比 user-info-popup 的 85vh 更大 */
  min-height: 60vh; /* 设置最小高度，确保足够大 */
  overflow-y: auto;
  padding: 0;
}

/* 内容淡入动画 - 和弹出层同步，无延迟 */
.home-panel.show .panel-content {
  animation: fadeInUp 0.3s ease-out both;
}

/* 淡入动画 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 内容区域 - 预留给未来的 thread 列表 */
.content-area {
  padding: 40rpx;
  min-height: 60vh;
}

