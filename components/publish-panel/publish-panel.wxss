/* components/publish-panel/publish-panel.wxss */

/* 遮罩层 */
.publish-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: transparent;
  z-index: 998;
}

/* 弹出层容器 */
.publish-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  transform: translateY(100%);
  opacity: 0;
}

.publish-panel.show {
  transform: translateY(0);
  opacity: 1;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
              opacity 0.3s ease;
}

.publish-panel:not(.show) {
  transform: translateY(100%);
  opacity: 0;
  transition: transform 0.25s cubic-bezier(0.4, 0, 1, 1),
              opacity 0.2s ease;
}

/* 弹出内容卡片 */
.popup-content {
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0px -2px 8px rgba(0, 0, 0, 0.1);
  overflow: hidden;
  max-height: 85vh;
  overflow-y: auto;
}

.publish-panel.show .popup-content {
  animation: fadeInUp 0.3s ease-out both;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ========== 头部卡片 ========== */
.header-card {}

.card-layout {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx 10rpx 40rpx;
  gap: 30rpx;
}

.left-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  min-width: 0;
}

.main-title {
  font-size: 28rpx;
  color: #000000;
  font-weight: 400;
  line-height: 1.5;
}

.sub-title {
  font-size: 24rpx;
  color: #808080;
  font-weight: 400;
  line-height: 1.6;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.cancel-btn {
  font-size: 28rpx;
  color: #808080;
  padding: 8rpx 8rpx;
}

.action-btn {
  color: #1A73E8;
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 400;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
  background: none !important;
  border: none;
}

.action-btn::after {
  border: none !important;
  background: none !important;
}

.action-btn:active { opacity: 0.7; }

.action-btn.disabled {
  color: #BDBDBD !important;
  opacity: 0.6;
}

/* ========== 内容区域 ========== */
.form-content {
  padding: 10rpx 40rpx 50rpx 40rpx;
}

.content-input-container {
  position: relative;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 32rpx;
  min-height: 148rpx;
  margin-bottom: 30rpx;
}

.content-textarea {
  width: 100%;
  min-height: 84rpx;
  border: none;
  font-size: 26rpx;
  line-height: 1.6;
  background-color: transparent;
  color: #333333;
}

.textarea-placeholder {
  color: #999999;
  font-size: 26rpx;
}

.char-count {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  font-size: 24rpx;
  color: #aaa;
}

/* ========== 图片网格 ========== */
.images-grid-1 { width: 100%; margin-bottom: 30rpx; }
.images-grid-1 .image-item { width: 100%; height: 0; padding-bottom: 100%; }

.images-grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.images-grid-2 .image-item { width: 100%; height: 0; padding-bottom: 100%; }

.images-grid-3, .images-grid-4, .images-grid-5,
.images-grid-6, .images-grid-7, .images-grid-8, .images-grid-9 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 30rpx;
}
.images-grid-3 .image-item, .images-grid-4 .image-item,
.images-grid-5 .image-item, .images-grid-6 .image-item,
.images-grid-7 .image-item, .images-grid-8 .image-item,
.images-grid-9 .image-item { width: 100%; height: 0; padding-bottom: 100%; }

.image-item {
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #f5f5f5;
  box-sizing: border-box;
}

.selected-image { width: 100%; height: 100%; display: block; }

.images-grid-1 .image-item .selected-image,
.images-grid-2 .image-item .selected-image,
.images-grid-3 .image-item .selected-image,
.images-grid-4 .image-item .selected-image,
.images-grid-5 .image-item .selected-image,
.images-grid-6 .image-item .selected-image,
.images-grid-7 .image-item .selected-image,
.images-grid-8 .image-item .selected-image,
.images-grid-9 .image-item .selected-image {
  position: absolute;
  top: 0; left: 0;
}

.delete-image-btn {
  position: absolute;
  top: 8rpx; right: 8rpx;
  width: 50rpx; height: 50rpx;
  background: rgba(0, 0, 0, 0.35);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-image-btn .delete-icon {
  width: 24rpx; height: 24rpx;
  filter: brightness(0) invert(1);
}

/* ========== 添加图片按钮 ========== */
.add-image-btn, .add-images-btn-initial {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 32rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  margin-top: 10rpx;
}

.add-icon-svg { width: 32rpx; height: 32rpx; opacity: 0.8; }
.add-text { font-size: 26rpx; color: #1A73E8; font-weight: 600; }

/* ========== 违规 ========== */
.violation-alert {
  margin-bottom: 30rpx;
  padding: 24rpx;
  background: #fef0f0;
  border-radius: 12rpx;
}

.alert-desc { display: block; font-size: 26rpx; color: #991b1b; line-height: 1.5; margin-bottom: 8rpx; }
.alert-timeout { display: block; font-size: 24rpx; color: #ef4444; margin-bottom: 20rpx; }

.btn-secondary {
  background-color: #374151;
  color: #ffffff;
  padding: 16rpx 32rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  text-align: center;
}

.image-item.violated { border: 3rpx solid #dc2626; }
.violation-badge {
  position: absolute; top: 8rpx; left: 8rpx;
  background-color: #dc2626; color: #ffffff;
  padding: 4rpx 12rpx; border-radius: 16rpx;
}
.violation-text { font-size: 20rpx; font-weight: 600; }
.delete-violated { background-color: rgba(220, 38, 38, 0.9); }
