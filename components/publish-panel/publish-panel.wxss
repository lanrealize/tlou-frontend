/* components/publish-panel/publish-panel.wxss */

.container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  z-index: 1000;
  transform: translateY(100vh);
  transition: transform 0.6s cubic-bezier(0.2, 1, 0.2, 1);
}

.container.slide-in {
  transform: translateY(0);
}

/* 自定义导航栏样式 */
.custom-navigation {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background-color: #ffffff;
}

.navigation-content {
  position: relative;
  width: 100%;
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 16px;
  box-sizing: border-box;
  background-color: #ffffff;
}

.nav-cancel-btn {
  position: absolute;
  left: 16px;
  top: 50%;
  transform: translateY(-50%);
  padding: 10rpx;
  display: flex;
  align-items: center;
}

.nav-cancel-text {
  font-size: 28rpx;
  color: #1A73E8;
}


.nav-center {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.title-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  line-height: 1;
}

/* 操作栏样式 - 充实的第二行 */
.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 32rpx;
  background-color: #ffffff;
  height: 96rpx;
  width: 100%;
  box-sizing: border-box;
}

.action-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-height: 60rpx;
}

.action-center {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  margin: 0 16rpx;
}

.action-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 60rpx;
}

/* 内容统计样式 */
.content-stats {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.stat-item {
  font-size: 26rpx;
  color: #999999;
  line-height: 1;
  font-weight: 400;
}

/* 空状态提示 */
.empty-hint {
  display: flex;
  align-items: center;
}

/* 静态提示文字 */
.static-hint {
  display: flex;
  align-items: center;
}

.hint-text {
  font-size: 26rpx;
  color: #8a8a8a;
  font-weight: 400;
  padding-left: 5rpx;
}

/* 违规警告 */
.violation-warning {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: rgba(255, 59, 48, 0.1);
  padding: 8rpx 12rpx;
  border-radius: 16rpx;
}

.warning-icon {
  font-size: 20rpx;
}

.warning-text {
  font-size: 20rpx;
  color: #ff3b30;
  font-weight: 500;
}

/* 页面内容区域 */
.page-content {
  background-color: #ffffff;
}




/* 文本输入区域 - 极简风格 */
.content-section {
  margin: 0rpx 32rpx;
}

.content-input-container {
  position: relative;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 32rpx;
  transition: all 0.2s ease;
  min-height: 148rpx;
}

.content-input-container:focus-within {
  background-color: #f0f0f0;
}

.content-textarea {
  width: 100%;
  min-height: 84rpx;
  padding: 0;
  border: none;
  border-radius: 0;
  font-size: 26rpx;
  line-height: 1.6;
  background-color: transparent;
  color: #333333;
  font-weight: 400;
  box-sizing: border-box;
}

.textarea-placeholder {
  color: #999999;
  font-size: 26rpx;
  line-height: 1.6;
  font-weight: 400;
}

.char-count {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  font-size: 24rpx;
  color: #aaa;
  font-weight: 400;
}

/* 图片上传区域 - 极简风格 */
.images-section {
  margin: 30rpx 32rpx;
}

/* 图片网格布局系统 - 分离式设计 */

/* 1张图片：完全独立的样式，与输入框精确对齐 */
.images-grid-1 {
  /* 不使用grid或flex，直接定位 */
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 35rpx; /* 增加下边距，与添加按钮保持适当间隔 */
}

/* 1张图片时，保持images-section的margin与content-section一致 */
.images-section:has(.images-grid-1) {
  margin: 30rpx 32rpx; /* 左右margin与content-section保持一致，与输入框容器宽度对齐 */
}

.images-grid-1 .image-item {
  /* 去掉所有margin，完全占满容器 */
  margin: 0; /* 完全去掉margin */
  width: 100%; /* 占满整个容器 */
  height: 0;
  padding-bottom: 100%; /* 保持正方形 */
  aspect-ratio: 1;
}

/* 2张图片：使用Grid布局，两列等宽 */
.images-grid-2 {
  display: grid;
  width: 100%;
  gap: 16rpx;
  box-sizing: border-box;
  grid-template-columns: 1fr 1fr;
  margin-bottom: 20rpx; /* 增加底部间距，与添加按钮保持适当间隔 */
}

.images-grid-2 .image-item {
  width: 100%;
  aspect-ratio: 1;
  height: 0;
  padding-bottom: 100%; /* 创建正方形 */
}

/* 3-9张图片：九宫格布局，使用Grid布局 - 基础样式 */
.images-grid-3,
.images-grid-4,
.images-grid-5,
.images-grid-6,
.images-grid-7,
.images-grid-8,
.images-grid-9 {
  display: grid;
  grid-template-columns: repeat(3, 1fr); /* 3列等宽 */
  grid-gap: 16rpx; /* 使用grid-gap确保兼容性，横向和纵向间距统一 */
  row-gap: 16rpx; /* 显式设置行间距 */
  column-gap: 16rpx; /* 显式设置列间距 */
  width: 100%;
  box-sizing: border-box;
  margin: 0 0 35rpx 0; /* 增加底部间距，与添加按钮保持适当间隔 */
  padding: 0;
}

/* 九宫格中的每个图片项 - 使用padding-bottom技巧确保正方形 */
.images-grid-3 .image-item,
.images-grid-4 .image-item,
.images-grid-5 .image-item,
.images-grid-6 .image-item,
.images-grid-7 .image-item,
.images-grid-8 .image-item,
.images-grid-9 .image-item {
  width: 100%;
  height: 0;
  padding-bottom: 100%; /* 创建正方形比例 */
  position: relative;
  margin: 0; /* 确保没有额外的margin */
}

/* 统一的图片容器样式 */
.image-item {
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #f5f5f5;
  box-sizing: border-box;
}


/* 图片元素样式 - 基础样式 */
.selected-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* 1-2张图片的特殊样式（使用padding-bottom技巧，需要绝对定位） */
.images-grid-1 .image-item .selected-image,
.images-grid-2 .image-item .selected-image {
  position: absolute;
  top: 0;
  left: 0;
}

/* 3-9张图片使用padding-bottom技巧，图片需要绝对定位 */
.images-grid-3 .image-item .selected-image,
.images-grid-4 .image-item .selected-image,
.images-grid-5 .image-item .selected-image,
.images-grid-6 .image-item .selected-image,
.images-grid-7 .image-item .selected-image,
.images-grid-8 .image-item .selected-image,
.images-grid-9 .image-item .selected-image {
  position: absolute;
  top: 0;
  left: 0;
}

.delete-image-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 50rpx;
  height: 50rpx;
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.35) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.25);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  transition: all 0.2s ease;
}

.delete-image-btn:active {
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.75) 100%);
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.delete-image-btn .delete-icon {
  width: 24rpx !important;
  height: 24rpx !important;
  opacity: 0.9;
  filter: brightness(0) saturate(100%) invert(100%) sepia(0%) saturate(7482%) hue-rotate(102deg) brightness(105%) contrast(101%);
}

/* 添加图片按钮 - 与初始按钮一致的样式 */
.add-image-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 32rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  transition: all 0.2s ease;
  margin-top: 10rpx;
  width: 100%;
  box-sizing: border-box;
}

.add-image-btn:active {
  background-color: #f0f0f0;
  transform: scale(0.98);
}

/* 添加按钮图标和文字样式 - 与初始按钮一致 */
.add-icon-svg {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.8;
}

.add-text {
  font-size: 26rpx;
  color: #1A73E8;
  font-weight: 600;
}

/* 初始添加图片按钮 - 主题色风格 */
.add-images-btn-initial {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 32rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.add-images-btn-initial:active {
  background-color: #f0f0f0;
  transform: scale(0.98);
}

/* 初始添加按钮和有图片时的按钮现在使用相同样式 */

/* 发布提示 - 极简风格 */
.publish-tips {
  margin: 40rpx 32rpx;
}

.violation-footer-tip {
  padding: 24rpx;
  background-color: #fff8e1;
  border-radius: 12rpx;
  text-align: center;
}

.tip-text {
  font-size: 26rpx;
  color: #856404;
  font-weight: 500;
}

/* 草稿状态 */
.draft-status {
  display: flex;
  align-items: center;
  height: 48rpx;
  background-color: #fff2cc;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
}

.draft-text {
  font-size: 22rpx;
  color: #333333;
  line-height: 1;
}

/* 导航栏发布按钮 - 纯文字样式 */
.nav-publish-btn {
  min-width: 80rpx;
  height: auto;
  padding: 16rpx 24rpx;
  border-radius: 0;
  font-size: 28rpx;
  font-weight: 600;
  border: none !important;
  background: transparent !important;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  line-height: 1;
}

.nav-publish-btn::after {
  border: none !important;
  background: transparent !important;
}

.nav-publish-btn.active {
  background: transparent !important;
  color: #1A73E8;
}

.nav-publish-btn.disabled {
  background: transparent !important;
  color: #cccccc;
}

.nav-publish-btn[disabled] {
  background: transparent !important;
  color: #cccccc;
}

.nav-publish-hover {
  opacity: 0.6;
  background: transparent !important;
}


/* 响应式调整 - 小屏幕优化，分离式设计 */
@media (max-width: 400px) {
  /* 2张图片的小屏幕适配 */
  .images-grid-2 {
    gap: 14rpx;
  }
  
  .images-grid-1 .image-item {
    /* 小屏幕下也去掉margin，完全占满容器 */
    margin: 0;
    width: 100%;
    height: 0;
    padding-bottom: 100%; /* 保持正方形 */
  }
  
  /* 2张图片在小屏幕保持100%宽度 */
  .images-grid-2 .image-item {
    width: 100%;
    height: 0;
    padding-bottom: 100%; /* 小屏幕正方形 */
  }
  
  /* 小屏幕下1-2张图片也需要绝对定位 */
  .images-grid-1 .image-item .selected-image,
  .images-grid-2 .image-item .selected-image {
    position: absolute;
    top: 0;
    left: 0;
  }
  
  /* 3-9张图片的小屏幕适配 */
  .images-grid-3,
  .images-grid-4,
  .images-grid-5,
  .images-grid-6,
  .images-grid-7,
  .images-grid-8,
  .images-grid-9 {
    grid-gap: 14rpx; /* 小屏幕统一间距 */
    row-gap: 14rpx; /* 显式设置行间距 */
    column-gap: 14rpx; /* 显式设置列间距 */
  }
  
  /* 小屏幕下图片项样式与主样式保持一致 */
  .images-grid-3 .image-item,
  .images-grid-4 .image-item,
  .images-grid-5 .image-item,
  .images-grid-6 .image-item,
  .images-grid-7 .image-item,
  .images-grid-8 .image-item,
  .images-grid-9 .image-item {
    width: 100%;
    height: 0;
    padding-bottom: 100%; /* 确保正方形 */
    position: relative;
    margin: 0; /* 确保没有额外的margin */
  }
}

/* 违规提示区域 */
.violation-alert {
  margin-bottom: 30rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #fef0f0 0%, #fdf2f2 100%);
  border: 2rpx solid #fecaca;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(254, 202, 202, 0.3);
}

.alert-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.alert-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.alert-title {
  font-size: 32rpx;
  color: #dc2626;
  font-weight: 600;
}

.alert-content {
  margin-bottom: 20rpx;
}

.alert-desc {
  display: block;
  font-size: 26rpx;
  color: #991b1b;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.alert-timeout {
  display: block;
  font-size: 24rpx;
  color: #ef4444;
  font-weight: 500;
}

.alert-actions {
  display: flex;
  justify-content: center;
}

.btn {
  padding: 20rpx 40rpx;
  border-radius: 25rpx;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
  transition: all 0.3s ease;
}

.btn-secondary {
  background-color: #374151;
  color: #ffffff;
}

.btn-secondary:active {
  background-color: #1f2937;
  transform: scale(0.98);
}

/* 违规图片样式 */
.image-item.violated {
  border: 3rpx solid #dc2626;
  box-shadow: 0 0 0 2rpx rgba(220, 38, 38, 0.2);
  animation: violation-pulse 2s infinite;
}

@keyframes violation-pulse {
  0%, 100% {
    box-shadow: 0 0 0 2rpx rgba(220, 38, 38, 0.2);
  }
  50% {
    box-shadow: 0 0 0 4rpx rgba(220, 38, 38, 0.3);
  }
}

.violation-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  background-color: #dc2626;
  color: #ffffff;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  z-index: 2;
}

.violation-text {
  font-size: 20rpx;
  font-weight: 600;
}

.delete-violated {
  background-color: rgba(220, 38, 38, 0.9);
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(220, 38, 38, 0.4);
}

.delete-violated:active {
  background-color: rgba(220, 38, 38, 1);
  transform: scale(0.9);
}

.violation-reason {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
  padding: 20rpx 8rpx 8rpx;
}

.reason-text {
  font-size: 20rpx;
  color: #ffffff;
  line-height: 1.3;
  display: block;
  text-align: center;
}