<!--components/publish-panel/publish-panel.wxml-->
<!-- 遮罩层 -->
<view class="publish-panel-mask" wx:if="{{show}}" bindtap="onMaskTap" catchtouchmove="preventMove"></view>

<!-- 弹出层 -->
<view class="publish-panel {{slideIn ? 'show' : ''}}" catchtouchmove="preventMove">
  <view class="popup-content">

    <!-- 头部卡片 -->
    <view class="header-card">
      <view class="card-layout">
        <view class="left-content">
          <text class="main-title">发布动态</text>
          <text class="sub-title" wx:if="{{showViolationAlert}}">{{violationDetails.violatedImages.length}}张图片违规，请处理后发布</text>
          <text class="sub-title" wx:else>说点什么，或者分享一张照片</text>
        </view>
        <view class="header-actions">
          <text class="cancel-btn" bindtap="onMaskTap">取消</text>
          <button
            class="action-btn {{(content.length > 0 || tempImages.length > 0) && !showViolationAlert ? '' : 'disabled'}}"
            bindtap="publishPost"
            disabled="{{isPublishing || (content.length === 0 && tempImages.length === 0) || showViolationAlert}}"
          >{{isPublishing ? '发布中' : '发布'}}</button>
        </view>
      </view>
    </view>

    <!-- 内容区域 -->
    <view class="form-content">

      <!-- 文本输入 -->
      <view class="content-input-container">
        <textarea
          id="contentTextarea"
          class="content-textarea"
          placeholder="说点什么..."
          value="{{content}}"
          bindinput="onContentInput"
          auto-height
          maxlength="2000"
          placeholder-class="textarea-placeholder"
          show-confirm-bar="{{false}}"
          adjust-position="{{false}}"
        ></textarea>
        <view class="char-count" wx:if="{{content.length > 0}}">{{content.length}}/2000</view>
      </view>

      <!-- 违规提示 -->
      <view class="violation-alert" wx:if="{{showViolationAlert}}">
        <text class="alert-desc">检测到{{violationDetails.violatedImages.length}}张图片违规，请移除红框图片后重新发布</text>
        <text class="alert-timeout">剩余时间：{{remainingTimeText || (violationDetails.timeoutMinutes + '分钟')}}</text>
        <view class="btn btn-secondary" bindtap="republishWithoutViolatedImages">
          <text>自动移除违规图片并发布</text>
        </view>
      </view>

      <!-- 图片网格 -->
      <view class="images-grid images-grid-{{tempImages.length}}" wx:if="{{tempImages.length > 0 && !showViolationAlert}}">
        <view class="image-item" wx:for="{{tempImages}}" wx:key="*this">
          <image class="selected-image" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-index="{{index}}"></image>
          <view class="delete-image-btn" bindtap="deleteImage" data-index="{{index}}">
            <image class="delete-icon" src="/assets/icons/delete.svg" mode="aspectFit"></image>
          </view>
        </view>
      </view>

      <!-- 违规模式图片 -->
      <view class="images-grid images-grid-{{tempImages.length}}" wx:if="{{showViolationAlert && tempImagesWithStatus}}">
        <view class="image-item {{item.isViolated ? 'violated' : ''}}" wx:for="{{tempImagesWithStatus}}" wx:key="originalIndex">
          <image class="selected-image" src="{{item.path}}" mode="aspectFill" bindtap="previewImage" data-index="{{index}}"></image>
          <view class="violation-badge" wx:if="{{item.isViolated}}"><text class="violation-text">违规</text></view>
          <view class="delete-image-btn {{item.isViolated ? 'delete-violated' : ''}}" bindtap="{{item.isViolated ? 'deleteViolatedImage' : 'deleteImage'}}" data-index="{{index}}">
            <image class="delete-icon" src="/assets/icons/delete.svg" mode="aspectFit"></image>
          </view>
        </view>
      </view>

      <!-- 添加图片按钮 -->
      <view class="add-image-btn" bindtap="chooseImages" wx:if="{{tempImages.length > 0 && tempImages.length < maxImages && !showViolationAlert}}">
        <image class="add-icon-svg" src="/assets/icons/add.svg" mode="aspectFit"></image>
        <text class="add-text">添加图片</text>
      </view>
      <view id="addImagesBtn" class="add-images-btn-initial" bindtap="chooseImages" wx:if="{{tempImages.length === 0}}">
        <image class="add-icon-svg" src="/assets/icons/add.svg" mode="aspectFit"></image>
        <text class="add-text">添加图片</text>
      </view>

    </view>
  </view>
</view>
