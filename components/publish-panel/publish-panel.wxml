<!--components/publish-panel/publish-panel.wxml-->
<!-- 遮罩层 -->
<view class="publish-panel-mask" wx:if="{{show}}" bindtap="onMaskTap" catchtouchmove="preventMove"></view>

<!-- 弹出层 -->
<view class="publish-panel {{slideIn ? 'show' : ''}}" catchtouchmove="preventMove">
  <view class="popup-content">

    <!-- 头部卡片 -->
    <view class="header-card">
      <view class="card-layout">
        <view class="left-content">
          <text class="main-title">发布动态</text>
          <text class="sub-title" wx:if="{{showViolationAlert}}">{{violationDetails.violatedImages.length}}张图片违规，请处理后发布</text>
          <text class="sub-title" wx:else>说点什么，或者分享一张照片</text>
        </view>
        <view class="header-actions">
          <text class="cancel-btn" bindtap="onMaskTap">取消</text>
          <button
            class="action-btn {{(content.length > 0 || tempImages.length > 0) && !showViolationAlert ? '' : 'disabled'}}"
            bindtap="publishPost"
            disabled="{{isPublishing || (content.length === 0 && tempImages.length === 0) || showViolationAlert}}"
          >{{isPublishing ? '发布中' : '发布'}}</button>
        </view>
      </view>
    </view>

    <!-- 内容区域 -->
    <view class="form-content">

      <!-- 文本输入 -->
      <view class="content-input-container">
        <textarea
          id="contentTextarea"
          class="content-textarea"
          placeholder="说点什么..."
          value="{{content}}"
          bindinput="onContentInput"
          auto-height
          maxlength="2000"
          placeholder-class="textarea-placeholder"
          show-confirm-bar="{{false}}"
          adjust-position="{{false}}"
        ></textarea>
      </view>

      <!-- 图片展示区域 -->
      <view class="images-row" wx:if="{{!showViolationAlert}}">
        <!-- 已选图片 -->
        <view class="image-wrapper {{removingImage ? 'removing' : ''}}" wx:if="{{tempImages.length > 0}}">
          <image class="selected-image" src="{{tempImages[0]}}" mode="{{imageDisplayInfo.mode || 'aspectFill'}}" style="width: {{imageDisplayInfo.width}}rpx; height: {{imageDisplayInfo.height}}rpx;" bindtap="previewImage" data-index="0"></image>
          <view class="delete-badge" bindtap="deleteImage" data-index="0">
            <text class="delete-icon">×</text>
          </view>
        </view>
        
        <!-- 添加图片按钮（正方形虚线框） -->
        <view class="add-images-btn-square" bindtap="chooseImages" style="width: {{imageDisplayInfo.width}}rpx; height: {{imageDisplayInfo.height}}rpx;">
          <image class="add-icon-svg-small" src="/assets/icons/add.svg" mode="aspectFit"></image>
          <text class="add-images-label">添加图片</text>
        </view>
      </view>

      <!-- 违规模式图片 -->
      <view class="image-container {{tempImagesWithStatus[0].isViolated ? 'violated' : ''}}" wx:if="{{showViolationAlert && tempImagesWithStatus}}">
        <image class="selected-image" src="{{tempImagesWithStatus[0].path}}" mode="widthFix" style="width: {{imageDisplayInfo.width}}rpx;" bindtap="previewImage" data-index="0"></image>
        <view class="violation-badge" wx:if="{{tempImagesWithStatus[0].isViolated}}"><text class="violation-text">违规</text></view>
      </view>

      <!-- 违规提示 -->
      <view class="violation-alert" wx:if="{{showViolationAlert}}">
        <text class="alert-desc">检测到{{violationDetails.violatedImages.length}}张图片违规，请移除红框图片后重新发布</text>
        <text class="alert-timeout">剩余时间：{{remainingTimeText || (violationDetails.timeoutMinutes + '分钟')}}</text>
        <view class="btn btn-secondary" bindtap="republishWithoutViolatedImages">
          <text>自动移除违规图片并发布</text>
        </view>
      </view>

      <!-- 信息 Badges -->
      <view class="badges-container">
        <view class="info-badge" bindtap="getLocation">
          <image class="badge-icon" src="/assets/icons/location.svg" mode="aspectFit"></image>
          <text class="badge-text">添加位置</text>
        </view>
      </view>

    </view>
  </view>
</view>
